# Alan adınızı yazın. 80/443 dışa açık ve DNS bu sunucuya bakıyorsa
# Caddy otomatik Let's Encrypt sertifikası alır ve yeniler.
# SignalR/WebSocket, reverse_proxy tarafından otomatik desteklenir.
your-domain.com {
    encode gzip zstd
    reverse_proxy app:8080
}

# --- Yerel test (TLS'siz) ---
