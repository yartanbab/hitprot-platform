# =====================================================================
#  Apya.Platform — production ortam değişkenleri
#  Bu dosyayı `.env` olarak kopyalayın ve tüm CHANGE_ME değerlerini doldurun.
#  .env dosyası ASLA commit'lenmemeli (.gitignore'da).
#
#  ÖNCE: OpenIddict sertifikasını üretin (openssl ile, ~10 yıl geçerli):
#    mkdir -p secrets
#    openssl req -x509 -newkey rsa:2048 -keyout secrets/key.pem \
#      -out secrets/cert.pem -days 3650 -nodes -subj "/CN=ApyaPlatform"
#    openssl pkcs12 -export -out secrets/openiddict.pfx \
#      -inkey secrets/key.pem -in secrets/cert.pem -passout pass:CHANGE_ME_pfx_pass
#  (pass: değeri ile aşağıdaki OpenIddict__CertificatePassword AYNI olmalı.)
# =====================================================================

# ---- PostgreSQL (db servisi) ----
POSTGRES_DB=ApyaPlatform
POSTGRES_USER=apya
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- Uygulama bağlantı dizesi ----
# Password, yukarıdaki POSTGRES_PASSWORD ile AYNI olmalı. Host=db (compose servis adı).
ConnectionStrings__Default=Host=db;Port=5432;Database=ApyaPlatform;Username=apya;Password=CHANGE_ME_strong_db_password;Include Error Detail=false

# ---- Genel URL (Caddy'nin sunduğu alan adı) ----
# Hem app hem migrator (OpenIddict redirect URI seed'i) bunu kullanır.
App__SelfUrl=https://your-domain.com
OpenIddict__Applications__Platform_Web__RootUrl=https://your-domain.com

# ---- Sırlar ----
# OpenIddict sertifika parolası (yukarıdaki openssl komutundaki pass: ile aynı)
OpenIddict__CertificatePassword=CHANGE_ME_pfx_pass
# Platform_Web client secret (dev'deki "1q2w3e*" yerine güçlü bir değer)
OpenIddict__Applications__Platform_Web__ClientSecret=CHANGE_ME_client_secret

# StringEncryption — DB'de saklanan ayarları/AI provider API anahtarlarını şifreler.
# BİR KEZ belirleyin ve ASLA DEĞİŞTİRMEYİN; değişirse şifreli veriler çözülemez.
StringEncryption__DefaultPassPhrase=CHANGE_ME_constant_passphrase

# OpenAI (AI modülü) — kullanılmıyorsa boş bırakılabilir
OpenAI__ApiKey=sk-...
