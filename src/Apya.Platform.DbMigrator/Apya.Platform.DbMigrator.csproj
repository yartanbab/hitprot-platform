<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="appsettings.secrets.json" />
    <Content Include="appsettings.secrets.json" Condition="Exists('appsettings.secrets.json')">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>    
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Volo.Abp.Castle.Core" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac" Version="10.0.2" />
	  <ProjectReference Include="..\Apya.Platform.Application.Contracts\Apya.Platform.Application.Contracts.csproj" />
	  <ProjectReference Include="..\Apya.Platform.EntityFrameworkCore\Apya.Platform.EntityFrameworkCore.csproj" />
	  <!-- SQL Server migration assembly'si: yalnızca Database:Provider=SqlServer iken kullanılır,
	       ama runtime'da bin'de bulunması için referans şart. -->
	  <ProjectReference Include="..\Apya.Platform.EntityFrameworkCore.SqlServer\Apya.Platform.EntityFrameworkCore.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apya.Platform.Domain\Apya.Platform.Domain.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.EntityFrameworkCore\Apya.Platform.Ai.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.Application.Contracts\Apya.Platform.Ai.Application.Contracts.csproj" />

    <!--
      İzin ve paket tohumlayıcıları APPLICATION katmanında yaşıyor. Bu referans
      olmadan DbMigrator o derlemeyi hiç yüklemiyordu; ölçüm: bin çıktısında
      Apya.Platform.Application.dll YOKTU ve modül grafiğinde de geçmiyordu.
      Sonuç: YEDİ IDataSeedContributor sessizce hiç çalışmıyordu —
        · beş izin tohumlayıcısı (Documents, Tasks, Consents, LoginScreen,
          IssueTasks) → yeni izinler admin rolüne hiç verilmiyor, özellik
          kurulu bir sistemde "yetkisiz" görünüyordu;
        · AiPermissionDataSeedContributor;
        · PackageDataSeedContributor → AppPlatformPackages tablosu boş kalıyordu.
      Web tarafında tohumlama çağrısı yok, yani DbMigrator tek yol.
    -->
    <ProjectReference Include="..\Apya.Platform.Application\Apya.Platform.Application.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.Application\Apya.Platform.Ai.Application.csproj" />
  </ItemGroup>

</Project>
