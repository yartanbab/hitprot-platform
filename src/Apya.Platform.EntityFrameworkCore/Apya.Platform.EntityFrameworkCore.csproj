<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Apya.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apya.Platform.Domain\Apya.Platform.Domain.csproj" />
    <ProjectReference Include="..\Apya.Platform.Domain.Shared\Apya.Platform.Domain.Shared.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.EntityFrameworkCore\Apya.Platform.Ai.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- CVE override: EF.Tools → Build.Tasks.Core 17.14.28 → System.Security.Cryptography.Xml 9.0.0
         GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf. 9.0.18 de 13 Ekim 2026'da yeni açıklarla işaretlendi
         (CVE-2026-96958/96959/96960 EncryptedXml DoS, 9.0.20'ye kadar açık) → 9.0.22. Xml'in bağımlı olduğu
         Pkcs de 9.0.22'ye çıkar. PrivateAssets=all: dev-time only. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- CVE override: Microsoft.Data.SqlClient 6.1.1 → System.Security.Cryptography.Pkcs 9.0.4
         (CVE-2026-84008 yüksek, CVE-2026-70162 orta; 9.0.20'ye kadar açık) → 9.0.22. SqlClient bu projedeki
         Volo.Abp.EntityFrameworkCore.SqlServer'dan girer; Web, DbMigrator ve testler bu projeden alır, bu yüzden
         PrivateAssets YOK. DbMigrator paketinde açıklı 9.0.4 gerçekten yükleniyordu (Web'de çalışma zamanı
         paketinin 10.0.x'i kazanır, ama restore uyarısı yine çıkar). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
  </ItemGroup>

</Project>
