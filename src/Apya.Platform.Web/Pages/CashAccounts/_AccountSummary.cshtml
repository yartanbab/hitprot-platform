@using Apya.Platform.CashAccounts
@using Apya.Platform.Web.Pages.Shared
@model Apya.Platform.Web.Pages.CashAccounts.IndexModel
@*
    Konsolide toplam + hesap kartları. Sayfa ilk basımda bu parçayı #AccountSummary içine
    koyar; hareket ekleme/düzenleme/silme ve transferden sonra JS aynı parçayı
    ?handler=AccountSummary ile yeniden alıp yerine koyar. Bakiye, kur çevrimi ve biçim
    tek yerde kalır — JS'te elle aynalanmış bir kart kopyası yok.
*@

@functions {
    string Money(decimal v) => v.ToString("N0");
    string MoneyC(decimal v, string cur) => v.ToString("N2") + (cur == "TRY" ? " ₺" : " " + cur);

    string TypeIcon(CashAccountType t) => t switch
    {
        CashAccountType.Bank => "fa-building-columns",
        CashAccountType.CreditCard => "fa-credit-card",
        _ => "fa-wallet"
    };
}

<div class="card mb-3 text-white" style="background: linear-gradient(135deg, var(--apya-accent-500), var(--apya-accent-700));">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <div class="apya-overline text-white-50 d-flex align-items-center">
                Konsolide Bakiye (₺ karşılığı)
                <apya-hint placement="bottom" text="Her hesabın bakiyesi, o para birimi için kayıtlı EN GÜNCEL kurla ₺'ye çevrilip toplanır. Kuru hiç girilmemiş bir para birimi toplama 0 olarak katılır — eksik görünüyorsa Kurlar sayfasından kur ekleyin." />
            </div>
            <h2 class="fw-bold apya-numeric mb-0">₺@Money(Model.TotalBalanceTry)</h2>
        </div>
        <div class="small text-white-50 text-end">
            @Model.Accounts.Count hesap · @Model.DistinctCurrencyCount para birimi
        </div>
    </div>
</div>

@if (!Model.Accounts.Any())
{
    <div class="card">
        <div class="card-body">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-cash-register", Title = "Henüz kasa/banka hesabı yok.", Description = "Yukarıdan \"Yeni Kasa Ekle\" ile başlayın." }' />
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-3" id="AccountCards">
        @foreach (var a in Model.Accounts)
        {
            <div class="col-6 col-lg-3">
                <button type="button" class="card w-100 h-100 text-start border-0 apya-account-card" data-account-id="@a.Id" data-account-name="@a.Name" data-account-currency="@a.Currency">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="kpi-icon-box kpi-icon-box--accent kpi-icon-box--sm">
                                <i class="fa @TypeIcon(a.Type)" aria-hidden="true"></i>
                            </div>
                            <span class="apya-chip apya-chip-neutral">@a.Currency</span>
                        </div>
                        <div class="fw-semibold text-truncate">@(a.BankName ?? a.Name)</div>
                        <div class="small text-muted text-truncate">@(a.Iban ?? a.Branch ?? a.Name)</div>
                        <div class="apya-numeric fw-bold mt-2 text-truncate" title="@MoneyC(a.Balance, a.Currency)">@MoneyC(a.Balance, a.Currency)</div>
                    </div>
                </button>
            </div>
        }
    </div>
}
