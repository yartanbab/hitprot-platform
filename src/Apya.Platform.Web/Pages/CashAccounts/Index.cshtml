@page
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@using Apya.Platform.CashAccounts
@using Apya.Platform.Web.Pages.Shared
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.CashAccounts.IndexModel
@{
    ViewBag.PageTitle = "Kasa & Banka";
}
@section scripts {
    <abp-script src="/js/apya-transfer.js" />
    <abp-script src="/Pages/CashAccounts/Index.js" />
}

<div data-page-description="Hesaplar ve hareketler · çoklu para birimi" class="apya-page">
@* Başlık + açıklama artık app header'da (ViewBag.Title + data-page-description);
   sayfa içinde tekrarlanmıyor. Burada yalnız sayfa aksiyonları kalır. *@
<div class="apya-page-head">
    <div class="apya-page-head-actions">
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.CashAccounts.Create))
        {
            <button id="NewCashAccountButton" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-plus me-1" aria-hidden="true"></i>Yeni Kasa Ekle
            </button>
        }
        <button id="OpenTransferButton" class="btn btn-sm btn-primary">
            <i class="fa fa-right-left me-1" aria-hidden="true"></i>Transfer
        </button>
        <apya-hint placement="bottom" text="İki hesap arasında para aktarır: kaynak hesaba çıkış, hedef hesaba giriş hareketi olarak tek işlemde yazılır. Para birimleri farklıysa kayıtlı kurla çevrilir; kur bulunamazsa işlem yapılmaz." />
    </div>
</div>

<div id="AccountSummary">
    <partial name="_AccountSummary" model="Model" />
</div>

@if (Model.Accounts.Any())
{
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold" id="MovementsTitle">Hareketler</span>
                <div class="small text-muted" id="MovementsSubtitle">Bir hesap kartı seçin</div>
            </div>
            @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.CashMovements.Create))
            {
                <button id="NewCashMovementButton" class="btn btn-sm btn-primary" disabled>
                    <i class="fa fa-plus me-1" aria-hidden="true"></i>Yeni Hareket
                </button>
            }
        </div>
        <div class="card-body">
            <div id="MovementsEmpty" class="text-muted text-center py-4" style="font-size:13px">
                Hareketleri görmek için yukarıdan bir hesap seçin.
            </div>
            <div class="table-responsive d-none" id="MovementsTableWrap">
                <table class="table table-sm align-middle mb-0 apya-clean-table" id="CashMovementsTable">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Yön</th>
                            <th>Açıklama</th>
                            <th class="text-end">Tutar</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="TransferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-paper-plane me-1" aria-hidden="true"></i>Hızlı Transfer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="ApyaTransferWidget">
                <div class="text-muted text-center py-3" style="font-size:13px">Hesaplar yükleniyor...</div>
            </div>
        </div>
    </div>
</div>
</div>
