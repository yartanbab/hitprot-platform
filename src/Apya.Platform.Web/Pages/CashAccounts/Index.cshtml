@page
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@using Apya.Platform.CashAccounts
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.CashAccounts.IndexModel
@{
    ViewBag.PageTitle = "Kasa & Banka";
}
@section scripts {
    <abp-script src="/js/apya-transfer.js" />
    <abp-script src="/Pages/CashAccounts/Index.js" />
}

@functions {
    string Money(decimal v) => v.ToString("N0");
    string MoneyC(decimal v, string cur) => v.ToString("N2") + (cur == "TRY" ? " ₺" : " " + cur);

    string TypeIcon(CashAccountType t) => t switch
    {
        CashAccountType.Bank => "fa-building-columns",
        CashAccountType.CreditCard => "fa-credit-card",
        _ => "fa-wallet"
    };
}

<div class="apya-page">
<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h5 mb-1"><i class="fa fa-building-columns me-2" aria-hidden="true"></i>Kasa &amp; Banka</h1>
        <p class="text-muted mb-0" style="font-size:12px">Hesaplar ve hareketler · çoklu para birimi</p>
    </div>
    <div class="d-flex gap-2">
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.CashAccounts.Create))
        {
            <button id="NewCashAccountButton" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-plus me-1" aria-hidden="true"></i>Yeni Kasa Ekle
            </button>
        }
        <button id="OpenTransferButton" class="btn btn-sm btn-primary">
            <i class="fa fa-right-left me-1" aria-hidden="true"></i>Transfer
        </button>
    </div>
</div>

<div class="card mb-3 text-white" style="background: linear-gradient(135deg, var(--apya-accent-500), var(--apya-accent-700));">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <div class="apya-overline text-white-50">Konsolide Bakiye (₺ karşılığı)</div>
            <h2 class="fw-bold apya-numeric mb-0">₺@Money(Model.TotalBalanceTry)</h2>
        </div>
        <div class="small text-white-50 text-end">
            @Model.Accounts.Count hesap · @Model.DistinctCurrencyCount para birimi
        </div>
    </div>
</div>

@if (!Model.Accounts.Any())
{
    <div class="card">
        <div class="card-body text-muted text-center py-5">
            Henüz kasa/banka hesabı yok. Yukarıdan <strong>Yeni Kasa Ekle</strong> ile başlayın.
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-3" id="AccountCards">
        @foreach (var a in Model.Accounts)
        {
            <div class="col-6 col-lg-3">
                <button type="button" class="card w-100 h-100 text-start border-0 apya-account-card" data-account-id="@a.Id" data-account-name="@a.Name" data-account-currency="@a.Currency">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="kpi-icon-box kpi-icon-box--accent kpi-icon-box--sm">
                                <i class="fa @TypeIcon(a.Type)" aria-hidden="true"></i>
                            </div>
                            <span class="apya-chip apya-chip-neutral">@a.Currency</span>
                        </div>
                        <div class="fw-semibold text-truncate">@(a.BankName ?? a.Name)</div>
                        <div class="small text-muted text-truncate">@(a.Iban ?? a.Branch ?? a.Name)</div>
                        <div class="apya-numeric fw-bold mt-2">@MoneyC(a.Balance, a.Currency)</div>
                    </div>
                </button>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="fw-semibold" id="MovementsTitle">Hareketler</span>
                <div class="small text-muted" id="MovementsSubtitle">Bir hesap kartı seçin</div>
            </div>
            @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.CashMovements.Create))
            {
                <button id="NewCashMovementButton" class="btn btn-sm btn-primary" disabled>
                    <i class="fa fa-plus me-1" aria-hidden="true"></i>Yeni Hareket
                </button>
            }
        </div>
        <div class="card-body">
            <div id="MovementsEmpty" class="text-muted text-center py-4" style="font-size:13px">
                Hareketleri görmek için yukarıdan bir hesap seçin.
            </div>
            <div class="table-responsive d-none" id="MovementsTableWrap">
                <table class="table table-sm align-middle mb-0 apya-clean-table" id="CashMovementsTable">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Yön</th>
                            <th>Açıklama</th>
                            <th class="text-end">Tutar</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="TransferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-paper-plane me-1" aria-hidden="true"></i>Hızlı Transfer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="ApyaTransferWidget">
                <div class="text-muted text-center py-3" style="font-size:13px">Hesaplar yükleniyor...</div>
            </div>
        </div>
    </div>
</div>
</div>
