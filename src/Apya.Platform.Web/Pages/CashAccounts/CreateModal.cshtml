@page
@model Apya.Platform.Web.Pages.CashAccounts.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/CashAccounts/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Kasa Ekle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="CashAccount.Name" label="Kasa Adı (Örn: Ana Kasa, Ziraat TL)" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="CashAccount.Type" asp-items="Model.Types" label="Kasa Türü" />
                </abp-column>
                <abp-column size-md="_3">
                    @* asp-for KULLANMA: string [StringLength(3,3)] → <select>'te jQuery
                       unobtrusive 'length' kuralı "3 seçili option" sanıp sessizce bloklar
                       (APYA-148/BUG-B). Manuel name ile client-val attribute üretilmez;
                       sunucu ValidateModel() yine "TRY"yi 3 char olarak doğrular. *@
                    <div class="mb-3">
                        <label class="form-label" for="CashAccount_Currency">Para Birimi *</label>
                        <select name="CashAccount.Currency" id="CashAccount_Currency" class="form-select">
                            <option value="TRY" selected="@(Model.CashAccount.Currency == "TRY")">₺ TRY</option>
                            <option value="USD" selected="@(Model.CashAccount.Currency == "USD")">$ USD</option>
                            <option value="EUR" selected="@(Model.CashAccount.Currency == "EUR")">€ EUR</option>
                        </select>
                    </div>
                </abp-column>
                <abp-column size-md="_3">
                    <abp-input asp-for="CashAccount.OpeningBalance" label="Açılış Bakiyesi" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_5">
                    <abp-input asp-for="CashAccount.BankName" label="Banka Adı" />
                </abp-column>
                <abp-column size-md="_3">
                    <abp-input asp-for="CashAccount.Branch" label="Şube" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="CashAccount.Iban" label="IBAN" />
                </abp-column>
            </abp-row>
            <abp-input asp-for="CashAccount.Description" label="Açıklama" />
            <abp-input asp-for="CashAccount.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
