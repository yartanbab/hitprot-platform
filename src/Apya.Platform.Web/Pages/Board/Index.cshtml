@page
@using Apya.Platform.Web.Menus
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Board.IndexModel
@{
    // "Board" menüsünün aktif görünmesi için
    ViewBag.PageTitle = "Kanban Board";
}

@section styles {
    @* Merkezi kanban tasarımı (tek kaynak) *@
    <abp-style src="/css/kanban.css" />
    <link rel="stylesheet" href="~/libs/select2/css/select2.min.css" />
}

@* Kanban full-bleed çalışır (DESIGN-SYSTEM §10: board wrapper/kart kullanmaz) —
   üstte hafif araç çubuğu, altında merkezi kanban markup'ı. *@
<div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-2">
    <select id="board-project" class="form-select form-select-sm w-auto" title="Proje seçince o projenin kolonları + Kolon Ekle gelir">
        <option value="">Tüm Projeler (Genel)</option>
    </select>
    <button id="btn-refresh-board" class="btn btn-outline-secondary btn-sm"><i class="fa fa-sync"></i> Yenile</button>
    @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Create))
    {
        <button id="btn-new-task" class="btn btn-primary btn-sm"><i class="fa fa-plus me-1"></i> Yeni Görev</button>
    }
</div>

@* Merkezi kanban markup'ı (tek kaynak) *@
<partial name="_KanbanBoard" />

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="~/libs/select2/js/select2.min.js"></script>
    <abp-script src="/js/apya-task-render.js" />
    <abp-script src="/js/apya-kanban.js" />
    <abp-script src="/Pages/Board/index.js" />
}
