@page
@model Apya.Platform.Web.Pages.AiCenter.PromptCategories.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
@* Düz form (Customers deseni): abp-dynamic-form, içinde <abp-form-content/> olmadan
   modelin tüm alanlarını formun başına İKİNCİ kez basıyordu; bağlama ilk (boş/eski)
   kopyayı aldığı için girilen değerler kaydedilmiyordu. *@
<form method="post" action="@Url.Page("/AiCenter/PromptCategories/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Prompt Kategorisi"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Category.Name" label="Ad" />
            <abp-input asp-for="Category.Code" label="Kod (benzersiz)" />
            <abp-input asp-for="Category.Description" text-area rows="3" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
