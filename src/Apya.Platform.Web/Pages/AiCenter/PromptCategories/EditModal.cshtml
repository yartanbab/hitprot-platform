@page
@model Apya.Platform.Web.Pages.AiCenter.PromptCategories.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Category" asp-page="/AiCenter/PromptCategories/EditModal">
    <abp-modal>
        <abp-modal-header title="Kategori Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Category.Name" label="Ad" />
            <abp-input asp-for="Category.Code" label="Kod (benzersiz)" />
            <abp-input asp-for="Category.Description" type="textarea" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
