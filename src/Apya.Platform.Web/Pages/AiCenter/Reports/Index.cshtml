@page
@using Apya.Platform.Ai.Permissions
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Web.Pages.Shared
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.AiCenter.Reports.IndexModel
@{
    ViewBag.Title = "AI Raporları";
    var d = Model.Data;
}

<div class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title><i class="fa fa-file-lines me-2"></i> AI Değerlendirme Raporu</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(AiPermissions.Reports.Export))
                {
                    <a href="?handler=ExportExcel" class="btn btn-sm btn-success">
                        <i class="fa fa-file-excel me-1"></i> Excel
                    </a>
                    <a href="?handler=ExportPdf" class="btn btn-sm btn-danger">
                        <i class="fa fa-file-pdf me-1"></i> PDF
                    </a>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <table class="table apya-clean-table align-middle">
            <tbody>
                <tr><th style="width:40%">Toplam Değerlendirme</th><td>@d.TotalEvaluations</td></tr>
                <tr><th>Tamamlandı</th><td><span class="text-success">@d.Completed</span></td></tr>
                <tr><th>İşleniyor</th><td>@d.Processing</td></tr>
                <tr><th>Bekliyor</th><td>@d.Pending</td></tr>
                <tr><th>Başarısız</th><td><span class="text-danger">@d.Failed</span></td></tr>
                <tr>
                    <th>Ortalama Skor</th>
                    <td>
                        @(d.AverageScore.HasValue ? d.AverageScore.Value.ToString("0.0") : "—")
                        <span class="text-muted small">(@d.ScoredCount skorlu sonuç)</span>
                    </td>
                </tr>
                <tr><th>Prompt / Sağlayıcı / Aktif İş Akışı</th><td>@d.PromptCount / @d.ProviderCount / @d.ActiveWorkflowCount</td></tr>
            </tbody>
        </table>

        @if (d.RiskDistribution.Count > 0)
        {
            <h6 class="mt-3">Risk Dağılımı</h6>
            <table class="table table-sm w-auto">
                <thead><tr><th>Seviye</th><th class="text-end">Sayı</th></tr></thead>
                <tbody>
                    @foreach (var b in d.RiskDistribution)
                    {
                        <tr><td>@b.Label</td><td class="text-end">@b.Count</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-triangle-exclamation", Title = "Henüz risk verisi yok.", Description = "Değerlendirmeler tamamlandıkça risk dağılımı burada görünür." }' />
        }
    </abp-card-body>
</abp-card>
</div>
