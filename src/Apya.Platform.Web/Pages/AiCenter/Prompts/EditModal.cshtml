@page
@model Apya.Platform.Web.Pages.AiCenter.Prompts.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Prompt" asp-page="/AiCenter/Prompts/EditModal">
    <abp-modal>
        <abp-modal-header title="Prompt Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Code" label="Kod" disabled="true" />
            <abp-input asp-for="Prompt.Name" label="Ad" />
            <abp-select asp-for="Prompt.CategoryId" asp-items="Model.Categories" label="Kategori" />
            <abp-input asp-for="Prompt.Description" type="textarea" label="Açıklama" />
            <abp-input asp-for="Prompt.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
