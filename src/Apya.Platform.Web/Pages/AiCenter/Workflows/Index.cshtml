@page
@using Apya.Platform.Ai.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.AiCenter.Workflows.IndexModel
@{
    ViewBag.Title = "AI İş Akışları";
}

@section scripts {
    <abp-script src="/Pages/AiCenter/Workflows/Index.js" />
}

<div class="apya-page">
    @* Başlık satırı *@
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h5 mb-1"><i class="fa fa-diagram-project me-2"></i>AI İş Akışları</h1>
            <p class="text-muted mb-0" style="font-size:12px">Değerlendirme tamamlandığında çalışan kural setleri (koşul → aksiyon)</p>
        </div>
        @if (await AuthorizationService.IsGrantedAsync(AiPermissions.Workflows.Manage))
        {
            <abp-button id="NewWorkflowButton" text="Yeni İş Akışı" icon="plus" button-type="Primary" size="Small" />
        }
    </div>

    @* Master-detail: sol liste + sağ detay (apya-shell.css §13) *@
    <div class="apya-md" id="WorkflowsMd">
        <div class="apya-md-list">
            <div class="apya-md-toolbar">
                <input type="text" id="WorkflowFilter" class="form-control form-control-sm"
                       placeholder="Ada göre ara..." />
            </div>
            <ul class="apya-md-items" id="WorkflowsList" role="listbox" aria-label="İş akışı listesi"></ul>
            <div class="apya-md-empty" id="WorkflowsListEmpty" hidden>
                <i class="fa fa-inbox" aria-hidden="true"></i>
                <span>Eşleşen iş akışı bulunamadı</span>
            </div>
            <div class="apya-md-pager">
                <span id="WorkflowsPagerInfo">—</span>
            </div>
        </div>
        <div class="apya-md-detail" id="WorkflowDetail">
            <div class="apya-md-empty">
                <i class="fa fa-diagram-project" aria-hidden="true"></i>
                <span>Detaylarını görmek için soldaki listeden bir iş akışı seçin.</span>
            </div>
        </div>
    </div>
</div>
