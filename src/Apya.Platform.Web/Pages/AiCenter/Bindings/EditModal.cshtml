@page
@model Apya.Platform.Web.Pages.AiCenter.Bindings.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
@* Düz form (Customers deseni): abp-dynamic-form, içinde <abp-form-content/> olmadan
   modelin tüm alanlarını formun başına İKİNCİ kez basıyordu; bağlama ilk (boş/eski)
   kopyayı aldığı için girilen değerler kaydedilmiyordu. *@
<form method="post" action="@Url.Page("/AiCenter/Bindings/EditModal")">
    <abp-modal>
        <abp-modal-header title="Form Bağlama Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <input type="hidden" asp-for="Binding.DocumentId" />
            <input type="hidden" asp-for="Binding.PromptId" />
            <div class="mb-3">
                <label class="form-label">Form</label>
                <input class="form-control" value="@Model.FormTitle" disabled />
            </div>
            <div class="mb-3">
                <label class="form-label">Prompt</label>
                <input class="form-control" value="@Model.PromptName" disabled />
            </div>
            <label class="form-label" for="Binding_TriggerMode">
                Tetikleme Modu
                <apya-hint text="OnSubmit: form her doldurulduğunda değerlendirme kendiliğinden çalışır — her gönderim sağlayıcıya istek gider ve maliyet doğurur. Manual: yalnız arayüzden elle başlattığınızda çalışır." />
            </label>
            <abp-select asp-for="Binding.TriggerMode" asp-items="Model.TriggerModes" suppress-label="true" />
            <label class="form-label" for="Binding_Order">
                Sıra
                <apya-hint text="Aynı forma birden çok prompt bağlıysa çalıştırma sırasını belirler; küçük sayı önce çalışır. Tek bağlama varsa etkisi yoktur." />
            </label>
            <abp-input asp-for="Binding.Order" suppress-label="true" />
            <abp-input asp-for="Binding.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
