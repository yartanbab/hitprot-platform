@page
@model Apya.Platform.Web.Pages.FxRevaluations.DetailModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-modal>
    <abp-modal-header title="Değerleme Detayı"></abp-modal-header>
    <abp-modal-body>
        <p>
            <strong>Tarih:</strong> @Model.Snapshot.AsOfDate.ToString("dd.MM.yyyy")
            &nbsp;|&nbsp; <strong>Toplam TL:</strong>
            <span class="apya-numeric">@Model.Snapshot.TotalTryValue.ToString("N2") ₺</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Snapshot.Notes))
        {
            <p class="text-muted">@Model.Snapshot.Notes</p>
        }
        <div class="table-responsive">
        <table class="table table-sm apya-clean-table">
            <thead>
                <tr>
                    <th>Kasa</th><th>Birim</th>
                    <th class="text-end apya-numeric">Bakiye</th>
                    <th class="text-end apya-numeric">Kur</th>
                    <th class="text-end apya-numeric">TL Karşılığı</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Snapshot.Lines)
            {
                <tr>
                    <td>@l.CashAccountName</td>
                    <td>@l.Currency</td>
                    <td class="text-end apya-numeric">@l.Balance.ToString("N2")</td>
                    <td class="text-end apya-numeric">@(l.Rate.HasValue ? l.Rate.Value.ToString("N4") : "-")</td>
                    <td class="text-end apya-numeric">@l.TryValue.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4" class="text-end">TOPLAM</td>
                    <td class="text-end apya-numeric">@Model.Snapshot.TotalTryValue.ToString("N2") ₺</td>
                </tr>
            </tfoot>
        </table>
        </div>
    </abp-modal-body>
    <abp-modal-footer buttons="@(AbpModalButtons.Close)"></abp-modal-footer>
</abp-modal>
