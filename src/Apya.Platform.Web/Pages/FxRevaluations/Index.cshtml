@page
@model Apya.Platform.Web.Pages.FxRevaluations.IndexModel
@{
    ViewBag.PageTitle = "Yıl Sonu Kur Değerleme";
}
@section scripts {
    <abp-script src="/Pages/FxRevaluations/Index.js" />
}

<div data-page-description="Dönem sonu kur farkı hesaplaması" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_7">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
                <small class="text-muted">Yabancı para kasalarının seçilen tarihteki TL karşılığı. Ardışık değerlemeler arası fark = kur farkı.</small>
            </abp-column>
            <abp-column size-md="_5" class="text-end">
                <button id="NewRevaluationButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-calculator"></i> Yeni Değerleme
                </button>
                <apya-hint placement="bottom" text="Seçtiğiniz tarihe kadarki hareketlerden her aktif kasanın bakiyesini hesaplar ve o tarihe ait en güncel kurla ₺'ye çevirerek donmuş bir kayıt oluşturur. Yabancı para kasalarından birinin o tarihe kadar hiç kuru yoksa işlem tamamen başarısız olur — önce Kurlar sayfasından eksik kuru girin." />
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="FxRevaluationsTable" class="nowrap apya-clean-table"></abp-table>
    </abp-card-body>
</abp-card>
</div>
