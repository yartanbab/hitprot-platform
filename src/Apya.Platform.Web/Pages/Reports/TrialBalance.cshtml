@page
@model Apya.Platform.Web.Pages.Reports.TrialBalanceModel
@{
    ViewBag.PageTitle = "Mizan (Yönetim Özeti)";
    var r = Model.Report;
}

@{
    var excelUrl = $"?handler=Excel&FromDate={Model.FromDate?.ToString("yyyy-MM-dd")}&ToDate={Model.ToDate?.ToString("yyyy-MM-dd")}";
    var pdfUrl   = $"?handler=Pdf&FromDate={Model.FromDate?.ToString("yyyy-MM-dd")}&ToDate={Model.ToDate?.ToString("yyyy-MM-dd")}";
}

<abp-card>
    <abp-card-header>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
                <small class="text-muted">@r.Disclaimer</small>
            </div>
            <div class="btn-group">
                <a href="@excelUrl" class="btn btn-outline-success btn-sm">
                    <i class="fa fa-file-excel"></i> Excel
                </a>
                <a href="@pdfUrl" class="btn btn-outline-danger btn-sm">
                    <i class="fa fa-file-pdf"></i> PDF
                </a>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                    <i class="fa fa-print"></i> Yazdır
                </button>
            </div>
        </div>
    </abp-card-header>
    <abp-card-body>
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label small">Başlangıç</label>
                <input type="date" name="FromDate" class="form-control form-control-sm"
                       value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label class="form-label small">Bitiş</label>
                <input type="date" name="ToDate" class="form-control form-control-sm"
                       value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-filter"></i> Hesapla
                </button>
            </div>
            <div class="col-auto">
                <a href="/Reports/TrialBalance" class="btn btn-outline-secondary btn-sm">Tümü</a>
            </div>
        </form>

        <table class="table apya-clean-table">
            <thead class="table-light">
                <tr>
                    <th style="width:80px;">Kod</th>
                    <th>Hesap Grubu</th>
                    <th class="text-end">Borç</th>
                    <th class="text-end">Alacak</th>
                    <th class="text-end">Bakiye</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var l in r.Lines)
            {
                <tr>
                    <td><code>@l.GroupCode</code></td>
                    <td>@l.GroupName</td>
                    <td class="text-end">@l.Debit.ToString("N2")</td>
                    <td class="text-end">@l.Credit.ToString("N2")</td>
                    <td class="text-end fw-bold @(l.Balance >= 0 ? "text-dark" : "text-danger")">
                        @l.Balance.ToString("N2")
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-bold table-secondary">
                    <td colspan="2" class="text-end">TOPLAM</td>
                    <td class="text-end">@r.TotalDebit.ToString("N2")</td>
                    <td class="text-end">@r.TotalCredit.ToString("N2")</td>
                    <td class="text-end">@((r.TotalDebit - r.TotalCredit).ToString("N2"))</td>
                </tr>
            </tfoot>
        </table>

        <div class="alert alert-info py-2 mb-0">
            <i class="fa fa-info-circle me-1"></i>
            Faturalı işlemler <strong>Cari (120/320)</strong> gruplarına yansır; faturasız gelir/gider
            <strong>600/770</strong>'te. Bu özet yönetseldir — resmi Tek Düzen Hesap Planı mizanı
            ayrı bir faz olarak (mali müşavir girdisiyle) ele alınacaktır.
        </div>
    </abp-card-body>
</abp-card>
