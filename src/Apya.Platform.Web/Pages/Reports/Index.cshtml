@page
@model Apya.Platform.Web.Pages.Reports.IndexModel
@using Apya.Platform.Reports
@using Apya.Platform.Web.Pages.Shared
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    ViewBag.Title = "Yönetim & Raporlama";
}

<div id="ReportsContainer" data-page-description="Efor, maliyet ve Ar-Ge metrikleri" class="apya-page pb-5">

    @* Başlık + açıklama app header'da; sayfa içinde tekrarlanmıyor. *@
    <div class="apya-page-head">
        <div class="apya-page-head-actions">
            <button class="btn btn-outline-primary btn-sm" disabled title="Çok yakında">
                <i class="fa fa-download me-2"></i> Excel Olarak İndir (Çok Yakında)
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <abp-row class="g-3 mb-4">
        <abp-column size-md="_3">
            <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-project-diagram", Accent = "accent", Label = "Aktif Projeler", ValueId = "KpiTotalProjects", Value = "0" }' />
        </abp-column>
        <abp-column size-md="_3">
            <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-clock", Accent = "positive", Label = "Toplam Harcanan Efor", ValueId = "KpiTotalHours", Value = "0s", Hint = "Listelenen projelerin görevlerine kaydedilen sürelerin toplamı, saat cinsinden. Zaman kaydı girilmemiş görevler bu toplama katkı vermez." }' />
        </abp-column>
        <abp-column size-md="_3">
            <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-wallet", Accent = "negative", Label = "Toplam Bütçe Kullanımı", ValueId = "KpiTotalBudget", Value = "0 ₺", Hint = "Harcanan tutar / ayrılan bütçe. Her iki değer de listelenen projelerin toplamıdır ve para birimi ayrımı yapılmadan toplanır." }' />
        </abp-column>
        <abp-column size-md="_3">
            <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-robot", Accent = "warning", Label = "Ar-Ge Uyum Puanı (AI)", Value = "%84", SubText = "(Hibe projelerindeki sapma)" }' />
        </abp-column>
    </abp-row>

    <!-- CHARTS -->
    <abp-row class="mb-4">
        <abp-column size-md="_6">
            <div class="card h-100">
                <div class="card-header border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Bütçe ve Finansal Sapma</h5>
                </div>
                <div class="card-body" style="position: relative; height: 300px; width: 100%;">
                    <canvas id="budgetChart"></canvas>
                </div>
            </div>
        </abp-column>
        <abp-column size-md="_6">
            <div class="card h-100">
                <div class="card-header border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0">Personel Bazlı Efor Yükü</h5>
                </div>
                <div class="card-body" style="position: relative; height: 300px; width: 100%;">
                    <canvas id="efficiencyChart"></canvas>
                </div>
            </div>
        </abp-column>
    </abp-row>

    <!-- TABLES -->
    <abp-row>
        <abp-column size-md="_8">
            <div class="card">
                <div class="card-header border-bottom-0 pb-0">
                    <h5 class="fw-bold mb-0">Proje Bazlı Kapsamlı Analiz</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                    <abp-table class="mb-0 apya-clean-table" id="DetailedReportTable">
                        <thead>
                            <tr>
                                <th class="border-0">Proje Adı</th>
                                <th class="border-0 apya-numeric">Toplam Bütçe</th>
                                <th class="border-0 apya-numeric">Harcanan</th>
                                <th class="border-0 text-center">Bütçe Doluluğu</th>
                                <th class="border-0">Efor &amp; Durum</th>
                            </tr>
                        </thead>
                        <tbody id="projectReportTableBody">
                        </tbody>
                    </abp-table>
                    </div>
                </div>
            </div>
        </abp-column>
        <abp-column size-md="_4">
            <div class="card h-100">
                <div class="card-header border-bottom-0 pb-0">
                    <h5 class="fw-bold mb-0">PDKS / Personel Özeti</h5>
                </div>
                <div class="card-body">
                    <div id="personnelSummaryList" class="list-group list-group-flush mt-2"></div>
                </div>
            </div>
        </abp-column>
    </abp-row>

    <!-- TENANT ROI ANALiZi -->
    <abp-row class="mt-4">
        <abp-column size-md="_12">
            <div class="card">
                <div class="card-header border-bottom-0 pb-0 d-flex align-items-center">
                    <div class="kpi-icon-box kpi-icon-box--brand kpi-icon-box--sm me-3">
                        <i class="fa fa-building"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Müşteri ROI Analizi</h5>
                        <small class="text-muted">Tenant bazında kârlılık ve efor karşılaştırması</small>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                    <abp-table class="mb-0 apya-clean-table" id="TenantRoiTable">
                        <thead>
                            <tr>
                                <th class="border-0">Müşteri</th>
                                <th class="border-0 text-center">Proje Sayısı</th>
                                <th class="border-0 apya-numeric">Toplam Bütçe</th>
                                <th class="border-0 apya-numeric">Harcanan</th>
                                <th class="border-0 apya-numeric">Kâr</th>
                                <th class="border-0 text-center">ROI %</th>
                                <th class="border-0">Toplam Efor</th>
                            </tr>
                        </thead>
                        <tbody id="tenantRoiTableBody">
                        </tbody>
                    </abp-table>
                    </div>
                    <div id="noTenantRoiMessage" class="text-center text-muted py-3 d-none">
                        <i class="fa fa-info-circle me-1"></i>Henüz müşteriye atanmış proje bulunmuyor.
                    </div>
                </div>
            </div>
        </abp-column>
    </abp-row>
</div>

@section scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <abp-script src="/js/apya-chart-theme.js" />
    <abp-script src="/Pages/Reports/index.js" />
}
