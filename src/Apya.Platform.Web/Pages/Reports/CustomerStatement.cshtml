@page
@model Apya.Platform.Web.Pages.Reports.CustomerStatementModel
@using Apya.Platform.CustomerLedger
@using Apya.Platform.Web.Pages.Shared
@{
    ViewBag.PageTitle = "Cari Ekstre Raporu";

    string ChipTone(CustomerLedgerSource s) => s switch
    {
        CustomerLedgerSource.Invoice => "brand",
        CustomerLedgerSource.Payment => "positive",
        _ => "neutral"
    };
    string ChipLabel(CustomerLedgerSource s) => s switch
    {
        CustomerLedgerSource.Invoice => "Fatura",
        CustomerLedgerSource.Payment => "Tahsilat",
        CustomerLedgerSource.Opening => "Açılış",
        _ => "Manuel"
    };
    string FormatAmount(decimal amount, string currency)
    {
        if (amount <= 0) return "—";
        var suffix = Model.Currency == "ALL" && currency != "TRY" ? $" {currency}" : "";
        return $"{amount:N2}{suffix}";
    }
    string Qs(string currency) =>
        $"CustomerId={Model.CustomerId}&FromDate={Model.FromDate?.ToString("yyyy-MM-dd")}&ToDate={Model.ToDate?.ToString("yyyy-MM-dd")}&Currency={currency}";

    var pdfUrl = $"?handler=Pdf&{Qs(Model.Currency)}";
    var excelUrl = $"?handler=Excel&{Qs(Model.Currency)}";
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        body { font-size: 12px; }
    }
</style>

<div data-page-description="Cari bazlı borç/alacak hareketleri" class="apya-page">

    <form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-4 no-print">
        <input type="hidden" name="Currency" value="@Model.Currency" />

        <div class="input-group input-group-sm" style="width:auto; min-width:230px;">
            <span class="input-group-text bg-transparent"><i class="fa fa-building text-muted"></i></span>
            <select name="CustomerId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Seçiniz --</option>
                @foreach (var c in Model.Customers)
                {
                    if (c.Id == Model.CustomerId)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>

        <div class="apya-date-range">
            <i class="fa fa-calendar-days"></i>
            <input type="date" name="FromDate" class="apya-date-range-input"
                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
            <span class="apya-date-range-sep">–</span>
            <input type="date" name="ToDate" class="apya-date-range-input"
                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
        </div>

        <div class="btn-group btn-group-sm" role="group">
            <a href="?@Qs("TRY")" class="btn @(Model.Currency != "ALL" ? "btn-primary" : "btn-outline-primary")">TRY</a>
            <a href="?@Qs("ALL")" class="btn @(Model.Currency == "ALL" ? "btn-primary" : "btn-outline-primary")">Tümü</a>
        </div>
        <apya-hint placement="bottom" text="TRY yalnız ₺ hareketlerini gösterir. Tümü seçildiğinde bütün para birimleri aynı listede toplanır — tutarlar kur çevrimi YAPILMADAN toplandığı için karışık para birimli carilerde toplamlar anlamlı olmaz." />

        <div class="flex-grow-1"></div>

        @if (Model.Statement != null)
        {
            <a href="@pdfUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-file-pdf text-danger me-1"></i>PDF
            </a>
            <a href="@excelUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-file-excel text-success me-1"></i>Excel
            </a>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()" title="Yazdır">
                <i class="fa fa-print"></i>
            </button>
        }
    </form>

    @if (Model.Statement == null)
    {
        <div class="card">
            <partial name="_EmptyState" model='new EmptyStateModel {
                Icon = "fa-building",
                Title = "Lütfen bir cari seçin.",
                Description = "Ekstresini görüntülemek istediğiniz cariyi yukarıdan seçin."
            }' />
        </div>
    }
    else
    {
        var s = Model.Statement;

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <partial name="_KpiCard" model='new KpiCardModel {
                    Icon = "fa-arrow-up", Accent = "accent",
                    Label = "Toplam Borç", Value = $"{s.TotalDebit:N2}",
                    Hint = "Cariye tahakkuk eden tutarların toplamı — kestiğiniz satış faturaları ve açılış kayıtları. Artması carinin size olan borcunu artırır."
                }' />
            </div>
            <div class="col-6 col-lg-3">
                <partial name="_KpiCard" model='new KpiCardModel {
                    Icon = "fa-arrow-down", Accent = "accent",
                    Label = "Toplam Alacak", Value = $"{s.TotalCredit:N2}",
                    Hint = "Cariden yaptığınız tahsilatların toplamı. Borcu kapatan tarafı temsil eder."
                }' />
            </div>
            <div class="col-6 col-lg-3">
                <partial name="_KpiCard" model='new KpiCardModel {
                    Icon = "fa-arrow-trend-up", Accent = s.Balance >= 0 ? "success" : "danger",
                    Label = "Bakiye", Value = $"{s.Balance:N2}",
                    Hint = "Toplam borç eksi toplam alacak. Artı değer carinin size borçlu olduğunu, eksi değer fazla tahsilat yapıldığını gösterir."
                }' />
            </div>
            <div class="col-6 col-lg-3">
                <partial name="_KpiCard" model='new KpiCardModel {
                    Icon = "fa-circle-info", Accent = s.OverdueAmount > 0 ? "danger" : "secondary",
                    Label = "Vadesi Geçen", Value = $"{s.OverdueAmount:N2}",
                    Hint = "Vade tarihi geçmiş satış faturalarının henüz ödenmemiş kısmı. İptal edilmiş faturalar ve alış faturaları sayılmaz; tarih aralığı filtresinden bağımsız olarak hesaplanır."
                }' />
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                @if (!s.Lines.Any())
                {
                    <partial name="_EmptyState" model='new EmptyStateModel {
                        Icon = "fa-receipt",
                        Title = "Bu cari için hareket yok.",
                        Description = "Seçtiğiniz tarih aralığında fatura veya tahsilat bulunmuyor."
                    }' />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Belge No</th>
                                    <th>Tür</th>
                                    <th>Açıklama</th>
                                    <th class="text-end">Borç</th>
                                    <th class="text-end">Alacak</th>
                                    <th class="text-end">Yürüyen Bakiye</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var l in s.Lines)
                            {
                                <tr>
                                    <td class="text-nowrap">@l.EntryDate.ToString("dd.MM.yyyy")</td>
                                    <td class="apya-numeric">@(l.DocumentNumber ?? "—")</td>
                                    <td><span class="apya-chip apya-chip-@ChipTone(l.Source)">@ChipLabel(l.Source)</span></td>
                                    <td>@(l.Description ?? "-")</td>
                                    <td class="text-end apya-numeric">@FormatAmount(l.Debit, l.Currency)</td>
                                    <td class="text-end apya-numeric">@FormatAmount(l.Credit, l.Currency)</td>
                                    <td class="text-end apya-numeric fw-bold">@l.RunningBalance.ToString("N2")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="px-3 py-3 text-muted small border-top">
                        @s.Lines.Count hareket · @s.CustomerName
                    </div>
                }
            </div>
        </div>
    }
</div>
