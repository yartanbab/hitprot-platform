@page
@model Apya.Platform.Web.Pages.Reports.ProjectBudgetModel
@{
    ViewBag.PageTitle = "Proje Bütçe / K/Z Raporu";
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .abp-card { border: none !important; box-shadow: none !important; }
        body { font-size: 12px; }
    }
</style>

<div data-page-description="Proje bazlı bütçe ve kâr/zarar" class="apya-page">
<abp-card>
    <abp-card-header>
        <div class="d-flex justify-content-between align-items-center">
            <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            @if (Model.Summary != null)
            {
                var excelUrl = $"?handler=Excel&ProjectId={Model.ProjectId}";
                var pdfUrl   = $"?handler=Pdf&ProjectId={Model.ProjectId}";
                <div class="btn-group no-print">
                    <a href="@excelUrl" class="btn btn-outline-success btn-sm">
                        <i class="fa fa-file-excel"></i> Excel
                    </a>
                    <a href="@pdfUrl" class="btn btn-outline-danger btn-sm">
                        <i class="fa fa-file-pdf"></i> PDF
                    </a>
                    <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                        <i class="fa fa-print"></i> Yazdır
                    </button>
                </div>
            }
        </div>
    </abp-card-header>
    <abp-card-body>
        <form method="get" class="row g-2 align-items-end mb-3 no-print">
            <div class="col-auto">
                <label class="form-label small">Proje</label>
                <select name="ProjectId" class="form-select form-select-sm" style="min-width:260px;">
                    <option value="">-- Seçiniz --</option>
                    @foreach (var p in Model.Projects)
                    {
                        if (p.Id == Model.ProjectId)
                        {
                            <option value="@p.Id" selected>@p.Name</option>
                        }
                        else
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-filter"></i> Getir
                </button>
            </div>
        </form>

        @if (Model.Summary == null)
        {
            <p class="text-muted">Lütfen bir proje seçin.</p>
        }
        else
        {
            var s = Model.Summary;
            var barColor = s.IsOverBudget ? "danger" : (s.BudgetUsagePercent >= 80 ? "warning" : "success");

            <h5 class="mb-3">@s.ProjectName</h5>

            @* Finans → Genel ve Bütçe Durumu modalıyla AYNI şerit, aynı hesap. *@
            <partial name="_ProjectBudgetKpis" model="s" />

            <label class="small text-muted">
                Bütçe Kullanımı: %@s.BudgetUsagePercent
                <apya-hint text="Harcanan / onaylanan bütçe oranı. Gelir bu orana girmez — bütçenin ne kadarının harcandığını gösterir, kâr/zarar durumunu değil." />
            </label>
            <div class="progress mb-2" style="height:22px;">
                <div class="progress-bar bg-@barColor" role="progressbar"
                     style="width:@(Math.Min(s.BudgetUsagePercent, 100))%;">
                    @s.BudgetUsagePercent%
                </div>
            </div>

            @if (s.IsOverBudget)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <strong>⚠ Bütçe aşıldı!</strong>
                    <span> Aşım: @((s.SpentAmount - s.ApprovedBudget).ToString("N2"))</span>
                </div>
            }

            @if (s.TaskBreakdown.Any(t => t.TaskId.HasValue))
            {
                <h6>Görev Bazlı Kırılım</h6>
                <div class="table-responsive">
                <table class="table table-sm apya-clean-table">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th class="text-end apya-numeric">Gider</th>
                            <th class="text-end apya-numeric">Gelir</th>
                            <th class="text-end apya-numeric">Net</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in s.TaskBreakdown.OrderByDescending(x => x.Expense))
                    {
                        var net = t.Income - t.Expense;
                        <tr>
                            <td>@(t.TaskId.HasValue ? (t.TaskName ?? t.TaskId.ToString()![..8] + "…") : "(Proje geneli)")</td>
                            <td class="text-end apya-numeric text-danger">@t.Expense.ToString("N2")</td>
                            <td class="text-end apya-numeric text-success">@t.Income.ToString("N2")</td>
                            <td class="text-end apya-numeric fw-bold @(net >= 0 ? "text-success" : "text-danger")">@net.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold table-secondary">
                            <td>TOPLAM</td>
                            <td class="text-end apya-numeric text-danger">@s.SpentAmount.ToString("N2")</td>
                            <td class="text-end apya-numeric text-success">@s.IncomeRecordTotal.ToString("N2")</td>
                            <td class="text-end apya-numeric @(s.IncomeRecordTotal - s.SpentAmount >= 0 ? "text-success" : "text-danger")">@((s.IncomeRecordTotal - s.SpentAmount).ToString("N2"))</td>
                        </tr>
                    </tfoot>
                </table>
                </div>
            }
        }
    </abp-card-body>
</abp-card>
</div> @* /.apya-page *@
