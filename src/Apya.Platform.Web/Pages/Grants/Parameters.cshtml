@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.ParametersModel
@{
    ViewBag.Title = L["Grants:Parameters:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Parameters.css" />
}

@section scripts {
    <abp-script src="/Pages/Grants/Poster.js" />
    <abp-script src="/Pages/Grants/Parameters.js" />
}

@* 10b · Hibe Parametre Formu, okunabilir hâli. Başlık + açıklama app header'da.
   Düzen: başlık ve canlı eşleşme kartı → sekme grubu → sekme panelleri → alt sabit çubuk.
   🔴 Alan kimlikleri (Param*) 1b'dekiyle AYNI: collect()/fill() ve kaydetme mantığı değişmedi,
   yalnız alanlar şart kartlarının içine taşındı. *@
<div data-page-description="@L["Grants:Parameters:Description"]" class="apya-page apya-grant-scope" data-grant-id="@Model.Id">
    <div class="apya-page-head">
        <div class="apya-page-head-actions d-flex align-items-center gap-2">
            <a href="/Grants" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>@L["Grants:Parameters:BackToPrograms"]
            </a>
        </div>
    </div>

    @* ---------- Başlık + şu an kaç firma uygun ---------- *@
    <div class="apya-param-hero">
        <div class="apya-param-hero-main">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="apya-param-title" id="ParamTitle"></h2>
                <span id="ParamDraftInfo" class="apya-chip apya-chip-warning d-none"></span>
            </div>
            <div class="apya-param-issuer" id="ParamIssuerText"></div>
            <p class="apya-param-lead" id="ParamLead"></p>
        </div>
        <div class="card mb-0 apya-param-match">
            <div class="card-body">
                <span class="apya-overline">@L["Grants:Parameters:MatchNow"]</span>
                <div class="apya-param-match-count">
                    <span class="apya-param-metric" id="MatchCount">—</span>
                    <span class="apya-param-match-total" id="MatchTotal"></span>
                </div>
                <div class="apya-mini-bar"><span id="MatchBar" style="width:0"></span></div>
                <div class="apya-param-match-hint">@L["Grants:Parameters:MatchHint"]</div>
            </div>
        </div>
    </div>

    @* ---------- Sekme grubu ---------- *@
    <div class="apya-grant-tabs apya-param-tabs" role="tablist" aria-label="@L["Grants:Parameters:Sections"]">
        <button type="button" class="apya-grant-tab" role="tab" data-tab="identity" aria-controls="SectionIdentity">
            @L["Grants:Parameters:Tab:Identity"]
        </button>
        <button type="button" class="apya-grant-tab is-active" role="tab" data-tab="eligibility" aria-controls="SectionEligibility">
            @L["Grants:Parameters:Tab:Eligibility"]
            <span class="apya-chip apya-chip-accent apya-numeric" id="NavEligibilityBadge">0</span>
        </button>
        <button type="button" class="apya-grant-tab" role="tab" data-tab="financial" aria-controls="SectionFinancial">
            @L["Grants:Parameters:Tab:Financial"]
            <span class="apya-chip apya-chip-neutral apya-numeric" id="NavFinancialBadge">0</span>
        </button>
        <button type="button" class="apya-grant-tab" role="tab" data-tab="documents" aria-controls="SectionDocuments">
            @L["Grants:Parameters:Tab:Documents"]
            <span class="apya-chip apya-chip-neutral apya-numeric" id="NavDocumentsBadge">0</span>
        </button>
        <button type="button" class="apya-grant-tab" role="tab" data-tab="process" aria-controls="SectionProcess">
            @L["Grants:Parameters:Tab:Process"]
            <span class="apya-chip apya-chip-neutral" id="NavProcessBadge"></span>
        </button>
        <button type="button" class="apya-grant-tab" role="tab" data-tab="weights" aria-controls="SectionWeights">
            @L["Grants:Parameters:Tab:Weights"]
            <span class="apya-chip apya-chip-neutral" id="NavWeightsBadge"></span>
        </button>
    </div>

    <div class="apya-param-panels">

        @* ---------- Kimlik ---------- *@
        <section class="card mb-0 apya-param-panel" id="SectionIdentity" data-panel="identity" role="tabpanel" hidden>
            <div class="card-body d-flex flex-column gap-3">
                <div class="apya-param-section-head">
                    <span class="apya-param-section-icon"><i class="fa fa-id-card-clip"></i></span>
                    <div>
                        <div class="fw-bold">@L["Grants:Parameters:Section:Identity"]</div>
                        <div class="small text-muted" id="ParamSourceUrlText"></div>
                    </div>
                </div>

                <div class="apya-param-grid apya-param-grid--2">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamName"><span>@L["Grants:Parameters:Name"]</span></label>
                        <input type="text" id="ParamName" class="form-control form-control-sm" maxlength="128" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamIssuer"><span>@L["Grants:Parameters:Issuer"]</span></label>
                        <input type="text" id="ParamIssuer" class="form-control form-control-sm" maxlength="64" />
                    </div>
                </div>

                @* 12b · Program afişi. Önizleme kiracı kartındaki afişin aynısı: aynı sınıflar
                   (Shared.css), aynı zemin (Poster.js). Dosya proje kapağı gibi App_Data/uploads'a yazılır. *@
                <div class="apya-field">
                    <span class="apya-field-label"><span>@L["Grants:Parameters:Poster"]</span></span>
                    <div class="apya-param-poster">
                        <div class="apya-feed-poster apya-param-poster-preview" id="PosterPreview" aria-hidden="true">
                            <span class="apya-feed-poster-top"></span>
                            <span class="apya-feed-poster-bottom">
                                <span class="apya-feed-poster-issuer" id="PosterPreviewIssuer"></span>
                                <span class="apya-feed-poster-name" id="PosterPreviewName"></span>
                            </span>
                        </div>
                        <div class="apya-param-poster-side">
                            <div class="apya-param-poster-rule">@L["Grants:Parameters:Poster:Rule"]</div>
                            <div class="apya-param-poster-status" id="PosterStatus"></div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="PosterUploadBtn">
                                    <i class="fa fa-upload me-1"></i>@L["Grants:Parameters:Poster:Upload"]
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger d-none" id="PosterRemoveBtn">
                                    <i class="fa fa-trash me-1"></i>@L["Grants:Parameters:Poster:Remove"]
                                </button>
                            </div>
                            <input type="file" id="PosterFile" accept="image/png,image/jpeg" hidden />
                        </div>
                    </div>
                </div>

                <div class="apya-field">
                    <label class="apya-field-label" for="ParamSourceUrl"><span>@L["Grants:Parameters:SourceUrl"]</span></label>
                    <input type="url" id="ParamSourceUrl" class="form-control form-control-sm apya-numeric" maxlength="512" />
                </div>

                <div class="apya-field">
                    <label class="apya-field-label" for="ParamSummary"><span>@L["Grants:Parameters:Summary"]</span></label>
                    <textarea id="ParamSummary" class="form-control form-control-sm" rows="2"></textarea>
                </div>
            </div>
        </section>

        @* ---------- Kimler başvurabilir: şart kartları ----------
           Kart = şartın tek satır özeti (şart · değer · nereden geldi · kaç firmayı eliyor).
           Karta tıklayınca altında alanın kendisi açılır (11c). Konmamış şart kart olarak
           görünmez; "Şart ekle" menüsünden açılır. Kartları JS boyar. *@
        <section class="apya-param-panel apya-rule-panel" id="SectionEligibility" data-panel="eligibility" role="tabpanel">
            <p class="apya-rule-intro">@L["Grants:Parameters:Section:EligibilityHint"]</p>

            <div class="apya-rule-head" aria-hidden="true">
                <span>@L["Grants:Parameters:Col:Rule"]</span>
                <span>@L["Grants:Parameters:Col:Value"]</span>
                <span>@L["Grants:Parameters:Col:Source"]</span>
                <span>@L["Grants:Parameters:Col:Impact"]</span>
            </div>

            <div class="apya-rule-list" id="RuleList">

                <div class="apya-rule" data-rule-key="size" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-size">
                        <span class="apya-rule-label">@L["Grants:Parameters:CompanySizes"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-size" hidden>
                        <div class="apya-choice-row" id="ParamSizes">
                            <button type="button" class="apya-choice" data-size="1">@L["Grants:Size:Mikro"]</button>
                            <button type="button" class="apya-choice" data-size="2">@L["Grants:Size:Kucuk"]</button>
                            <button type="button" class="apya-choice" data-size="4">@L["Grants:Size:Orta"]</button>
                            <button type="button" class="apya-choice" data-size="8">@L["Grants:Size:Buyuk"]</button>
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="age" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-age">
                        <span class="apya-rule-label">@L["Grants:Parameters:CompanyAge"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-age" hidden>
                        <div class="apya-field-range">
                            <input type="number" min="0" max="200" id="ParamMinAge" class="form-control form-control-sm apya-numeric"
                                   aria-label="@L["Grants:Parameters:CompanyAge"]" />
                            <span class="apya-field-range-sep">—</span>
                            <input type="number" min="0" max="200" id="ParamMaxAge" class="form-control form-control-sm apya-numeric"
                                   placeholder="@L["Grants:Parameters:Unlimited"]" aria-label="@L["Grants:Parameters:CompanyAge"]" />
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="trl" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-trl">
                        <span class="apya-rule-label">@L["Grants:Parameters:Trl"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-trl" hidden>
                        <div class="apya-trl-bar" id="ParamTrl">
                            @for (var i = 1; i <= 9; i++)
                            {
                                <button type="button" class="apya-trl-seg" data-trl="@i">@i</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="staff" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-staff">
                        <span class="apya-rule-label">@L["Grants:Parameters:StaffCount"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-staff" hidden>
                        <input type="number" min="0" id="ParamMinStaff" class="form-control form-control-sm apya-numeric apya-rule-input"
                               aria-label="@L["Grants:Parameters:StaffCount"]" />
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="rdstaff" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-rdstaff">
                        <span class="apya-rule-label">@L["Grants:Parameters:RdStaffCount"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-rdstaff" hidden>
                        <input type="number" min="0" id="ParamMinRdStaff" class="form-control form-control-sm apya-numeric apya-rule-input"
                               aria-label="@L["Grants:Parameters:RdStaffCount"]" />
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="revenue" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-revenue">
                        <span class="apya-rule-label">@L["Grants:Parameters:Revenue"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-revenue" hidden>
                        <div class="apya-field-range">
                            <input type="number" min="0" step="0.01" id="ParamMinRevenue" data-money-input="true" class="form-control form-control-sm apya-numeric"
                                   aria-label="@L["Grants:Parameters:Revenue"]" />
                            <span class="apya-field-range-sep">—</span>
                            <input type="number" min="0" step="0.01" id="ParamMaxRevenue" data-money-input="true" class="form-control form-control-sm apya-numeric"
                                   placeholder="@L["Grants:Parameters:Unlimited"]" aria-label="@L["Grants:Parameters:Revenue"]" />
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="consortium" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-consortium">
                        <span class="apya-rule-label">@L["Grants:Rule:Consortium"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-consortium" hidden>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="ParamConsortium" />
                                <label class="form-check-label" for="ParamConsortium">@L["Grants:Parameters:Consortium"]</label>
                            </div>
                            <input type="number" min="2" max="99" id="ParamMinPartners"
                                   class="form-control form-control-sm apya-numeric apya-rule-input" disabled
                                   placeholder="@L["Grants:Parameters:MinPartners"]" aria-label="@L["Grants:Parameters:MinPartners"]" />
                        </div>
                    </div>
                </div>

                @* --- Uyum puanını etkileyen hedefleme (eleme DEĞİL) --- *@
                <div class="apya-rule" data-rule-key="nace" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-nace">
                        <span class="apya-rule-label">@L["Grants:Parameters:Nace"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-nace" hidden>
                        <div class="apya-tag-input" data-kind="3">
                            <span class="apya-tag-chips"></span>
                            <input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]"
                                   aria-label="@L["Grants:Parameters:Nace"]" />
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="sector" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-sector">
                        <span class="apya-rule-label">@L["Grants:Parameters:Sector"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-sector" hidden>
                        <div class="apya-tag-input" data-kind="0">
                            <span class="apya-tag-chips"></span>
                            <input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]"
                                   aria-label="@L["Grants:Parameters:Sector"]" />
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="region" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-region">
                        <span class="apya-rule-label">@L["Grants:Parameters:Region"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-region" hidden>
                        <div class="apya-tag-input" data-kind="1">
                            <span class="apya-tag-chips"></span>
                            <input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]"
                                   aria-label="@L["Grants:Parameters:Region"]" />
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="keyword" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-keyword">
                        <span class="apya-rule-label">@L["Grants:Parameters:Keyword"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-keyword" hidden>
                        <div class="apya-tag-input" data-kind="2">
                            <span class="apya-tag-chips"></span>
                            <input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]"
                                   aria-label="@L["Grants:Parameters:Keyword"]" />
                        </div>
                    </div>
                </div>

                @* STK çağrılarının hedefi: firma profilindeki tematik alanla aynı sabit
                   listeden seçilir, iki taraf da enum adını yazdığı için birebir eşleşir. *@
                <div class="apya-rule" data-rule-key="thematic" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-thematic">
                        <span class="apya-rule-label">@L["Grants:Parameters:Thematic"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-thematic" hidden>
                        <div class="apya-choice-row" id="ParamThematic">
                            @foreach (var area in Enum.GetNames<Apya.Platform.Grants.GrantThematicArea>())
                            {
                                <button type="button" class="apya-choice" data-area="@area">@L["Grants:Thematic:" + area]</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="priority" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-priority">
                        <span class="apya-rule-label">@L["Grants:Parameters:Priorities"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-priority" hidden>
                        <div class="d-flex flex-column gap-1">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="ParamPrefersFemale" />
                                <label class="form-check-label" for="ParamPrefersFemale">@L["Grants:Parameters:PrefersFemale"]</label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="ParamPrefersYoung" />
                                <label class="form-check-label" for="ParamPrefersYoung">@L["Grants:Parameters:PrefersYoung"]</label>
                            </div>
                            <div class="small text-muted">@L["Grants:Parameters:PriorityHint"]</div>
                        </div>
                    </div>
                </div>

                <div class="apya-rule" data-rule-key="minscore" hidden>
                    <button type="button" class="apya-rule-summary" aria-expanded="false" aria-controls="RuleEditor-minscore">
                        <span class="apya-rule-label">@L["Grants:Parameters:MinMatchScore"]</span>
                        <span class="apya-rule-value" data-rule-value></span>
                        <span class="apya-rule-source" data-rule-source></span>
                        <span class="apya-rule-impact" data-rule-impact><span class="apya-rule-impact-text"></span><span class="apya-rule-bar"><span></span></span></span>
                    </button>
                    <div class="apya-rule-editor" id="RuleEditor-minscore" hidden>
                        <input type="number" min="0" max="100" id="ParamMinScore" class="form-control form-control-sm apya-numeric apya-rule-input"
                               aria-label="@L["Grants:Parameters:MinMatchScore"]" />
                    </div>
                </div>
            </div>

            @* Resmî metin ile program değeri çelişirse: tam cümle + iki eylem. JS boyar. *@
            <div class="apya-rule-conflicts" id="RuleConflicts" aria-live="polite"></div>

            <div class="dropdown">
                <button type="button" class="apya-param-add apya-rule-add" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa fa-plus"></i>@L["Grants:Parameters:AddRule"]
                </button>
                <ul class="dropdown-menu" id="RuleAddMenu"></ul>
            </div>
        </section>

        @* ---------- Para ve süre ---------- *@
        <section class="card mb-0 apya-param-panel" id="SectionFinancial" data-panel="financial" role="tabpanel" hidden>
            <div class="card-body d-flex flex-column gap-3">
                <div class="apya-param-section-head">
                    <span class="apya-param-section-icon apya-param-section-icon--financial"><i class="fa fa-sack-dollar"></i></span>
                    <div>
                        <div class="fw-bold">@L["Grants:Parameters:Section:Financial"]</div>
                        <div class="small text-muted">@L["Grants:Parameters:Section:FinancialHint"]</div>
                    </div>
                </div>

                <div class="apya-param-grid apya-param-grid--4">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamMaxAmount"><span>@L["Grants:Parameters:MaxAmount"]</span></label>
                        <input type="number" min="0" step="0.01" id="ParamMaxAmount" data-money-input="true" class="form-control form-control-sm apya-numeric" />
                        <div class="small text-muted">@L["Grants:Parameters:MaxAmountHint"]</div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamSupportRate"><span>@L["Grants:Parameters:SupportRate"]</span></label>
                        <input type="number" min="0" max="100" id="ParamSupportRate" class="form-control form-control-sm apya-numeric" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamCoFinancing"><span>@L["Grants:Parameters:CoFinancing"]</span></label>
                        <input type="text" id="ParamCoFinancing" class="form-control form-control-sm apya-numeric" readonly disabled />
                        <div class="small text-muted">@L["Grants:Parameters:CoFinancingHint"]</div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamDuration"><span>@L["Grants:Parameters:Duration"]</span></label>
                        <input type="number" min="1" max="240" id="ParamDuration" class="form-control form-control-sm apya-numeric" />
                    </div>
                </div>

                <div class="apya-field">
                    <span class="apya-field-label">
                        <span>@L["Grants:Parameters:CostItems"]</span>
                        <span class="text-muted fw-normal">@L["Grants:Parameters:CostItemsHint"]</span>
                    </span>
                    <div class="apya-cost-grid" id="ParamCostItems">
                        @foreach (var (kind, key) in new[]
                        {
                            (0, "Personel"), (1, "MakineTechizat"), (2, "Danismanlik"),
                            (3, "YazilimLisans"), (4, "Seyahat"), (5, "SarfMalzeme")
                        })
                        {
                            <div class="apya-cost-tile" data-kind="@kind">
                                <span>@L["Grants:CostItem:" + key]</span>
                                <span class="apya-cost-tile-state">@L["Grants:Parameters:CostClosed"]</span>
                                <input type="number" min="0" max="100" class="apya-cost-limit d-none"
                                       title="@L["Grants:Parameters:CostLimit"]" />
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-4 pt-3 border-top">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamRepayment"><span>@L["Grants:Parameters:Repayment"]</span></label>
                        <select id="ParamRepayment" class="form-select form-select-sm">
                            <option value="0">@L["Grants:Parameters:RepaymentNone"]</option>
                            <option value="1">@L["Grants:Parameters:RepaymentYes"]</option>
                        </select>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="ParamAdvance" />
                            <label class="form-check-label small" for="ParamAdvance">@L["Grants:Parameters:AdvancePayment"]</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="ParamGuarantee" />
                            <label class="form-check-label small" for="ParamGuarantee">@L["Grants:Parameters:GuaranteeLetter"]</label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* ---------- Evraklar ---------- *@
        <section class="card mb-0 apya-param-panel" id="SectionDocuments" data-panel="documents" role="tabpanel" hidden>
            <div class="card-body d-flex flex-column gap-3">
                <div class="apya-param-section-head">
                    <span class="apya-param-section-icon"><i class="fa fa-folder-open"></i></span>
                    <div>
                        <div class="fw-bold">@L["Grants:Parameters:Section:Documents"]</div>
                        <div class="small text-muted">@L["Grants:Parameters:Documents:Hint"]</div>
                    </div>
                </div>

                <div class="apya-doc-table">
                    <div class="apya-doc-row apya-doc-head">
                        <span>@L["Grants:Parameters:Documents:Name"]</span>
                        <span>@L["Grants:Parameters:Documents:Obligation"]</span>
                        <span>@L["Grants:Parameters:Documents:Uploader"]</span>
                        <span>@L["Grants:Parameters:Documents:ESignature"]</span>
                        <span></span>
                    </div>
                    <div id="ParamDocuments"></div>
                    <div id="ParamDocumentsEmpty" class="apya-doc-empty">@L["Grants:Parameters:Documents:Empty"]</div>
                </div>

                <div>
                    <button type="button" id="ParamAddDocument" class="apya-param-add">
                        <i class="fa fa-plus"></i>@L["Grants:Parameters:Documents:Add"]
                    </button>
                </div>
            </div>
        </section>

        @* ---------- Süreç ---------- *@
        <section class="card mb-0 apya-param-panel" id="SectionProcess" data-panel="process" role="tabpanel" hidden>
            <div class="card-body d-flex flex-column gap-3">
                <div class="apya-param-section-head">
                    <span class="apya-param-section-icon"><i class="fa fa-diagram-project"></i></span>
                    <div>
                        <div class="fw-bold">@L["Grants:Parameters:Section:Process"]</div>
                        <div class="small text-muted">@L["Grants:Parameters:Process:Hint"]</div>
                    </div>
                </div>

                <div class="apya-param-grid apya-param-grid--2">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ParamStageTemplate">
                            <span>@L["Grants:Parameters:Process:Template"]</span>
                        </label>
                        <select id="ParamStageTemplate" class="form-select form-select-sm"></select>
                    </div>
                    <div class="apya-field">
                        <span class="apya-field-label"><span>&nbsp;</span></span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="apya-chip apya-chip-accent" id="ParamStageStepCount"></span>
                            <a href="/Grants/StageTemplates" class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-diagram-project me-1"></i>@L["Grants:Parameters:Process:Manage"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* ---------- Eşleştirme ---------- *@
        <section class="card mb-0 apya-param-panel" id="SectionWeights" data-panel="weights" role="tabpanel" hidden>
            <div class="card-body d-flex flex-column gap-3">
                <div class="apya-param-section-head">
                    <span class="apya-param-section-icon"><i class="fa fa-bullseye"></i></span>
                    <div>
                        <div class="fw-bold">@L["Grants:Parameters:Section:Weights"]</div>
                        <div class="small text-muted">@L["Grants:Parameters:Section:WeightsHint"]</div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                    <div id="ParamWeightSummary" class="d-flex flex-wrap gap-1"></div>
                    <a id="ParamWeightLink" href="/Grants/MatchWeights" class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-bullseye me-1"></i>@L["Grants:Parameters:Weights:Manage"]
                    </a>
                </div>
            </div>
        </section>
    </div>

    @* ---------- Alt sabit çubuk: tamamlanma · yayın kapısı · eylemler ---------- *@
    <div class="apya-param-bar">
        <div class="apya-param-bar-status">
            <div class="apya-param-progress">
                <div class="apya-param-progress-head">
                    <span>@L["Grants:Parameters:Completion"]</span>
                    <span class="apya-numeric" id="ParamCompletionText">%0</span>
                </div>
                <div class="apya-mini-bar"><span id="ParamCompletionBar" style="width:0"></span></div>
            </div>
            <span class="apya-param-bar-sep" aria-hidden="true"></span>
            <span class="apya-param-bar-message" id="ParamMissingText"></span>
        </div>
        <div class="apya-param-bar-actions">
            <button type="button" id="ParamSaveBtn" class="btn btn-outline-secondary">
                @L["Grants:Parameters:SaveDraft"]
            </button>
            <button type="button" id="ParamPublishBtn" class="btn btn-primary" disabled>
                <i class="fa fa-check me-1"></i>@L["Grants:Parameters:Publish"]
            </button>
        </div>
    </div>
</div>
