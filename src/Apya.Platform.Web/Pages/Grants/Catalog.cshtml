@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.CatalogModel
@{
    ViewBag.Title = L["Grants:Catalog:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Tenant.css" />
}

@section scripts {
    <abp-script src="/Pages/Grants/Catalog.js" />
}

@* Başlık + açıklama app header'da; sayfa içinde tekrarlanmıyor. *@
<div data-page-description="@L["Grants:Catalog:Description"]" class="apya-page">

    <div class="apya-tenant-tabs">
        <a class="apya-tenant-tab" href="/Grants">
            @L["Grants:Feed:Tab:Eligible"]<span class="apya-chip apya-chip-neutral" id="TabCountEligible">—</span>
        </a>
        <button type="button" class="apya-tenant-tab is-active">
            @L["Grants:Feed:Tab:All"]<span class="apya-chip apya-chip-accent" id="TabCountAll">—</span>
        </button>
    </div>

    <div class="apya-bucket-grid">
        <div class="apya-bucket is-eligible">
            <span class="apya-overline">@L["Grants:Bucket:Uygun"]</span>
            <span class="apya-bucket-value" id="BucketEligible">—</span>
        </div>
        <div class="apya-bucket">
            <span class="apya-overline">@L["Grants:Bucket:Kosullu"]</span>
            <span class="apya-bucket-value" id="BucketConditional">—</span>
        </div>
        <div class="apya-bucket">
            <span class="apya-overline">@L["Grants:Bucket:UygunDegil"]</span>
            <span class="apya-bucket-value" id="BucketIneligible">—</span>
        </div>
    </div>

    <section class="card mb-0">
        <div class="card-body d-flex flex-column gap-3">
            <div class="apya-cat-table">
                <div class="apya-cat-row apya-cat-head">
                    <span></span>
                    <span>@L["Grants:Catalog:Col:Call"]</span>
                    <span>@L["Grants:Catalog:Col:Eligibility"]</span>
                    <span>@L["Grants:Catalog:Col:Score"]</span>
                    <span></span>
                    <span class="text-end">@L["Grants:Catalog:Col:Amount"]</span>
                    <span>@L["Grants:Catalog:Col:Days"]</span>
                    <span></span>
                </div>
                <div id="CatalogRows"></div>
                <div id="CatalogEmpty" class="apya-src-empty d-none">@L["Grants:Catalog:Empty"]</div>
            </div>

            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="OnlyFixable" />
                <label class="form-check-label small" for="OnlyFixable">@L["Grants:Catalog:OnlyFixable"]</label>
            </div>
        </div>
    </section>
</div>
