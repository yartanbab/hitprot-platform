@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.DetailModel
@{
    ViewBag.Title = L["Grants:Detail:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Tenant.css" />
    <abp-style src="/Pages/Grants/Detail.css" />
}

@section scripts {
    <abp-script src="/Pages/Grants/Detail.js" />
}

@* Başlık + açıklama app header'da; sayfa içinde tekrarlanmıyor. *@
<div class="apya-page apya-grant-scope" data-call-id="@Model.Id">
    <div class="apya-page-head">
        <div class="apya-page-head-actions d-flex align-items-center gap-2">
            <a href="/Grants" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>@L["Grants:Detail:BackToList"]
            </a>
            <button type="button" id="BookmarkBtn" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-bookmark me-1"></i><span id="BookmarkText"></span>
            </button>
            @* Kiracı başvuruyu kendi açmaz: ilgi bildirir, host değerlendirir (tur 14).
               "İlgileniyorum" YALNIZ burada — kartlar "İncele" der. Durumu JS boyar. *@
            <button type="button" id="InterestBtn" class="btn btn-sm btn-primary d-none">
                <i class="fa fa-handshake me-1"></i><span id="InterestBtnText"></span>
            </button>
            <span id="InterestChip" class="apya-chip d-none"></span>
            <a id="InterestAppLink" class="btn btn-sm btn-outline-primary d-none" href="#">
                @L["Grants:Interest:GoToApplication"]
            </a>
        </div>
    </div>

    <div class="apya-detail-head card mb-4">
        <div class="card-body d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h5 class="fw-bold mb-0" id="CallTitle"></h5>
                <span class="apya-chip" id="BucketChip"></span>
                <span class="apya-chip apya-chip-neutral" id="DaysChip"></span>
            </div>
            <div class="apya-feed-issuer" id="CallIssuer"></div>
            <div class="small text-muted" id="CallDescription"></div>
            @* Uygun bulunmayan talebin gerekçesi — host'un yazdığı cümle birebir. *@
            <div id="InterestFeedback" class="apya-side-note d-none">
                <i class="fa fa-circle-info mt-1"></i>
                <span><strong>@L["Grants:Interest:Feedback"]:</strong> <span id="InterestFeedbackText"></span></span>
            </div>
            <div id="InterestWithdrawn" class="apya-side-note apya-side-note--quiet d-none">
                <i class="fa fa-rotate-left mt-1"></i>
                <span id="InterestWithdrawnText"></span>
            </div>
            <div class="apya-detail-metrics" id="CallMetrics"></div>
        </div>
    </div>

    @* Tur 14 · "İlginiz iletildi" + dört adımlı ilerleme. Talep sürerken ve başvuruya
       döndüğünde görünür; reddedilen / geri çekilen talep başlık kartındaki notla anlatılır. *@
    <section id="InterestState" class="apya-interest-state d-none" aria-live="polite">
        <div id="InterestSent" class="apya-interest-sent d-none">
            <span class="apya-interest-sent-icon"><i class="fa fa-circle-check"></i></span>
            <div class="min-w-0">
                <div class="apya-interest-sent-title">@L["Grants:Interest:Sent:Title"]</div>
                <div class="apya-interest-sent-text" id="InterestSentText"></div>
            </div>
        </div>
        <ol class="apya-interest-steps" id="InterestSteps"></ol>
        <div class="apya-interest-actions">
            <button type="button" id="InterestWithdrawBtn" class="btn apya-interest-withdraw d-none">
                <i class="fa fa-rotate-left me-1"></i>@L["Grants:Interest:Withdraw"]
            </button>
        </div>
    </section>

    <div class="apya-detail-layout">
        <div class="d-flex flex-column gap-4">

            @* Resmî duyurunun metin başlıkları. Hiçbiri dolu değilse kart gizli kalır; JS boyar. *@
            <section class="card mb-0 d-none" id="AboutCard">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="fw-bold">@L["Grants:Detail:About"]</div>
                    <div id="AboutObjective" class="d-none">
                        <div class="apya-overline">@L["Grants:Parameters:Objective"]</div>
                        <p class="mb-0 apya-detail-prose" id="AboutObjectiveText"></p>
                    </div>
                    <div id="AboutPriorities" class="d-none">
                        <div class="apya-overline">@L["Grants:Parameters:ProgramPriorities"]</div>
                        <ul class="mb-0 ps-3" id="AboutPrioritiesList"></ul>
                    </div>
                    <div id="AboutApplicants" class="d-none">
                        <div class="apya-overline">@L["Grants:Parameters:EligibleApplicants"]</div>
                        <ul class="mb-0 ps-3" id="AboutApplicantsList"></ul>
                    </div>
                </div>
            </section>

            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="fw-bold">@L["Grants:Detail:Eligibility"]</div>
                    <div class="apya-cat-table">
                        <div class="apya-check-row apya-cat-head">
                            <span></span>
                            <span>@L["Grants:Detail:Col:Condition"]</span>
                            <span class="text-end">@L["Grants:Detail:Col:Note"]</span>
                        </div>
                        <div id="RuleRows"></div>
                        <div id="RuleEmpty" class="apya-src-empty d-none">@L["Grants:Detail:NoRules"]</div>
                    </div>
                    <div id="NotBlockingNote" class="apya-side-note apya-side-note--quiet d-none">
                        <i class="fa fa-circle-info mt-1"></i><span>@L["Grants:Detail:NotBlocking"]</span>
                    </div>
                </div>
            </section>

            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <div>
                        <div class="fw-bold">@L["Grants:Detail:Budget"]</div>
                        <div class="small text-muted">@L["Grants:Detail:Budget:Hint"]</div>
                    </div>
                    <div class="apya-cat-table">
                        <div class="apya-budget-row apya-cat-head">
                            <span>@L["Grants:Detail:Budget:Item"]</span>
                            <span class="text-end">@L["Grants:Detail:Budget:Yours"]</span>
                            <span class="text-end">@L["Grants:Detail:Budget:Rate"]</span>
                            <span class="text-end">@L["Grants:Detail:Budget:Support"]</span>
                        </div>
                        <div id="BudgetRows"></div>
                        <div id="BudgetEmpty" class="apya-src-empty d-none">@L["Grants:Detail:Budget:NoItems"]</div>
                    </div>
                    <div class="apya-budget-summary">
                        <div>
                            <div class="apya-overline">@L["Grants:Detail:Budget:TotalSupport"]</div>
                            <div class="apya-budget-metric is-support" id="BudgetSupport">—</div>
                        </div>
                        <div>
                            <div class="apya-overline">@L["Grants:Detail:Budget:YourShare"]</div>
                            <div class="apya-budget-metric" id="BudgetShare">—</div>
                        </div>
                        <div class="small text-muted d-flex align-items-end" id="BudgetNote"></div>
                    </div>
                </div>
            </section>

            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="fw-bold">@L["Grants:Detail:Process"]</div>
                    <div id="StepStrip" class="apya-steps"></div>
                    <div id="StepEmpty" class="small text-muted d-none">@L["Grants:Detail:Process:NoSteps"]</div>

                    <div class="apya-overline">@L["Grants:Detail:Documents"]</div>
                    <div id="DocumentList" class="d-flex flex-column gap-1"></div>
                    <div id="DocumentEmpty" class="small text-muted d-none">@L["Grants:Detail:Documents:None"]</div>
                </div>
            </section>
        </div>

        <aside class="apya-detail-side">
            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Detail:Score"]</span>
                    <div class="apya-budget-metric" id="ScoreValue">—</div>
                    <div id="ScoreDimensions" class="d-flex flex-column gap-2"></div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="apya-overline">@L["Grants:Detail:Difficulty"]</span>
                        <span class="apya-chip apya-chip-neutral" id="DifficultyLabel"></span>
                    </div>
                    <div class="apya-difficulty" id="DifficultyBar"></div>
                    <div id="DifficultyReasons" class="d-flex flex-column gap-1"></div>
                    <div id="HardWarning" class="apya-side-note d-none">
                        <i class="fa fa-triangle-exclamation mt-1"></i>
                        <span>@L["Grants:Detail:Difficulty:HardWarning"]</span>
                    </div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Detail:Similar"]</span>
                    <div id="SimilarList" class="d-flex flex-column gap-1"></div>
                    <div id="SimilarEmpty" class="small text-muted d-none">@L["Grants:Detail:Similar:None"]</div>
                </div>
            </div>
        </aside>
    </div>
</div>

@* ---- Tur 14 · İlgi onayı (1. adım) + proje fikri (2. adım) ----
   Modal sayfa kabının DIŞINDA; okunabilirlik token'ları gelsin diye kapsam sınıfı kendisinde. *@
<div class="modal fade apya-grant-scope" id="InterestModal" tabindex="-1" aria-hidden="true" aria-labelledby="InterestConfirmTitle">
    <div class="modal-dialog modal-dialog-centered apya-interest-dialog">
        <div class="modal-content apya-interest-modal">
            <form id="InterestForm" novalidate>
                @* 1. adım — ne olacağı açıkça yazılı, vazgeçme hakkı net. *@
                <div class="apya-interest-pane" data-pane="confirm">
                    <div class="apya-interest-body">
                        <span class="apya-interest-icon"><i class="fa fa-hand-point-up"></i></span>
                        <div>
                            <h5 class="apya-interest-title" id="InterestConfirmTitle">@L["Grants:Interest:Confirm:Title"]</h5>
                            <p class="apya-interest-lead">@L["Grants:Interest:Confirm:Lead"]</p>
                        </div>
                        <ul class="apya-interest-facts">
                            <li><i class="fa fa-file-pen"></i><span>@L["Grants:Interest:Confirm:Form"]</span></li>
                            <li><i class="fa fa-user-check"></i><span>@L["Grants:Interest:Confirm:Review"]</span></li>
                            <li><i class="fa fa-rotate-left is-quiet"></i><span>@L["Grants:Interest:Confirm:NoCommitment"]</span></li>
                        </ul>
                    </div>
                    <div class="apya-interest-foot">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Interest:Confirm:Cancel"]</button>
                        <button type="button" class="btn btn-primary" id="InterestContinue">@L["Grants:Interest:Confirm:Continue"]</button>
                    </div>
                </div>

                @* 2. adım — proje fikri. Çağrı bu sayfadan seçili gelir. *@
                <div class="apya-interest-pane d-none" data-pane="form">
                    <div class="apya-interest-body">
                        <div>
                            <h5 class="apya-interest-title">@L["Grants:Interest:Form:Title"]</h5>
                            <p class="apya-interest-lead mb-0">@L["Grants:Interest:Form:Lead"]</p>
                        </div>

                        <div class="apya-interest-field">
                            <span class="form-label mb-0">@L["Grants:Interest:Form:Call"]</span>
                            <div class="apya-interest-call">
                                <span id="InterestCallName"></span>
                                <span class="apya-chip apya-chip-accent">@L["Grants:Interest:Form:CallPreselected"]</span>
                            </div>
                        </div>

                        @* Tur 19 · APYA proje fikri bilgi formunun dokuz sorusu; yalnız ilk ikisi zorunlu. *@
                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestNote">@L["Grants:Interest:Form:Idea"] <span class="text-danger" aria-hidden="true">*</span></label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Idea:Hint"]</div>
                            <textarea class="form-control" id="InterestNote" rows="3" maxlength="1000" required></textarea>
                            <div class="invalid-feedback">@L["Grants:Interest:Form:IdeaRequired"]</div>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestProblem">@L["Grants:Interest:Form:Problem"] <span class="text-danger" aria-hidden="true">*</span></label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Problem:Hint"]</div>
                            <textarea class="form-control" id="InterestProblem" rows="3" maxlength="1000" required></textarea>
                            <div class="invalid-feedback">@L["Grants:Interest:Form:ProblemRequired"]</div>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestAudience">@L["Grants:Interest:Form:Audience"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Audience:Hint"]</div>
                            <textarea class="form-control" id="InterestAudience" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestActivities">@L["Grants:Interest:Form:Activities"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Activities:Hint"]</div>
                            <textarea class="form-control" id="InterestActivities" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestDuration">@L["Grants:Interest:Form:Duration"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Duration:Hint"]</div>
                            <textarea class="form-control" id="InterestDuration" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestSupport">@L["Grants:Interest:Form:Support"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Support:Hint"]</div>
                            <textarea class="form-control" id="InterestSupport" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestExperience">@L["Grants:Interest:Form:Experience"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Experience:Hint"]</div>
                            <textarea class="form-control" id="InterestExperience" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestTeam">@L["Grants:Interest:Form:Team"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Team:Hint"]</div>
                            <textarea class="form-control" id="InterestTeam" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-field">
                            <label class="form-label mb-0" for="InterestStakeholders">@L["Grants:Interest:Form:Stakeholders"]</label>
                            <div class="apya-interest-hint">@L["Grants:Interest:Form:Stakeholders:Hint"]</div>
                            <textarea class="form-control" id="InterestStakeholders" rows="2" maxlength="1000"></textarea>
                        </div>

                        <div class="apya-interest-grid">
                            <div class="apya-interest-field">
                                <label class="form-label mb-0" for="InterestBudget">@L["Grants:Interest:Form:Budget"]</label>
                                <input type="number" min="0" step="0.01" class="form-control apya-numeric" id="InterestBudget" data-money-input="true" />
                            </div>
                            <div class="apya-interest-field">
                                <label class="form-label mb-0" for="InterestStart">@L["Grants:Interest:Form:TargetStart"]</label>
                                <select class="form-select" id="InterestStart"></select>
                            </div>
                        </div>

                        @* Yalnız konsorsiyum şartlı çağrıda görünür ve orada zorunludur. *@
                        <fieldset id="InterestPartnerBlock" class="apya-interest-field d-none">
                            <legend class="form-label mb-0">@L["Grants:Interest:Form:Partner"] <span class="text-danger" aria-hidden="true">*</span></legend>
                            <div class="apya-interest-choices">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="InterestPartner" id="InterestPartnerHas" value="has" />
                                    <label class="form-check-label" for="InterestPartnerHas">@L["Grants:Interest:Form:Partner:Has"]</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="InterestPartner" id="InterestPartnerNeeds" value="needs" />
                                    <label class="form-check-label" for="InterestPartnerNeeds">@L["Grants:Interest:Form:Partner:Needs"]</label>
                                </div>
                            </div>
                            <div class="invalid-feedback" id="InterestPartnerError">@L["Grants:Interest:Form:PartnerRequired"]</div>
                            <input type="text" class="form-control d-none" id="InterestPartnerName" maxlength="200"
                                   placeholder="@L["Grants:Interest:Form:PartnerName"]" aria-label="@L["Grants:Interest:Form:PartnerName"]" />
                            <div id="InterestPartnerHint" class="apya-side-note apya-side-note--quiet d-none">
                                <i class="fa fa-lightbulb mt-1"></i>
                                <span>@L["Grants:Interest:Form:PartnerHint"]</span>
                            </div>
                        </fieldset>
                    </div>
                    <div class="apya-interest-foot">
                        <button type="button" class="btn btn-outline-secondary" id="InterestBack">@L["Grants:Interest:Form:Back"]</button>
                        <button type="submit" class="btn btn-primary">@L["Grants:Interest:Form:Submit"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
