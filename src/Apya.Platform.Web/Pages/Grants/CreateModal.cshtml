@page
@model Apya.Platform.Web.Pages.Grants.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Grant" asp-page="/Grants/CreateModal">
    <abp-modal>
        <abp-modal-header title="Yeni Hibe Programı"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Grant.Name" label="Program Adı" />
            <abp-input asp-for="Grant.Issuer" label="Kurum (TÜBİTAK, KOSGEB vb.)" />
            <abp-input asp-for="Grant.Description" text-area rows="3" label="Açıklama" />
            <abp-row>
                <abp-column size="_6">
                    <abp-input asp-for="Grant.MaxAmount" label="Maksimum Destek Tutarı (₺)" />
                </abp-column>
                <abp-column size="_6">
                    <label class="form-label" for="Grant_MinMatchScore">
                        Minimum Uyum Puanı (%)
                        <apya-hint text="Bu puanın altında kalan firmalara program otomatik olarak önerilmez. Host olarak Firmalara Gönder ekranından elle gönderdiğiniz öneriler bu eşiği aşmasa da firmaya ulaşır." />
                    </label>
                    <abp-input asp-for="Grant.MinMatchScore" suppress-label="true" />
                </abp-column>
            </abp-row>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
