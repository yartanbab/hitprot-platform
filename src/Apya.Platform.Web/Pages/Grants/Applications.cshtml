@page
@model Apya.Platform.Web.Pages.Grants.ApplicationsModel
@{
    ViewBag.Title = "Hibe Başvuruları";
}

@section scripts {
    <abp-script src="/Pages/Grants/Applications.js" />
}

<style>
    .apya-app-row:first-of-type { border-top: 0 !important; }
</style>

<div class="apya-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <div class="apya-overline mb-1">Hibe Yönetimi</div>
            <h1 class="h3 fw-bold mb-1">Hibe Başvuruları</h1>
            <p class="text-muted mb-0" style="max-width: 640px;">
                Tüm firmaların başvurularını buradan izleyin; aşamayı ilerletin, onaylanan tutarı ve
                tahsilat dilimlerini/milestone'ları yönetin. Firmalar bu bilgileri salt-okunur görür.
            </p>
        </div>
        <a href="/Grants" class="btn btn-outline-secondary flex-shrink-0"><i class="fa fa-arrow-left me-1"></i>Programlara Dön</a>
    </div>

    <div id="AppList"></div>
    <div id="AppListEmpty" class="apya-tile-grid-empty d-none">
        <i class="fa fa-file-signature"></i>
        <span>Henüz başvuru yok.</span>
    </div>
</div>

@* ---- Aşama İlerlet modalı ---- *@
<div class="modal fade" id="AdvanceStageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="AdvanceStageForm">
                <div class="modal-header">
                    <h5 class="modal-title">Aşama İlerlet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="StageAppId" />
                    <div class="mb-3">
                        <label class="form-label" for="StageSelect">Aşama</label>
                        <select class="form-select" id="StageSelect">
                            <option value="0">Başvuru</option>
                            <option value="1">Değerlendirme</option>
                            <option value="2">Onay</option>
                            <option value="3">Ödeme</option>
                        </select>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="StageApprovedAmount">Onaylanan Tutar (₺, opsiyonel)</label>
                        <input type="number" step="0.01" class="form-control" id="StageApprovedAmount" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ---- Dilim ekle/düzenle modalı ---- *@
<div class="modal fade" id="TrancheModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="TrancheForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="TrancheModalTitle">Yeni Dilim</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="TrancheId" />
                    <input type="hidden" id="TrancheAppId" />
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label" for="TrancheSeq">Sıra</label>
                            <input type="number" class="form-control" id="TrancheSeq" min="1" value="1" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label" for="TrancheAmount">Tutar (₺)</label>
                            <input type="number" step="0.01" class="form-control" id="TrancheAmount" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label" for="TrancheStatus">Durum</label>
                            <select class="form-select" id="TrancheStatus">
                                <option value="0">Planlandı</option>
                                <option value="1">Talep Edildi</option>
                                <option value="2">Ödendi</option>
                            </select>
                        </div>
                        <div class="col-6 mb-1">
                            <label class="form-label" for="TrancheDueDate">Vade</label>
                            <input type="date" class="form-control" id="TrancheDueDate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ---- Milestone ekle/düzenle modalı ---- *@
<div class="modal fade" id="MilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="MilestoneForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="MilestoneModalTitle">Yeni Milestone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="MilestoneId" />
                    <input type="hidden" id="MilestoneAppId" />
                    <div class="mb-3">
                        <label class="form-label" for="MilestoneTitle">Başlık</label>
                        <input type="text" class="form-control" id="MilestoneTitle" maxlength="128" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label" for="MilestoneDueDate">Vade</label>
                            <input type="date" class="form-control" id="MilestoneDueDate" />
                        </div>
                        <div class="col-6 mb-1 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="MilestoneCompleted">
                                <label class="form-check-label" for="MilestoneCompleted">Tamamlandı</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
