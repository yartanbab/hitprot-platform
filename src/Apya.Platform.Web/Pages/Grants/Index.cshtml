@page
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Grants.IndexModel
@{
    ViewBag.Title = "Hibe Programları";
}

@section scripts {
    <abp-script src="/Pages/Grants/Index.js" />
}

<div class="apya-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <div class="apya-overline mb-1">Hibe Yönetimi</div>
            <h1 class="h3 fw-bold mb-1">Hibe Programları</h1>
            <p class="text-muted mb-0" style="max-width: 640px;">
                KOSGEB, TÜBİTAK, AB gibi kurumların destek programlarını burada tanımlayın; uyum puanı eşiği
                başvuru eşleştirmelerinde kullanılır.
            </p>
        </div>
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Grants.Create))
        {
            <button id="NewGrantButton" class="btn btn-primary flex-shrink-0">
                <i class="fa fa-plus me-1"></i> Yeni Hibe Ekle
            </button>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-award", Accent = "primary", Label = "Toplam Program", ValueId = "KpiTotalPrograms", Value = "—" }' />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-sack-dollar", Accent = "success", Label = "Toplam Potansiyel Tutar", ValueId = "KpiTotalAmount", Value = "—" }' />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-bullseye", Accent = "info", Label = "Ortalama Uyum Puanı", ValueId = "KpiAvgScore", Value = "—" }' />
        </div>
        <div class="col-6 col-md-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-trophy", Accent = "warning", Label = "En Yüksek Tutarlı Program", ValueId = "KpiTopProgram", Value = "—" }' />
        </div>
    </div>

    <div id="GrantTileGrid" class="apya-tile-grid"></div>

    <div id="GrantTileGridEmpty" class="apya-tile-grid-empty d-none">
        <i class="fa fa-award"></i>
        <span>Henüz hibe programı eklenmedi.</span>
    </div>
</div>
