@page
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Web.Pages.Shared
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Grants.IndexModel
@{
    ViewBag.Title = "Hibeler";
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    @if (!Model.IsHost)
    {
        <abp-style src="/Pages/Grants/Tenant.css" />
    }
}

@section scripts {
    @if (Model.IsHost)
    {
        <abp-script src="/Pages/Grants/Index.js" />
    }
    else
    {
        <abp-script src="/Pages/Grants/Tenant.js" />
    }
}

<style>
    .apya-call-row:first-of-type { border-top: 0 !important; }

    /* #GrantModal modal-dialog-scrollable kullanıyor ama header/body/footer bir form etiketi içinde;
       form flex olmayınca Bootstrap'ın scroll zinciri kırılıyor ve alt kısım (footer dahil) taşıp kesiliyor. */
    #GrantModal .modal-content > form {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }
</style>

@if (Model.IsHost)
{
    @* Başlık + açıklama app header'da (ViewBag.Title + data-page-description);
       sayfa içinde tekrarlanmıyor — bkz. apya-shell.css §19. *@
    <div data-page-description="KOSGEB, TÜBİTAK, AB gibi kurumların destek programları ve dönemsel çağrıları" class="apya-page">
        <div class="apya-page-head">
            <div class="apya-page-head-actions">
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Grants.Edit))
                {
                    <a href="/Grants/Applications" class="btn btn-outline-secondary"><i class="fa fa-file-signature me-1"></i>Başvurular</a>
                }
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Grants.Create))
                {
                    <button id="NewGrantButton" class="btn btn-primary">
                        <i class="fa fa-plus me-1"></i> Yeni Hibe Ekle
                    </button>
                }
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-award", Accent = "accent", Label = "Toplam Program", ValueId = "KpiTotalPrograms", Value = "—" }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-sack-dollar", Accent = "positive", Label = "Toplam Potansiyel Tutar", ValueId = "KpiTotalAmount", Value = "—", Hint = "Listelenen tüm programların üst limit tutarlarının toplamı. Dağıtılmış ya da taahhüt edilmiş tutar değil, teorik tavandır." }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-bullseye", Accent = "brand", Label = "Ortalama Uyum Puanı", ValueId = "KpiAvgScore", Value = "—", Hint = "Programlara tanımladığınız asgari uyum eşiklerinin ortalaması — firmaların gerçek eşleşme puanı değildir. Firmaların puanını görmek için bir çağrıda Firmalara Gönder ekranındaki önizlemeyi kullanın." }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-trophy", Accent = "warning", Label = "En Yüksek Tutarlı Program", ValueId = "KpiTopProgram", Value = "—" }' />
            </div>
        </div>

        <div id="GrantTileGrid" class="apya-tile-grid"></div>

        <div id="GrantTileGridEmpty" class="d-none">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-award", Title = "Henüz hibe programı eklenmedi." }' />
        </div>
    </div>

    @* ---- Program (Grant) modalı ---- *@
    <div class="modal fade" id="GrantModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form id="GrantForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="GrantModalTitle">Yeni Hibe Programı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="GrantId" />
                        <div class="mb-3">
                            <label class="form-label" for="GrantName">Program Adı</label>
                            <input type="text" class="form-control" id="GrantName" maxlength="128" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="GrantIssuer">Kurum (TÜBİTAK, KOSGEB vb.)</label>
                            <input type="text" class="form-control" id="GrantIssuer" maxlength="64" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="GrantDescription">Açıklama</label>
                            <textarea class="form-control" id="GrantDescription" rows="2"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="GrantMaxAmount">Maksimum Destek Tutarı (₺)</label>
                                <input type="number" step="0.01" class="form-control" id="GrantMaxAmount" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="GrantMinMatchScore">Minimum Uyum Puanı (%)</label>
                                <input type="number" step="1" min="0" max="100" class="form-control" id="GrantMinMatchScore" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hedef Firma Ölçeği</label>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check"><input class="form-check-input apya-size" type="checkbox" value="1" id="szMikro"><label class="form-check-label" for="szMikro">Mikro</label></div>
                                <div class="form-check"><input class="form-check-input apya-size" type="checkbox" value="2" id="szKucuk"><label class="form-check-label" for="szKucuk">Küçük</label></div>
                                <div class="form-check"><input class="form-check-input apya-size" type="checkbox" value="4" id="szOrta"><label class="form-check-label" for="szOrta">Orta</label></div>
                                <div class="form-check"><input class="form-check-input apya-size" type="checkbox" value="8" id="szBuyuk"><label class="form-check-label" for="szBuyuk">Büyük</label></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hedef Sektörler</label>
                            <div class="apya-tag-input" data-kind="0"><div class="apya-tag-chips"></div><input type="text" class="form-control form-control-sm apya-tag-entry" placeholder="Yazın, Enter'a basın…" /></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hedef Bölgeler</label>
                            <div class="apya-tag-input" data-kind="1"><div class="apya-tag-chips"></div><input type="text" class="form-control form-control-sm apya-tag-entry" placeholder="Yazın, Enter'a basın…" /></div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Anahtar Kelimeler</label>
                            <div class="apya-tag-input" data-kind="2"><div class="apya-tag-chips"></div><input type="text" class="form-control form-control-sm apya-tag-entry" placeholder="Yazın, Enter'a basın…" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ---- Çağrı (GrantCall) modalı ---- *@
    <div class="modal fade" id="CallModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="CallForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="CallModalTitle">Yeni Çağrı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="CallId" />
                        <input type="hidden" id="CallGrantId" />
                        <div class="mb-3">
                            <label class="form-label" for="CallPeriod">Dönem (örn. 2025/1)</label>
                            <input type="text" class="form-control" id="CallPeriod" maxlength="32" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="CallStatus">Durum</label>
                            <select class="form-select" id="CallStatus">
                                <option value="0">Planlandı</option>
                                <option value="1" selected>Açık</option>
                                <option value="2">Kapandı</option>
                            </select>
                        </div>
                        @* Tarih alanlarında abp-data-datepicker="false" ŞART: ABP'nin genel
                           başlatıcısı input[type=date] alanlarını type="text" yapıp değeri tr
                           biçimine ("22.08.2026") çevirir. Index.js ise .val()'i ISO sanıp
                           doğrudan API'ye gönderiyor — çağrı kaydı bu yüzden düşüyordu. *@
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="CallOpenDate">Açılış Tarihi</label>
                                <input type="date" abp-data-datepicker="false" class="form-control" id="CallOpenDate" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="CallDeadline">Son Başvuru Tarihi</label>
                                <input type="date" abp-data-datepicker="false" class="form-control" id="CallDeadline" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-1">
                                <label class="form-label" for="CallBudget">Bütçe (₺)</label>
                                <input type="number" step="0.01" class="form-control" id="CallBudget" />
                            </div>
                            <div class="col-6 mb-1">
                                <label class="form-label" for="CallReference">Referans No</label>
                                <input type="text" class="form-control" id="CallReference" maxlength="64" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}
else
{
    @* 1d · Kiracı: Uygun Hibeler. Başlık + açıklama app header'da. *@
    <div data-page-description="Profilinize uygun açık hibe çağrıları ve başvurularınız" class="apya-page">

        <div class="apya-tenant-tabs">
            <button type="button" class="apya-tenant-tab is-active" data-tab="eligible">
                @L["Grants:Feed:Tab:Eligible"]<span class="apya-chip apya-chip-accent" id="TabCountEligible">—</span>
            </button>
            <a class="apya-tenant-tab" href="/Grants/Catalog">
                @L["Grants:Feed:Tab:All"]<span class="apya-chip apya-chip-neutral" id="TabCountAll">—</span>
            </a>
            <button type="button" class="apya-tenant-tab" data-tab="bookmarked">
                @L["Grants:Feed:Tab:Bookmarked"]<span class="apya-chip apya-chip-neutral" id="TabCountBookmarked">—</span>
            </button>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-circle-check", Accent = "positive", Label = "Onaylanan", ValueId = "KpiOnaylanan", Value = "—" }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-magnifying-glass-chart", Accent = "warning", Label = "Değerlendirmede", ValueId = "KpiDegerlendirmede", Value = "—" }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-sack-dollar", Accent = "accent", Label = "Tahsil Edilen", ValueId = "KpiTahsilEdilen", Value = "—" }' />
            </div>
            <div class="col-6 col-md-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-hourglass-half", Accent = "brand", Label = "Bu Ay Son Tarih", ValueId = "KpiBuAySonTarih", Value = "—" }' />
            </div>
        </div>

        <div class="apya-tenant-top">
            @* --- Profil kartı --- *@
            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span class="apya-overline">@L["Grants:Feed:Profile:Title"]</span>
                        <span class="apya-chip apya-chip-warning d-none" id="ProfileMissingChip"></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="apya-numeric fw-bold fs-5" id="ProfileCompleteText">—</span>
                    </div>
                    <div class="apya-mini-bar"><span id="ProfileBar" style="width:0"></span></div>
                    <div class="small text-muted" id="ProfileGain"></div>
                    <button type="button" id="ProfileToggleBtn" class="btn btn-sm btn-outline-secondary align-self-start">
                        <i class="fa fa-id-card-clip me-1"></i>@L["Grants:Feed:Profile:Cta"]
                    </button>
                </div>
            </section>

            @* --- Takvim şeridi (90 gün) --- *@
            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <span class="apya-overline">@L["Grants:Feed:Timeline"]</span>
                    <div id="Timeline" class="apya-timeline"></div>
                    <div id="TimelineEmpty" class="small text-muted d-none">@L["Grants:Feed:Timeline:Empty"]</div>
                </div>
            </section>
        </div>

        @* --- Profil editörü (katlanır) --- *@
        <section class="card d-none" id="ProfileEditor">
            <div class="card-body d-flex flex-column gap-3">
                <div class="fw-bold"><i class="fa fa-id-card-clip me-2"></i>@L["Grants:Feed:Profile:Title"]</div>

                <div class="apya-param-grid apya-param-grid--4">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileSize"><span>@L["Grants:Parameters:CompanySizes"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileSize">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="1">@L["Grants:Size:Mikro"]</option>
                            <option value="2">@L["Grants:Size:Kucuk"]</option>
                            <option value="4">@L["Grants:Size:Orta"]</option>
                            <option value="8">@L["Grants:Size:Buyuk"]</option>
                        </select>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileFoundedOn"><span>@L["Grants:DataField:FoundedOn"]</span></label>
                        <input type="date" abp-data-datepicker="false" class="form-control form-control-sm apya-numeric" id="ProfileFoundedOn" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileStaff"><span>@L["Grants:DataField:StaffCount"]</span></label>
                        <input type="number" min="0" class="form-control form-control-sm apya-numeric" id="ProfileStaff" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileRdStaff"><span>@L["Grants:DataField:RdStaff"]</span></label>
                        <input type="number" min="0" class="form-control form-control-sm apya-numeric" id="ProfileRdStaff" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileRevenue"><span>@L["Grants:DataField:Revenue"]</span></label>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm apya-numeric" id="ProfileRevenue" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileTrl"><span>@L["Grants:DataField:Trl"]</span></label>
                        <input type="number" min="1" max="9" class="form-control form-control-sm apya-numeric" id="ProfileTrl" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileConsortium"><span>@L["Grants:DataField:ConsortiumPartner"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileConsortium">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="true">@L["Grants:Sources:Active"]</option>
                            <option value="false">@L["Grants:Sources:Chip:Passive"]</option>
                        </select>
                    </div>
                </div>

                <div class="apya-param-grid apya-param-grid--4">
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Nace"]</span></label>
                        <div class="apya-tag-input" data-kind="3"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Sector"]</span></label>
                        <div class="apya-tag-input" data-kind="0"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Region"]</span></label>
                        <div class="apya-tag-input" data-kind="1"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Keyword"]</span></label>
                        <div class="apya-tag-input" data-kind="2"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                </div>

                <button id="SaveProfileBtn" class="btn btn-sm btn-primary align-self-start">
                    <i class="fa fa-save me-1"></i>@L["Grants:Sources:Save"]
                </button>
            </div>
        </section>

        @* --- Kart akışı --- *@
        <div id="FeedGrid" class="apya-skel-cards apya-feed-grid"></div>
        <div id="FeedEmpty" class="d-none">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-wand-magic-sparkles", Title = "Şu an size uygun açık çağrı yok.", Description = "Profilinizi tamamlayın ya da tüm açık hibeleri inceleyin." }' />
        </div>
        <div id="BookmarkEmpty" class="d-none">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-bookmark", Title = "Henüz takip ettiğiniz çağrı yok.", Description = "Katalogda yer imi simgesine basarak çağrı takip edebilirsiniz." }' />
        </div>

        @* --- Başvurularım --- *@
        <h5 class="fw-bold mb-3 mt-4"><i class="fa fa-file-signature me-2"></i>Başvurularım</h5>
        <div id="AppsList" class="d-flex flex-column gap-2"></div>
        <div id="AppsEmpty" class="text-muted small d-none">Henüz başvurunuz yok.</div>
    </div>
}
