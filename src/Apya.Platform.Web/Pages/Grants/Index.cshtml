@page
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Web.Pages.Shared
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Grants.IndexModel
@{
    ViewBag.Title = Model.IsHost ? L["Grants:Calls:Title"].Value : "Hibeler";
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    @if (Model.IsHost)
    {
        <abp-style src="/Pages/Grants/Calls.css" />
    }
    else
    {
        <abp-style src="/Pages/Grants/Tenant.css" />
    }
}

@section scripts {
    <abp-script src="/Pages/Grants/Poster.js" />
    @if (Model.IsHost)
    {
        <abp-script src="/Pages/Grants/Index.js" />
    }
    else
    {
        <abp-script src="/Pages/Grants/Tenant.js" />
    }
}

@if (Model.IsHost)
{
    @* 21a/22 · Host Çağrılar. Kart = çağrı + programı. Sekmeler Yayında · Taslak · Kaynaklar (ayrı
       sayfa, aynı başlık); "Kapanmış" sekme değil süzgeç. Program oluşturma Elle hibe gir'de (/Grants/Import),
       düzenleme Parametreler'de — eski program penceresi kaldırıldı. Kartları Index.js boyar. *@
    <div data-page-description="@L["Grants:Calls:Description"]" class="apya-page apya-grant-scope" data-call-tab="@Model.Tab">
        <div class="apya-page-head">
            <div class="apya-page-head-actions d-flex align-items-center gap-2">
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Grants.Create))
                {
                    <a href="/Grants/Import" class="btn btn-outline-secondary">
                        <i class="fa fa-pen-to-square me-1"></i>@L["Grants:Sources:ManualEntry"]
                    </a>
                }
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Grants.Edit))
                {
                    <button type="button" id="ScrapeAllBtn" class="btn btn-primary">
                        <i class="fa fa-rotate me-1"></i>@L["Grants:Sources:ScrapeAll"]
                    </button>
                }
            </div>
        </div>

        <div class="apya-req-bar">
            <partial name="_CallTabs" model="Model.Tab" />
            <div class="apya-req-filters">
                <select class="form-select" id="IssuerFilter" aria-label="@L["Grants:Calls:Filter:Issuer"]">
                    <option value="">@L["Grants:Calls:Filter:AllIssuers"]</option>
                </select>
                <select class="form-select apya-call-live-only" id="StateFilter" aria-label="@L["Grants:Calls:Filter:State"]">
                    <option value="open">@L["Grants:Calls:Filter:Open"]</option>
                    <option value="closed">@L["Grants:Calls:Filter:Closed"]</option>
                </select>
                <select class="form-select" id="SortFilter" aria-label="@L["Grants:Calls:Filter:Sort"]">
                    <option value="0">@L["Grants:Calls:Sort:Deadline"]</option>
                    <option value="1">@L["Grants:Calls:Sort:Newest"]</option>
                    <option value="2">@L["Grants:Calls:Sort:Name"]</option>
                </select>
                <div class="apya-req-views" role="group" aria-label="@L["Grants:Calls:Views"]">
                    <button type="button" class="apya-req-view is-active" data-view="cards" aria-pressed="true"
                            title="@L["Grants:Calls:View:Cards"]" aria-label="@L["Grants:Calls:View:Cards"]">
                        <i class="fa fa-grip" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="apya-req-view" data-view="list" aria-pressed="false"
                            title="@L["Grants:Calls:View:List"]" aria-label="@L["Grants:Calls:View:List"]">
                        <i class="fa fa-list" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="CallGrid" class="apya-feed-grid apya-call-grid apya-skel-cards" data-cols="3"></div>

        <section id="CallList" class="card mb-0 apya-call-list d-none">
            <div class="apya-call-row apya-call-head" aria-hidden="true">
                <span>@L["Grants:Calls:Col:Program"]</span>
                <span>@L["Grants:Calls:Col:Deadline"]</span>
                <span>@L["Grants:Calls:Col:Amount"]</span>
                <span>@L["Grants:Calls:Col:Reach"]</span>
                <span></span>
            </div>
            <div id="CallRows"></div>
        </section>

        <p id="CallEmpty" class="apya-src-empty d-none"></p>
    </div>

    @* ---- Çağrı (GrantCall) modalı ---- *@
    <div class="modal fade" id="CallModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="CallForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="CallModalTitle">Yeni Çağrı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="CallId" />
                        <input type="hidden" id="CallGrantId" />
                        <div class="mb-3">
                            <label class="form-label" for="CallPeriod">Dönem (örn. 2025/1)</label>
                            <input type="text" class="form-control" id="CallPeriod" maxlength="32" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="CallStatus">Durum</label>
                            @* Taslak seçeneği ŞART: yoksa taslak çağrı bu pencereden düzenlenince select ilk
                               seçeneğe düşer ve çağrı sessizce "Planlandı" olarak kaydedilirdi. *@
                            <select class="form-select" id="CallStatus">
                                <option value="3">@L["Grants:Calls:State:Draft"]</option>
                                <option value="0">Planlandı</option>
                                <option value="1">Açık</option>
                                <option value="2">Kapandı</option>
                            </select>
                            @* 18b · Kapanış zinciri sabit; host ne olacağını kaydetmeden önce görür. *@
                            <div class="form-text">@L["Grants:CallClose:Hint"]</div>
                        </div>
                        @* Tarih alanlarında abp-data-datepicker="false" ŞART: ABP'nin genel
                           başlatıcısı input[type=date] alanlarını type="text" yapıp değeri tr
                           biçimine ("22.08.2026") çevirir. Index.js ise .val()'i ISO sanıp
                           doğrudan API'ye gönderiyor — çağrı kaydı bu yüzden düşüyordu. *@
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label" for="CallOpenDate">Açılış Tarihi</label>
                                <input type="date" abp-data-datepicker="false" class="form-control" id="CallOpenDate" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label" for="CallDeadline">Son Başvuru Tarihi</label>
                                <input type="date" abp-data-datepicker="false" class="form-control" id="CallDeadline" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-1">
                                <label class="form-label" for="CallBudget">Bütçe (₺)</label>
                                <input type="number" step="0.01" class="form-control" id="CallBudget" data-money-input="true" />
                            </div>
                            <div class="col-6 mb-1">
                                <label class="form-label" for="CallReference">Referans No</label>
                                <input type="text" class="form-control" id="CallReference" maxlength="64" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-1"></i>Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}
else
{
    @* 1d · Kiracı: Uygun Hibeler. Başlık + açıklama app header'da. *@
    <div data-page-description="Profilinize uygun açık hibe çağrıları ve başvurularınız" class="apya-page apya-grant-scope">

        @* 10c/13a · Başlık cümlesi: kaç uygun çağrı, en yakın son tarih hangi kartta.
           11c · KPI kartları KALDIRILDI: "Onaylanan 2 · Tahsil 3,4M" firma için karar değiştirmiyor. *@
        <div class="apya-feed-head-block">
            <h2 class="apya-feed-heading apya-skel-num" id="FeedHeading"></h2>
            <p class="apya-feed-lead" id="FeedLead"></p>
        </div>

        <div class="apya-feed-top">
            @* --- Profil kartı --- *@
            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span class="apya-overline">@L["Grants:Feed:Profile:Title"]</span>
                        <span class="apya-chip apya-chip-warning d-none" id="ProfileMissingChip"></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="apya-numeric fw-bold fs-5" id="ProfileCompleteText">—</span>
                    </div>
                    <div class="apya-mini-bar"><span id="ProfileBar" style="width:0"></span></div>
                    <div class="small text-muted" id="ProfileGain"></div>
                    <button type="button" id="ProfileToggleBtn" class="btn btn-sm btn-outline-secondary align-self-start">
                        <i class="fa fa-id-card-clip me-1"></i>@L["Grants:Feed:Profile:Cta"]
                    </button>
                </div>
            </section>

            @* 19a · Çağrı beklemeden proje fikri — Fikir Havuzu'na düşer, uygun çağrı açılınca danışman eşleştirir. *@
            <section class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Idea:FeedCard:Title"]</span>
                    <p class="apya-feed-idea-text mb-0">@L["Grants:Idea:FeedCard:Text"]</p>
                    <a href="/Grants/Idea" class="btn btn-sm btn-outline-primary align-self-start mt-auto">
                        <i class="fa fa-lightbulb me-1" aria-hidden="true"></i>@L["Grants:Idea:Share"]
                    </a>
                </div>
            </section>

        </div>

        @* --- Profil editörü (katlanır) --- *@
        <section class="card d-none" id="ProfileEditor">
            <div class="card-body d-flex flex-column gap-3">
                <div class="fw-bold"><i class="fa fa-id-card-clip me-2"></i>@L["Grants:Feed:Profile:Title"]</div>
                @* Hiç kaydedilmemiş profil kurum profilinden önerilir; kayıt olmadan eşleşmeye girmez. *@
                <div class="alert alert-info small mb-0 d-none" id="ProfileSuggestedNote" role="status">
                    <i class="fa fa-wand-magic-sparkles me-2" aria-hidden="true"></i>@L["Grants:Feed:Profile:Suggested"]
                </div>

                <div class="apya-param-grid apya-param-grid--4">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileOrgType"><span>@L["Grants:DataField:OrganizationType"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileOrgType">
                            <option value="0">@L["Grants:OrgType:Sirket"]</option>
                            <option value="1">@L["Grants:OrgType:Dernek"]</option>
                            <option value="2">@L["Grants:OrgType:Kulup"]</option>
                            <option value="3">@L["Grants:OrgType:Vakif"]</option>
                            <option value="4">@L["Grants:OrgType:Federasyon"]</option>
                        </select>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileFoundedOn"><span>@L["Grants:DataField:FoundedOn"]</span></label>
                        <input type="date" abp-data-datepicker="false" class="form-control form-control-sm apya-numeric" id="ProfileFoundedOn" />
                    </div>
                </div>

                @* --- Şirket alanları --- *@
                <div class="apya-param-grid apya-param-grid--4" data-org-group="company">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileSize"><span>@L["Grants:Parameters:CompanySizes"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileSize">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="1">@L["Grants:Size:Mikro"]</option>
                            <option value="2">@L["Grants:Size:Kucuk"]</option>
                            <option value="4">@L["Grants:Size:Orta"]</option>
                            <option value="8">@L["Grants:Size:Buyuk"]</option>
                        </select>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileStaff"><span>@L["Grants:DataField:StaffCount"]</span></label>
                        <input type="number" min="0" class="form-control form-control-sm apya-numeric" id="ProfileStaff" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileRdStaff"><span>@L["Grants:DataField:RdStaff"]</span></label>
                        <input type="number" min="0" class="form-control form-control-sm apya-numeric" id="ProfileRdStaff" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileRevenue"><span>@L["Grants:DataField:Revenue"]</span></label>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm apya-numeric" id="ProfileRevenue" data-money-input="true" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileTrl"><span>@L["Grants:DataField:Trl"]</span></label>
                        <input type="number" min="1" max="9" class="form-control form-control-sm apya-numeric" id="ProfileTrl" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileConsortium"><span>@L["Grants:DataField:ConsortiumPartner"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileConsortium">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="true">@L["Grants:Sources:Active"]</option>
                            <option value="false">@L["Grants:Sources:Chip:Passive"]</option>
                        </select>
                    </div>
                </div>

                @* --- STK alanları --- *@
                <div class="apya-param-grid apya-param-grid--4 d-none" data-org-group="ngo">
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileRegistryNo"><span>@L["Grants:DataField:RegistryNumber"]</span></label>
                        <input type="text" maxlength="64" class="form-control form-control-sm" id="ProfileRegistryNo" placeholder="@L["Grants:DataFieldHint:RegistryNumber"]" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileTaxNo"><span>@L["Grants:DataField:TaxNumber"]</span></label>
                        <input type="text" maxlength="16" class="form-control form-control-sm apya-numeric" id="ProfileTaxNo" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileTaxOffice"><span>@L["Grants:DataField:TaxOffice"]</span></label>
                        <input type="text" maxlength="128" class="form-control form-control-sm" id="ProfileTaxOffice" />
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileStaffBand"><span>@L["Grants:DataField:StaffBand"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileStaffBand">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="1">@L["Grants:StaffBand:BirUc"]</option>
                            <option value="2">@L["Grants:StaffBand:DortOn"]</option>
                            <option value="3">@L["Grants:StaffBand:OnBirYirmiBes"]</option>
                            <option value="4">@L["Grants:StaffBand:YirmiBesUstu"]</option>
                        </select>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label" for="ProfileExperience"><span>@L["Grants:DataField:ProjectExperience"]</span></label>
                        <select class="form-select form-select-sm" id="ProfileExperience">
                            <option value="">@L["Grants:Detail:NotEntered"]</option>
                            <option value="0">@L["Grants:Experience:Yok"]</option>
                            <option value="1">@L["Grants:Experience:BirUc"]</option>
                            <option value="2">@L["Grants:Experience:DortOn"]</option>
                            <option value="3">@L["Grants:Experience:OnBirYirmiBes"]</option>
                            <option value="4">@L["Grants:Experience:YirmiBesUstu"]</option>
                        </select>
                    </div>
                </div>

                @* Tematik alan sabit listeden seçilir: host da program tarafında aynı
                   listeden hedefler, iki taraf aynı anahtarı yazınca eşleşme birebir tutar. *@
                <div class="apya-field d-none" data-org-group="ngo">
                    <label class="apya-field-label"><span>@L["Grants:Parameters:Thematic"]</span></label>
                    <div class="apya-choice-row" id="ProfileThematic">
                        @foreach (var area in Enum.GetNames<Apya.Platform.Grants.GrantThematicArea>())
                        {
                            <button type="button" class="apya-choice" data-area="@area">@L["Grants:Thematic:" + area]</button>
                        }
                    </div>
                </div>

                <div class="apya-param-grid apya-param-grid--4">
                    <div class="apya-field" data-org-group="company">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Nace"]</span></label>
                        <div class="apya-tag-input" data-kind="3"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field" data-org-group="company">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Sector"]</span></label>
                        <div class="apya-tag-input" data-kind="0"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Region"]</span></label>
                        <div class="apya-tag-input" data-kind="1"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                    <div class="apya-field">
                        <label class="apya-field-label"><span>@L["Grants:Parameters:Keyword"]</span></label>
                        <div class="apya-tag-input" data-kind="2"><span class="apya-tag-chips"></span><input type="text" class="form-control apya-tag-entry" placeholder="@L["Grants:Parameters:TagPlaceholder"]" /></div>
                    </div>
                </div>

                <button id="SaveProfileBtn" class="btn btn-sm btn-primary align-self-start">
                    <i class="fa fa-save me-1"></i>@L["Grants:Sources:Save"]
                </button>
            </div>
        </section>

        @* --- 13 · Üç sekmede aynı kart: Size uygun (2 kolon) · Tüm açık hibeler (3 kolon) · Takip ettiklerim --- *@
        <div class="apya-feed-bar">
            <div class="apya-tenant-tabs mb-0" role="tablist">
                <button type="button" class="apya-tenant-tab is-active" role="tab" data-tab="eligible">
                    @L["Grants:Feed:Tab:Eligible"]<span class="apya-chip apya-chip-accent apya-numeric" id="TabCountEligible">—</span>
                </button>
                <button type="button" class="apya-tenant-tab" role="tab" data-tab="all">
                    @L["Grants:Feed:Tab:All"]<span class="apya-chip apya-chip-neutral apya-numeric" id="TabCountAll">—</span>
                </button>
                <button type="button" class="apya-tenant-tab" role="tab" data-tab="bookmarked">
                    @L["Grants:Feed:Tab:Bookmarked"]<span class="apya-chip apya-chip-neutral apya-numeric" id="TabCountBookmarked">—</span>
                </button>
            </div>
            <div class="apya-feed-bar-right">
                <span class="apya-feed-sort" id="FeedSortLabel"></span>
                <a href="/Grants/Catalog" class="btn btn-sm btn-outline-secondary" id="FeedTableLink" title="@L["Grants:Feed:TableView"]">
                    <i class="fa fa-list me-1"></i>@L["Grants:Feed:TableView"]
                </a>
            </div>
        </div>

        @* 12a · Tüm açık hibeler: kova sayısı tek satır — uygun olmayan gizlenmez, soluk durur. *@
        <div class="apya-feed-buckets d-none" id="FeedBuckets"></div>

        @* 13b · Takip ettiklerim: bildirim vaadi tek cümle. *@
        <p class="apya-feed-note d-none" id="BookmarkHint">@L["Grants:Feed:Bookmark:Hint"]</p>

        <div id="FeedGrid" class="apya-skel-cards apya-feed-grid" data-cols="2"></div>

        @* 13a · Eşiğin altındaki çağrılar gizlenmez; kart akışının altında tek cümleyle çağrılır. *@
        <div class="apya-feed-more d-none" id="FeedMore">
            <i class="fa fa-list"></i>
            <span id="FeedMoreText"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="FeedMoreBtn">@L["Grants:Feed:More:Cta"]</button>
        </div>

        <div id="FeedEmpty" class="d-none">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-wand-magic-sparkles", Title = "Şu an size uygun açık çağrı yok.", Description = "Profilinizi tamamlayın ya da tüm açık hibeleri inceleyin." }' />
        </div>
        <div id="BookmarkEmpty" class="d-none">
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-bookmark", Title = "Henüz takip ettiğiniz çağrı yok.", Description = "Herhangi bir kartın köşesindeki yer imiyle takibe alabilirsiniz; danışmanınız da sizin adınıza işaretleyebilir." }' />
        </div>

        @* 13b · Takip notu — kartın köşesindeki kalemle açılır. Modal sayfa kabının dışında; kapsam sınıfı kendisinde. *@
        <div class="modal fade apya-grant-scope" id="BookmarkNoteModal" tabindex="-1" aria-hidden="true" aria-labelledby="BookmarkNoteTitle">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form id="BookmarkNoteForm">
                        <div class="modal-header">
                            <h5 class="modal-title" id="BookmarkNoteTitle">@L["Grants:Feed:Bookmark:NoteTitle"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                        </div>
                        <div class="modal-body d-flex flex-column gap-2">
                            <div class="fw-semibold" id="BookmarkNoteCall"></div>
                            <label class="form-label mb-0" for="BookmarkNoteText">@L["Grants:Feed:Bookmark:NoteLabel"]</label>
                            <textarea class="form-control" id="BookmarkNoteText" rows="3" maxlength="500"></textarea>
                            <div class="small text-muted">@L["Grants:Feed:Bookmark:NoteHint"]</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Sources:Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@L["Grants:Feed:Bookmark:NoteSave"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* --- Başvurularım --- *@
        <h5 class="fw-bold mb-3 mt-4"><i class="fa fa-file-signature me-2"></i>Başvurularım</h5>
