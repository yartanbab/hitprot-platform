@page
@using Apya.Platform.Localization
@using Apya.Platform.Web.Pages.Shared
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.SourcesModel
@{
    ViewBag.Title = L["Grants:Sources:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Sources.css" />
}

@section scripts {
    <abp-script src="/Pages/Grants/Sources.js" />
}

@* Başlık + açıklama app header'da; sayfa içinde tekrarlanmıyor. *@
<div data-page-description="@L["Grants:Sources:Description"]" class="apya-page apya-grant-scope">
    <div class="apya-page-head">
        <div class="apya-page-head-actions d-flex align-items-center gap-2">
            <a href="/Grants" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i>@L["Grants:Parameters:BackToPrograms"]
            </a>
            <a href="/Grants/Import" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-pen-to-square me-1"></i>@L["Grants:Sources:ManualEntry"]
            </a>
            <button type="button" id="ScrapeAllBtn" class="btn btn-sm btn-primary">
                <i class="fa fa-rotate me-1"></i>@L["Grants:Sources:ScrapeAll"]
            </button>
        </div>
    </div>

    <div class="apya-src-note">
        <i class="fa fa-circle-info"></i><span>@L["Grants:Sources:Note"]</span>
    </div>

    <div class="apya-src-kpis">
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-globe", Accent = "brand", Label = L["Grants:Sources:Kpi:ActiveSources"].Value, ValueId = "KpiActiveSources", Value = "—" }' />
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-inbox", Accent = "warning", Label = L["Grants:Sources:Kpi:DraftQueue"].Value, ValueId = "KpiDraftQueue", Value = "—" }' />
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-bullhorn", Accent = "accent", Label = L["Grants:Sources:Kpi:PublishedCalls"].Value, ValueId = "KpiPublishedCalls", Value = "—" }' />
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-clock-rotate-left", Accent = "ai", Label = L["Grants:Sources:Kpi:ChangedThisWeek"].Value, ValueId = "KpiChangedThisWeek", Value = "—" }' />
    </div>

    <div class="apya-src-layout">

        @* ---------- Sol: kaynak listesi ---------- *@
        <section class="card mb-0 apya-src-list">
            <div class="card-body d-flex flex-column gap-2">
                <div class="apya-overline">@L["Grants:Sources:List"]</div>
                <div id="SourceList" class="d-flex flex-column gap-1"></div>
                <div id="SourceListEmpty" class="apya-src-empty d-none">
                    <div class="fw-semibold">@L["Grants:Sources:Empty"]</div>
                    <div class="small">@L["Grants:Sources:EmptyHint"]</div>
                </div>

                <button type="button" id="SourceAddBtn" class="apya-src-add">
                    <i class="fa fa-plus"></i>@L["Grants:Sources:Add"]
                </button>

                <div id="SourceForm" class="apya-src-form d-none">
                    <input type="text" id="SourceName" class="form-control form-control-sm"
                           maxlength="96" placeholder="@L["Grants:Sources:NamePlaceholder"]" />
                    <input type="url" id="SourceUrl" class="form-control form-control-sm apya-numeric"
                           maxlength="512" placeholder="@L["Grants:Sources:UrlPlaceholder"]" />
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="SourceActive" checked />
                        <label class="form-check-label small" for="SourceActive">@L["Grants:Sources:Active"]</label>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" id="SourceSaveBtn" class="btn btn-sm btn-primary">@L["Grants:Sources:Save"]</button>
                        <button type="button" id="SourceCancelBtn" class="btn btn-sm btn-link text-secondary">@L["Grants:Sources:Cancel"]</button>
                        <button type="button" id="SourceDeleteBtn" class="btn btn-sm btn-link text-danger ms-auto d-none">@L["Grants:Sources:Delete"]</button>
                    </div>
                </div>
            </div>
        </section>

        @* ---------- Sağ: taslak kuyruğu ---------- *@
        <section class="card mb-0">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <div class="fw-bold">@L["Grants:Sources:Queue"]</div>
                    <span class="apya-chip apya-chip-warning" id="QueueCount"></span>
                </div>

                <div class="apya-queue-table">
                    <div class="apya-queue-row apya-queue-head">
                        <span>@L["Grants:Sources:Col:Call"]</span>
                        <span>@L["Grants:Sources:Col:Period"]</span>
                        <span>@L["Grants:Sources:Col:Deadline"]</span>
                        <span class="text-end">@L["Grants:Sources:Col:Amount"]</span>
                        <span>@L["Grants:Sources:Col:Confidence"]</span>
                        <span></span>
                    </div>
                    <div id="DraftQueue"></div>
                    <div id="DraftQueueEmpty" class="apya-src-empty d-none">
                        <div class="fw-semibold">@L["Grants:Sources:QueueEmpty"]</div>
                        <div class="small">@L["Grants:Sources:QueueEmptyHint"]</div>
                    </div>
                </div>

                <div class="small text-muted">@L["Grants:Sources:ConfidenceNote"]</div>
            </div>
        </section>
    </div>
</div>
