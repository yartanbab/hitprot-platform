@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.AppealModel
@{
    ViewBag.Title = L["Grants:Appeal:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Appeal.css" />
}

@section scripts {
    <abp-script src="/Pages/Grants/Appeal.js" />
}

<div data-page-description="@L["Grants:Appeal:Description"]" class="apya-page" data-application-id="@Model.Id">

    @* ---------- Karar barı ---------- *@
    <div class="card mb-0 apya-ap-head d-none" id="DecisionBar">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <span class="apya-ap-badge"><i class="fa fa-circle-xmark"></i></span>
            <div class="flex-fill min-w-0">
                <div class="fw-bold" id="DecisionTitle"></div>
                <div class="apya-ap-meta apya-numeric" id="DecisionMeta"></div>
            </div>
            <div class="d-flex flex-column align-items-end gap-1">
                <span class="apya-field-label"><span>@L["Grants:Appeal:Window"]</span></span>
                <span class="apya-ap-countdown apya-numeric" id="Countdown">—</span>
            </div>
            <button type="button" class="btn btn-sm btn-primary d-none" id="SubmitAppealBtn">
                <i class="fa fa-gavel me-1"></i>@L["Grants:Appeal:Submit"]
            </button>
        </div>
    </div>

    @* Karar henüz girilmemişse ekran boş kalmaz: ne yapılacağını söyler. *@
    <div class="apya-src-empty d-none" id="NoDecision">
        <div class="fw-semibold">@L["Grants:Appeal:NoDecision"]</div>
        <div class="small" id="NoDecisionHint"></div>
    </div>

    <div class="apya-ap-layout">
        <section class="card mb-0">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <div>
                        <div class="fw-bold">@L["Grants:Appeal:Reasons"]</div>
                        <div class="apya-ap-hint">@L["Grants:Appeal:ReasonsHint"]</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="AddItemBtn">
                        <i class="fa fa-plus me-1"></i>@L["Grants:Appeal:AddItem"]
                    </button>
                </div>

                <div id="Items" class="apya-skel-rows d-flex flex-column gap-3"></div>
                <div id="ItemsEmpty" class="apya-src-empty d-none">
                    <div class="fw-semibold">@L["Grants:Appeal:NoItem"]</div>
                    <div class="small">@L["Grants:Appeal:NoItemHint"]</div>
                </div>
            </div>
        </section>

        @* ---------- Sağ panel ---------- *@
        <aside class="apya-ap-side">
            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:File"]</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="apya-ap-metric apya-numeric" id="AppealedCount">0/0</span>
                        <span class="apya-ap-hint">@L["Grants:Appeal:FileHint"]</span>
                    </div>
                    <div id="AcceptedNote" class="apya-ap-hint"></div>
                    <div class="apya-side-note d-none" id="EmptyFileNote">
                        <i class="fa fa-triangle-exclamation mt-1"></i>
                        <span>@L["Grants:Appeal:EmptyFile"]</span>
                    </div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:Stats"]</span>
                    <div id="Stats"></div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:Retry"]</span>
                    <div id="RetryBox"></div>
                    <div class="apya-ap-hint">@L["Grants:Appeal:HistoryNote"]</div>
                </div>
            </div>
        </aside>
    </div>
</div>
