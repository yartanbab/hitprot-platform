@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.AppealModel
@{
    ViewBag.Title = L["Grants:Appeal:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Appeal.css" />
}

@section scripts {
    @* Durum rozetlerinin tek kaynağı — sayfa JS'i apyaGrantStatus olarak okur. *@
    <partial name="_StatusMap" />
    <abp-script src="/Pages/Grants/Appeal.js" />
}

<div data-page-description="@L["Grants:Appeal:Description"]" class="apya-page apya-grant-scope" data-application-id="@Model.Id">

    @* ---------- Karar barı ---------- *@
    <div class="card mb-0 apya-ap-head d-none" id="DecisionBar">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <span class="apya-ap-badge" id="DecisionBadge"><i class="fa fa-circle-xmark" id="DecisionIcon"></i></span>
            <div class="flex-fill min-w-0">
                <div class="fw-bold" id="DecisionTitle"></div>
                <div class="apya-ap-meta apya-numeric" id="DecisionMeta"></div>
            </div>
            @* İtiraz penceresi yalnız red kararında anlamlı; onayda "süre doldu" yazmasın. *@
            <div class="d-flex flex-column align-items-end gap-1" id="WindowBox">
                <span class="apya-field-label"><span>@L["Grants:Appeal:Window"]</span></span>
                <span class="apya-ap-countdown apya-numeric" id="Countdown">—</span>
            </div>
            @* Kurumun itiraza yanıtı (danışman işler) — istatistiği bu besler. *@
            <div class="d-flex align-items-center gap-2 flex-wrap d-none" id="ResolveBox">
                <span class="apya-ap-hint">@L["Grants:Appeal:Resolve:Question"]</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-accepted="true">
                    <i class="fa fa-check me-1"></i>@L["Grants:Appeal:Resolve:Accepted"]
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-accepted="false">
                    <i class="fa fa-xmark me-1"></i>@L["Grants:Appeal:Resolve:Rejected"]
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-primary d-none" id="SubmitAppealBtn">
                <i class="fa fa-gavel me-1"></i>@L["Grants:Appeal:Submit"]
            </button>
        </div>
    </div>

    @* Karar henüz girilmemişse ekran boş kalmaz: ne yapılacağını söyler. *@
    <div class="apya-src-empty d-none" id="NoDecision">
        <div class="fw-semibold">@L["Grants:Appeal:NoDecision"]</div>
        <div class="small" id="NoDecisionHint"></div>
        @* Karar girişinin tek yeri başvuru detayı; buradan oraya, pencere açık gelir. *@
        <a class="btn btn-sm btn-primary mt-2 d-none" id="EnterDecisionLink" href="/Grants/DetailHost?id=@Model.Id#decision">
            <i class="fa fa-gavel me-1"></i>@L["Grants:Appeal:EnterDecision"]
        </a>
    </div>

    <div class="apya-ap-layout">
        <section class="card mb-0">
            <div class="card-body d-flex flex-column gap-3">
                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <div>
                        <div class="fw-bold">@L["Grants:Appeal:Reasons"]</div>
                        <div class="apya-ap-hint">@L["Grants:Appeal:ReasonsHint"]</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="AddItemBtn">
                        <i class="fa fa-plus me-1"></i>@L["Grants:Appeal:AddItem"]
                    </button>
                </div>

                <div id="Items" class="apya-skel-rows d-flex flex-column gap-3"></div>
                <div id="ItemsEmpty" class="apya-src-empty d-none">
                    <div class="fw-semibold">@L["Grants:Appeal:NoItem"]</div>
                    <div class="small">@L["Grants:Appeal:NoItemHint"]</div>
                </div>
            </div>
        </section>

        @* ---------- Sağ panel ---------- *@
        <aside class="apya-ap-side">
            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:File"]</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="apya-ap-metric apya-numeric" id="AppealedCount">0/0</span>
                        <span class="apya-ap-hint">@L["Grants:Appeal:FileHint"]</span>
                    </div>
                    <div id="AcceptedNote" class="apya-ap-hint"></div>
                    <div class="apya-side-note d-none" id="EmptyFileNote">
                        <i class="fa fa-triangle-exclamation mt-1"></i>
                        <span>@L["Grants:Appeal:EmptyFile"]</span>
                    </div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:Stats"]</span>
                    <div id="Stats"></div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:Appeal:Retry"]</span>
                    <div id="RetryBox"></div>
                    <div class="apya-ap-hint">@L["Grants:Appeal:HistoryNote"]</div>
                </div>
            </div>
        </aside>
    </div>

    @* LIF-12 · Danışman görüşü tek pencerede. İki ardışık istem kutusuydu (karar, sonra
       gerekçe): ikincisinde vazgeçilince ilk seçim de kayboluyor, gerekçe tek satıra
       yazılıyordu. Sınır sunucudakiyle aynı (SaveGrantAppealOpinionInput.Detail). *@
    <div class="modal fade" id="OpinionModal" tabindex="-1" aria-labelledby="OpinionModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="OpinionModalTitle">@L["Grants:Appeal:OpinionModal:Title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Grants:Appeal:OpinionModal:Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div class="fw-semibold mb-3" id="OpinionItemTitle"></div>
                    <div class="mb-3">
                        <label class="form-label" for="OpinionStance">@L["Grants:Appeal:OpinionPrompt"]</label>
                        <select class="form-select" id="OpinionStance">
                            <option value="1">@L["Grants:Appeal:Stance:Itiraz"]</option>
                            <option value="2">@L["Grants:Appeal:Stance:Kabul"]</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="OpinionDetail">@L["Grants:Appeal:OpinionDetailPrompt"]</label>
                        <textarea class="form-control" id="OpinionDetail" rows="6" maxlength="2000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Appeal:OpinionModal:Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="OpinionSaveBtn">@L["Grants:Appeal:OpinionModal:Save"]</button>
                </div>
            </div>
        </div>
    </div>

    @* LIF-12 · İtiraz maddesi: başlık + kurumun ifadesi tek pencerede. Sınırlar sunucudakiyle
       aynı (AddGrantAppealItemInput). *@
    <div class="modal fade" id="ItemModal" tabindex="-1" aria-labelledby="ItemModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ItemModalTitle">@L["Grants:Appeal:AddItem"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Grants:Appeal:OpinionModal:Cancel"]"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="ItemTitle">@L["Grants:Appeal:AddItemPrompt"]</label>
                        <input type="text" class="form-control" id="ItemTitle" maxlength="256" />
                        <div class="invalid-feedback">@L["Grants:Appeal:ItemModal:TitleRequired"]</div>
                    </div>
                    <div>
                        <label class="form-label" for="ItemInstitutionText">@L["Grants:Appeal:ItemModal:InstitutionText"]</label>
                        <textarea class="form-control" id="ItemInstitutionText" rows="5" maxlength="2000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Appeal:OpinionModal:Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="ItemSaveBtn">@L["Grants:Appeal:ItemModal:Save"]</button>
                </div>
            </div>
        </div>
    </div>
</div>
