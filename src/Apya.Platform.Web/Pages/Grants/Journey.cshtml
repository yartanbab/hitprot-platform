@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.JourneyModel
@{
    ViewBag.Title = L["Grants:Journey:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/Journey.css" />
}

@section scripts {
    @* Durum rozetlerinin tek kaynağı — sayfa JS'i apyaGrantStatus olarak okur. *@
    <partial name="_StatusMap" />
    <abp-script src="/Pages/Grants/Journey.js" />
}

@* 18d · Hibe Yolculuğum — firmanın bütün hibe ilişkileri tek zaman çizgisinde. Başvurularım
   tablo olarak kalır; bu ekran "nerede duruyorum" sorusunu cevaplar. Cümleleri JS kurar. *@
<div data-page-description="@L["Grants:Journey:Description"]" class="apya-page apya-grant-scope apya-jny">

    <div class="apya-jny-head">
        <div class="apya-jny-head-text">
            <h2 class="apya-jny-title">@L["Grants:Journey:Heading"]</h2>
            <p class="apya-jny-sub apya-skel-num" id="JourneySub"></p>
        </div>
        <div class="apya-jny-head-side">
            <div class="apya-jny-won d-none" id="JourneyWon">
                <span class="apya-jny-won-label">@L["Grants:Journey:Won"]</span>
                <span class="apya-jny-won-value apya-numeric" id="JourneyWonValue"></span>
            </div>
            @* 19a · Çağrı beklemeden fikir: havuza düşer, bu listede "fikir havuzunda" satırı olur. *@
            <a href="/Grants/Idea" class="btn btn-sm btn-outline-primary">
                <i class="fa fa-lightbulb me-1" aria-hidden="true"></i>@L["Grants:Idea:Share"]
            </a>
        </div>
    </div>

    <ol class="apya-jny-list apya-skel-cards" id="JourneyItems"></ol>

    <div class="card mb-0 d-none" id="JourneyEmpty">
        <div class="card-body apya-jny-empty">
            <i class="fa fa-route"></i>
            <p class="mb-0">@L["Grants:Journey:Empty"]</p>
            <a href="/Grants" class="btn btn-sm btn-primary">@L["Grants:Journey:EmptyCta"]</a>
        </div>
    </div>
</div>

@* 18e · Görüşme saati öner: firma üç saat seçer, danışman birini onaylar. *@
<div class="modal fade apya-grant-scope" id="MeetingModal" tabindex="-1" aria-hidden="true" aria-labelledby="MeetingTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="MeetingForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="MeetingTitle">@L["Grants:Meeting:Propose:Title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Grants:Meeting:Cancel"]"></button>
                </div>
                <div class="modal-body d-flex flex-column gap-3">
                    <div class="fw-semibold" id="MeetingTarget"></div>
                    <p class="apya-jny-meeting-hint mb-0">@L["Grants:Meeting:Propose:Hint", Apya.Platform.Grants.GrantMeetingConsts.DurationMinutes]</p>
                    @for (var slot = 1; slot <= Apya.Platform.Grants.GrantMeetingConsts.SlotCount; slot++)
                    {
                        <div>
                            <label class="form-label mb-1" for="MeetingSlot@(slot)">@L["Grants:Meeting:Propose:Slot", slot]</label>
                            <input type="datetime-local" class="form-control" id="MeetingSlot@(slot)" data-meeting-slot required />
                        </div>
                    }
                    <p class="apya-jny-meeting-error mb-0 d-none" id="MeetingError" role="alert">@L["Grants:Meeting:Propose:Invalid"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Meeting:Cancel"]</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-calendar-plus me-1"></i>@L["Grants:Meeting:Propose:Submit"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
