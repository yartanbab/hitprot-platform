@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Grants.DetailHostModel
@{
    ViewBag.Title = L["Grants:DetailHost:Title"].Value;
}

@section styles {
    <abp-style src="/Pages/Grants/Shared.css" />
    <abp-style src="/Pages/Grants/DetailHost.css" />
}

@section scripts {
    @* Durum rozetlerinin tek kaynağı — sayfa JS'i apyaGrantStatus olarak okur. *@
    <partial name="_StatusMap" />
    <abp-script src="/Pages/Grants/DetailHost.js" />
}

<div data-page-description="@L["Grants:DetailHost:Description"]" class="apya-page apya-grant-scope" data-application-id="@Model.Id">

    @* ---------- Künye ---------- *@
    <div class="card mb-0">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <span class="apya-dh-avatar" id="FirmInitials"></span>
            <div class="flex-fill min-w-0">
                <div class="fw-bold" id="HeaderTitle"></div>
                <div class="apya-dh-meta apya-numeric" id="HeaderMeta"></div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="apya-chip apya-chip-neutral" id="StageChip"></span>
                <span class="apya-chip apya-numeric apya-chip-warning d-none" id="DaysChip"></span>
                <span class="apya-chip apya-numeric apya-chip-accent d-none" id="ScoreChip"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-secondary" id="DocumentsLink">
                    <i class="fa fa-folder-open me-1"></i>@L["Grants:DetailHost:Documents"]
                </a>
                <a class="btn btn-sm btn-outline-secondary" href="/Grants/Convert?id=@Model.Id">
                    <i class="fa fa-wand-magic-sparkles me-1"></i>@L["Grants:Conversion:Title"]
                </a>
                <button type="button" class="btn btn-sm btn-primary" id="AdvanceBtn">
                    <i class="fa fa-forward me-1"></i>@L["Grants:DetailHost:Advance"]
                </button>
            </div>
        </div>
    </div>

    @* ---------- Süreç adımları ---------- *@
    <div class="card mb-0">
        <div class="card-body">
            <div class="apya-dh-steps" id="Steps"></div>
            <div class="apya-dh-hint d-none" id="NoTemplate">@L["Grants:DetailHost:NoTemplate"]</div>
        </div>
    </div>

    <div class="apya-dh-layout">
        <section class="d-flex flex-column gap-3">

            @* Form durumu — alan bazlı sahiplik *@
            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span class="apya-overline">@L["Grants:DetailHost:FormState"]</span>
                        <span class="apya-dh-hint">@L["Grants:DetailHost:FormStateHint"]</span>
                    </div>
                    <div id="Sections"></div>
                </div>
            </div>

            @* Süreç akışı — mesaj + evrak + aşama *@
            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span class="apya-overline">@L["Grants:DetailHost:Feed"]</span>
                        <div class="apya-choice-row">
                            <button type="button" class="apya-choice is-on" data-channel="all">@L["Grants:DetailHost:Feed:All"]</button>
                            <button type="button" class="apya-choice" data-channel="1">@L["Grants:DetailHost:Feed:Documents"]</button>
                            <button type="button" class="apya-choice" data-channel="0">@L["Grants:DetailHost:Feed:Messages"]</button>
                            <button type="button" class="apya-choice" data-channel="2">@L["Grants:DetailHost:Feed:Stages"]</button>
                        </div>
                    </div>

                    <div id="Feed" class="apya-dh-feed"></div>

                    <div class="apya-dh-compose">
                        <input type="text" class="form-control form-control-sm" id="MessageBody"
                               maxlength="1000" placeholder="@L["Grants:DetailHost:MessagePlaceholder"]" />
                        <button type="button" class="btn btn-sm btn-outline-primary" id="SendMessageBtn">
                            <i class="fa fa-paper-plane me-1"></i>@L["Grants:DetailHost:Send"]
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @* ---------- Sağ panel ---------- *@
        <aside class="apya-dh-side">
            @* Kurum kararı: karar girişinin tek yeri. Red kararında gerekçe ve itiraz Appeal ekranında. *@
            <div class="card mb-0" id="decision">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span class="apya-overline">@L["Grants:Decision:Title"]</span>
                        <span class="apya-chip d-none" id="DecisionChip"></span>
                    </div>
                    <div class="apya-dh-hint d-none" id="DecisionNone">@L["Grants:Decision:None"]</div>
                    <div class="apya-dh-section-note apya-numeric d-none" id="DecisionMeta"></div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="DecisionBtn" disabled>
                            <i class="fa fa-gavel me-1"></i><span id="DecisionBtnText">@L["Grants:Decision:Enter"]</span>
                        </button>
                        <a class="btn btn-sm btn-outline-secondary d-none" id="DecisionAppealLink" href="/Grants/Appeal?id=@Model.Id">
                            @L["Grants:Decision:OpenAppeal"]
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:DetailHost:Tranches"]</span>
                    <div id="Tranches" class="d-flex flex-column gap-2"></div>
                    <div class="apya-dh-hint">@L["Grants:DetailHost:TranchesHint"]</div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-2">
                    <span class="apya-overline">@L["Grants:DetailHost:Milestones"]</span>
                    <div id="Milestones" class="d-flex flex-column gap-2"></div>
                </div>
            </div>

            <div class="card mb-0">
                <div class="card-body d-flex flex-column gap-3">
                    <span class="apya-overline">@L["Grants:DetailHost:Consulting"]</span>
                    <div class="apya-dh-consulting">
                        <div>
                            <span class="apya-field-label"><span>@L["Grants:DetailHost:Hours"]</span></span>
                            <span class="apya-dh-metric apya-numeric" id="TotalHours">0</span>
                        </div>
                        <div>
                            <span class="apya-field-label"><span>@L["Grants:DetailHost:SuccessFee"]</span></span>
                            <span class="apya-dh-metric apya-numeric" id="SuccessFee">—</span>
                        </div>
                        <div>
                            <span class="apya-field-label"><span>@L["Grants:DetailHost:Revenue"]</span></span>
                            <span class="apya-dh-metric apya-dh-metric--good apya-numeric" id="Revenue">—</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" id="AddHoursBtn">
                            <i class="fa fa-clock me-1"></i>@L["Grants:DetailHost:AddHours"]
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" id="SetFeeBtn">
                            <i class="fa fa-percent me-1"></i>@L["Grants:DetailHost:SetFee"]
                        </button>
                    </div>
                    <div id="Logs" class="d-flex flex-column gap-2"></div>
                </div>
            </div>
        </aside>
    </div>
</div>

@* ---- Kurum kararı ---- *@
<div class="modal fade apya-grant-scope" id="DecisionModal" tabindex="-1" aria-hidden="true" aria-labelledby="DecisionModalTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="DecisionForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="DecisionModalTitle">@L["Grants:Decision:Title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body d-flex flex-column gap-3">
                    @* Varsayılan seçim YOK: yanlışlıkla "Reddedildi" kaydetmek firmaya kapatılamayan bir bildirim gönderir. *@
                    <div>
                        <label class="form-label" for="DecisionOutcome">@L["Grants:Decision:Outcome"]</label>
                        <select class="form-select" id="DecisionOutcome" required>
                            <option value="" disabled selected>@L["Grants:Decision:OutcomePlaceholder"]</option>
                            <option value="1">@L["Grants:Decision:Outcome:Onaylandi"]</option>
                            <option value="2">@L["Grants:Decision:Outcome:KismiOnay"]</option>
                            <option value="0">@L["Grants:Decision:Outcome:Reddedildi"]</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        @* abp-data-datepicker="false" ŞART: ABP başlatıcısı type=date'i metne çevirip değeri tr biçimine sokar. *@
                        <div class="col-sm-6">
                            <label class="form-label" for="DecisionDecidedOn">@L["Grants:Decision:DecidedOn"]</label>
                            <input type="date" abp-data-datepicker="false" class="form-control" id="DecisionDecidedOn" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="DecisionReference">@L["Grants:Decision:ReferenceNo"]</label>
                            <input type="text" class="form-control" id="DecisionReference" maxlength="64"
                                   aria-describedby="DecisionReferenceHint" />
                            <div class="form-text" id="DecisionReferenceHint">@L["Grants:Decision:ReferenceNoHint"]</div>
                        </div>
                    </div>
                    <div class="d-none" id="DecisionAppealField">
                        <label class="form-label" for="DecisionAppealDeadline">@L["Grants:Decision:AppealDeadline"]</label>
                        <input type="date" abp-data-datepicker="false" class="form-control" id="DecisionAppealDeadline"
                               aria-describedby="DecisionAppealHint" />
                        <div class="form-text" id="DecisionAppealHint">@L["Grants:Decision:AppealDeadlineHint"]</div>
                    </div>
                    <div class="apya-side-note">
                        <i class="fa fa-bell mt-1"></i>
                        <span>@L["Grants:Decision:NotifyNote"]</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Grants:Sources:Cancel"]</button>
                    <button type="submit" class="btn btn-primary" id="DecisionSaveBtn">
                        <i class="fa fa-save me-1"></i>@L["Grants:Decision:Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
