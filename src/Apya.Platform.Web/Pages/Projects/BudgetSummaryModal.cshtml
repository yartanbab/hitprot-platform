@page
@model Apya.Platform.Web.Pages.Projects.BudgetSummaryModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
    var b = Model.Budget;
    var barTone = b.IsOverBudget ? "is-negative" : (b.BudgetUsagePercent >= 80 ? "is-warning" : "is-positive");
    var cur = b.Currency;
}
<abp-modal size="Large">
    <abp-modal-header title="@($"Bütçe Durumu — {b.ProjectName}")"></abp-modal-header>
    <abp-modal-body>
        @* Finans → Genel sekmesiyle AYNI şerit, aynı hesap. *@
        <partial name="_ProjectBudgetKpis" model="b" />

        <label class="small text-muted">Bütçe Kullanımı: <span class="apya-numeric">%@b.BudgetUsagePercent</span></label>
        <div class="apya-mini-progress @barTone mb-2" style="height:10px"><span style="width:@(Math.Min(b.BudgetUsagePercent, 100))%"></span></div>

        @if (b.IsOverBudget)
        {
            <div class="alert alert-danger py-2">
                <strong>⚠ Bütçe aşıldı!</strong>
                <span class="apya-numeric">Aşım: @((b.SpentAmount - b.ApprovedBudget).ToString("N2")) @cur</span>
            </div>
        }

        @if (b.TaskBreakdown.Any(t => t.TaskId.HasValue))
        {
            <h6 class="mt-3">Görev Bazlı Kırılım</h6>
            <div class="table-responsive">
            <table class="table table-sm apya-clean-table">
                <thead><tr><th>Görev</th><th class="text-end apya-numeric">Gider</th><th class="text-end apya-numeric">Gelir</th></tr></thead>
                <tbody>
                @foreach (var t in b.TaskBreakdown.OrderByDescending(x => x.Expense))
                {
                    <tr>
                        <td>@(t.TaskId.HasValue ? (t.TaskName ?? t.TaskId.ToString()![..8] + "…") : "(Proje geneli)")</td>
                        <td class="text-end apya-numeric">@t.Expense.ToString("N2")</td>
                        <td class="text-end apya-numeric">@t.Income.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }

        <a class="small text-decoration-none"
           href="/Finance?projectId=@b.ProjectId&tab=@Apya.Platform.Web.Pages.Finance.FinanceContext.TabOverview">
            Finans çatısında aç →
        </a>
    </abp-modal-body>
    <abp-modal-footer buttons="@(AbpModalButtons.Close)"></abp-modal-footer>
</abp-modal>
