@page
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Projects.IndexModel
@{
    ViewBag.Title = "Projeler";
}

@section scripts {
    <abp-script src="/Pages/Projects/Index.js" />
}

<div class="apya-page">
    @* Başlık satırı — AiCenter/Workflows/Index.cshtml ile aynı yerleşik desen. *@
    <div class="mb-3">
        <h1 class="h5 mb-1"><i class="fa fa-rocket me-2"></i>Projeler</h1>
        <p class="text-muted mb-0" style="font-size:12px">Aktif projeler · bütçe ve ilerleme sağlığı</p>
    </div>

    @* Pages/Index.cshtml'deki (eski kök sayfa) uyarı widget'ları — kaybolmasın diye taşındı. *@
    <div class="row mb-4" id="DashboardAlertsContainer" style="display: none;">
        <div class="col-12">
            <div class="card bg-danger bg-opacity-10 border-danger border-2 shadow-sm">
                <div class="card-body py-3">
                    <h5 class="card-title text-danger mb-3 fw-bold">
                        <i class="fa fa-exclamation-circle fa-beat me-2"></i> Gecikmiş & Acil Görevleriniz Var!
                    </h5>
                    <div id="OverdueTasksList" class="d-flex flex-wrap gap-2">
                        <!-- JS Tarafından Yüklenecek -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4" id="DashboardUpcomingContainer" style="display: none;">
        <div class="col-12">
            <div class="card bg-warning bg-opacity-10 border-warning border-2 shadow-sm">
                <div class="card-body py-3">
                    <h5 class="card-title text-warning mb-3 fw-bold">
                        <i class="fa fa-clock me-2"></i> Yaklaşan Görevler (Son 48 Saat)
                    </h5>
                    <div id="UpcomingTasksList" class="d-flex flex-wrap gap-2">
                        <!-- JS Tarafından Yüklenecek -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-rocket", Accent = "primary", Label = "Aktif Proje", ValueId = "KpiActiveProjects", Value = "—" }' />
        </div>
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.ViewBudget))
        {
            <div class="col-6 col-lg-3">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-sack-dollar", Accent = "success", Label = "Toplam Bütçe", ValueId = "KpiTotalBudget", Value = "—" }' />
            </div>
        }
        <div class="col-6 col-lg-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-chart-line", Accent = "info", Label = "Ortalama İlerleme", ValueId = "KpiAvgProgress", Value = "—" }' />
        </div>
        <div class="col-6 col-lg-3">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-triangle-exclamation", Accent = "danger", Label = "Risk Altında", ValueId = "KpiAtRisk", Value = "—" }' />
        </div>
    </div>

    @* HANDOFF: Projeler = kart ızgarası (repeat(auto-fill, minmax()) grid).
       Veri/aksiyonlar Index.js'te; tablo yerine .apya-tile kartları render edilir. *@
    <div class="apya-grid-toolbar">
        <span class="apya-grid-count" id="ProjectsCount"></span>
        <div class="ms-auto d-flex align-items-center gap-2">
            <input type="search" id="ProjectsSearch" class="form-control form-control-sm apya-grid-search"
                   placeholder="Proje, kod veya müşteri ara…" autocomplete="off" />
            @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Create))
            {
                <abp-button id="NewProjectButton"
                            text="Yeni Proje Ekle"
                            icon="plus"
                            button-type="Primary" size="Small" />
            }
        </div>
    </div>

    <div id="ProjectsGrid" class="apya-tile-grid apya-fade-in" aria-live="polite"></div>

    <div id="ProjectsEmpty" class="apya-tile-grid-empty" style="display:none">
        <i class="fa fa-rocket" aria-hidden="true"></i>
        <div class="fw-semibold">Henüz proje yok</div>
        <div>İlk projenizi ekleyerek görev ve bütçe takibine başlayın.</div>
    </div>

    <div class="apya-tile-grid-more">
        <button id="ProjectsLoadMore" class="btn btn-outline-secondary btn-sm" style="display:none">
            Daha fazla yükle
        </button>
    </div>
</div>
