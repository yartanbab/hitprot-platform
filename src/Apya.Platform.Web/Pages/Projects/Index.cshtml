@page
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Projects.IndexModel
@{
    ViewBag.Title = "Projeler";
}

@section scripts {
    <abp-script src="/Pages/Projects/Index.js" />
}

<div data-page-description="Aktif projeler · bütçe ve ilerleme sağlığı" class="apya-page">
    @* Başlık satırı + ızgara araç çubuğu TEK SATIRDA: sayaç, arama ve "Yeni Proje
       Ekle" başlığın sağına alındı (önceden KPI şeridinin altında ayrı bir satırdı).
       Öğe id'leri korundu → Index.js bağlantıları (#ProjectsCount, #ProjectsSearch,
       #NewProjectButton) aynen çalışıyor. *@
    <div class="apya-page-head">
        <div class="apya-page-head-actions">
            <span class="apya-grid-count" id="ProjectsCount"></span>
            <input type="search" id="ProjectsSearch" class="form-control form-control-sm apya-grid-search"
                   placeholder="Proje, kod veya müşteri ara…" autocomplete="off" />
            @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Create))
            {
                <abp-button id="NewProjectButton"
                            text="Yeni Proje Ekle"
                            icon="plus"
                            button-type="Primary" size="Small" />
            }
        </div>
    </div>

    @* Kompakt KPI şeridi — proje kartları asıl görsel ağırlık olsun diye bu sayfaya
       özel küçültülmüş rozet stili (bkz. apya-shell.css .apya-kpi-row-compact);
       paylaşılan _KpiCard/.kpi-icon-box varsayılanı diğer sayfalarda aynen kalır. *@
    <div class="row g-3 mb-3 apya-kpi-row-compact">
        <div class="col-6 col-md-4 col-xl">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-rocket", Accent = "accent", Label = "Aktif Proje", ValueId = "KpiActiveProjects", Value = "—" }' />
        </div>
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.ViewBudget))
        {
            <div class="col-6 col-md-4 col-xl">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-sack-dollar", Accent = "positive", Label = "Toplam Bütçe", ValueId = "KpiTotalBudget", Value = "—" }' />
            </div>
        }
        <div class="col-6 col-md-4 col-xl">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-chart-line", Accent = "brand", Label = "Ortalama İlerleme", ValueId = "KpiAvgProgress", Value = "—" }' />
        </div>
        <div class="col-6 col-md-4 col-xl">
            <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-triangle-exclamation", Accent = "negative", Label = "Risk Altında", ValueId = "KpiAtRisk", Value = "—" }' />
        </div>
        @* Gecikmiş/yaklaşan görev uyarı banner'ları yerine: tıklanabilir KPI kartları + modal (bkz. Index.js loadTaskAlerts). *@
        <div class="col-6 col-md-4 col-xl">
            <div id="OverdueTasksKpiCard" class="h-100" role="button" tabindex="0" aria-label="Geçmiş görevleri görüntüle" style="cursor:pointer">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-clock-rotate-left", Accent = "negative", Label = "Geçmiş Görevler", ValueId = "KpiOverdueTasks", Value = "—" }' />
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div id="UpcomingTasksKpiCard" class="h-100" role="button" tabindex="0" aria-label="Yaklaşan görevleri görüntüle" style="cursor:pointer">
                <partial name="_KpiCard" model='new Apya.Platform.Web.Pages.Shared.KpiCardModel { Icon = "fa-clock", Accent = "warning", Label = "Yaklaşan Görevler", ValueId = "KpiUpcomingTasks", Value = "—" }' />
            </div>
        </div>
    </div>

    @* HANDOFF: Projeler = kart ızgarası (repeat(auto-fill, minmax()) grid).
       Veri/aksiyonlar Index.js'te; tablo yerine .apya-tile kartları render edilir.
       Araç çubuğu yukarı, başlık satırına taşındı. *@
    <div id="ProjectsGrid" class="apya-tile-grid apya-fade-in" aria-live="polite"></div>

    <div id="ProjectsEmpty" class="apya-tile-grid-empty" style="display:none">
        <i class="fa fa-rocket" aria-hidden="true"></i>
        <div class="fw-semibold">Henüz proje yok</div>
        <div>İlk projenizi ekleyerek görev ve bütçe takibine başlayın.</div>
    </div>

    <div class="apya-tile-grid-more">
        <button id="ProjectsLoadMore" class="btn btn-outline-secondary btn-sm" style="display:none">
            Daha fazla yükle
        </button>
    </div>
</div>

@* Geçmiş/Yaklaşan görev KPI kartlarının açtığı liste modalı — bkz. Index.js loadTaskAlerts/openTaskAlertsModal. *@
<div class="modal fade" id="TaskAlertsModal" tabindex="-1" aria-labelledby="TaskAlertsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="TaskAlertsModalLabel">Görevler</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="TaskAlertsModalBody" class="d-flex flex-wrap gap-2"></div>
                <div id="TaskAlertsModalEmpty" class="text-muted small" style="display:none">Gösterilecek görev yok.</div>
            </div>
        </div>
    </div>
</div>
