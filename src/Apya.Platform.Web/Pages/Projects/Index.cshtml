@page
@using Apya.Platform.Permissions
@using Apya.Platform.Settings
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Web.Pages.Shared
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.Settings.ISettingProvider SettingProvider
@model Apya.Platform.Web.Pages.Projects.IndexModel
@{
    ViewBag.Title = "Projeler";

    var canViewBudget = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.ViewBudget);
    var canCreate = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Create);
    var canDelete = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Delete);
    var canEdit = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Edit);

    // Açılış görünümü: Ayarlar ekranındaki kullanıcı tercihi (varsayılan "card").
    // Araç çubuğundaki anahtar bunu o cihazda localStorage ile ezer — JS karar verir.
    var defaultView = await SettingProvider.GetOrNullAsync(PlatformSettings.Projects.DefaultView)
                      ?? PlatformSettingDefaults.ProjectsDefaultView;

    // Görev paneli (sağdan açılan drawer) şimdilik varsayılan KAPALI; kullanıcı Ayarlar'dan açabilir.
    var detailPanel = string.Equals(
        await SettingProvider.GetOrNullAsync(PlatformSettings.Projects.DetailPanel),
        "true", StringComparison.OrdinalIgnoreCase);

    // Rol bazlı açılış ön ayarı. Ayrı bir rol tablosu okumak yerine izinlerden
    // türetilir: sistemdeki rol ADLARINA bağlanmak kırılgan olurdu (kiracı kendi
    // rollerini adlandırıyor), izinler ise sabit. Yalnız İLK ziyarette geçerli;
    // sonrası localStorage'dan gelir.
    var rolePreset = canDelete ? "admin" : (canCreate ? "pm" : "field");
}

@section scripts {
    <abp-script src="/Pages/Projects/Index.js" />
}

@*
    HANDOFF: Projeler konsolu — KPI şeridi · araç çubuğu · filtre çipleri ·
    (yoğun liste | kart ızgarası) · görev paneli. Tasarım "Projeler Redesign"
    kanvasının 3a/3b prototipleri. Stil tek kaynak: apya-shell.css §22.
    LeptonX kabuğuna (kenar çubuğu/üst bar) DOKUNULMAZ; burası yalnız
    .lpx-content gövdesi.

    Veri/filtre/sıralama/risk mantığının tamamı Index.js'te tek modülde.
    Sunucudan gelen bayraklar data-* ile aktarılır ki JS'te ikinci bir
    yetki varsayımı oluşmasın.
*@
<div data-page-description="Aktif projeler · bütçe ve ilerleme sağlığı"
     class="apya-page apya-proj-console"
     id="ProjectsConsole"
     data-can-view-budget="@canViewBudget.ToString().ToLowerInvariant()"
     data-can-create="@canCreate.ToString().ToLowerInvariant()"
     data-can-edit="@canEdit.ToString().ToLowerInvariant()"
     data-default-view="@defaultView"
     data-detail-panel="@detailPanel.ToString().ToLowerInvariant()"
     data-role-preset="@rolePreset">

    @* --- KPI şeridi: 6 bölmeli tek satır. Risk / Geçmiş / Yaklaşan hücreleri
         sırasıyla risk · overdue · week filtresini sürer; aktif filtre hücrede
         belli olur (bkz. §22.1 .is-active).
         Şerit MASAÜSTÜNE özeldir: mobilde tümü gizlenir (§22.10), çünkü orada
         geriye yalnız çip şeridiyle çiftlenen üç hücre kalıyordu. Bu yüzden
         is-mobile-hidden şu an ETKİSİZ — hangi hücrelerin masaüstüne özel
         olduğunu işaretlemek için duruyor. --- *@
    <div class="apya-proj-kpis" id="ProjectsKpis" aria-label="Proje özeti">
        <div class="apya-proj-kpi is-mobile-hidden">
            <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--accent" aria-hidden="true"><i class="fa fa-rocket"></i></span>
            <div class="apya-proj-kpi-text">
                <div class="apya-overline">Aktif proje</div>
                <div class="apya-proj-kpi-value apya-numeric" id="KpiActiveProjects">—</div>
            </div>
        </div>

        @if (canViewBudget)
        {
            <div class="apya-proj-kpi is-wide is-mobile-hidden">
                <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--positive" aria-hidden="true"><i class="fa fa-sack-dollar"></i></span>
                <div class="apya-proj-kpi-text">
                    <div class="apya-overline">Toplam bütçe</div>
                    <div class="apya-proj-kpi-value apya-numeric" id="KpiTotalBudget">—</div>
                </div>
            </div>
        }

        @* Risk hücresi: hafif kırmızı zeminli, "risk" filtresini sürer. *@
        <button type="button" class="apya-proj-kpi is-risk is-clickable" data-kpi-filter="risk"
                aria-pressed="false" title="Riskli projeleri filtrele">
            <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--negative" aria-hidden="true"><i class="fa fa-triangle-exclamation"></i></span>
            <div class="apya-proj-kpi-text">
                <div class="apya-overline">Risk altında</div>
                <div class="apya-proj-kpi-value apya-numeric" id="KpiAtRisk">—</div>
            </div>
            <i class="fa fa-filter apya-proj-kpi-hint" aria-hidden="true"></i>
        </button>

        <button type="button" class="apya-proj-kpi is-clickable" data-kpi-filter="overdue"
                aria-pressed="false" title="Gecikmiş görevi olan projeleri filtrele">
            <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--negative" aria-hidden="true"><i class="fa fa-clock-rotate-left"></i></span>
            <div class="apya-proj-kpi-text">
                <div class="apya-overline">Geçmiş görev</div>
                <div class="apya-proj-kpi-value apya-numeric" id="KpiOverdueTasks">—</div>
            </div>
            <i class="fa fa-filter apya-proj-kpi-hint" aria-hidden="true"></i>
        </button>

        <button type="button" class="apya-proj-kpi is-clickable" data-kpi-filter="week"
                aria-pressed="false" title="Bu hafta biten projeleri filtrele">
            <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--warning" aria-hidden="true"><i class="fa fa-clock"></i></span>
            <div class="apya-proj-kpi-text">
                <div class="apya-overline">Yaklaşan görev</div>
                <div class="apya-proj-kpi-value apya-numeric" id="KpiUpcomingTasks">—</div>
            </div>
            <i class="fa fa-filter apya-proj-kpi-hint" aria-hidden="true"></i>
        </button>

        <div class="apya-proj-kpi is-mobile-hidden">
            <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--brand" aria-hidden="true"><i class="fa fa-chart-line"></i></span>
            <div class="apya-proj-kpi-text">
                <div class="apya-overline">Ortalama ilerleme</div>
                <div class="apya-proj-kpi-value apya-numeric" id="KpiAvgProgress">—</div>
            </div>
        </div>
    </div>

    @* --- Araç çubuğu (tek satır) --- *@
    <div class="apya-proj-toolbar">
        <div class="apya-proj-seg apya-proj-toolbar-desktop" role="group" aria-label="Yoğunluk">
            <button type="button" class="apya-proj-seg-btn" data-density="cozy">Ferah</button>
            <button type="button" class="apya-proj-seg-btn" data-density="tight">Sıkı</button>
        </div>

        @* Rol rozeti aynı zamanda kapsam anahtarı: "Saha" ön ayarında yalnız
           kullanıcıya atanmış görevi olan projeler listelenir. Gizli filtre
           bırakmamak için tıklanabilir ve durumu rozette yazılı. *@
        <button type="button" class="apya-chip apya-chip-accent apya-proj-role-chip apya-proj-toolbar-desktop"
                id="ProjectsRoleChip" aria-pressed="false">
            <i class="fa fa-user-gear" aria-hidden="true"></i><span id="ProjectsRoleChipText">—</span>
        </button>

        <div class="apya-proj-toolbar-end">
            <span class="apya-proj-count" id="ProjectsCount" aria-live="polite"></span>

            @await Html.PartialAsync("/Pages/Shared/_FeedbackLink.cshtml",
                new Apya.Platform.Web.Feedbacks.FeedbackLinkContext(Module: "Projects", Component: "ProjectList"))

            <div class="apya-proj-search">
                <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" id="ProjectsSearch" placeholder="Proje veya kod ara…"
                       autocomplete="off" aria-label="Proje ara" />
                <button type="button" class="apya-proj-search-clear" id="ProjectsSearchClear"
                        aria-label="Aramayı temizle" hidden><i class="fa fa-xmark"></i></button>
            </div>

            <select class="apya-proj-sort" id="ProjectsSort" aria-label="Sıralama">
                <option value="urgency">Aciliyet</option>
                <option value="name">Ad</option>
                <option value="budget">Bütçe</option>
                <option value="progress">İlerleme</option>
            </select>

            <div class="apya-proj-seg apya-proj-toolbar-desktop" role="group" aria-label="Görünüm">
                <button type="button" class="apya-proj-seg-btn is-icon" data-view="list"
                        aria-label="Liste görünümü" title="Liste görünümü"><i class="fa fa-list"></i></button>
                <button type="button" class="apya-proj-seg-btn is-icon" data-view="card"
                        aria-label="Kart görünümü" title="Kart görünümü"><i class="fa fa-table-cells-large"></i></button>
            </div>

            @if (canCreate)
            {
                <abp-button id="NewProjectButton" text="Yeni Proje Ekle" icon="plus"
                            button-type="Primary" size="Small" />
            }
        </div>
    </div>

    @* --- Filtre çipleri: canlı sayılar JS'ten; aktif çip koyu zemin.
         "Filtreleri temizle" yalnız aktif filtre/arama varken görünür.
         Sarmalayıcı mobilde sıralama kutusunu da barındırır: Index.js/placeSort
         onu 768px altında araç çubuğundan BURAYA taşır ki araç çubuğu tek satıra
         insin (§22.10). Kutu çiplerin İÇİNE değil yanına girer — renderFilters
         #ProjectsFilters'ın html'ini komple değiştiriyor, içeride olsa silinirdi.
         Masaüstünde kutu araç çubuğundaki yerinde kalır. --- *@
    <div class="apya-proj-filterbar" id="ProjectsFilterBar">
        <div class="apya-proj-filters" id="ProjectsFilters" role="group" aria-label="Hızlı filtreler"></div>
    </div>

    @* --- Yoğun liste --- *@
    <div class="apya-proj-list" id="ProjectsList" hidden>
        <div class="apya-proj-list-head" role="row">
            <span></span>
            <button type="button" class="apya-proj-col-sort" data-sort-col="name">Proje <i class="fa fa-arrow-down-short-wide"></i></button>
            <button type="button" class="apya-proj-col-sort apya-proj-col-duration" data-sort-col="urgency">Süre <i class="fa fa-arrow-down-short-wide"></i></button>
            <button type="button" class="apya-proj-col-sort apya-proj-col-budget" data-sort-col="budget">Bütçe <i class="fa fa-arrow-down-short-wide"></i></button>
            <button type="button" class="apya-proj-col-sort" data-sort-col="progress">İlerleme <i class="fa fa-arrow-down-short-wide"></i></button>
            <span>Gecikmiş görev</span>
            <span class="apya-proj-col-team">Ekip</span>
            <span></span>
        </div>
        <div id="ProjectsListBody"></div>
    </div>

    @* --- Kurulum ipucu şeridi: tek projesi olan yeni hesapta "sırada ne var"
         (eski odak kartının yerini aldı — kart tasarımı artık tek projede de
         ızgaradaki kartın aynısı). --- *@
    <div id="ProjectsSteps" hidden></div>

    @* --- Kart ızgarası (varsayılan görünüm) --- *@
    <div id="ProjectsGrid" class="apya-tile-grid apya-fade-in" aria-live="polite" hidden></div>

    @* --- Filtre sonucu yok --- *@
    <div class="apya-proj-noresult" id="ProjectsNoResult" hidden>
        <span class="kpi-icon-box kpi-icon-box--neutral" aria-hidden="true"><i class="fa fa-magnifying-glass"></i></span>
        <div class="apya-proj-noresult-title">Bu filtreyle proje yok</div>
        <div class="apya-proj-noresult-desc" id="ProjectsNoResultHint"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="ProjectsNoResultClear">
            <i class="fa fa-rotate-left me-1"></i>Filtreleri temizle
        </button>
    </div>

    @* --- Hiç proje yok: boş durum + şablon kartları --- *@
    <div id="ProjectsEmpty" hidden>
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-rocket", Title = "Henüz proje yok", Description = "İlk projenizi ekleyin; bütçe, görev ve gecikme takibi bu ekranda kendiliğinden oluşur." }' />
        @if (canCreate)
        {
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-primary btn-sm" data-new-project>
                    <i class="fa fa-plus me-1"></i>Yeni Proje Ekle
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-new-project data-template="grant">
                    <i class="fa fa-file-import me-1"></i>Hibe şablonundan başla
                </button>
            </div>
            <div class="apya-proj-templates">
                <button type="button" class="apya-proj-template" data-new-project data-template="grant">
                    <div class="apya-overline">Hibe projesi</div>
                    <div class="apya-proj-template-desc">Bütçe kalemleri ve rapor takvimi hazır gelir</div>
                </button>
                <button type="button" class="apya-proj-template" data-new-project data-template="event">
                    <div class="apya-overline">Etkinlik</div>
                    <div class="apya-proj-template-desc">Geri sayım ve tedarikçi görevleriyle</div>
                </button>
                <button type="button" class="apya-proj-template" data-new-project>
                    <div class="apya-overline">Boş proje</div>
                    <div class="apya-proj-template-desc">Sadece ad, kod ve tarih aralığı</div>
                </button>
            </div>
        }
    </div>

    <div class="apya-tile-grid-more">
        <button id="ProjectsLoadMore" class="btn btn-outline-secondary btn-sm" hidden>Daha fazla yükle</button>
    </div>
</div>

@* Görev paneli (slide-over) — satır/karttan açılır, içeriği Index.js basar.
   Bootstrap modal DEĞİL: backdrop/ESC/dış-tık yönetimi panelin kendisinde. *@
<div id="ProjectsDrawerRoot"></div>

@* Proje ⋯ menüsü — TEK örnek, sayfa kökünde.
   Kart içine basılamaz: .apya-proj-card `overflow:hidden` taşıyor, menü kırpılırdı.
   Index.js açılışta bağlantıları o projenin id'siyle yazar ve position:fixed ile
   düğmenin yanına yerleştirir. *@
<div id="ProjectMoneyMenu" class="apya-console-menu apya-proj-money-menu" hidden role="menu">
    <a class="apya-console-menu-item text-decoration-none" data-link="detail" href="#">
        <span class="apya-console-menu-icon"><i class="fa fa-list-check" aria-hidden="true"></i></span>
        Proje detayı
    </a>
    @if (canViewBudget)
    {
        <a class="apya-console-menu-item text-decoration-none" data-link="budget" href="#">
            <span class="apya-console-menu-icon"><i class="fa fa-list-ul" aria-hidden="true"></i></span>
            Proje bütçesi
        </a>
        <a class="apya-console-menu-item text-decoration-none" data-link="finance" href="#">
            <span class="apya-console-menu-icon"><i class="fa fa-coins" aria-hidden="true"></i></span>
            Finans
        </a>
    }
    @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Documents.Default))
    {
        <a class="apya-console-menu-item text-decoration-none" data-link="documents" href="#">
            <span class="apya-console-menu-icon"><i class="fa fa-folder-open" aria-hidden="true"></i></span>
            Belgeler
        </a>
    }
    @if (canEdit)
    {
        <a class="apya-console-menu-item text-decoration-none" data-link="edit" href="#">
            <span class="apya-console-menu-icon"><i class="fa fa-pen" aria-hidden="true"></i></span>
            Projeyi düzenle
        </a>
    }
</div>
