@page "{id:Guid}"
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Projects.ProjectDetailsModel
@{
    ViewBag.Title = Model.Project?.Name;

    var totalTasks     = Model.Tasks?.Count ?? 0;
    var completedTasks = Model.Tasks?.Count(t => t.Status == Apya.Platform.Tasks.TaskStatus.Done) ?? 0; // Done=4 (önceki "==3" InReview'i sayıyordu → bug)
    var progressPct    = totalTasks > 0 ? (int)Math.Round((double)completedTasks / totalTasks * 100) : 0;

    // Gecikmiş / 7 gün içinde — şerit barlarının kaynağı. İptal (0) ve Tamamlandı (4)
    // aciliyet saymaz (apya-task-render.js dueDateChip ile aynı kural).
    var today = DateTime.Today;
    bool IsOpen(Apya.Platform.Tasks.TaskDto t) =>
        t.Status != Apya.Platform.Tasks.TaskStatus.Done &&
        t.Status != Apya.Platform.Tasks.TaskStatus.Cancelled;

    var overdueCount = Model.Tasks?.Count(t => IsOpen(t) && t.DueDate.HasValue && t.DueDate.Value.Date < today) ?? 0;
    var due7Count    = Model.Tasks?.Count(t => IsOpen(t) && t.DueDate.HasValue
                                              && t.DueDate.Value.Date >= today
                                              && t.DueDate.Value.Date <= today.AddDays(7)) ?? 0;

    // Ekip = görev atamalarından türer (ProjectMember tablosu yok).
    var assignees = (Model.Tasks ?? new List<Apya.Platform.Tasks.TaskDto>())
        .Where(t => t.AssigneeId.HasValue && !string.IsNullOrWhiteSpace(t.AssigneeName))
        .GroupBy(t => t.AssigneeId!.Value)
        .Select(g => new { Id = g.Key, Name = g.First().AssigneeName! })
        .OrderBy(a => a.Name)
        .ToList();

    // apya-task-render.js'teki initials + hashTone ile BİREBİR aynı sonucu üretir
    // (aynı kişi listede ve şeritte aynı rengi/harfi alsın). JS toUpperCase()
    // locale-invariant çalıştığı için burada da ToUpperInvariant kullanılır.
    string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
    string HashTone(string name)
    {
        var tones = new[] { "positive", "negative", "warning", "brand", "ai", "neutral" };
        var h = 0;
        foreach (var c in name) { unchecked { h = h * 31 + c; } }
        return tones[(int)(Math.Abs((long)h) % tones.Length)];
    }

    // Backend Bootstrap renk adı döndürüyor (success/warning/danger/info/secondary) ->
    // apya-chip tone. Tüm olası değerler ProjectMetricsCalculator'da sabit; exhaustive.
    string ToApyaChipTone(string bsColor) => bsColor switch
    {
        "success" => "positive",
        "warning" => "warning",
        "danger"  => "negative",
        "info"    => "brand",
        _         => "neutral"
    };
    var timeHealthTone = ToApyaChipTone(Model.TimeHealthColor);

    // apya-mini-progress ton sınıfı (bg-danger/warning/success yerine).
    string ToApyaBarTone(string bsColor) => bsColor switch
    {
        "success" => "is-positive",
        "warning" => "is-warning",
        "danger"  => "is-negative",
        _         => ""
    };
    var timeHealthBarTone = ToApyaBarTone(Model.TimeHealthColor);
    var budgetBarTone = Model.BudgetPercent > 90 ? "is-negative" : Model.BudgetPercent > 60 ? "is-warning" : "is-positive";
    var hasBudget = Model.Project?.TotalBudget > 0;
    var hasDates  = Model.TimeNotStarted || Model.Project?.EndDate.HasValue == true;

    // 403 hâli sunucuda karara bağlanır: yetki yoksa DataTables hiç kurulmaz
    // (başarısız ajax + global hata modalı yerine ekranda kilit paneli).
    var canViewTasks = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Default);
}

<style>
    @@keyframes heartbeat {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    .heartbeat-animation { animation: heartbeat 1.5s infinite; }

    /* Konsol tasarımı apya-shell.css §21'de (tek kaynak).
       Kanban tasarımı /css/kanban.css'te (tek kaynak). */

    /* DataTables'ın kendi arama kutusu gizlenir — arama şeritteki pile taşındı
       (#console-search → dataTable.search()). */
    .apya-project-console .dt-search { display: none; }
</style>

@* Tailwind island stylesheet (js/style.css) — bu partial olmadan görev detay modalı stilsiz kalır. *@
<partial name="_ApyaThemeBootstrap" />

@section styles {
    @* Merkezi kanban tasarımı (tek kaynak) *@
    <abp-style src="/css/kanban.css" />
    <link rel="stylesheet" href="~/libs/select2/css/select2.min.css" />
}

<div data-page-description="Proje operasyon merkezi" class="apya-page apya-project-console">

@* ─── ÖZET ŞERİDİ (60px, yapışkan) ─── *@
<div class="apya-console-rail">

    <a href="/" class="btn btn-outline-secondary apya-console-back">
        <i class="fa fa-arrow-left" aria-hidden="true"></i> Geri
    </a>
    <span class="apya-console-sep" aria-hidden="true"></span>

    @* ── Proje kimliği ── *@
    <div class="apya-console-identity">
        <div>
            <i class="fa fa-rocket apya-console-rocket" aria-hidden="true"></i>
            <h1 class="apya-console-name">@Model.Project?.Name</h1>
            <span class="apya-chip apya-chip-brand">
                <i class="fa fa-tag me-1" aria-hidden="true"></i>@Model.Project?.Code
            </span>
            <button type="button" class="apya-console-copy" data-copy-code="@Model.Project?.Code"
                    aria-label="Proje kodunu kopyala" title="Proje kodunu kopyala">
                <i class="fa fa-copy" aria-hidden="true"></i>
            </button>
        </div>
        <div>
            <span class="apya-chip apya-console-tenant-chip apya-chip-@(Model.IsInternalProject ? "neutral" : "brand")">
                <i class="fa @(Model.IsInternalProject ? "fa-house" : "fa-building") me-1" aria-hidden="true"></i>
                @(Model.IsInternalProject ? "Dahili Proje" : $"Müşteri: {Model.TenantName}")
            </span>
            @* Açıklama 60px şeride iki satır sığmadığı için ⓘ ipucuna taşındı. *@
            @if (!string.IsNullOrWhiteSpace(Model.Project?.Description))
            {
                <apya-hint placement="bottom" text="@Model.Project.Description" />
            }
        </div>
    </div>
    <span class="apya-console-sep" aria-hidden="true"></span>

    @* ── Metrik barları ──
       Bütçe barı bugünkü davranışını korur (#btn-budget-summary → modal).
       İlerleme / Gecikmiş / 7 Gün barları filtre üretmeye 3. adımda bağlanır. *@
    <div class="apya-console-bars">

        @* Kalan Süre *@
        <button type="button" class="apya-console-bar" id="bar-time"
                title="@(hasDates ? $"Zaman sağlığı: {Model.TimeHealthLabel}" : "Proje tarihleri belirlenmemiş")"
                disabled="@(!hasDates)">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-hourglass-half me-1" aria-hidden="true"></i>Kalan Süre</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            @if (hasDates)
            {
                <span class="apya-console-bar-value">
                    <strong class="apya-numeric">@Model.RemainingDays</strong>
                    <small>@(Model.TimeNotStarted ? "gün · başlangıca" : $"gün · %{Model.TimeUsagePercent}")</small>
                </span>
                <span class="apya-mini-progress @timeHealthBarTone"><span style="width:@(Model.TimeNotStarted ? 0 : Model.TimeUsagePercent)%"></span></span>
            }
            else
            {
                <span class="apya-console-bar-value"><small>Tarih belirlenmemiş</small></span>
            }
        </button>

        @* Bütçe — mevcut "Bütçe vs Gerçekleşen" modalını açar *@
        <button type="button" class="apya-console-bar" id="btn-budget-summary"
                data-project-id="@Model.Project?.Id"
                title="@(hasBudget ? "Bütçe vs Gerçekleşen" : "Bütçe tanımlı değil")"
                disabled="@(!hasBudget)">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-wallet me-1" aria-hidden="true"></i>Bütçe</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            @if (hasBudget)
            {
                <span class="apya-console-bar-value">
                    <strong class="apya-numeric">@Model.BudgetSpent.ToString("N0")</strong>
                    <small class="apya-numeric">/ @Model.Project?.TotalBudget.ToString("N0")</small>
                </span>
                <span class="apya-mini-progress @budgetBarTone"><span style="width:@Model.BudgetPercent%"></span></span>
            }
            else
            {
                <span class="apya-console-bar-value"><small>Bütçe tanımsız</small></span>
            }
        </button>

        @* İlerleme *@
        <button type="button" class="apya-console-bar" id="bar-progress" aria-pressed="false" title="Tamamlanmamış görevleri filtrele">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-chart-line me-1" aria-hidden="true"></i>İlerleme</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric">%@progressPct</strong>
                <small class="apya-numeric">· @completedTasks/@totalTasks</small>
            </span>
            <span class="apya-mini-progress @(progressPct == 100 ? "is-positive" : "is-progress")"><span style="width:@progressPct%"></span></span>
        </button>

        @* Gecikmiş *@
        <button type="button" class="apya-console-bar" id="bar-overdue" aria-pressed="false" title="Gecikmiş görevleri filtrele">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>Gecikmiş</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric is-negative">@overdueCount</strong>
                <small>görev</small>
            </span>
            <span class="apya-mini-progress is-negative"><span style="width:@(totalTasks > 0 ? overdueCount * 100 / totalTasks : 0)%"></span></span>
        </button>

        @* 7 Gün İçinde *@
        <button type="button" class="apya-console-bar" id="bar-due7" aria-pressed="false" title="7 gün içinde bitmesi gerekenler">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-calendar-day me-1" aria-hidden="true"></i>7 Gün İçinde</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric is-warning">@due7Count</strong>
                <small>görev</small>
            </span>
            <span class="apya-mini-progress is-warning"><span style="width:@(totalTasks > 0 ? due7Count * 100 / totalTasks : 0)%"></span></span>
        </button>

        @* Ekip — avatara tıklamak o kişinin görevlerini filtreler.
           Ekip Yönetimi paneli ProjectMember backend'i olmadığı için kapsam dışı. *@
        <div class="apya-console-team">
            <span class="apya-console-facepile">
                @foreach (var a in assignees.Take(5))
                {
                    <button type="button" class="apya-avatar apya-avatar-@HashTone(a.Name)"
                            data-assignee-id="@a.Id" aria-pressed="false"
                            title="@a.Name — görevlerini filtrele">@Initials(a.Name)</button>
                }
                @if (assignees.Count > 5)
                {
                    <span class="apya-avatar apya-avatar-neutral" title="@(assignees.Count - 5) kişi daha">+@(assignees.Count - 5)</span>
                }
            </span>
            <span class="apya-console-team-label">
                @(assignees.Count == 0 ? "EKİP YOK" : $"EKİP ({assignees.Count})")
            </span>
        </div>

    </div>

    @* ── Şerit aksiyonları ── *@
    <div class="apya-console-actions">
        <div class="apya-console-search">
            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="console-search" placeholder="Görev ara" aria-label="Görev ara" />
        </div>
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Create))
        {
            <button id="btn-ai-task-generator"
                    class="btn btn-outline-primary"
                    data-project-id="@Model.Id"
                    title="PDF yükle, AI taslak görevlere bölsün, beğendiklerini onayla.">
                <i class="fa fa-robot" aria-hidden="true"></i> AI ile Görev Oluştur
            </button>
            <button id="btn-create-task"
                    class="btn btn-primary"
                    data-project-id="@Model.Id">
                <i class="fa fa-plus" aria-hidden="true"></i> Yeni Görev Ekle
            </button>
        }

        @* ── ⋯ Proje menüsü ──
           Bootstrap dropdown: dışarı tıklama / Esc / odak yönetimi hazır gelir.
           auto-close="outside": Yoğunluk segmentine basınca menü kapanmasın. *@
        <div class="dropdown">
            <button type="button" class="apya-console-kebab" id="btn-project-menu"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                    aria-label="Proje menüsü" title="Proje menüsü">
                <i class="fa fa-ellipsis" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end apya-console-menu" aria-labelledby="btn-project-menu">

                <div class="apya-console-menu-head">Proje</div>
                @if (hasBudget)
                {
                    <button type="button" class="apya-console-menu-item" id="menu-budget-summary"
                            data-project-id="@Model.Project?.Id">
                        <span class="apya-console-menu-icon"><i class="fa fa-wallet" aria-hidden="true"></i></span>
                        Bütçe vs gerçekleşen
                    </button>
                }
                <button type="button" class="apya-console-menu-item" data-copy-code="@Model.Project?.Code">
                    <span class="apya-console-menu-icon"><i class="fa fa-copy" aria-hidden="true"></i></span>
                    Proje kodunu kopyala
                    <span class="apya-console-menu-trailing apya-numeric">@Model.Project?.Code</span>
                </button>

                <div class="apya-console-menu-head is-divided">Görünüm</div>
                <div class="apya-console-menu-row">
                    <span>Yoğunluk</span>
                    <span class="apya-console-density" role="group" aria-label="Satır yoğunluğu">
                        <button type="button" data-density-set="compact" title="Sıkı">S</button>
                        <button type="button" data-density-set="cozy" title="Normal">N</button>
                        <button type="button" data-density-set="comfortable" title="Geniş">G</button>
                    </span>
                </div>

                @* Silme: ayrılmış negatif bölüm. id + data-* attribute'ları Danger Zone
                   kartındakiyle AYNEN aynı — mevcut SweetAlert akışı değişmedi. *@
                @if (await AuthorizationService.IsGrantedAsync("Platform.Projects.ManageTeam") || await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Delete))
                {
                    <button type="button" class="apya-console-menu-item is-danger"
                            id="btn-delete-project"
                            data-project-id="@Model.Id"
                            data-project-code="@Model.Project?.Code">
                        <span class="apya-console-menu-icon"><i class="fa fa-trash" aria-hidden="true"></i></span>
                        Projeyi sil…
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@* ─── GÖREV ALANI (kalan yüksekliğin tamamı) ─── *@
<div class="card apya-console-main">

    <div class="apya-console-tabs" role="tablist">
        <button type="button" class="apya-console-tab active" id="btn-view-list"
                role="tab" aria-selected="true" aria-controls="view-list">
            <i class="fa fa-list" aria-hidden="true"></i>Liste
        </button>
        <button type="button" class="apya-console-tab" id="btn-view-kanban"
                role="tab" aria-selected="false" aria-controls="view-kanban">
            <i class="fa fa-table-columns" aria-hidden="true"></i>Kanban
        </button>
        <span class="apya-console-count apya-numeric" id="console-task-count">@totalTasks görev</span>
    </div>

    @* ─── Filtre çubuğu (42px) ───
       Şerit barları ve buradaki chip'ler AYNI state'i okur/yazar
       (ProjectDetails.js → filterState). İki ayrı filtre mekanizması yok. *@
    <div class="apya-console-filters" id="console-filters">
        <span class="apya-console-filter-label">Filtre</span>

        <div class="dropdown">
            <button type="button" class="apya-filter-chip" id="chip-status"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <span data-chip-text>Durum: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu apya-console-menu">
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="">Tümü</button>
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="1">Yapılacak</button>
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="2">Sürüyor</button>
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="3">Testte</button>
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="4">Tamamlandı</button>
                <button type="button" class="apya-console-menu-item" data-filter="status" data-value="0">İptal</button>
            </div>
        </div>

        <div class="dropdown">
            <button type="button" class="apya-filter-chip" id="chip-assignee"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <span data-chip-text>Atanan: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu apya-console-menu">
                <button type="button" class="apya-console-menu-item" data-filter="assignee" data-value="">Tümü</button>
                @foreach (var a in assignees)
                {
                    <button type="button" class="apya-console-menu-item" data-filter="assignee" data-value="@a.Id" data-label="@a.Name">
                        <span class="apya-avatar apya-avatar-@HashTone(a.Name)">@Initials(a.Name)</span>@a.Name
                    </button>
                }
            </div>
        </div>

        <div class="dropdown">
            <button type="button" class="apya-filter-chip" id="chip-priority"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <span data-chip-text>Öncelik: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu apya-console-menu">
                <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="">Tümü</button>
                <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="1">Düşük</button>
                <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="2">Orta</button>
                <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="3">Yüksek</button>
                <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="4">Kritik</button>
            </div>
        </div>

        <button type="button" class="apya-filter-chip" id="chip-overdue" aria-pressed="false">Gecikmiş</button>
        <button type="button" class="apya-filter-chip" id="chip-mine" aria-pressed="false">Bana atanan</button>
        <button type="button" class="apya-console-filter-clear d-none" id="btn-clear-filters">Filtreleri temizle</button>
    </div>

    <div class="apya-console-views">

        @* --- LİSTE GÖRÜNÜMÜ --- *@
        <div id="view-list" class="view-panel" role="tabpanel" aria-labelledby="btn-view-list">
            @if (canViewTasks)
            {
                <abp-table class="apya-clean-table" id="ProjectTasksTable"></abp-table>

                @* Yükleniyor — spinner değil, tablo hizasında iskelet satırlar. *@
                <div class="apya-console-skeleton d-none" id="state-loading" aria-hidden="true">
                    @for (var i = 0; i < 8; i++)
                    {
                        <div class="apya-console-skeleton-row">
                            <span class="apya-skeleton" style="width:38%"></span>
                            <span class="apya-skeleton" style="width:12%"></span>
                            <span class="apya-skeleton" style="width:10%"></span>
                            <span class="apya-skeleton" style="width:10%"></span>
                            <span class="apya-skeleton" style="width:12%"></span>
                        </div>
                    }
                </div>

                @* Boş hâller — DataTables'ın boş hücresine JS ile basılır. *@
                <template id="tpl-state-empty">
                    <div class="apya-console-state">
                        <span class="apya-console-state-icon"><i class="fa fa-list-check" aria-hidden="true"></i></span>
                        <strong>Bu projede henüz görev yok</strong>
                        <p>İlk görevi elle ekleyin ya da bir dokümandan AI ile üretin.</p>
                        <span class="apya-console-state-actions">
                            <button type="button" class="btn btn-primary btn-sm" data-state-action="create">
                                <i class="fa fa-plus me-1" aria-hidden="true"></i>Yeni Görev Ekle
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-state-action="ai">
                                <i class="fa fa-robot me-1" aria-hidden="true"></i>AI ile Görev Oluştur
                            </button>
                        </span>
                    </div>
                </template>
                <template id="tpl-state-nomatch">
                    <div class="apya-console-state">
                        <span class="apya-console-state-icon"><i class="fa fa-filter" aria-hidden="true"></i></span>
                        <strong>Filtreye uyan görev yok</strong>
                        <span class="apya-console-state-actions">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-state-action="clear">Filtreleri temizle</button>
                        </span>
                    </div>
                </template>
            }
            else
            {
                @* 403 — proje özeti görünür kalır, yalnız liste kilitlenir. *@
                <div class="apya-console-state is-denied">
                    <span class="apya-console-state-icon is-muted"><i class="fa fa-lock" aria-hidden="true"></i></span>
                    <strong>Bu projenin görevlerini görme yetkiniz yok</strong>
                    <p>
                        Proje özeti görünür kalır; görev listesi
                        <code class="apya-numeric">@PlatformPermissions.Tasks.Default</code> izni gerektirir.
                        Proje yöneticisi bu izni verebilir.
                    </p>
                </div>
            }
        </div>

        @* --- KANBAN GÖRÜNÜMÜ --- *@
        <div id="view-kanban" class="view-panel d-none" role="tabpanel" aria-labelledby="btn-view-kanban">
            @* Merkezi kanban markup'ı (tek kaynak) *@
            <partial name="_KanbanBoard" />
