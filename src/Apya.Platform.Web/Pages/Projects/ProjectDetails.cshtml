@page "{id:Guid}"
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.Projects.ProjectDetailsModel
@{
    ViewBag.Title = Model.Project?.Name;

    var totalTasks     = Model.Tasks?.Count ?? 0;
    var completedTasks = Model.Tasks?.Count(t => t.Status == Apya.Platform.Tasks.TaskStatus.Done) ?? 0; // Done=4 (önceki "==3" InReview'i sayıyordu → bug)
    var progressPct    = totalTasks > 0 ? (int)Math.Round((double)completedTasks / totalTasks * 100) : 0;
    var assigneeCount  = Model.Tasks?.Where(t => t.AssigneeId.HasValue).Select(t => t.AssigneeId).Distinct().Count() ?? 0;
    var facepileCount  = Math.Min(assigneeCount, 5);

    // Backend Bootstrap renk adı döndürüyor (success/warning/danger/info/secondary) ->
    // apya-chip tone. Tüm olası değerler ProjectMetricsCalculator'da sabit; exhaustive.
    string ToApyaChipTone(string bsColor) => bsColor switch
    {
        "success" => "positive",
        "warning" => "warning",
        "danger"  => "negative",
        "info"    => "brand",
        _         => "neutral"
    };
    var timeHealthTone = ToApyaChipTone(Model.TimeHealthColor);
}

<style>
    @@keyframes heartbeat {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    .heartbeat-animation { animation: heartbeat 1.5s infinite; }

    /* ÖNEMLİ: bu kart .card kullanır (sistemik dark bridge zemini çeviriyor) ama
       bu class kendi background'ını EZİYORDU (sabit beyaz gradient) — dark'ta
       kart beyaz kalıp içindeki (text-dark kaldırılmış) metinler görünmez
       olurdu. Token'a bağlandı. */
    .project-dashboard-card { border-radius: 1rem; border: none; background: var(--apya-surface-raised); }
    .avatar-group { display: flex; align-items: center; }
    .avatar-circle {
        width: 36px; height: 36px; border-radius: 50%;
        background-color: var(--apya-accent-500); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-weight: bold; font-size: 0.85rem;
        border: 2px solid var(--apya-surface-raised); margin-left: -10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .avatar-circle:first-child { margin-left: 0; }
    .avatar-circle.more { background-color: var(--apya-neutral-500); }

    /* Görünüm tab'ları — utility class jonglörlüğü yerine state-tabanlı token stili.
       (Eski hali: aktif underline Liste'ye SABİTti, aktif renk LeptonX pembesine/
       dark'ta görünmez koyuya düşüyordu.) */
    #projectViewTabs .nav-link { color: var(--apya-text-secondary); background: transparent; }
    #projectViewTabs .nav-link:hover { color: var(--apya-text-primary); }
    #projectViewTabs .nav-link.active { color: var(--apya-text-primary); box-shadow: inset 0 -3px 0 var(--apya-accent-500); }
    
    /* Kanban tasarımı merkezi /css/kanban.css dosyasına taşındı (tek kaynak). */
</style>

@section styles {
    @* Merkezi kanban tasarımı (tek kaynak) *@
    <abp-style src="/css/kanban.css" />
}

@* ─── PROJE OPERASYON MERKEZi - Dashboard Header ─── *@
<div class="apya-page">
<div class="card shadow-sm mb-4 project-dashboard-card">
    <div class="card-body p-4 position-relative">

        @* Geri — kartın üst sağına sabitlendi (kullanıcı isteği) *@
        <a href="/" class="btn btn-light border btn-sm position-absolute" style="top:1.25rem; right:1.25rem; z-index:3;">
            <i class="fa fa-arrow-left me-1"></i> Geri
        </a>

        @* Hızlı kısayollar — masaüstünde gizli (d-md-none); JS handler'ları korunsun diye DOM'da kalır *@
        <div class="btn-group btn-group-sm d-md-none mb-3" role="group">
            <button class="btn btn-outline-primary px-3" title="Hızlı Efor Gir" id="btn-quick-effort"><i class="fa fa-clock"></i></button>
            <button class="btn btn-outline-primary px-3" title="Dosya Yükle" id="btn-quick-upload"><i class="fa fa-upload"></i></button>
            <button class="btn btn-outline-primary px-3" title="Not Ekle" id="btn-quick-note"><i class="fa fa-sticky-note"></i></button>
        </div>

        @* Metrikler kart içinde dikey ortalı *@
        <div class="row align-items-center gy-3">

            @* ── Proje Bilgileri + Tenant Rozeti ── *@
            <div class="col-md-3">
                @* Tenant Rozeti *@
                <span class="apya-chip apya-chip-@(Model.IsInternalProject ? "neutral" : "brand") mb-2" style="font-size: 0.75rem;">
                    <i class="fa @(Model.IsInternalProject ? "fa-home" : "fa-building") me-1"></i>
                    @(Model.IsInternalProject ? "Dahili Proje" : $"Müşteri: {Model.TenantName}")
                </span>

                @* Proje Adı + Kopyalanabilir Kod *@
                <h1 class="fw-bold mb-2" style="font-size: 1.6rem;">
                    <i class="fa fa-rocket text-primary me-2"></i>@Model.Project?.Name
                </h1>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="apya-chip apya-chip-brand" style="font-size: 0.8rem; padding: 6px 14px;">
                        <i class="fa fa-tag me-1"></i>@Model.Project?.Code
                    </span>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0"
                            onclick="navigator.clipboard.writeText('@Model.Project?.Code'); abp.notify.success('Proje kodu kopyalandı!');"
                            title="Proje kodunu kopyala">
                        <i class="fa fa-copy" style="font-size: 0.75rem;"></i>
                    </button>
                    @* "Bütçe Durumu" butonu kaldırıldı — artık aşağıdaki "Bütçe Tüketimi"
                       widget'ına tıklayınca aynı modal açılıyor. *@
                </div>
                <p class="text-muted mb-0 small" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                    @Model.Project?.Description
                </p>
            </div>

            @* ── AI Risk Öngörüsü — GEÇİCİ GİZLİ (kullanıcı isteği 2026-06-09): geri getirmek için "d-none" kaldır ── *@
            <div class="col-md-2 border-start px-3 d-none">
                <div class="d-flex align-items-center mb-2">
                    <div class="bg-@Model.AiRiskColor bg-opacity-10 p-2 rounded-circle me-2 border border-@Model.AiRiskColor shadow-sm d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                        <i class="fa fa-robot text-@Model.AiRiskColor fs-5"></i>
                    </div>
                    <div>
                        <h6 class="apya-overline mb-0">AI Risk</h6>
                        <span class="fw-bold fs-5 text-@Model.AiRiskColor">%@Model.AiRiskScore</span>
                    </div>
                </div>
                <p class="text-muted mb-0 lh-sm" style="font-size:0.75rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                    @Model.AiRiskMessage
                </p>
            </div>

            @* ── Kalan Süre Countdown + Zaman Sapma ── *@
            <div class="col-md-2 border-start px-3">
                <h6 class="apya-overline mb-2">
                    <i class="fa fa-hourglass-half me-1"></i>Kalan Süre
                </h6>
                @if (Model.TimeNotStarted)
                {
                    @* İleri tarihli proje: bitişe değil BAŞLANGICA geri sayım *@
                    <div class="d-flex align-items-baseline gap-1 mb-1 flex-wrap">
                        <span class="text-muted small">Başlamasına</span>
                        <span class="fw-bold fs-4">@Model.RemainingDays</span>
                        <span class="text-muted small">Gün Kaldı</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted" style="font-size:0.7rem;">Başlangıç: @Model.Project?.StartDate?.ToString("dd.MM.yyyy")</small>
                        <span class="apya-chip apya-chip-@timeHealthTone" style="font-size:0.65rem;">
                            @Model.TimeHealthLabel
                        </span>
                    </div>
                }
                else if (Model.Project?.EndDate.HasValue == true)
                {
                    <div class="d-flex align-items-baseline gap-1 mb-1">
                        <span class="fw-bold fs-4">@Model.RemainingDays</span>
                        <span class="text-muted small">Gün Kaldı</span>
                    </div>
                    <div class="progress shadow-sm mb-1" style="height:6px;border-radius:4px;">
                        <div class="progress-bar bg-@Model.TimeHealthColor @(Model.TimeUsagePercent < 100 ? "progress-bar-striped progress-bar-animated" : "")"
                             style="width:@Model.TimeUsagePercent%"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small class="text-muted" style="font-size:0.7rem;">Sürenin %@Model.TimeUsagePercent'i</small>
                        <span class="apya-chip apya-chip-@timeHealthTone" style="font-size:0.65rem;">
                            @Model.TimeHealthLabel
                        </span>
                    </div>
                }
                else
                {
                    <span class="text-muted small">Tarih belirlenmemiş</span>
                }
            </div>

            @* ── Bütçe Tüketimi (tıklanabilir → Bütçe vs Gerçekleşen modalı) ── *@
            <div id="btn-budget-summary" data-project-id="@Model.Project?.Id" role="button"
                 class="col-md-2 border-start px-3 budget-consumption-clickable" style="cursor:pointer;"
                 title="Detay için tıkla — Bütçe vs Gerçekleşen">
                <h6 class="apya-overline mb-2">
                    <i class="fa fa-wallet me-1"></i>Bütçe Tüketimi
                    <i class="fa fa-up-right-from-square ms-1 text-primary" style="font-size:0.6rem;opacity:0.65;"></i>
                </h6>
                @if (Model.Project?.TotalBudget > 0)
                {
                    <div class="mb-1">
                        <span class="fw-bold apya-numeric" style="font-size:1rem;">
                            @Model.BudgetSpent.ToString("N0")
                        </span>
                        <span class="text-muted small apya-numeric"> / @Model.Project?.TotalBudget.ToString("N0")</span>
                    </div>
                    <div class="progress shadow-sm mb-1" style="height:6px;border-radius:4px;">
                        <div class="progress-bar @(Model.BudgetPercent > 90 ? "bg-danger" : Model.BudgetPercent > 60 ? "bg-warning" : "bg-success")"
                             style="width:@Model.BudgetPercent%"></div>
                    </div>
                    <small class="text-muted" style="font-size:0.7rem;">%@Model.BudgetPercent kullanıldı</small>
                }
                else
                {
                    <span class="text-muted small">Bütçe tanımsız</span>
                }
            </div>

            @* ── İlerleme + Ekip ── *@
            <div class="col-md-3 border-start ps-3">
                @* İlerleme *@
                <div class="mb-2">
                    <h6 class="apya-overline mb-1">Proje İlerlemesi</h6>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold fs-5 @(progressPct == 100 ? "text-success" : "text-primary")">%@progressPct</span>
                        <div class="progress flex-grow-1 shadow-sm" style="height:6px;border-radius:4px;">
                            <div class="progress-bar @(progressPct == 100 ? "bg-success" : "bg-primary progress-bar-striped progress-bar-animated")"
                                 style="width:@progressPct%"></div>
                        </div>
                    </div>
                    <small class="text-muted" style="font-size:0.7rem;">@completedTasks / @totalTasks Görev Bitti</small>
                </div>

                @* Ekip Avatarları *@
                <div>
                    <h6 class="apya-overline mb-1">Ekip (@assigneeCount)</h6>
                    <div class="avatar-group">
                        @for (int i = 0; i < facepileCount; i++)
                        {
                            <div class="avatar-circle"><i class="fa fa-user"></i></div>
                        }
                        @if (assigneeCount > 5)
                        {
                            <div class="avatar-circle more">+@(assigneeCount - 5)</div>
                        }
                        @if (facepileCount == 0)
                        {
                            <span class="text-muted small">Henüz atanan yok</span>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@* ─── Görev Listesi (View Tabs) ─── *@
<abp-card class="shadow-sm rounded-4 border-0">
    <abp-card-header class="bg-transparent border-bottom-0 pt-4 pb-0">
        <abp-row class="align-items-center">
            <abp-column size="_6">
                <!-- Tabs -->
                <ul class="nav nav-tabs border-0" id="projectViewTabs" role="tablist">
                    <li class="nav-item border-0" role="presentation">
                        <button class="nav-link active fw-bold border-0" id="list-tab" data-bs-toggle="tab" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="true">
                            <i class="fa fa-list me-2"></i>Liste
                        </button>
                    </li>
                    <li class="nav-item border-0 ms-3" role="presentation">
                        <button class="nav-link fw-bold border-0" id="board-tab" data-bs-toggle="tab" data-bs-target="#board-view" type="button" role="tab" aria-controls="board-view" aria-selected="false">
                            <i class="fa fa-columns me-2"></i>Kanban
                        </button>
                    </li>
                </ul>
            </abp-column>
            <abp-column size="_6" class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Create))
                {
                    <button id="btn-ai-task-generator"
                            class="btn btn-outline-primary btn-sm me-2"
                            data-project-id="@Model.Id"
                            title="PDF yükle, AI taslak görevlere bölsün, beğendiklerini onayla.">
                        <i class="fa fa-robot me-1"></i> AI ile Görev Oluştur
                    </button>
                    <button id="btn-create-task"
                            class="btn btn-primary btn-sm"
                            data-project-id="@Model.Id">
                        <i class="fa fa-plus me-1"></i> Yeni Görev Ekle
                    </button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>

    <abp-card-body class="pt-3">
        <div class="tab-content" id="projectViewTabsContent">
            
            @* --- LİSTE GÖRÜNÜMÜ --- *@
            <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">
                <div class="table-responsive mt-2">
                    <abp-table striped-rows="true" class="table-hover align-middle border" id="ProjectTasksTable"></abp-table>
                </div>
            </div>

            @* --- KANBAN BOARD GÖRÜNÜMÜ --- *@
            <div class="tab-pane fade" id="board-view" role="tabpanel" aria-labelledby="board-tab">
                @* Merkezi kanban markup'ı (tek kaynak) *@
                <partial name="_KanbanBoard" />
            </div>

        </div>
    </abp-card-body>
</abp-card>

@* ─── Danger Zone ─── *@
@if (await AuthorizationService.IsGrantedAsync("Platform.Projects.ManageTeam") || await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Delete))
{
    <div class="card mt-5 border-danger shadow-sm">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <i class="fa fa-exclamation-triangle fs-5 me-2"></i>
            <h5 class="mb-0 fw-bold" style="letter-spacing:1px;">TEHLİKELİ BÖLGE (DANGER ZONE)</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-1">Bu Projeyi Sil</h6>
                    <p class="text-muted mb-0 small">
                        Dikkat! Bir projeyi sildiğinizde projeye bağlı <strong>tüm görevler, alt görevler ve dosyalar kalıcı olarak silinir.</strong> Bu işlem geri alınamaz.
                    </p>
                </div>
                <div class="ms-4">
                    <button class="btn btn-outline-danger fw-bold shadow-sm"
                            id="btn-delete-project"
                            data-project-id="@Model.Id"
                            data-project-code="@Model.Project?.Code">
                        <i class="fa fa-trash me-2"></i>Projeyi Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
}
</div> @* /.apya-page *@

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <abp-script src="/js/apya-task-render.js" />
    <abp-script src="/js/apya-kanban.js" />
    <abp-script src="/Pages/Projects/ProjectDetails.js" />
}