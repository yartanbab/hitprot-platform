@model int
<div id="notification-bell-container" class="dropdown">
    <a class="nav-link dropdown-toggle" href="#" role="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa fa-bell"></i>
        <span id="notification-unread-badge" class="badge rounded-pill position-absolute top-0 start-100 translate-middle @(Model > 0 ? "" : "d-none")">
            @(Model > 99 ? "99+" : Model)
        </span>
    </a>
    <ul id="notification-list" class="dropdown-menu dropdown-menu-end p-0 shadow-lg" aria-labelledby="notificationDropdown">
        <li class="apya-notif-panel-bar d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <h6 class="mb-0">Bildirimler</h6>
            <a href="#" id="mark-all-as-read" class="text-xs">Tümünü oku</a>
        </li>
        <li id="notification-items-list">
            @* Bildirimler JS ile buraya yüklenecek *@
            <div class="text-center p-4">
                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
            </div>
        </li>
        <li class="apya-notif-panel-bar text-center border-top py-2">
            <a href="/Notifications" class="text-sm fw-bold">Tümünü gör</a>
        </li>
    </ul>
</div>

<style>
    /* Site-geneli bildirim zili (her sayfa header'ında) — token-driven. */
    #notification-bell-container .nav-link { position: relative; font-size: 1.25rem; color: var(--apya-text-secondary); transition: color var(--apya-motion-base) ease; }
    #notification-bell-container .nav-link:hover { color: var(--apya-text-primary); }
    #notification-list { min-width: 360px; max-height: 460px; overflow-y: auto; }

    /* Önem hiyerarşisi: "Önemli" bölümü üstte, kendi başlığıyla ayrılır. */
    /* Bölüm başlığı ve zaman damgası --apya-text-tertiary ile küçük puntoda
       2.31:1 kontrast veriyordu (AA eşiği 4.5:1) → secondary'ye alındı. */
    .apya-notif-section { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--apya-text-secondary); padding: 0.5rem 0.75rem 0.25rem; }

    .notification-item { display: flex; gap: 0.625rem; padding: 0.625rem 0.75rem; cursor: pointer;
        border-bottom: 1px solid var(--apya-border-subtle);
        border-left: 3px solid transparent;
        transition: background var(--apya-motion-base) ease; }
    .notification-item:hover { background-color: var(--apya-surface-raised); }
    .notification-item.unread { background-color: var(--apya-surface-sunken); }

    /* Aciliyet yalnız renkle değil, konumla da anlatılıyor (üstte "Önemli" bölümü). */
    .notification-item.sev-critical { border-left-color: var(--apya-negative-500); }
    .notification-item.sev-high     { border-left-color: var(--apya-warning-500); }

    .apya-notif-icon { flex: 0 0 auto; width: 1.75rem; height: 1.75rem; border-radius: 50%;
        display: grid; place-items: center; font-size: 0.75rem;
        background-color: var(--apya-surface-raised); color: var(--apya-text-secondary); }
    .notification-item.sev-critical .apya-notif-icon { color: var(--apya-negative-500); }
    .notification-item.sev-high     .apya-notif-icon { color: var(--apya-warning-500); }

    .apya-notif-body { min-width: 0; flex: 1 1 auto; }
    .apya-notif-title { font-size: 0.8125rem; font-weight: 600; color: var(--apya-text-primary);
        display: flex; align-items: center; gap: 0.375rem; }
    .notification-text { font-size: 0.8125rem; color: var(--apya-text-secondary);
        overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .notification-time { font-size: 0.6875rem; color: var(--apya-text-secondary); }

    /* Grup sayacı: "3 yeni yorum" yerine kompakt rozet. */
    .apya-notif-count { flex: 0 0 auto; font-size: 0.6875rem; font-weight: 600;
        padding: 0.05rem 0.35rem; border-radius: 999px;
        background-color: var(--apya-accent-600); color: #fff; }

    .apya-notif-empty { padding: 2rem 1rem; text-align: center;
        font-size: 0.8125rem; color: var(--apya-text-secondary); }

    /* Rozet: token'lı; kenarlık header zemininden ayırıyor. */
    #notification-unread-badge {
        padding: 0.25em 0.4em; font-size: 0.6rem; margin-top: 5px; margin-right: 5px;
        background-color: var(--apya-negative-500);
        border: 1px solid var(--apya-surface-header);
    }
    /* Panel başlık/alt çubuğu — token yüzeyi. */
    .apya-notif-panel-bar { background-color: var(--apya-surface-sunken); }
    .apya-notif-panel-bar a { color: var(--apya-text-primary); text-decoration: none; }
    .apya-notif-panel-bar a:hover { color: var(--apya-accent-500); }
    .apya-notif-panel-bar #mark-all-as-read { color: var(--apya-accent-500); }
</style>
