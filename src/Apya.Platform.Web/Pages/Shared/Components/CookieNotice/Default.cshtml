@model bool
@* Model = onaylandı mı? true ise şerit hiç basılmaz. *@
@if (!Model)
{
    <div id="apya-cookie-notice" role="region" aria-label="Çerez bilgilendirmesi"
         style="position:fixed;left:1rem;right:1rem;bottom:1rem;z-index:2000;max-width:520px;margin-inline:auto;
                background:var(--apya-surface,#fff);color:var(--apya-text,#1a1a2e);
                border:1px solid var(--apya-border,#e5e7eb);border-radius:14px;
                box-shadow:0 10px 30px rgba(0,0,0,.18);padding:1rem 1.15rem;
                font-family:var(--apya-font-sans,system-ui),sans-serif;font-size:.875rem;line-height:1.55;">
        <div style="display:flex;gap:.75rem;align-items:flex-start;">
            <span aria-hidden="true" style="font-size:1.25rem;line-height:1;">🍪</span>
            <div style="flex:1;">
                <p style="margin:0 0 .6rem;">
                    Bu platform yalnızca çalışması için gerekli <strong>zorunlu çerezleri</strong> kullanır;
                    üçüncü taraf izleme çerezi yoktur. Ayrıntı için
                    <a href="/gizlilik-politikasi" target="_blank" rel="noopener"
                       style="color:var(--apya-primary,#4f46e5);">Gizlilik Politikası</a>.
                </p>
                <div style="display:flex;gap:.5rem;justify-content:flex-end;">
                    <button type="button" id="apya-cookie-ack"
                            style="border:0;border-radius:9px;padding:.45rem 1.1rem;font-weight:600;cursor:pointer;
                                   background:var(--apya-primary,#4f46e5);color:#fff;font-size:.85rem;">
                        Anladım
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            var bar = document.getElementById('apya-cookie-notice');
            var btn = document.getElementById('apya-cookie-ack');
            if (!bar || !btn) { return; }
            btn.addEventListener('click', function () {
                btn.disabled = true;
                fetch('/consent/ack', { method: 'POST', credentials: 'same-origin' })
                    .catch(function () { /* rıza kaydı best-effort; şeridi yine de kapat */ })
                    .finally(function () { bar.remove(); });
            });
        })();
    </script>
}
