@*
    İlk giriş tanıtım turu. Yalnız kullanıcı turu tamamlamadıysa (veya ?tur=1 ile
    açıkça istediyse) render edilir — bkz. ProductTourViewComponent.

    Slayt görselleri wwwroot/tanitim/ altındadır ve docs/sunum/build/render.sh
    tarafından kopyalanır; elle konmaz. Görselin üzerindeki yazı telefon
    genişliğinde okunamayacağı için başlık (pencere başlığında) ve tek cümlelik
    özet (görselin altında) GERÇEK METİN olarak da basılır.
*@
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Components.ProductTour.ProductTourViewModel

<div class="modal fade apya-tour" id="apyaProductTour" tabindex="-1"
     aria-labelledby="apyaTourTitle" aria-hidden="true" data-count="@Model.Slides.Count">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="apya-tour-kicker">
                        @L["Tour:Kicker"] <span class="apya-tour-sep">·</span>
                        <span class="apya-tour-step">1</span>/@Model.Slides.Count
                    </div>
                    <h5 class="modal-title mb-0" id="apyaTourTitle"></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="@L["Tour:Close"].Value"></button>
            </div>

            <div class="modal-body">
                @for (var i = 0; i < Model.Slides.Count; i++)
                {
                    var slide = Model.Slides[i];
                    var title = L[slide.TitleKey].Value;
                    <figure class="apya-tour-slide" data-index="@i" data-title="@title" hidden>
                        <img src="~/tanitim/@slide.Image" alt="@title"
                             width="1600" height="900" decoding="async"
                             loading="@(i == 0 ? "eager" : "lazy")" />
                        <figcaption>@L[slide.BodyKey]</figcaption>
                    </figure>
                }
            </div>

            <div class="modal-footer">
                <a class="btn btn-outline-secondary btn-sm" href="@Model.PdfUrl" download>
                    @L["Tour:DownloadPdf"]
                </a>

                <div class="apya-tour-dots">
                    @for (var i = 0; i < Model.Slides.Count; i++)
                    {
                        <button type="button" class="apya-tour-dot" data-goto="@i"
                                aria-label="@L["Tour:GoToSlide", i + 1].Value"></button>
                    }
                </div>

                <div class="apya-tour-nav">
                    <button type="button" class="btn btn-link btn-sm apya-tour-skip"
                            data-bs-dismiss="modal">@L["Tour:Skip"]</button>
                    <button type="button" class="btn btn-outline-secondary apya-tour-prev">@L["Tour:Prev"]</button>
                    <button type="button" class="btn btn-primary apya-tour-next">@L["Tour:Next"]</button>
                    <button type="button" class="btn btn-primary apya-tour-done"
                            data-bs-dismiss="modal" hidden>@L["Tour:Done"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .apya-tour .modal-content { border: 0; }
    .apya-tour-kicker { font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; color: var(--lpx-primary, #37437d); margin-bottom: 4px; }
    .apya-tour-sep { opacity: .5; }
    .apya-tour .modal-body { padding-top: .5rem; }
    .apya-tour-slide { margin: 0; }
    .apya-tour-slide[hidden] { display: none; }
    .apya-tour-slide img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--apya-border-default, rgba(0,0,0,.1)); background: #fff; }
    .apya-tour-slide figcaption { margin-top: 14px; font-size: .95rem; line-height: 1.5; color: var(--apya-text-secondary, #4B5563); }

    /* Bootstrap footer'ı sağa yaslar; burada üç grup var: indir · noktalar · gezinme. */
    .apya-tour .modal-footer { justify-content: space-between; gap: 12px; }
    .apya-tour-dots { display: flex; gap: 7px; align-items: center; }
    .apya-tour-dot { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: var(--apya-border-strong, #cbd0d6); cursor: pointer; transition: background .15s, transform .15s; }
    .apya-tour-dot[aria-current="true"] { background: var(--lpx-primary, #37437d); transform: scale(1.35); }
    .apya-tour-nav { display: flex; gap: 8px; align-items: center; }

    @@media (max-width: 991.98px) {
        /* Fullscreen modda noktalar yer kaplamasın, gezinme tam genişlik alsın. */
        .apya-tour .modal-footer { justify-content: center; }
        .apya-tour-dots { order: -1; width: 100%; justify-content: center; }
    }
    @@media (max-width: 575.98px) {
        .apya-tour-nav { flex: 1; }
        .apya-tour-nav .btn { flex: 1; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .apya-tour-dot { transition: none; }
    }
</style>

<script>
    (function () {
        var el = document.getElementById('apyaProductTour');
        if (!el || typeof bootstrap === 'undefined') { return; }

        var slides = Array.prototype.slice.call(el.querySelectorAll('.apya-tour-slide'));
        var dots = Array.prototype.slice.call(el.querySelectorAll('.apya-tour-dot'));
        if (!slides.length) { return; }

        var titleEl = el.querySelector('.modal-title');
        var stepEl = el.querySelector('.apya-tour-step');
        var prevBtn = el.querySelector('.apya-tour-prev');
        var nextBtn = el.querySelector('.apya-tour-next');
        var doneBtn = el.querySelector('.apya-tour-done');
        var skipBtn = el.querySelector('.apya-tour-skip');
        var last = slides.length - 1;
        var index = 0;

        function render() {
            slides.forEach(function (s, i) { s.hidden = i !== index; });
            dots.forEach(function (d, i) { d.setAttribute('aria-current', i === index ? 'true' : 'false'); });
            titleEl.textContent = slides[index].getAttribute('data-title') || '';
            stepEl.textContent = index + 1;
            prevBtn.disabled = index === 0;
            // Son slaytta "İleri" yerini "Bitir"e bırakır; "Atla" da gereksizleşir.
            nextBtn.hidden = index === last;
            doneBtn.hidden = index !== last;
            skipBtn.hidden = index === last;
            el.querySelector('.modal-body').scrollTop = 0;
        }

        function go(i) { index = Math.min(last, Math.max(0, i)); render(); }

        prevBtn.addEventListener('click', function () { go(index - 1); });
        nextBtn.addEventListener('click', function () { go(index + 1); });
        dots.forEach(function (d) {
            d.addEventListener('click', function () { go(parseInt(d.getAttribute('data-goto'), 10)); });
        });
        el.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { go(index + 1); }
            else if (e.key === 'ArrowLeft') { go(index - 1); }
        });

        // Görülme işareti: kapanış nasıl olursa olsun (Bitir, Atla, Esc, çarpı)
        // bir kez yazılır — kullanıcı turu ikinci kez zorla izlemesin.
        var marked = false;
        el.addEventListener('hide.bs.modal', function () {
            if (marked) { return; }
            marked = true;
            try { fetch('/product-tour/mark-seen', { method: 'POST' }); } catch (e) { }
        });

        render();
        new bootstrap.Modal(el).show();

        // Menüden ?tur=1 ile gelindiyse adresi temizle: yenilemede tekrar açılmasın.
        if (window.history && history.replaceState && /[?&]tur=1(&|$)/.test(location.search)) {
            var q = location.search.replace(/([?&])tur=1(&|$)/, '$1').replace(/[?&]$/, '');
            history.replaceState(null, '', location.pathname + q + location.hash);
        }
    })();
</script>
