@using Microsoft.Extensions.Localization
@using Apya.Platform.Localization
@inject IStringLocalizer<PlatformResource> L
@*
    Site-wide tema head — LayoutHooks.Head.Last ile her sayfanın <head>'ine enjekte edilir.
    Token'lar + köprü global stil bundle'ında; burada yalnız PWA head + FOUC engelleme.
*@
<link rel="manifest" href="@Url.Content("~/manifest.webmanifest")" />
<meta name="theme-color" content="#F5F5F5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0A0A0B" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="@Url.Content("~/icons/apya-icon.svg")" />
<link rel="apple-touch-icon" href="@Url.Content("~/icons/apya-icon.svg")" />

@*
    FOUC engelleme — ThemeProvider/dark-mode.js mount olmadan ÖNCE (paint öncesi) çalışır.
    Çözüm: kayıtlı tercih ('apya-theme') || OS tercihi → <html data-theme> + LeptonX class mirror.
    Tüm kontrolcüler aynı 'apya-theme' anahtarını okur (bu FOUC, dark-mode.js, React ThemeProvider).
*@
<script>
    (function () {
        try {
            var html = document.documentElement;
            // JS-var işareti: header'daki ham içerik gizleme kuralları (apya-theme-bridge.css
            // "html.js" seçicileri) bu sınıf yoksa devre dışı kalır → JS çalışmazsa güvenli geri dönüş.
            html.classList.add('js');
            // Auth/account sayfaları (login, register, forgot-password) tema-nötr LIGHT tutulur:
            // LeptonX account layout redesign kapsamı dışında; dark'ta başlık/kart kontrast bozuluyor.
            var isAuthPage = /^\/Account\//i.test(location.pathname);
            var stored = null;
            try { stored = localStorage.getItem('apya-theme'); } catch (e) { }
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var resolved = isAuthPage
                ? 'light'
                : ((stored === 'dark' || (stored !== 'light' && prefersDark)) ? 'dark' : 'light');
            html.setAttribute('data-theme', resolved);
            html.classList.remove('lpx-theme-light', 'lpx-theme-dark', 'lpx-theme-dim');
            html.classList.add(resolved === 'dark' ? 'lpx-theme-dark' : 'lpx-theme-light');

            // Yoğunluk (density) — kayıtlı tercih || cozy (varsayılan).
            var density = 'cozy';
            try { density = localStorage.getItem('apya-density') || 'cozy'; } catch (e) { }
            html.setAttribute('data-density', density);

            // Kenar çubuğu modu — sabit (yok) / dinamik (collapsed) / kapalı (hidden).
            // Kayıtlı tercih kendi anahtarımızda ('apya-sidebar-mode'); geriye dönük
            // uyum için LeptonX'in kendi yazdığı 'lpx:side-menu-state' ('1'=ray)
            // yedek olarak okunur. Tema bu durumu yüklemede geri UYGULAMAZ (Lite gap)
            // → pre-paint burada attribute'la uygulanır; class senkronu ve mod
            // seçicisi sidebar-toggle.js'te. CSS: apya-theme-bridge.css
            // "SIDEBAR COLLAPSE" bölümü.
            if (!isAuthPage) {
                var mode = null;
                try { mode = localStorage.getItem('apya-sidebar-mode'); } catch (e) { }
                if (!mode) {
                    var side = null;
                    try { side = localStorage.getItem('lpx:side-menu-state'); } catch (e) { }
                    mode = (side === '1') ? 'dynamic' : 'pinned';
                }
                if (mode === 'dynamic') { html.setAttribute('data-sidebar', 'collapsed'); }
                else if (mode === 'hidden') { html.setAttribute('data-sidebar', 'hidden'); }

                // Mobil kabuk varyantı — çekmece (varsayılan) / alt sekme.
                // Kenar çubuğu modunun birebir ikizi: SoT <html data-mobile-shell>,
                // kalıcılık 'apya-mobile-shell', uygulama sidebar-toggle.js'te.
                // Attribute paint ÖNCESİ yazılır ki iki varyant arası geçiş
                // sayfa yenilemede yanıp sönmesin (CSS ikisini de bu attribute ile ayırır).
                var shell = null;
                try { shell = localStorage.getItem('apya-mobile-shell'); } catch (e) { }
                html.setAttribute('data-mobile-shell', shell === 'tabs' ? 'tabs' : 'drawer');

                // Kenar çubuğu genişliği — kullanıcı tutamakla ayarlamışsa. Paint'ten
                // ÖNCE yazılır, yoksa her yenilemede menü 320px'ten seçilen
                // genişliğe zıplar. Sınırlar apya-sidebar-resize.js ile aynı;
                // localStorage elle kurcalanmış olabilir.
                var sidebarWidth = null;
                try { sidebarWidth = parseInt(localStorage.getItem('apya-sidebar-width'), 10); } catch (e) { }
                if (sidebarWidth >= 200 && sidebarWidth <= 420) {
                    html.style.setProperty('--apya-sidebar-w', sidebarWidth + 'px');
                }
            }
        } catch (e) { /* sessizce devam */ }
    })();
</script>

@*
    Mobil kabuğun metinleri — sidebar-toggle.js bu bloğu okur, JS'e metin gömülmez
    (SidebarModeToggle'daki data-label-* deseninin çok anahtarlı karşılığı; mobil
    barda bizim bir view'umuz olmadığı için etiketler head'e JSON olarak iner).
    "Short.*" anahtarları alt sekme etiketleridir: anahtar = menü öğesinin adı,
    karşılığı yoksa JS menüdeki tam adı kullanır.
*@
<script type="application/json" id="ApyaMobileShellL10n">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new System.Collections.Generic.Dictionary<string, string>
    {
        ["menu"] = L["MobileShell:Menu"].Value,
        ["close"] = L["MobileShell:Close"].Value,
        ["open"] = L["MobileShell:Open"].Value,
        ["back"] = L["MobileShell:Back"].Value,
        ["groupDaily"] = L["MobileShell:GroupDaily"].Value,
        ["groupOther"] = L["MobileShell:GroupOther"].Value,
        ["more"] = L["MobileShell:More"].Value,
        ["search"] = L["MobileShell:Search"].Value,
        ["notifications"] = L["MobileShell:Notifications"].Value,
        ["account"] = L["MobileShell:Account"].Value,
        ["themeDark"] = L["MobileShell:ThemeDark"].Value,
        ["themeLight"] = L["MobileShell:ThemeLight"].Value,
        ["settings"] = L["MobileShell:Settings"].Value,
        ["logout"] = L["MobileShell:Logout"].Value,
        ["short.Apya.Dashboard"] = L["MobileShell:Short.Apya.Dashboard"].Value,
        ["short.Apya.Work"] = L["MobileShell:Short.Apya.Work"].Value,
        ["short.Apya.Finance"] = L["MobileShell:Short.Apya.Finance"].Value,
        ["short.Apya.Reports"] = L["MobileShell:Short.Apya.Reports"].Value,
        // Kenar çubuğu genişlik tutamağının erişilebilirlik etiketi. Tek etiket
        // için ayrı bir JSON bloğu açmak yerine kabuğun mevcut sözlüğüne biner.
        ["sidebarWidth"] = L["Shell:SidebarWidth"].Value
    }))
</script>
