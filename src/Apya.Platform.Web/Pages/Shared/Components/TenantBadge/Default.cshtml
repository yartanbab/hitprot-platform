@model Apya.Platform.Web.Components.TenantBadge.TenantBadgeViewModel
@*
    Header müşteri (tenant) rozeti / değiştiricisi — hedef tasarımdaki "Host ⌄" pili.
    (Önceki hali sidebar'da logo altında duran, tıklanamaz bir rozetti.)

    Yetkisiz kullanıcı: tıklanamaz düz rozet — yalnız kendi tenant adı.
    Yetkili kullanıcı:  açılır liste + ABP'nin /Account/ImpersonateTenant POST'u.

    FOUC önleme: header toolbar'ına taşınana kadar gizli (aşağıdaki senkron
    script Body.Last'ta çalışır, topbar o an DOM'da hazırdır).
*@
@{
    // Baş harf — hedef tasarımda pilin solunda koyu kare rozet duruyor
    // (matara ikonunun yerini aldı: ikon hangi kiracıda olduğunu söylemiyordu).
    // Türkçe kültürle büyütülür: "istanbul" → "İ", "ısparta" → "I".
    var tenantInitial = string.IsNullOrWhiteSpace(Model.TenantName)
        ? "?"
        : Model.TenantName.Trim().Substring(0, 1).ToUpper(new System.Globalization.CultureInfo("tr-TR"));
}
<div id="apya-tenant-switch" class="apya-tenant-switch @(Model.CanSwitch ? "dropdown" : "")" style="display:none">
    @if (Model.CanSwitch)
    {
        <button type="button" class="apya-tenant-switch-btn" data-bs-toggle="dropdown" aria-expanded="false"
                title="Müşteri değiştir">
            <span class="apya-tenant-switch-initial" aria-hidden="true">@tenantInitial</span>
            <span class="apya-tenant-switch-name">@Model.TenantName</span>
            <i class="fa fa-chevron-down apya-tenant-switch-caret" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end apya-tenant-switch-menu">
            <li class="apya-tenant-switch-head">
                <span class="apya-overline">Müşteri (Tenant)</span>
                @if (Model.TenantCount.HasValue)
                {
                    <span class="apya-tenant-switch-count apya-numeric">@Model.TenantCount</span>
                }
            </li>

            @if (Model.IsImpersonated)
            {
                <li>
                    <form method="post" action="/Account/BackToImpersonator">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item apya-tenant-switch-back">
                            <i class="fa fa-arrow-rotate-left" aria-hidden="true"></i> Asıl hesabıma dön
                        </button>
                    </form>
                </li>
                <li><hr class="dropdown-divider"></li>
            }

            @* Geri dönüş yolu BackToImpersonator'dır (yukarıda); burada yalnız
               geçilebilecek tenant'lar listelenir. *@
            @foreach (var t in Model.Tenants)
            {
                var isCurrent = Model.CurrentTenantId == t.Id;
                <li>
                    <form method="post" action="/Account/ImpersonateTenant">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TenantId" value="@t.Id" />
                        <button type="submit" class="dropdown-item @(isCurrent ? "active" : "")" disabled="@isCurrent">
                            <span class="apya-tenant-switch-item-name">@t.Name</span>
                            @if (isCurrent)
                            {
                                <i class="fa fa-check" aria-hidden="true"></i>
                            }
                        </button>
                    </form>
                </li>
            }

            @if (Model.HasMore)
            {
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item apya-tenant-switch-more" href="/TenantManagement/Tenants">
                        Tümünü gör &rarr;
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <span class="apya-tenant-switch-btn apya-tenant-switch-btn--static" title="Müşteri">
            <span class="apya-tenant-switch-initial" aria-hidden="true">@tenantInitial</span>
            <span class="apya-tenant-switch-name">@Model.TenantName</span>
        </span>
    }
</div>
@* Body.Last'ta çalışır → header toolbar'ı bu noktada DOM'da hazır. jQuery
   ready'yi beklemeden, ilk paint'ten ÖNCE taşınıp gösterilir (layout shift yok).
   Toolbar yoksa rozet olduğu yerde gizli kalır — sayfa bozulmaz. *@
<script>
    (function () {
        var el = document.getElementById('apya-tenant-switch');
        var bar = document.querySelector('.lpx-topbar-content');
        if (el && bar) {
            bar.appendChild(el);   // sıra CSS flex `order` ile (bkz. apya-theme-bridge.css)
            el.style.display = '';
        }
    })();
</script>
