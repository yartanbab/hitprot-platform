@*
    Ortak boş durum (tek kaynak) — boş liste/veri, yükleme hatası ve kilit durumları.
    Görsel sözleşme apya-shell.css .apya-console-state: ikon balonu + başlık + açıklama +
    isteğe bağlı eylem. JS karşılığı apya.loadState.errorHtml, React karşılığı
    components/ui/EmptyState.jsx. Id / CssClass KÖKE basılır — JS kancaları
    (NoSubTasksPlaceholder, no-file-text) ona bağlı.
    Kullanım:
      <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-comments", Title = "Henüz yorum yapılmamış." }' />
    Eylemli (CTA): ActionText + ActionIcon + ActionAttributes (data-* kancası; parça yeniden
    basılıyorsa JS sarmalayıcıya delege bağlar) — örnek CashAccounts/_AccountSummary.cshtml.
    ActionUrl verilirse eylem <a href>, yoksa <button type="button">.
    Hata: Variant = EmptyStateVariant.Error → soluk balon + uyarı üçgeni + role="alert"; eylem
    kanonik "Tekrar dene" (btn-outline-primary + fa-rotate-right). Kilit: EmptyStateVariant.Locked.
    Hatanın varsayılan metinleri burada (model yerelleştirmeye erişmez; errorHtml / React ile aynı):
    Description null → Common:FetchError ("" → açıklama yok); eylem hedefi (ActionUrl ya da
    ActionAttributes kancası) verilip ActionText boşsa → Common:Retry.
    Tam sayfa (hata sayfası, /AccessDenied): EmptyStateVariant.Page + ErrorStates → başlık sayfa
    başlığıdır, Kind (data-apya-state; yalnız doluyken basılır), Details/Hint/Footnote, SecondaryActions.
    Geri/yeniden yükle (EmptyStateAction.Back/Retry) YALNIZ tam sayfada (Page) basılır ve aşağıdaki
    küçük betiğe bağlanır: betik kökü document.currentScript ile bulur, AJAX (jQuery .html(),
    ModalManager) ya da innerHTML ile eklenen parçada çalışmaz (gizli "Geri", ölü "Tekrar dene").
*@
@using Apya.Platform.Web.Pages.Shared
@model Apya.Platform.Web.Pages.Shared.EmptyStateModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    if (Model.Variant == EmptyStateVariant.Error)
    {
        Model.Description ??= L["Common:FetchError"].Value;
        if (string.IsNullOrWhiteSpace(Model.ActionText)
            && (!string.IsNullOrEmpty(Model.ActionUrl) || Model.ActionAttributes is { Count: > 0 }))
        {
            Model.ActionText = L["Common:Retry"].Value;
        }
    }
    var action = Model.BuildAction();
    var secondaryActions = Model.BuildSecondaryActions();
    // data-* öznitelikleri Razor'da koşullu DEĞİL (null değerde de ="" basılır): yalnız Kind doluyken,
    // önündeki boşlukla birlikte — Kind'sız kök G5 öncesiyle birebir aynı basılır.
    var kindAttribute = string.IsNullOrEmpty(Model.Kind)
        ? null
        : Html.Raw(" data-apya-state=\"" + Html.Encode(Model.Kind) + "\"");
}

<div class="apya-console-state @Model.CssClass" id="@Model.Id" role="@Model.Role"@kindAttribute>
    <span class="apya-console-state-icon @(Model.IsMuted ? "is-muted" : null)"><i class="fa @Model.IconClass" aria-hidden="true"></i></span>
    <strong role="@(Model.IsPageHeading ? "heading" : null)" aria-level="@(Model.IsPageHeading ? "1" : null)">@Model.Title</strong>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p>@Model.Description</p>
    }
    @if (Model.Details is { Count: > 0 })
    {
        <ul class="small text-start mb-0">
            @foreach (var detail in Model.Details)
            {
                <li>@detail</li>
            }
        </ul>
    }
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <p>@Model.Hint</p>
    }
    @if (action != null || secondaryActions.Count > 0)
    {
        <span class="apya-console-state-actions">@(action)@foreach (var secondary in secondaryActions) { @secondary }</span>
    }
    @if (!string.IsNullOrEmpty(Model.Footnote))
    {
        <p class="apya-numeric">@Model.Footnote</p>
    }
</div>
@if (Model.HasClientHooks)
{
    @* Yalnız tam sayfa (Page). jQuery'siz (sayfa demetinden önce çalışır); yalnız kendi kökünü bağlar.
       Geçmiş yoksa (yeni sekme) "Geri dön" gizli kalır; JS yoksa da gizlidir. *@
    <script>
        (function () {
            var root = document.currentScript && document.currentScript.previousElementSibling;
            if (!root) { return; }
            var back = root.querySelector('[data-apya-back]');
            if (back && window.history.length > 1) {
                back.hidden = false;
                back.addEventListener('click', function () { window.history.back(); });
            }
            var retry = root.querySelector('[data-apya-retry]');
            if (retry) {
                retry.addEventListener('click', function () { window.location.reload(); });
            }
        })();
    </script>
}
