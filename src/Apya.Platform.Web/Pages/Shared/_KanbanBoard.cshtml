@*
    Merkezi Kanban board markup'ı (tek kaynak).
    Projeler / Görevler (/Board) / Tasks sayfaları bu partial'ı kullanır.
    4 sistem kolonu (TaskStatus 1-4). Özel kolonlar ve count'lar sayfa JS'i
    tarafından doldurulur; sınıf/ID'ler tüm sayfalarda aynıdır.
    Tasarım: /css/kanban.css
*@
<div class="kanban-board mt-2">
    <!-- Yapılacak (Todo=1) -->
    <div class="kanban-column" data-status-id="1">
        <div class="kanban-header">
            <span class="text-secondary"><i class="fa fa-circle me-2"></i>Yapılacak</span>
            <span class="apya-chip apya-chip-neutral kanban-count">0</span>
        </div>
        <div class="kanban-cards" id="kanban-todo"></div>
    </div>

    <!-- Sürüyor (InProgress=2) -->
    <div class="kanban-column" data-status-id="2">
        <div class="kanban-header">
            <span class="text-warning-emphasis"><i class="fa fa-circle me-2"></i>Sürüyor</span>
            <span class="apya-chip apya-chip-warning kanban-count">0</span>
        </div>
        <div class="kanban-cards" id="kanban-inprogress"></div>
    </div>

    <!-- Testte (InReview=3) -->
    <div class="kanban-column" data-status-id="3">
        <div class="kanban-header">
            <span class="text-info"><i class="fa fa-circle me-2"></i>Testte</span>
            <span class="apya-chip apya-chip-brand kanban-count">0</span>
        </div>
        <div class="kanban-cards" id="kanban-inreview"></div>
    </div>

    <!-- Tamamlandı (Done=4) -->
    <div class="kanban-column" data-status-id="4">
        <div class="kanban-header">
            <span class="text-success"><i class="fa fa-check-circle me-2"></i>Tamamlandı</span>
            <span class="apya-chip apya-chip-positive kanban-count">0</span>
        </div>
        <div class="kanban-cards" id="kanban-done"></div>
    </div>
</div>
