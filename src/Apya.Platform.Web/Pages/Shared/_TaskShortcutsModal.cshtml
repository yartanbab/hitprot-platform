@*
    Klavye kısayolları penceresi — görev konsolu ve Görevler sayfası ortak.
    Kablolama /js/apya-task-console.js → bindShortcuts() içinde (#shortcuts-modal).

    canBulk / canChangeStatus satırları yetkiye göre gizlenir: kullanıcının
    yapamayacağı bir kısayolu listelemek yanıltıcı olur.
*@
@model Apya.Platform.Web.Pages.Shared.TaskShortcutsModalModel

<div class="modal fade" id="shortcuts-modal" tabindex="-1" aria-labelledby="shortcuts-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content apya-console-shortcuts">
            <div class="modal-header">
                <span class="apya-console-state-icon is-sm"><i class="fa fa-keyboard" aria-hidden="true"></i></span>
                <h5 class="modal-title ms-2" id="shortcuts-title">Klavye kısayolları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="apya-console-shortcuts-grid">
                    <div>
                        <span class="apya-console-popover-label">Liste</span>
                        <div class="apya-console-shortcut"><kbd>j</kbd><kbd>k</kbd><span>Satırlar arasında gez</span></div>
                        <div class="apya-console-shortcut"><kbd>↵</kbd><span>Görev detayını aç</span></div>
                        @if (Model.CanBulk)
                        {
                            <div class="apya-console-shortcut"><kbd>x</kbd><span>Satırı seç (toplu işlem)</span></div>
                        }
                        @if (Model.CanChangeStatus)
                        {
                            <div class="apya-console-shortcut"><kbd>1</kbd>–<kbd>4</kbd><span>Odaklı görevin durumunu değiştir</span></div>
                        }
                        <div class="apya-console-shortcut"><kbd>/</kbd><span>Arama alanına odaklan</span></div>
                    </div>
                    <div>
                        <span class="apya-console-popover-label">Görünüm &amp; genel</span>
                        <div class="apya-console-shortcut"><kbd>g</kbd> <kbd>l</kbd><span>Liste görünümü</span></div>
                        <div class="apya-console-shortcut"><kbd>g</kbd> <kbd>k</kbd><span>Kanban görünümü</span></div>
                        <div class="apya-console-shortcut"><kbd>n</kbd><span>Yeni görev</span></div>
                        <div class="apya-console-shortcut"><kbd>?</kbd><span>Bu pencere</span></div>
                        <div class="apya-console-shortcut"><kbd>Esc</kbd><span>Panel / pencereyi kapat</span></div>
                    </div>
                </div>
                <p class="apya-console-popover-note mt-3">
                    Kısayollar bir metin alanına yazarken veya bir pencere açıkken devre dışıdır.
                </p>
            </div>
        </div>
    </div>
</div>
