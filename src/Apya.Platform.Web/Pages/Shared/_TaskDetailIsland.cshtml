@* Görev detay modalı — Tasks/Board/ProjectDetails sayfalarının ortak mount noktası.
   Island açılana kadar hiçbir şey render etmez (taskDetailStore boşken null döner).
   data-taskui: kullanıcının "Genel Ayarlar"da seçtiği arayüz tercihi, sunucuda çözülür
   ("v2" = yeni modal varsayılan, "v1" = eski drawer). task-detail.jsx bunu okur. *@
@inject Volo.Abp.Settings.ISettingProvider SettingProvider
@{
    var taskUi = await SettingProvider.GetOrNullAsync(Apya.Platform.Settings.PlatformSettings.TaskDetail.Ui) ?? "v2";
}
<div id="task-detail-island" data-taskui="@taskUi"></div>

@* Kuyruk köprüsü: jQuery script'leri (index.js vb.) ES module yüklenmeden önce
   window.apya.taskDetail.open(id) çağırırsa bu fonksiyon ID'yi kuyruğa alır.
   Module yüklenince window.apya.taskDetail gerçek store'u referanslar ve kuyruk
   boşaltılır. *@
<script>
    (function () {
        window.apya = window.apya || {};
        if (window.apya.taskDetail) return; // zaten yüklendiyse dokunma

        var _pendingId = null;
        // Geçici placeholder: tıklama anında module henüz yüklenmediyse ID'yi sakla
        window.apya.taskDetail = {
            open: function (arg) {
                var id = typeof arg === 'string' ? arg : (arg && arg.id ? arg.id : null);
                if (!id) return;
                _pendingId = id;
                // Module yüklendiyse hemen tetikle
                if (window.apya._taskDetailReady) {
                    window.apya._taskDetailReady(id);
                }
            },
            close: function () { },
            onResult: function () { }
        };
        // Module yüklenince bu fonksiyonu çağırır; kuyrukta bekleyen varsa açar
        window.apya._taskDetailFlush = function (openFn) {
            window.apya.taskDetail = openFn; // gerçek store bağlandı
            window.apya._taskDetailReady = function (id) { openFn.open(id); };
            if (_pendingId) {
                openFn.open(_pendingId);
                _pendingId = null;
            }
        };
    })();
</script>
@* Preload, script ile YAN YANA: bu partial sayfa sonunda çağrılıyor, daha
   erken bir çapası yok. Yine de chunk grafiği entry ile paralel iner —
   entry ayrıştırılıp bağımlılıkların keşfedilmesi beklenmez. *@
<island-preload entry="task-detail" />
<script type="module" src="~/js/task-detail.js" asp-append-version="true"></script>
