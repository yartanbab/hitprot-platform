@*
    APYA Theme Bootstrap Partial (React island sayfaları için)
    -----------------------------------------------------------------------
    İçerik:
      - PWA manifest + theme-color meta + icon
      - FOUC engelleme inline script (data-theme + LeptonX class mirror)
      - js/style.css (React island Tailwind utility'leri)

    NOT: Token'lar (tokens.css) ve LeptonX/Bootstrap köprüsü
    (apya-theme-bridge.css) artık GLOBAL stil bundle'ında
    (PlatformWebModule.ConfigureBundles) — burada tekrar yüklenmez.

    Kullanım:
      <partial name="_ApyaThemeBootstrap" />
*@

<link rel="manifest" href="~/manifest.webmanifest" />
<meta name="theme-color" content="#2563EB" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="~/icons/apya-icon.svg" />
<link rel="apple-touch-icon" href="~/icons/apya-icon.svg" />

@* React island stylesheet — Tailwind utility'leri (token'ları da içerir;
   global bundle'la çakışmaz, aynı değerler). *@
<link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />

@*
    FOUC engelleme — ThemeProvider mount olmadan ÖNCE çalışır.
    data-theme attribute'unu set eder + LeptonX class'larını mirror eder.
    LeptonX kendi cookie'sini görse de bizim attribute öncelikli olur.
*@
<script>
    (function () {
        try {
            /* DARK MODE GEÇİCİ OLARAK DEVRE DIŞI (2026-06-09)
               OS'i dark olan + tema seçmemiş kullanıcılar varsayılan dark açılıyordu;
               dark CSS köprüsü butonları tam kapsamadığından "beyaz buton / görünmez
               yazı" regresyonu (tüm platform). Tüm kontrolcüler (bu FOUC, dark-mode.js,
               React ThemeProvider) aynı 'apya-theme' anahtarını okur → erkenden 'light'
               yazıp sabitliyoruz. AÇMAK İÇİN: aşağıdaki OS-duyarlı bloğu geri getir +
               dark-mode.js -> DARK_MODE_ENABLED = true. */
            var html = document.documentElement;
            localStorage.setItem('apya-theme', 'light');
            html.setAttribute('data-theme', 'light');
            html.classList.remove('lpx-theme-light', 'lpx-theme-dark', 'lpx-theme-dim');
            html.classList.add('lpx-theme-light');

            /* --- ESKİ (OS-duyarlı) ÇÖZÜM — dark yeniden açılınca geri getir:
            var stored = localStorage.getItem('apya-theme');
            var prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var resolved = stored === 'dark' || (stored !== 'light' && prefers) ? 'dark' : 'light';
            html.setAttribute('data-theme', resolved);
            html.classList.remove('lpx-theme-light', 'lpx-theme-dark', 'lpx-theme-dim');
            html.classList.add(resolved === 'dark' ? 'lpx-theme-dark' : 'lpx-theme-light');
            --- */
        } catch (_) { /* sessizce devam */ }
    })();
</script>
