@*
    APYA Theme Bootstrap Partial
    -----------------------------------------------------------------------
    Her sayfanın <head>'inde olmalı:
      - PWA manifest + theme-color meta + icon
      - FOUC engelleme inline script (data-theme + LeptonX class mirror)
      - apya-theme-bridge.css link (LeptonX/Bootstrap dark mode köprüsü)
      - apya-tokens.css link (React island'la aynı --apya-* tokens, Razor için)

    Kullanım:
      <partial name="_ApyaThemeBootstrap" />

    Site-wide adopsiyon: bu partial'ı LeptonX layout override'ında çağır
    (örn. Pages/Shared/Components/Layouts/_Layout.cshtml içinde @section Head
    ya da BrandingProvider extension).
*@

<link rel="manifest" href="~/manifest.webmanifest" />
<meta name="theme-color" content="#2563EB" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="~/icons/apya-icon.svg" />
<link rel="apple-touch-icon" href="~/icons/apya-icon.svg" />

@* Bridge: LeptonX/Bootstrap değişkenleri Apya tokens'a bağlar *@
<link rel="stylesheet" href="~/css/apya-theme-bridge.css" asp-append-version="true" />

@* React island stylesheet — aynı tokens.css'i içerir, Razor sayfaları da
   bu sayede --apya-* değişkenlerine erişebilir. *@
<link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />

@*
    FOUC engelleme — ThemeProvider mount olmadan ÖNCE çalışır.
    data-theme attribute'unu set eder + LeptonX class'larını mirror eder.
    LeptonX kendi cookie'sini görse de bizim attribute öncelikli olur.
*@
<script>
    (function () {
        try {
            var stored = localStorage.getItem('apya-theme');
            var prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var resolved = stored === 'dark' || (stored !== 'light' && prefers) ? 'dark' : 'light';
            var html = document.documentElement;
            html.setAttribute('data-theme', resolved);
            /* LeptonX class mirror — eski sayfalar (jQuery + .card + .table) da koyu */
            html.classList.remove('lpx-theme-light', 'lpx-theme-dark', 'lpx-theme-dim');
            html.classList.add(resolved === 'dark' ? 'lpx-theme-dark' : 'lpx-theme-light');
        } catch (_) { /* sessizce devam */ }
    })();
</script>
