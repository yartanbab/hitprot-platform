@*
    Ortak KPI kartı (tek kaynak) — gösterge sayfalarındaki metrik kartları.
    Kullanım:
      <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-clock", Accent = "positive", Label = "Toplam Efor", ValueId = "KpiTotalHours", Value = "0s" }' />
    Kart çerçevesi (radius/gölge) apya-theme-bridge'in .card kuralından gelir.
*@
@using System.Text.Encodings.Web
@model Apya.Platform.Web.Pages.Shared.KpiCardModel
@{
    // Href verilmişse kart bir bağlantıyla sarılır — metrikten kaynağı olan
    // listeye gitmek için. Verilmemişse çıktı eskisiyle birebir aynı kalır.
    // Sarmalayıcı Html.Raw ile basılır: Razor'ın HTML ayrıştırıcısı @if içinde
    // dengesiz etiket kabul etmiyor.
    var enc = HtmlEncoder.Default;
    var linkOpen = string.IsNullOrEmpty(Model.Href)
        ? null
        : Html.Raw($"<a class=\"apya-kpi-card-link\" href=\"{enc.Encode(Model.Href)}\" " +
                   $"title=\"{enc.Encode(Model.HrefTitle ?? Model.Label)}\">");
}
@linkOpen
<div class="card h-100">
    <div class="card-body d-flex align-items-center">
        <div class="kpi-icon-box kpi-icon-box--@Model.Tone me-3">
            <i class="fa @Model.Icon"></i>
        </div>
        <div class="kpi-card-text">
            @* Hint verilince ikon truncate'in DIŞINDA kalmalı — aksi halde uzun
               etiketlerde etiketle birlikte kırpılıyor. *@
            @if (string.IsNullOrEmpty(Model.Hint))
            {
                <div class="apya-overline mb-1 text-truncate" title="@Model.Label">@Model.Label</div>
            }
            else
            {
                <div class="apya-overline mb-1 d-flex align-items-center">
                    <span class="text-truncate" title="@Model.Label">@Model.Label</span>
                    <apya-hint text="@Model.Hint" />
                </div>
            }
            <h3 class="fw-bold mb-0 apya-numeric text-truncate" id="@Model.ValueId" title="@Model.Value">
                @if (Model.ValueHtml != null) { @Model.ValueHtml } else { @Model.Value }
            </h3>
            @if (!string.IsNullOrEmpty(Model.SubText))
            {
                <small class="text-muted text-truncate d-block">@Model.SubText</small>
            }
        </div>
        @if (linkOpen != null)
        {
            <i class="fa fa-chevron-right ms-auto ps-2 apya-kpi-card-chevron" aria-hidden="true"></i>
        }
    </div>
</div>
@if (linkOpen != null) { @Html.Raw("</a>") }
