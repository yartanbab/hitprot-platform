@page
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Accounts
@using Apya.Platform.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@using Volo.Abp.Identity
@model Apya.Platform.Web.Pages.Account.ApyaLoginModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<PlatformResource> PL
@inject ILoginScreenSettingsAppService LoginScreenSettings
@{
    Layout = "~/Pages/Account/_ApyaAccountLayout.cshtml";
    ViewBag.Title = L["Login"].Value;

    var loginScreen = await LoginScreenSettings.GetAsync();
    // Ayar açık OLSA BİLE yapılandırılmış sağlayıcı yoksa hiçbir şey gösterilmez —
    // ölü düğme çıkmasın.
    var showSocial = loginScreen.ShowSocialLogin && Model.VisibleExternalProviders.Any();
}

@if (Model.ShowRequireMigrateSeedMessage)
{
    <div class="alert alert-danger apya-auth__alert" role="alert">
        <strong>@L["RequireMigrateSeedTitle"]</strong>
        <div>@L["RequireMigrateSeedMessage"]</div>
    </div>
}

@if (showSocial)
{
    <form class="apya-auth__social" method="post" asp-page="./Login" asp-page-handler="ExternalLogin"
          asp-route-returnUrl="@Model.ReturnUrl" asp-route-returnUrlHash="@Model.ReturnUrlHash">
        @foreach (var provider in Model.VisibleExternalProviders)
        {
            <button type="submit" class="apya-auth__social-btn" name="provider"
                    value="@provider.AuthenticationScheme"
                    title="@L["LogInUsingYourProviderAccount", provider.DisplayName]">
                <partial name="_SocialProviderIcon" model="provider.AuthenticationScheme" />
                @provider.DisplayName
            </button>
        }
    </form>

    @if (Model.EnableLocalLogin)
    {
        <div class="apya-auth__divider">veya e-posta ile</div>
    }
}

@if (Model.EnableLocalLogin)
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="apya-auth__summary apya-auth__error"></div>

        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="LoginInput.UserNameOrEmailAddress"></label>
            <input class="apya-auth__input" asp-for="LoginInput.UserNameOrEmailAddress"
                   autocomplete="username" autofocus placeholder="ad.soyad@apya.com" />
            <span class="apya-auth__error" asp-validation-for="LoginInput.UserNameOrEmailAddress"></span>
        </div>

        <div class="apya-auth__field">
            <div class="apya-auth__field-head">
                <label class="apya-auth__label" asp-for="LoginInput.Password"></label>
                <a class="apya-auth__link"
                   href="@Url.Page("./ForgotPassword", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })">@L["ForgotPassword"]</a>
            </div>
            <div class="apya-auth__input-group">
                <input class="apya-auth__input" type="password" asp-for="LoginInput.Password"
                       autocomplete="current-password" maxlength="@IdentityUserConsts.MaxPasswordLength" />
                <button class="apya-auth__reveal" type="button" data-apya-reveal aria-pressed="false"
                        aria-label="Şifreyi göster / gizle">
                    <partial name="_RevealIcon" />
                </button>
            </div>
            <span class="apya-auth__error" asp-validation-for="LoginInput.Password"></span>
        </div>

        <div class="apya-auth__row">
            <label class="apya-auth__check">
                <input type="checkbox" asp-for="LoginInput.RememberMe" />
                <span>@L["RememberMe"]</span>
            </label>

            @* Self-servis kayıt kapalı (bkz. AccountSettingOverrideProvider): aday
               müşteri hesap açmaz, demo talep eder ve ekip kendisine döner. *@
            <span class="apya-auth__muted">
                @PL["DemoRequest:LoginPrompt"]
                <a class="apya-auth__link" asp-page="./DemoRequest">@PL["DemoRequest:LoginLink"]</a>
            </span>
        </div>

        <button class="apya-auth__submit" type="submit" name="Action" value="Login">@L["Login"]</button>

        @if (Model.ShowCancelButton)
        {
            <button class="apya-auth__submit apya-auth__submit--secondary" type="submit"
                    formnovalidate="formnovalidate" name="Action" value="Cancel">@L["Cancel"]</button>
        }
    </form>
}

@if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
{
    <div class="alert alert-warning apya-auth__alert" role="alert">
        <strong>@L["InvalidLoginRequest"]</strong>
        <div>@L["ThereAreNoLoginSchemesConfiguredForThisClient"]</div>
    </div>
}
