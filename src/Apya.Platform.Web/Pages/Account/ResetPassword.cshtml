@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Identity.Localization
@model Volo.Abp.Account.Web.Pages.Account.ResetPasswordModel
@inject IHtmlLocalizer<AccountResource> L
@inject IHtmlLocalizer<IdentityResource> LI
@{
    Layout = "~/Pages/Account/_ApyaAccountLayout.cshtml";
    ViewBag.Title = L["ResetPassword"].Value;
}

@if (Model.InvalidToken)
{
    <div class="alert alert-danger apya-auth__alert" role="alert">
        @LI["Volo.Abp.Identity:InvalidToken"]
    </div>
    <a class="apya-auth__link d-inline-block mt-3" asp-page="./ForgotPassword">&larr; @L["ForgotPassword"]</a>
}
else
{
    <p class="apya-auth__hint">@L["ResetPassword_Information"]</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="apya-auth__summary apya-auth__error"></div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="ResetToken" />

        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="Password"></label>
            <div class="apya-auth__input-group">
                <input class="apya-auth__input" type="password" asp-for="Password" autocomplete="new-password" autofocus />
                <button class="apya-auth__reveal" type="button" data-apya-reveal aria-pressed="false"
                        aria-label="Şifreyi göster / gizle">
                    <partial name="_RevealIcon" />
                </button>
            </div>
            <span class="apya-auth__error" asp-validation-for="Password"></span>
        </div>

        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="ConfirmPassword"></label>
            <div class="apya-auth__input-group">
                <input class="apya-auth__input" type="password" asp-for="ConfirmPassword" autocomplete="new-password" />
                <button class="apya-auth__reveal" type="button" data-apya-reveal aria-pressed="false"
                        aria-label="Şifreyi göster / gizle">
                    <partial name="_RevealIcon" />
                </button>
            </div>
            <span class="apya-auth__error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="apya-auth__submit" type="submit">@L["Submit"]</button>
    </form>

    <div class="apya-auth__row">
        <a class="apya-auth__link" asp-page="./Login">&larr; @L["Cancel"]</a>
    </div>
}
