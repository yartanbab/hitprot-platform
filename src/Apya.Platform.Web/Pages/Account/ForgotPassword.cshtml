@page
@using System.Collections.Generic
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model Apya.Platform.Web.Pages.Account.ApyaForgotPasswordModel
@inject IHtmlLocalizer<AccountResource> L
@{
    Layout = "~/Pages/Account/_ApyaAccountLayout.cshtml";
    ViewBag.Title = L["ForgotPassword"].Value;
}

<p class="apya-auth__hint">@L["SendPasswordResetLink_Information"]</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="apya-auth__summary apya-auth__error"></div>

    <div class="apya-auth__field">
        <label class="apya-auth__label" asp-for="Email"></label>
        <input class="apya-auth__input" asp-for="Email" type="email" autocomplete="email" autofocus
               placeholder="ad.soyad@apya.com" />
        <span class="apya-auth__error" asp-validation-for="Email"></span>
    </div>

    <button class="apya-auth__submit" type="submit">@L["Submit"]</button>
</form>

<div class="apya-auth__row">
    <a class="apya-auth__link"
       asp-page="./Login"
       asp-all-route-data="@(new Dictionary<string, string> { { "returnUrl", Model.ReturnUrl }, { "returnUrlHash", Model.ReturnUrlHash } })">
        &larr; @L["Login"]
    </a>
</div>
