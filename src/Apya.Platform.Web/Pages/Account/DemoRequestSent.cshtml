@page
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@model Apya.Platform.Web.Pages.Account.DemoRequestSentModel
@inject IHtmlLocalizer<PlatformResource> L
@{
    Layout = "~/Pages/Account/_ApyaAccountLayout.cshtml";
    ViewBag.Title = L["DemoRequest:Sent:Title"].Value;
}

<p class="apya-auth__hint">@L["DemoRequest:Sent:Message"]</p>

<a class="apya-auth__submit d-flex align-items-center justify-content-center text-decoration-none"
   asp-page="./Login">
    &larr; @L["DemoRequest:BackToLogin"]
</a>
