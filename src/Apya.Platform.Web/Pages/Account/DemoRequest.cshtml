@page
@using System.Collections.Generic
@using Apya.Platform.DemoRequests
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@model Apya.Platform.Web.Pages.Account.DemoRequestModel
@inject IHtmlLocalizer<PlatformResource> L
@{
    Layout = "~/Pages/Account/_ApyaAccountLayout.cshtml";
    ViewBag.Title = L["DemoRequest:Title"].Value;
}

<p class="apya-auth__hint">@L["DemoRequest:Intro"]</p>

<form method="post" autocomplete="on">
    <div asp-validation-summary="ModelOnly" class="apya-auth__summary apya-auth__error"></div>

    @* Bal küpü: gerçek kullanıcı görmez, bot doldurur. Ekran okuyucudan da gizli. *@
    <div class="apya-auth__hp" aria-hidden="true">
        <label for="Website">Web sitesi</label>
        @* asp-for KULLANILMAZ: bal küpü gerçek bir alan değil, model meta verisine
           (ve dolayısıyla Türkçe ad sözlüğüne) girmesinin bir anlamı yok. *@
        <input id="Website" name="Website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    @* Kısa alanlar yan yana, uzun olanlar tam genişlikte: kartın iç genişliği
       384px, ikiye bölününce sütun 170px kalıyor ve e-posta adresi kutuya
       sığmıyor. Ad/kurum ve seçim kutuları bu darlıkta rahat okunuyor. *@
    <div class="apya-auth__grid">
        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="Input.FullName">@L["DemoRequest:FullName"]</label>
            <input class="apya-auth__input" asp-for="Input.FullName" autocomplete="name" autofocus />
            <span class="apya-auth__error" asp-validation-for="Input.FullName"></span>
        </div>

        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="Input.CompanyName">@L["DemoRequest:CompanyName"]</label>
            <input class="apya-auth__input" asp-for="Input.CompanyName" autocomplete="organization" />
            <span class="apya-auth__error" asp-validation-for="Input.CompanyName"></span>
        </div>
    </div>

    <div class="apya-auth__field">
        <label class="apya-auth__label" asp-for="Input.Email">@L["DemoRequest:Email"]</label>
        <input class="apya-auth__input" asp-for="Input.Email" type="email" autocomplete="email"
               placeholder="ad.soyad@kurum.com" />
        <span class="apya-auth__error" asp-validation-for="Input.Email"></span>
    </div>

    <div class="apya-auth__field">
        <label class="apya-auth__label" asp-for="Input.Phone">@L["DemoRequest:Phone"]</label>
        <input class="apya-auth__input" asp-for="Input.Phone" type="tel" autocomplete="tel"
               placeholder="05xx xxx xx xx" />
        <span class="apya-auth__error" asp-validation-for="Input.Phone"></span>
    </div>

    <div class="apya-auth__grid">
        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="Input.OrganizationKind">
                @L["DemoRequest:OrganizationKind"] <span class="apya-auth__optional">@L["DemoRequest:Optional"]</span>
            </label>
            <select class="apya-auth__input apya-auth__select" asp-for="Input.OrganizationKind">
                <option value="">@L["DemoRequest:Choose"]</option>
                @foreach (var kind in Model.OrganizationKinds)
                {
                    <option value="@kind">@L["DemoRequest:OrganizationKind:" + kind]</option>
                }
            </select>
        </div>

        <div class="apya-auth__field">
            <label class="apya-auth__label" asp-for="Input.CompanySize">
                @L["DemoRequest:CompanySize"] <span class="apya-auth__optional">@L["DemoRequest:Optional"]</span>
            </label>
            <select class="apya-auth__input apya-auth__select" asp-for="Input.CompanySize">
                <option value="">@L["DemoRequest:Choose"]</option>
                @foreach (var size in Model.CompanySizes)
                {
                    <option value="@size">@L["DemoRequest:CompanySize:" + size]</option>
                }
            </select>
        </div>
    </div>

    <div class="apya-auth__field">
        <span class="apya-auth__label">
            @L["DemoRequest:Modules"] <span class="apya-auth__optional">@L["DemoRequest:Optional"]</span>
        </span>
        <div class="apya-auth__choices">
            @foreach (var key in Model.ModuleKeys)
            {
                <label class="apya-auth__check">
                    <input type="checkbox" name="Input.InterestedModules" value="@key"
                           checked="@(Model.Input.InterestedModules.Contains(key))" />
                    <span>@L["DemoRequest:Module:" + key]</span>
                </label>
            }
        </div>
    </div>

    <div class="apya-auth__field">
        <label class="apya-auth__label" asp-for="Input.Message">
            @L["DemoRequest:Message"] <span class="apya-auth__optional">@L["DemoRequest:Optional"]</span>
        </label>
        <textarea class="apya-auth__input apya-auth__textarea" asp-for="Input.Message" rows="3"
                  placeholder="@L["DemoRequest:MessagePlaceholder"]"></textarea>
        <span class="apya-auth__error" asp-validation-for="Input.Message"></span>
    </div>

    <div class="apya-auth__field">
        <label class="apya-auth__check">
            <input type="checkbox" asp-for="AcceptKvkk" />
            <span>
                @L["DemoRequest:KvkkPrefix"]
                <a class="apya-auth__link" href="~/aydinlatma-metni" target="_blank" rel="noopener">@L["DemoRequest:KvkkLinkText"]</a>
                @L["DemoRequest:KvkkSuffix"]
            </span>
        </label>
        <span class="apya-auth__error" asp-validation-for="AcceptKvkk"></span>
    </div>

    <button class="apya-auth__submit" type="submit">@L["DemoRequest:Submit"]</button>
</form>

<div class="apya-auth__row">
    <a class="apya-auth__link" asp-page="./Login">&larr; @L["DemoRequest:BackToLogin"]</a>
</div>
