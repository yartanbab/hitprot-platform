@page
@model Apya.Platform.Web.Pages.Invoices.CreateModalModel
@using Apya.Platform.Invoices
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    Layout = null;
}
@* Düz form (Customers deseni): abp-dynamic-form, içinde <abp-form-content/> olmadan
   modelin tüm alanlarını formun başına İKİNCİ kez basıyordu; bağlama ilk (boş)
   kopyayı aldığı için fatura numarası boş gidiyor ve fatura HİÇ kaydedilemiyordu. *@
<form method="post" action="@Url.Page("/Invoices/CreateModal")" id="ViewModelForm" data-vat-exemptions="@Model.VatExemptionsJson" enctype="multipart/form-data">
    <abp-modal size="Large">
        <abp-modal-header title="Yeni Fatura Oluştur"></abp-modal-header>
        <abp-modal-body>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.ProjectId">Proje</label>
                    <select asp-for="InvoiceInfo.ProjectId" asp-items="Model.Projects" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.CustomerId">Müşteri</label>
                    <select asp-for="InvoiceInfo.CustomerId" asp-items="Model.Customers" class="form-select"></select>
                </div>
            </div>
            @* FIN-05 · Bütçe kalemi: proje seçilince dolar (gider/gelir penceresindeki ortak yardımcı),
               ama burada HİÇBİR ZAMAN zorunlu değildir. *@
            <div class="row">
                <div class="col-md-6 mb-3 d-none" data-budget-line-wrap>
                    <label class="form-label" asp-for="InvoiceInfo.BudgetLineId">
                        Bütçe kalemi <span class="text-muted fw-normal">(isteğe bağlı)</span>
                    </label>
                    <select asp-for="InvoiceInfo.BudgetLineId" class="form-select"></select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Yön</label>
                    @* Seçim modelden AÇIKÇA kurulur: radyo değerleri sayısal ("0"/"1"), etiket
                       yardımcısı ise modelin enum ADIYLA ("Sales") karşılaştırdığı için hiçbirini
                       seçili basmıyordu. Dinamik formun fazladan bastığı kopya alan varsayılanı
                       taşıyordu; düz formda yön seçilmeden "Kaydet" doğrulamada sessizce takılıyordu. *@
                    <div class="d-flex gap-3 pt-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="InvoiceInfo.Direction" value="0" id="DirSales"
                                   checked="@(Model.InvoiceInfo.Direction == InvoiceDirection.Sales)" />
                            <label class="form-check-label" for="DirSales">Satış Faturası</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="InvoiceInfo.Direction" value="1" id="DirPurchase"
                                   checked="@(Model.InvoiceInfo.Direction == InvoiceDirection.Purchase)" />
                            <label class="form-check-label" for="DirPurchase">Alış Faturası</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.InvoiceNumber">Fatura No</label>
                    <input asp-for="InvoiceInfo.InvoiceNumber" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.InvoiceDate">Fatura Tarihi</label>
                    <input asp-for="InvoiceInfo.InvoiceDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.DueDate">Son Ödeme Tarihi</label>
                    <input asp-for="InvoiceInfo.DueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.TaxRate">KDV Oranı (%)</label>
                    <input asp-for="InvoiceInfo.TaxRate" type="number" step="0.01" class="form-control" data-money-input="true" />
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="InvoiceInfo.PricesIncludeTax" />
                        <label class="form-check-label" asp-for="InvoiceInfo.PricesIncludeTax">Fiyatlar KDV dahil</label>
                    </div>
                </div>
                @* Çoklu para birimi gizlendi — tüm faturalar TRY. *@
                <input type="hidden" asp-for="InvoiceInfo.Currency" value="TRY" />
                @* Görev panelinden açıldıysa faturayı o göreve etiketle. Görünür bir
                   görev seçicisi YOK: modal göreve bağlı açılır, serbest seçim
                   Faturalar sayfasının işi. *@
                <input type="hidden" asp-for="InvoiceInfo.TaskId" />
            </div>

            @* KDV istisnası: belge no doluysa fatura KDV'siz kesilir (sunucu oranı 0'a çeker). Proje
               belgesi fatura tarihinde geçerliyse alan önden dolar (aşağıdaki betik). *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="InvoiceInfo.VatExemptionReference">KDV istisna belge no</label>
                    <input asp-for="InvoiceInfo.VatExemptionReference" class="form-control" placeholder="İstisna yoksa boş bırakın" />
                    <div class="form-text">Doluysa fatura KDV'siz kesilir (KDV %0).</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="InvoiceInfo.Notes">Notlar</label>
                <textarea asp-for="InvoiceInfo.Notes" class="form-control" rows="2" placeholder="İsteğe bağlı not..."></textarea>
            </div>

            @if (Model.CanAttachDocuments)
            {
                <partial name="_FinanceDocumentField" model="Model.LinkedDocuments" />
            }

            <hr />
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Fatura Kalemleri</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" id="AddInvoiceItemBtn">
                    <i class="fa fa-plus"></i> Yeni Kalem Ekle
                </button>
            </div>
            
            <div id="InvoiceItemsContainer">
                <div class="row invoice-item mb-2 align-items-end" data-index="0">
                    <div class="col-md-5">
                        <label class="form-label">Açıklama</label>
                        <input name="InvoiceInfo.Items[0].Description" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Miktar</label>
                        @* __Invariant ŞART: bu alanlar asp-for ile değil elle name= ile yazıldığı
                           için ASP.NET işaretçiyi kendiliğinden eklemiyor. Onsuz "2.5" tr-TR ile
                           bağlanır ve 25 olur; type="number" ise değeri DAİMA noktalı gönderir. *@
                        <input name="InvoiceInfo.Items[0].Quantity" type="number" step="0.01" class="form-control input-qty" value="1" data-money-input="true" required />
                        <input type="hidden" name="__Invariant" value="InvoiceInfo.Items[0].Quantity" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Birim Fiyat</label>
                        @* data-money-input gizli alana String(num) yazar, yani NOKTALI invariant
                           değer — __Invariant olmadan o da 1234.56'yı 123456 yapardı. *@
                        <input name="InvoiceInfo.Items[0].UnitPrice" type="number" step="0.01" data-money-input class="form-control input-price" required />
                        <input type="hidden" name="__Invariant" value="InvoiceInfo.Items[0].UnitPrice" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-remove-item" aria-label="Kalemi sil" title="Kalemi sil"><i class="fa fa-trash"></i></button>
                    </div>
                </div>
            </div>
            @* KDV dahil işaretliyken birim fiyat sunucuda KDV'den arındırılır; özet aynı hesabı gösterir. *@
            <div class="text-end small text-muted mt-2" data-invoice-summary></div>

            <!-- JavaScript for Items -->
            <script>
                $(function () {
                    // Modal AJAX ile yüklendiği için bağlama bir sonraki döngüde yapılır (gider penceresiyle aynı).
                    setTimeout(function () {
                        if (!window.apya || !apya.financeModal) { return; }
                        apya.financeModal.bindBudgetContext({
                            formSelector: 'form[action$="/Invoices/CreateModal"]',
                            projectSelector: '#InvoiceInfo_ProjectId',
                            lineSelector: '#InvoiceInfo_BudgetLineId',
                            taskSelector: '#InvoiceInfo_NoTask',
                            lineWrapSelector: '[data-budget-line-wrap]',
                            taskWrapSelector: '[data-no-task-wrap]',
                            hintSelector: '[data-no-hint]',
                            optionalLine: true,
                            selectedLineId: '@Model.InvoiceInfo.BudgetLineId'
                        });
                        applyProjectExemption();
                    }, 0);

                    var $form = $('form[action$="/Invoices/CreateModal"]');
                    // Sunucudaki hesabın aynısı: KDV dahil fiyat kuruşa yuvarlanarak KDV hariçe çevrilir.
                    function updateSummary() {
                        var num = function (el) {
                            var v = window.apya && apya.moneyInput ? apya.moneyInput.getValue(el) : parseFloat(el && el.value);
                            return v || 0;
                        };
                        // İstisnalı faturada KDV yok: oran 0, KDV dahil çevirmesi yapılmaz (sunucuyla aynı).
                        var exempt = String($form.find('#InvoiceInfo_VatExemptionReference').val() || '').trim() !== '';
                        var rate = exempt ? 0 : num($form.find('#InvoiceInfo_TaxRate')[0]);
                        var included = !exempt && $form.find('#InvoiceInfo_PricesIncludeTax').is(':checked');
                        var subtotal = 0;
                        $form.find('.invoice-item').each(function () {
                            var price = num($(this).find('.input-price')[0]);
                            if (included) { price = Math.round(price * 10000 / (100 + rate)) / 100; }
                            subtotal += num($(this).find('.input-qty')[0]) * price;
                        });
                        var total = subtotal * (1 + rate / 100);
                        var tl = function (v) { return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺'; };
                        $form.find('[data-invoice-summary]').text('Ara toplam ' + tl(subtotal) + (exempt ? ' · KDV (istisna) ' : ' · KDV ') + tl(total - subtotal) + ' · Genel toplam ' + tl(total));
                    }
                    $form.on('input change', updateSummary);

                    // Projenin istisna belgesi fatura tarihinde geçerliyse belge no önden dolar; kullanıcı silebilir.
                    var exemptions = $form.data('vat-exemptions') || {};
                    function applyProjectExemption() {
                        var e = exemptions[$form.find('#InvoiceInfo_ProjectId').val()];
                        var date = $form.find('#InvoiceInfo_InvoiceDate').val();
                        var valid = e && (!e.until || !date || date <= e.until);
                        $form.find('#InvoiceInfo_VatExemptionReference').val(valid ? e.no : '');
                        updateSummary();
                    }
                    $form.on('change', '#InvoiceInfo_ProjectId, #InvoiceInfo_InvoiceDate', applyProjectExemption);

                    var itemIndex = 1;
                    $('#AddInvoiceItemBtn').click(function () {
                        var html = `
                        <div class="row invoice-item mb-2 align-items-end" data-index="${itemIndex}">
                            <div class="col-md-5">
                                <label class="form-label">Açıklama</label>
                                <input name="InvoiceInfo.Items[${itemIndex}].Description" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Miktar</label>
                                @* __Invariant ŞART: bu alanlar asp-for ile değil elle name= ile yazıldığı
                                   için ASP.NET işaretçiyi kendiliğinden eklemiyor. Onsuz "2.5" tr-TR ile
                                   bağlanır ve 25 olur; type="number" ise değeri DAİMA noktalı gönderir. *@
                                <input name="InvoiceInfo.Items[${itemIndex}].Quantity" type="number" step="0.01" class="form-control input-qty" value="1" data-money-input="true" required />
                                <input type="hidden" name="__Invariant" value="InvoiceInfo.Items[${itemIndex}].Quantity" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Birim Fiyat</label>
                                @* data-money-input gizli alana String(num) yazar, yani NOKTALI invariant
                                   değer — __Invariant olmadan o da 1234.56'yı 123456 yapardı. *@
                                <input name="InvoiceInfo.Items[${itemIndex}].UnitPrice" type="number" step="0.01" data-money-input class="form-control input-price" required />
                                <input type="hidden" name="__Invariant" value="InvoiceInfo.Items[${itemIndex}].UnitPrice" />
                            </div>
                            <div class="col-md-1 text-end">
                                <button type="button" class="btn btn-outline-danger btn-remove-item" aria-label="Kalemi sil" title="Kalemi sil"><i class="fa fa-trash"></i></button>
                            </div>
                        </div>`;
                        var $row = $(html).appendTo('#InvoiceItemsContainer');
                        if (window.apya && apya.moneyInput) { apya.moneyInput.scan($row[0]); }
                        itemIndex++;
                    });

                    // Liste bağlama 0'dan başlayan KESİNTİSİZ indeks ister: ortadan satır
                    // silinince kalanları yeniden numarala (tutar maskesinin gizli alanı ve
                    // __Invariant işaretçisi dahil), yoksa boşluktan sonraki kalemler düşer.
                    function reindexItems() {
                        var $rows = $('#InvoiceItemsContainer .invoice-item');
                        $rows.each(function (i) {
                            var prefix = 'InvoiceInfo.Items[' + i + ']';
                            $(this).attr('data-index', i);
                            $(this).find('[name^="InvoiceInfo.Items["]').each(function () {
                                this.name = this.name.replace(/^InvoiceInfo\.Items\[\d+\]/, prefix);
                            });
                            $(this).find('input[name="__Invariant"]').each(function () {
                                this.value = this.value.replace(/^InvoiceInfo\.Items\[\d+\]/, prefix);
                            });
                        });
                        itemIndex = $rows.length;
                    }

                    // document yerine kaba bağlı: modal her açılışta yeniden yüklenir,
                    // document'a bağlanan dinleyici her seferinde birikiyordu.
                    $('#InvoiceItemsContainer').on('click', '.btn-remove-item', function () {
                        if ($('#InvoiceItemsContainer .invoice-item').length > 1) {
                            $(this).closest('.invoice-item').remove();
                            reindexItems();
                            updateSummary();
                        } else {
                            abp.notify.warn(abp.localization.getResource('Platform')('Notify:Invoice:ItemRequired'));
                        }
                    });
                });
            </script>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
