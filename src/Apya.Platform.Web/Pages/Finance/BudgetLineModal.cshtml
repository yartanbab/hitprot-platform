@page
@model Apya.Platform.Web.Pages.Finance.BudgetLineModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Finance/BudgetLineModal", new { projectId = Model.ProjectId, id = Model.Id })">
    <abp-modal>
        <abp-modal-header title="@(Model.IsEdit ? "Bütçe Kalemini Düzenle" : "Yeni Bütçe Kalemi")"></abp-modal-header>
        <abp-modal-body>
            <abp-row>
                <abp-column size-md="_4">
                    <abp-input asp-for="Line.Code" label="Kod" placeholder="1.2" />
                </abp-column>
                <abp-column size-md="_8">
                    <abp-input asp-for="Line.Name" label="Kalem adı" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Line.PlannedAmount" label="Sözleşme tutarı" data-money-input="true" />
                </abp-column>
                <abp-column size-md="_6">
                    @* Boş bırakılırsa sunucu sözleşme tutarını kullanır (yeni kalemde ikisi aynıdır). *@
                    <abp-input asp-for="Line.ApprovedAmount" label="Onaylanan tutar" data-money-input="true" />
                </abp-column>
            </abp-row>
            <abp-input asp-for="Line.TransferLimitPercent" label="Aktarım payı sınırı (%) — opsiyonel" />
            <p class="text-muted mb-0" style="font-size:12px">
                Onaylanan tutarı buradan değiştirmek <strong>revizyon kaydı üretmez</strong>.
                Kesinti sonrası bütçe düşürmek için “Dilimler &amp; kesintiler” sekmesindeki
                revizyon akışını kullanın.
            </p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
