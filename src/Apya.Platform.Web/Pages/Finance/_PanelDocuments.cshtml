@*
    Finans → "Belgeler" sekmesi (tasarım 5a · 5b · 5c).

    YENİ BELGE DEPOSU YOK. Üç blok da mevcut doküman modülünün servislerinden
    beslenir (IDocumentMatchingAppService · IComplianceAppService ·
    IDeliveryPackageAppService); ekranlar da orada — buradan derin bağlantıyla
    açılır. Bu panelin kattığı tek şey FİNANS BAĞLAMI: belge açığının bütçe
    kalemi bazında kırılımı.

    Yetkisi olmayan bloklar sessizce düşer (page model'de TryAddAsync); üçü de
    düşerse panel "belge modülüne erişiminiz yok" der.
*@
@using Apya.Platform.Documents
@using Apya.Platform.Web.Pages.Shared
@model Apya.Platform.Web.Pages.Finance.IndexModel

@functions {
    string Money(decimal v) => v.ToString("N2") + " ₺";

    string ComplianceTone(int percent) => percent >= 100 ? "positive" : percent >= 60 ? "warning" : "negative";
}

@{
    var projectId = Model.SelectedProject!.Id;
    var board = Model.DocumentBoard;
    var compliance = Model.Compliance;

    var blocking = compliance?.Summary.BlockingMissingCount ?? 0;
}

@if (board == null && compliance == null && Model.DeliveryPackages.Count == 0)
{
    <partial name="_EmptyState" model='new EmptyStateModel {
        Icon = "fa-folder-open",
        Title = "Belge modülüne erişiminiz yok",
        Description = "Belge açığı, uygunluk kontrol listesi ve teslim paketleri doküman modülünde tutulur." }' />
    return;
}

<div class="row g-3">

    @* ── 5a/5b · BELGE AÇIĞI ────────────────────────────────────────────── *@
    <div class="col-12 col-xl-6">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                    <div>
                        <h6 class="mb-1" style="font-size:13px;font-weight:700">Belge açığı</h6>
                        <p class="text-muted mb-0" style="font-size:12px">
                            Harcamanın belgesi yoksa donöre sunulamaz; belge bir harcamaya bağlanmadıysa hiçbir kaleme sayılmaz.
                        </p>
                    </div>
                    <a href="@($"/Documents/Matching?projectId={projectId}")" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                        <i class="fa fa-link me-1" aria-hidden="true"></i>Eşleştir
                    </a>
                </div>

                @if (board == null)
                {
                    <p class="text-muted mb-0" style="font-size:12.5px">Bu bölümü görme yetkiniz yok.</p>
                }
                else if (board.Expenses.Count == 0 && board.Documents.Count == 0)
                {
                    <p class="mb-0" style="font-size:12.5px;color:var(--apya-positive-500)">
                        <i class="fa fa-circle-check me-1" aria-hidden="true"></i>
                        Açık yok: her harcamanın belgesi, her belgenin harcaması var.
                    </p>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="apya-overline mb-1">Belgesiz harcama</div>
                            <div class="apya-numeric fw-bold" style="font-size:18px;color:var(--apya-negative-500)">
                                @board.Expenses.Count
                            </div>
                            <div class="small text-muted apya-numeric">@Money(board.UndocumentedTotal)</div>
                        </div>
                        <div class="col-6">
                            <div class="apya-overline mb-1">Harcamasız belge</div>
                            <div class="apya-numeric fw-bold" style="font-size:18px">@board.Documents.Count</div>
                            <div class="small text-muted">bağlanmayı bekliyor</div>
                        </div>
                    </div>

                    @if (Model.UndocumentedLines.Count > 0)
                    {
                        <div class="apya-overline mb-2">Kalem bazında</div>
                        <table class="table apya-clean-table align-middle mb-0">
                            <tbody>
                                @foreach (var line in Model.UndocumentedLines)
                                {
                                    <tr>
                                        <td>
                                            @if (line.BudgetLineId != null)
                                            {
                                                <span class="apya-chip apya-chip-neutral">@line.Name</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">@line.Name</span>
                                            }
                                        </td>
                                        <td class="text-end apya-numeric" style="width:92px;white-space:nowrap">@line.Count kayıt</td>
                                        <td class="text-end apya-numeric fw-semibold" style="width:130px">@Money(line.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    </div>

    @* ── 5c · UYGUNLUK KONTROL LİSTESİ ──────────────────────────────────── *@
    <div class="col-12 col-xl-6">
        <div class="card h-100 mb-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                    <div>
                        <h6 class="mb-1" style="font-size:13px;font-weight:700">Uygunluk</h6>
                        <p class="text-muted mb-0" style="font-size:12px">
                            Kurumun istediği belge listesi. Durumlar belgelerden hesaplanır, elle işaretlenmez.
                        </p>
                    </div>
                    <a href="@($"/Documents/Scope?projectId={projectId}")" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                        <i class="fa fa-list-check me-1" aria-hidden="true"></i>Kontrol listesi
                    </a>
                </div>

                @if (compliance == null)
                {
                    <p class="text-muted mb-0" style="font-size:12.5px">Bu bölümü görme yetkiniz yok.</p>
                }
                else if (compliance.Checklists.Count == 0)
                {
                    <p class="text-muted mb-0" style="font-size:12.5px">
                        Bu projeye henüz bir uygunluk paketi uygulanmamış.
                    </p>
                }
                else
                {
                    var s = compliance.Summary;
                    <div class="apya-tile-progress-label">
                        <span>@s.SatisfiedCount / @s.TotalCount kalem tamam@(s.WaivedCount > 0 ? $" · {s.WaivedCount} feragat" : "")</span>
                        <span class="apya-numeric">%@s.Percent</span>
                    </div>
                    <div class="apya-mini-progress is-@ComplianceTone(s.Percent)">
                        <span style="width:@(Math.Min(s.Percent, 100))%"></span>
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2">
                        @if (blocking > 0)
                        {
                            <span class="apya-chip apya-chip-negative">@blocking bloke kalem</span>
                        }
                        @if (s.MissingCount > 0)
                        {
                            <span class="apya-chip apya-chip-warning">@s.MissingCount eksik</span>
                        }
                        @foreach (var checklist in compliance.Checklists)
                        {
                            <span class="apya-chip apya-chip-neutral">@checklist.PackageName</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── 5c · TESLİM PAKETLERİ ──────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card mb-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                    <div>
                        <h6 class="mb-1" style="font-size:13px;font-weight:700">Teslim paketleri</h6>
                        <p class="text-muted mb-0" style="font-size:12px">
                            Bütçe tablosu, harcama listesi ve ekler tek dosyada. Bloke kalem varken paket dışa aktarılamaz.
                        </p>
                    </div>
                    <a href="@($"/Documents/Deliveries?projectId={projectId}")" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                        <i class="fa fa-box-archive me-1" aria-hidden="true"></i>Teslimler
                    </a>
                </div>

                @if (Model.DeliveryPackages.Count == 0)
                {
                    <p class="text-muted mb-0" style="font-size:12.5px">
                        Bu projede teslim paketi yok. Donöre gidecek dosyayı Teslimler ekranından kurabilirsiniz.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table apya-clean-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Paket</th>
                                    <th style="width:110px">Dönem</th>
                                    <th class="text-end apya-numeric" style="width:80px">Ek</th>
                                    <th style="width:220px">Son kontrol</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.DeliveryPackages)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@row.Package.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(row.Package.ReportTemplateName))
                                            {
                                                <div class="small text-muted">@row.Package.ReportTemplateName</div>
                                            }
                                        </td>
                                        <td class="apya-numeric">@(row.Package.PeriodCode ?? "—")</td>
                                        <td class="text-end apya-numeric">@row.Package.ItemCount</td>
                                        <td>
                                            @if (row.Preflight == null)
                                            {
                                                <span class="text-muted">kontrol edilemedi</span>
                                            }
                                            else if (row.Preflight.CanGenerate)
                                            {
                                                <span class="apya-chip apya-chip-positive">dışa aktarılabilir</span>
                                                @if (row.Preflight.WarningCount > 0)
                                                {
                                                    <span class="apya-chip apya-chip-warning ms-1">@row.Preflight.WarningCount uyarı</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="apya-chip apya-chip-negative">@row.Preflight.BlockingCount bloke</span>
                                                <div class="small text-muted mt-1">paket dışa aktarılamaz</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
