@page
@model Apya.Platform.Web.Pages.Finance.SupportRateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Finance/SupportRateModal", new { projectId = Model.ProjectId })">
    <abp-modal>
        <abp-modal-header title="Destek Oranı"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Rate.SupportRatePercent" label="Hibe destek oranı (%)"
                       data-money-input="true" data-group="false" />
            <p class="text-muted mb-0" style="font-size:12px">
                Kurum katkısı (eş finansman) oranı otomatik olarak <strong>100 − destek oranı</strong> olur.
                Kalemlerde hibe payı elle girilmemişse bu orana göre hesaplanır.
                @if (Model.ProgramRatePercent.HasValue)
                {
                    <br />
                    <span>Boş bırakılırsa hibe programının oranı kullanılır: <strong class="apya-numeric">%@Model.ProgramRatePercent.Value.ToString("0.##")</strong>.</span>
                }
            </p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
