@page
@model Apya.Platform.Web.Pages.Finance.VatExemptionModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Finance/VatExemptionModal", new { projectId = Model.ProjectId })">
    <abp-modal>
        <abp-modal-header title="KDV İstisna Belgesi"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-3">
                <label class="form-label" asp-for="Exemption.VatExemptionCertificateNo">Belge no</label>
                <input asp-for="Exemption.VatExemptionCertificateNo" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Exemption.VatExemptionValidUntil">Son geçerlilik tarihi</label>
                <input asp-for="Exemption.VatExemptionValidUntil" type="date" class="form-control" />
            </div>
            <p class="text-muted mb-0" style="font-size:12px">
                Belge geçerliyken bu projeye kesilen yeni faturalar <strong>KDV istisnalı</strong> açılır
                (KDV %0, yazdırmada belge no basılır); fatura penceresinde kaldırılabilir.
                Tarih boşsa belge süresiz sayılır. Belge no'yu silerseniz istisna kaldırılır.
                Belgenin taramasını Belgeler'e "KDV istisna belgesi" türüyle yükleyebilirsiniz.
            </p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
