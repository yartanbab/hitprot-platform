@*
    "Bütçe kalemleri" sekmesi — tasarım 1a'nın kalem tablosu.

    Harcanan/kalan/gerçekleşme SUNUCUDA hesaplanır (kalemde saklanmaz); burada
    yalnız basılır. "Belge" kolonu tasarımda var ama doküman entegrasyonu henüz
    yok — uydurma kolon basılmıyor.
*@
@using Apya.Platform.Web.Pages.Finance
@model IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L

@functions {
    string Money(decimal v) => v.ToString("N2");

    string MoneyOrDash(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "—";

    // Sıralama/süzme için ham değer — kültürden bağımsız, JS Number() ile okunur.
    string Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    string Pct(decimal v) => v.ToString("0.##");

    string BarTone(int usagePercent) => usagePercent >= 100 ? "is-negative"
        : usagePercent >= 80 ? "is-warning"
        : "is-positive";
}

@if (Model.Budget == null)
{
    <partial name="_EmptyState" model='new Apya.Platform.Web.Pages.Shared.EmptyStateModel {
        Icon = "fa-list-ul",
        Title = "Bütçe görüntülenemiyor",
        Description = "Bir proje seçin ya da bütçe görme yetkinizi kontrol edin." }' />
}
else
{
    var b = Model.Budget;
    var cur = b.Currency == "TRY" ? "₺" : b.Currency;

    // Kırılım anahtarının bağlantıları — seçim URL'de taşınır.
    string BreakUrl(string? mode) =>
        $"/Finance?projectId={Model.ProjectId}&tab={Model.ActiveTab}" +
        (string.IsNullOrEmpty(mode) ? "" : $"&breakdown={mode}");

    string BreakCls(string? mode) =>
        (Model.Breakdown ?? "") == (mode ?? "")
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="fw-semibold">Bütçe kalemleri</span>
        <span class="apya-chip apya-chip-neutral">@b.Lines.Count kalem</span>
        @if (b.LatestRevisionNo > 0)
        {
            <span class="apya-chip apya-chip-warning">Rev.@b.LatestRevisionNo</span>
        }
        @if (b.SupportRatePercent.HasValue)
        {
            <span class="apya-chip apya-chip-neutral"
                  title="@(b.SupportRateFromProgram ? "Oran hibe programından geliyor" : "Projenin destek oranı")">
                Hibe %@Pct(b.SupportRatePercent.Value) · Kurum %@Pct(b.InstitutionRatePercent!.Value)
            </span>
        }
        else
        {
            <span class="apya-chip apya-chip-warning">Destek oranı girilmemiş</span>
        }
        @if (b.VatExemptionCertificateNo != null)
        {
            <span class="apya-chip apya-chip-neutral" data-vat-exemption>
                KDV istisnası · @b.VatExemptionCertificateNo@(b.VatExemptionValidUntil.HasValue ? " · " + b.VatExemptionValidUntil.Value.ToString("dd.MM.yyyy") + "'e kadar" : "")
            </span>
        }
        @if (Model.CanEditBudget)
        {
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="BtnSupportRate">
                    <i class="fa fa-percent me-1" aria-hidden="true"></i>Destek oranı
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="BtnVatExemption">
                    <i class="fa fa-receipt me-1" aria-hidden="true"></i>KDV istisnası
                </button>
                @if (b.Lines.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="BtnApplyRevision">
                        <i class="fa fa-code-branch me-1" aria-hidden="true"></i>Bütçeyi revize et
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" id="BtnContextWizard">
                    <i class="fa fa-list-check me-1" aria-hidden="true"></i>Bağlamı kur
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="BtnImportBudgetLines">
                    <i class="fa fa-file-import me-1" aria-hidden="true"></i>@L["Import:ExcelButton"]
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="BtnAddBudgetLine">
                    <i class="fa fa-plus me-1" aria-hidden="true"></i>Kalem ekle
                </button>
            </div>
        }
    </div>

    @* Kırılım anahtarı (tasarım 4b). Düz kalem listesi VARSAYILAN kalır;
       matris onun yerine geçmez, yanına gelir. Seçim URL'de taşınır. *@
    @if (b.Lines.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="apya-overline mb-0">Kırılım</span>
            <a href="@BreakUrl(null)" class="@BreakCls(null)">Kalem listesi</a>
            <a href="@BreakUrl("kalem-gorev")" class="@BreakCls("kalem-gorev")">Kalem → görev</a>
            <a href="@BreakUrl("gorev-kalem")" class="@BreakCls("gorev-kalem")">Görev → kalem</a>
        </div>
    }

    @if (!b.Lines.Any())
    {
        <partial name="_EmptyState" model='new Apya.Platform.Web.Pages.Shared.EmptyStateModel {
            Icon = "fa-list-ul",
            Title = "Bu projede bütçe kalemi yok",
            Description = "Kalem tanımlayana kadar bütçe tek tutar olarak yönetilir; harcamalar kaleme yazılamaz." }' />
    }
    else if (Model.IsMatrixBreakdown && Model.Matrix != null)
    {
        <partial name="_PanelMatrix" model="Model" />
    }
    else
    {
        @* Süzgeç ve sıralama tarayıcıda (Budget.js): kalem sayısı küçük, sunucuya gidip
           gelmek gereksiz. Süzgeç eşleşen kalemin ÜST kalemlerini de gösterir — ağaç kopmasın. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" data-budget-filter>
            <input type="search" class="form-control form-control-sm" style="max-width:260px"
                   placeholder="Kod ya da ad ara…" aria-label="Kod ya da ad ara" data-filter-text />
            <select class="form-select form-select-sm" style="max-width:220px" aria-label="Duruma göre süz" data-filter-status>
                <option value="">Tüm kalemler</option>
                <option value="over">Bütçeyi aşanlar</option>
                <option value="spent">Harcama yapılanlar</option>
                <option value="unspent">Harcama yapılmayanlar</option>
                <option value="manual-grant">Hibe payı elle girilenler</option>
            </select>
            <span class="small text-muted" data-filter-count></span>
        </div>

        <div class="table-responsive">
            <table class="table apya-clean-table align-middle mb-0" data-budget-lines-table>
                <thead>
                    <tr>
                        @* Varsayılan sıra: kod SAYI sırası (1, 2, 2.1, 2.2, 10) — sunucu da böyle basar. *@
                        <th aria-sort="ascending"><button type="button" class="apya-th-sort" data-sort-key="code">Kalem</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="planned">Sözleşme</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="approved">Onaylanan</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="grant">Hibe</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="inst">Kurum</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="spent">Harcanan</button></th>
                        <th class="text-end apya-numeric" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="remaining">Kalan</button></th>
                        <th style="width:140px" aria-sort="none"><button type="button" class="apya-th-sort" data-sort-key="usage">Gerçekleşme</button></th>
                        @if (Model.CanEditBudget)
                        {
                            <th style="width:120px"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @* Üst kalem satırı kendi tutarı + alt kalemlerinin toplamını gösterir (Total*). *@
                    @foreach (var line in b.Lines)
                    {
                        <tr data-line-row
                            data-id="@line.Id" data-parent="@line.ParentId"
                            data-code="@line.Code" data-name="@line.Name" data-order="@line.Order"
                            data-planned="@Inv(line.TotalPlannedAmount)" data-approved="@Inv(line.TotalApprovedAmount)"
                            data-grant="@Inv(line.TotalGrantShare)" data-inst="@Inv(line.TotalInstitutionShare)"
                            data-spent="@Inv(line.TotalSpentAmount)" data-remaining="@Inv(line.TotalRemainingAmount)"
                            data-usage="@line.TotalUsagePercent" data-manual-grant="@(line.GrantAmount.HasValue ? "1" : "0")"
                            class="@(line.HasChildren ? "apya-budget-parent" : "")">
                            <td>
                                <div class="d-flex align-items-start gap-2" style="padding-left:@(line.Depth * 20)px">
                                    @if (line.HasChildren)
                                    {
                                        <i class="fa fa-folder-open text-muted mt-1" aria-hidden="true"></i>
                                    }
                                    <div>
                                        <div class="fw-semibold">@line.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(line.Justification))
                                        {
                                            <div class="small text-muted">@line.Justification</div>
                                        }
                                        <div class="small text-muted">
                                            @if (!string.IsNullOrWhiteSpace(line.Code))
                                            {
                                                <span class="apya-numeric">@line.Code</span>
                                            }
                                            @if (line.HasChildren && line.ApprovedAmount > 0)
                                            {
                                                <span class="apya-chip apya-chip-neutral ms-1" title="Alt kalemler hariç bu kalemin kendi tutarı">kendi tutarı @Money(line.ApprovedAmount)</span>
                                            }
                                            @if (line.LinkedRecordCount > 0)
                                            {
                                                <span class="apya-chip apya-chip-neutral ms-1">@line.LinkedRecordCount kayıt</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-end apya-numeric text-muted">@Money(line.TotalPlannedAmount)</td>
                            <td class="text-end apya-numeric fw-semibold">@Money(line.TotalApprovedAmount)</td>
                            <td class="text-end apya-numeric">
                                @MoneyOrDash(line.TotalGrantShare)
                                @if (line.GrantAmount.HasValue)
                                {
                                    <span class="text-muted" title="Hibe payı elle girildi (orandan hesaplanmadı)">*</span>
                                }
                            </td>
                            <td class="text-end apya-numeric">@MoneyOrDash(line.TotalInstitutionShare)</td>
                            <td class="text-end apya-numeric">@Money(line.TotalSpentAmount)</td>
                            <td class="text-end apya-numeric fw-semibold @(line.TotalRemainingAmount < 0 ? "text-danger" : "")">@Money(line.TotalRemainingAmount)</td>
                            <td>
                                <div class="apya-tile-progress-label">
                                    <span class="apya-numeric">%@line.TotalUsagePercent</span>
                                </div>
                                <div class="apya-mini-progress @BarTone(line.TotalUsagePercent)">
                                    <span style="width:@(Math.Min(line.TotalUsagePercent, 100))%"></span>
                                </div>
                            </td>
                            @if (Model.CanEditBudget)
                            {
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-link p-1 text-decoration-none"
                                            data-add-child-line="@line.Id" title="Alt kalem ekle">
                                        <i class="fa fa-indent" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-link p-1 text-decoration-none"
                                            data-edit-line="@line.Id" title="Düzenle">
                                        <i class="fa fa-pen" aria-hidden="true"></i>
                                    </button>
                                    @if (line.HasChildren)
                                    {
                                        <span class="btn btn-sm btn-link p-1 text-muted disabled"
                                              title="Bu kalemin alt kalemleri var; önce onları silin ya da başka bir üst kaleme taşıyın.">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </span>
                                    }
                                    else if (line.LinkedRecordCount == 0)
                                    {
                                        <form method="post" asp-page-handler="DeleteLine" class="d-inline"
                                              asp-route-projectId="@Model.ProjectId" asp-route-tab="@Model.ActiveTab">
                                            <input type="hidden" name="LineId" value="@line.Id" />
                                            <button type="submit" class="btn btn-sm btn-link p-1 text-danger text-decoration-none"
                                                    title="Sil" data-confirm="Kalem silinsin mi?" data-confirm-danger>
                                                <i class="fa fa-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-link p-1 text-muted disabled"
                                              title="Bu kaleme bağlı @line.LinkedRecordCount kayıt var; önce onları başka kaleme taşıyın.">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @* Toplamlar kalemlerin KENDİ tutarlarından — üst kalem satırları zaten
                       alt kalemleri içerdiği için satır toplamı alınırsa çift sayılırdı.
                       Süzgeçten etkilenmez: her zaman projenin toplamıdır. *@
                    <tr class="fw-bold">
                        <td>TOPLAM</td>
                        <td class="text-end apya-numeric">@Money(b.Lines.Sum(x => x.PlannedAmount))</td>
                        <td class="text-end apya-numeric">@Money(b.ApprovedBudget)</td>
                        <td class="text-end apya-numeric">@MoneyOrDash(b.GrantShareTotal)</td>
                        <td class="text-end apya-numeric">@MoneyOrDash(b.InstitutionShareTotal)</td>
                        <td class="text-end apya-numeric">@Money(b.Lines.Sum(x => x.SpentAmount))</td>
                        <td class="text-end apya-numeric">@Money(b.Lines.Sum(x => x.RemainingAmount))</td>
                        <td colspan="@(Model.CanEditBudget ? 2 : 1)"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="text-muted mt-2 mb-0 d-none" style="font-size:12.5px" data-filter-empty>
            Süzgece uyan kalem yok.
        </p>

        @if (b.UnassignedSpentAmount > 0)
        {
            <p class="text-muted mt-3 mb-0" style="font-size:12.5px">
                <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                Bu projede <strong class="apya-numeric">@cur@Money(b.UnassignedSpentAmount)</strong>
                tutarında harcama <strong>hiçbir kaleme yazılmamış</strong> — kalem toplamları ile
                projenin toplam harcaması arasındaki fark budur.
            </p>
        }
    }
}
