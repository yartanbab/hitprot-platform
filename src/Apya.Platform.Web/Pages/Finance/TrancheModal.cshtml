@page
@model Apya.Platform.Web.Pages.Finance.TrancheModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Finance/TrancheModal", new { projectId = Model.ProjectId, id = Model.Id })">
    <abp-modal>
        <abp-modal-header title="@(Model.IsEdit ? "Dilimi Düzenle" : "Yeni Fonlama Dilimi")"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Tranche.Title" label="Başlık (opsiyonel)" placeholder="1. Hakediş" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Tranche.PlannedAmount" label="Planlanan tutar" data-money-input="true" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Tranche.PlannedDate" type="date" label="Planlanan tarih" />
                </abp-column>
            </abp-row>
            <abp-input asp-for="Tranche.Note" label="Not (opsiyonel)" />
            <p class="text-muted mb-0" style="font-size:12px">
                Tahsilat bu ekranda girilmez — dilim oluştuktan sonra satırdaki
                <strong>Tahsilat gir</strong> ile kaydedilir.
            </p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
