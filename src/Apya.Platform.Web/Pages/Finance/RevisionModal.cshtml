@page
@model Apya.Platform.Web.Pages.Finance.RevisionModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Finance/RevisionModal", new { projectId = Model.ProjectId, deductionId = Model.DeductionId })">
    <abp-modal size="Large">
        <abp-modal-header title="@($"Bütçe Revizyonu — Rev.{Model.NextRevisionNo}")"></abp-modal-header>
        <abp-modal-body>
            @if (Model.IsDeductionMode)
            {
                @* Tasarım 2b: kesintinin iki çıkışı da BURADA. Satırdaki tek tıklık
                   "Finanse edilmeyen" düğmesi kısayol olarak duruyor. *@
                <div class="row g-2 mb-3" id="RevisionModeCards">
                    <div class="col-md-6">
                        <label class="card h-100 mb-0 apya-revmode is-selected" data-mode="revise">
                            <div class="card-body py-2 px-3 d-flex align-items-start gap-2">
                                <input class="form-check-input mt-1" type="radio" name="Mode" value="revise" checked />
                                <span>
                                    <span class="fw-semibold d-block">Bütçeyi revize et</span>
                                    <span class="small text-muted">Kesintiyi kalemlere dağıt, Rev.@Model.NextRevisionNo oluşsun.</span>
                                </span>
                            </div>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label class="card h-100 mb-0 apya-revmode" data-mode="unfunded">
                            <div class="card-body py-2 px-3 d-flex align-items-start gap-2">
                                <input class="form-check-input mt-1" type="radio" name="Mode" value="unfunded" />
                                <span>
                                    <span class="fw-semibold d-block">Açık bırak</span>
                                    <span class="small text-muted">Bütçe aynı kalır; kesinti "finanse edilmeyen" olarak kapanır.</span>
                                </span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="alert alert-warning py-2 mb-3" style="font-size:12.5px" id="RevisionUnallocated">
                    Dağıtılacak kesinti:
                    <strong class="apya-numeric">@Model.SourceDeductionAmount.ToString("N2")</strong> ·
                    dağıtılmayan kalan: <strong class="apya-numeric" data-unallocated>@Model.SourceDeductionAmount.ToString("N2")</strong>.
                    <span class="text-muted">Tamamını dağıtmak zorunda değilsiniz — kalan kısım bütçede açık olarak durur.</span>
                </div>
            }

            <div class="apya-revision-fields">
            <abp-row>
                <abp-column size-md="_8">
                    <abp-input asp-for="Reason" label="Gerekçe" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="EffectiveDate" type="date" label="Yürürlük tarihi" />
                </abp-column>
            </abp-row>
            </div>

            @if (!Model.Lines.Any())
            {
                <p class="text-muted mb-0">Bu projede bütçe kalemi yok — önce kalem tanımlayın.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm apya-clean-table mb-0">
                        <thead>
                            <tr>
                                <th>Kalem</th>
                                <th class="text-end apya-numeric">Rev.@(Model.NextRevisionNo - 1)</th>
                                @if (Model.IsDeductionMode)
                                {
                                    <th class="text-end apya-numeric" style="width:150px">Düşülecek</th>
                                    <th class="text-end apya-numeric" style="width:150px">Rev.@Model.NextRevisionNo</th>
                                }
                                else
                                {
                                    <th class="text-end apya-numeric" style="width:180px">Yeni tutar</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Lines.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.Lines[i].Name
                                        <input type="hidden" asp-for="Lines[i].LineId" />
                                        <input type="hidden" asp-for="Lines[i].Name" />
                                        <input type="hidden" asp-for="Lines[i].CurrentAmount" />
                                    </td>
                                    <td class="text-end apya-numeric" data-current="@Model.Lines[i].CurrentAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Lines[i].CurrentAmount.ToString("N2")</td>
                                    @if (Model.IsDeductionMode)
                                    {
                                        <td>
                                            @* __Invariant ŞART — bkz. reference: type="number" değeri daima
                                               noktalı gönderir, tr-TR bağlaması onu binlik sayardı. *@
                                            <input asp-for="Lines[i].Reduction" type="number" step="0.01" min="0"
                                                   class="form-control form-control-sm text-end apya-numeric fw-bold text-danger"
                                                   data-reduction data-limit="@(Model.Lines[i].TransferLimitPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                            <input type="hidden" name="__Invariant" value="Lines[@i].Reduction" />
                                            <div class="small text-warning d-none" data-limit-warning></div>
                                        </td>
                                        <td class="text-end apya-numeric fw-semibold" data-result>@Model.Lines[i].CurrentAmount.ToString("N2")</td>
                                    }
                                    else
                                    {
                                        <td>
                                            <input asp-for="Lines[i].NewAmount" class="form-control form-control-sm text-end apya-numeric" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted mb-0 mt-2" style="font-size:12px">
                    Yalnız <strong>değiştirdiğiniz</strong> kalemler revizyon kaydına girer.
                    Kalemin sözleşme tutarı değişmez; sadece onaylanan tutar taşınır.
                </p>
            }
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

@if (Model.IsDeductionMode)
{
    <script>
        (function () {
            var total = @Model.SourceDeductionAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var $body = $('#RevisionModeCards').closest('.modal-body, form');

            function fmt(n) {
                return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Kip anahtarı: "Açık bırak" seçilince revizyon alanları anlamsızlaşır,
            // gizlenir — kullanıcı doldurup sonra atıldığını görmesin.
            function applyMode() {
                var mode = $body.find('input[name="Mode"]:checked').val();
                var revise = mode !== 'unfunded';
                $body.find('.apya-revmode').each(function () {
                    $(this).toggleClass('is-selected', $(this).data('mode') === mode);
                });
                $body.find('#RevisionUnallocated, .table-responsive, .apya-revision-fields').toggle(revise);
            }

            function recalc() {
                var allocated = 0;
                $body.find('[data-reduction]').each(function () {
                    var $inp = $(this);
                    var $row = $inp.closest('tr');
                    var current = parseFloat($row.find('[data-current]').data('current')) || 0;
                    var red = parseFloat($inp.val().replace(',', '.')) || 0;
                    allocated += red;

                    $row.find('[data-result]').text(fmt(current - red));

                    // Aktarım payı UYARIDIR, engel değil: sınır sunucuda uygulanmıyor.
                    var limit = parseFloat($inp.data('limit'));
                    var $warn = $row.find('[data-limit-warning]');
                    if (limit > 0 && current > 0 && red > current * limit / 100) {
                        $warn.text('aktarım payı %' + limit + ' sınırını aşıyor').removeClass('d-none');
                    } else {
                        $warn.addClass('d-none');
                    }
                });
                $body.find('[data-unallocated]').text(fmt(total - allocated));
            }

            $body.on('change', 'input[name="Mode"]', applyMode);
            $body.on('input', '[data-reduction]', recalc);
            applyMode();
            recalc();
        })();
    </script>
}
