@page
@using Apya.Platform.Localization
@using Apya.Platform.Permissions
@using Apya.Platform.Web.Pages.Finance
@using Apya.Platform.Web.Pages.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<PlatformResource> L
@model IndexModel
@{
    ViewBag.PageTitle = L["Finance:PageTitle"].Value;
}
@section scripts {
    @if (Model.ActiveTab == FinanceContext.TabCash)
    {
        <abp-script src="/js/apya-transfer.js" />
        <abp-script src="/Pages/Finance/Index.js" />
    }
    @if (Model.ActiveTab == FinanceContext.TabBudgetLines || Model.ActiveTab == FinanceContext.TabTranches)
    {
        <abp-script src="/Pages/Finance/Budget.js" />
    }
}

<div data-page-description="Bütçe, gelir-gider ve kasa — tek çatı" class="apya-page"
     data-project-id="@Model.ProjectId">

@* ─── BAĞLAM ÇUBUĞU — proje seçici + şablon + aksiyonlar ─── *@
<div class="apya-console-rail apya-finance-context">
    <form method="get" class="d-flex align-items-center gap-2">
        @* Sekme korunur: proje değişince kullanıcı aynı sekmede kalır. Yeni
           şablonun setinde o sekme yoksa sunucu ilk sekmeye düşürür. *@
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <label class="apya-overline mb-0" for="FinanceProjectPicker">@L["Finance:Project"]</label>
        <select name="projectId" id="FinanceProjectPicker" class="form-select form-select-sm"
                onchange="this.form.submit()">
            <option value="">@L["Finance:AllProjects"]</option>
            @foreach (var p in Model.Projects)
            {
                <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Name</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">@L["Finance:Apply"]</button></noscript>
    </form>

    <span class="apya-console-sep" aria-hidden="true"></span>

    @if (Model.SelectedProject != null)
    {
        <span class="apya-chip apya-chip-accent">
            <i class="fa fa-layer-group me-1" aria-hidden="true"></i>@L[FinanceContext.LabelKeyOf(Model.Template)]
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.SelectedProject.Code))
        {
            <span class="apya-chip apya-chip-neutral apya-numeric">@Model.SelectedProject.Code</span>
        }
        <span class="apya-chip apya-chip-neutral">@Model.SelectedProject.Currency</span>
    }
    else
    {
        <span class="apya-chip apya-chip-neutral">
            <i class="fa fa-layer-group me-1" aria-hidden="true"></i>@L["Finance:PortfolioContext"]
        </span>
    }

    <div class="ms-auto d-flex align-items-center gap-2">
        @if (Model.SelectedProject != null)
        {
            @* Şablonu proje KATEGORİSİ belirlediği için "yapılandır" projenin
               düzenleme ekranına gider — bağlam oradan değişir. *@
            @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Projects.Edit))
            {
                <a href="/Projects/Edit/@Model.SelectedProject.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="fa fa-sliders me-1" aria-hidden="true"></i>@L["Finance:ConfigureProject"]
                </a>
            }
            <a href="/Projects/ProjectDetails/@Model.SelectedProject.Id" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-rocket me-1" aria-hidden="true"></i>@L["Finance:OpenProject"]
            </a>
        }
    </div>
</div>

@* ─── SEKME ŞERİDİ + AKTİF PANEL ─── *@
<div class="card">
    <partial name="_TabStrip" model="Model" />

    <div class="card-body">
        @switch (Model.ActiveTab)
        {
            case FinanceContext.TabOverview:
                <partial name="_PanelOverview" model="Model" />
                break;

            case FinanceContext.TabCash:
                <partial name="_PanelCash" model="Model" />
                break;

            case FinanceContext.TabBudgetLines:
                <partial name="_PanelBudgetLines" model="Model" />
                break;

            case FinanceContext.TabTranches:
                <partial name="_PanelTranches" model="Model" />
                break;

            case FinanceContext.TabLedger:
                @* Kayıtlar bugün iki ayrı sayfada yaşıyor; tek tabloya taşınana
                   kadar sekme köprü görevi görür — ölü ekran basılmaz. *@
                <partial name="_EmptyState" model='new EmptyStateModel {
                    Icon = "fa-right-left",
                    Title = "Gelir ve gider kayıtları ayrı sayfalarda",
                    Description = "Üç para birimli tek tablo hazırlanıyor. Şimdilik kayıtlara kendi sayfalarından ulaşın." }' />
                <div class="text-center">
                    <a href="/Incomes" class="btn btn-sm btn-outline-secondary me-2"><i class="fa fa-arrow-down-long me-1" aria-hidden="true"></i>Gelirler</a>
                    <a href="/Expenses" class="btn btn-sm btn-outline-secondary"><i class="fa fa-arrow-up-long me-1" aria-hidden="true"></i>Giderler</a>
                </div>
                break;

            case FinanceContext.TabInvoices:
                <partial name="_EmptyState" model='new EmptyStateModel {
                    Icon = "fa-file-invoice-dollar",
                    Title = "Faturalar kendi sayfasında",
                    Description = "Master-detail fatura görünümü bu sekmeye taşınacak." }' />
                <div class="text-center">
                    <a href="/Invoices" class="btn btn-sm btn-outline-secondary"><i class="fa fa-file-invoice-dollar me-1" aria-hidden="true"></i>Faturalar &amp; Ödemeler</a>
                </div>
                break;

            case FinanceContext.TabDocuments:
                <partial name="_EmptyState" model='new EmptyStateModel {
                    Icon = "fa-folder-open",
                    Title = "Belgeler doküman modülünde",
                    Description = "Finans bağlamıyla süzülmüş belge listesi bu sekmeye gelecek; ayrı bir belge deposu kurulmayacak." }' />
                <div class="text-center">
                    <a href="/Documents" class="btn btn-sm btn-outline-secondary"><i class="fa fa-folder-open me-1" aria-hidden="true"></i>Dokümanlar</a>
                </div>
                break;

            case FinanceContext.TabDonor:
                <partial name="_EmptyState" model='new EmptyStateModel {
                    Icon = "fa-file-export",
                    Title = "Donör raporlaması hazırlanıyor",
                    Description = "Rapor dönemleri, uygunluk denetimi ve donör rapor paketi bu sekmeye gelecek." }' />
                break;

            case FinanceContext.TabDonations:
                <partial name="_EmptyState" model='new EmptyStateModel {
                    Icon = "fa-hand-holding-heart",
                    Title = "Bağış ve katılım hazırlanıyor",
                    Description = "Kampanya bazlı bağış ve katılım takibi bu sekmeye gelecek." }' />
                break;
        }
    </div>
</div>
</div>
