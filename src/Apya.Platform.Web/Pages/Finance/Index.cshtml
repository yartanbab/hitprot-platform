@page
@using Apya.Platform.Web.Pages.Finance
@using Apya.Platform.CashAccounts
@model IndexModel
@{
    ViewBag.PageTitle = "Finans Hub";
}
@section scripts {
    <abp-script src="/js/apya-transfer.js" />
    <abp-script src="/Pages/Finance/Index.js" />
}

@functions {
    string Money(decimal v) => v.ToString("N0");
    string MoneyC(decimal v, string cur) => v.ToString("N2") + (cur == "TRY" ? " ₺" : " " + cur);

    string TypeIcon(CashAccountType t) => t switch
    {
        CashAccountType.Bank => "fa-building-columns",
        CashAccountType.CreditCard => "fa-credit-card",
        _ => "fa-wallet"
    };

    string TypeLabel(CashAccountType t) => t switch
    {
        CashAccountType.Bank => "Banka hesabı",
        CashAccountType.CreditCard => "Kredi kartı",
        _ => "Nakit kasa"
    };

    (string tone, string icon) TxVisual(IndexModel.TxType type, bool isInflow) => type switch
    {
        IndexModel.TxType.Transfer => ("kpi-icon-box--accent", "fa-right-left"),
        _ when isInflow => ("kpi-icon-box--positive", "fa-arrow-down-long"),
        _ => ("kpi-icon-box--negative", "fa-arrow-up-long")
    };
}

<div class="apya-page">
<p class="text-muted mb-3" style="font-size:13px">Hesaplar arası transfer ve son işlemler</p>
<div class="row g-3">
    <div class="col-lg-5">

        <div class="card mb-3 text-white" style="background: linear-gradient(135deg, var(--apya-accent-500), var(--apya-accent-700));">
            <div class="card-body">
                <div class="apya-overline text-white-50">Toplam Bakiye (₺ karşılığı)</div>
                <h2 class="fw-bold apya-numeric mb-1">₺@Money(Model.TotalBalanceTry)</h2>
                <div class="small text-white-50">
                    <i class="fa fa-arrow-trend-up me-1" aria-hidden="true"></i>
                    @Model.Accounts.Count hesap · @Model.DistinctCurrencyCount para birimi
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Hesaplar</div>
            @if (!Model.Accounts.Any())
            {
                <div class="card-body text-muted text-center py-4" style="font-size:13px">
                    Henüz kasa/banka hesabı yok. <a href="/CashAccounts">Kasa &amp; Banka</a>'dan ekleyin.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.Accounts)
                    {
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <div class="kpi-icon-box kpi-icon-box--accent kpi-icon-box--sm">
                                <i class="fa @TypeIcon(a.Type)" aria-hidden="true"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate">
                                    @a.Name <span class="apya-chip apya-chip-neutral ms-1">@a.Currency</span>
                                </div>
                                <div class="small text-muted apya-numeric text-truncate">@(a.Iban ?? TypeLabel(a.Type))</div>
                            </div>
                            <div class="text-end apya-numeric fw-bold text-nowrap">@MoneyC(a.Balance, a.Currency)</div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="fa fa-paper-plane me-1" aria-hidden="true"></i>Hızlı Transfer</div>
            <div class="card-body" id="ApyaTransferWidget">
                <div class="text-muted text-center py-3" style="font-size:13px">Hesaplar yükleniyor...</div>
            </div>
        </div>

    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <span class="fw-semibold">Son İşlemler</span>
                    <div class="small text-muted">Tüm hesaplar</div>
                </div>
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.Transactions.Any())
                {
                    <div class="list-group-item text-muted text-center py-4" style="font-size:13px">Henüz işlem yok.</div>
                }
                @foreach (var t in Model.Transactions)
                {
                    var (tone, icon) = TxVisual(t.Type, t.IsInflow);
                    <a href="@t.Url" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <div class="kpi-icon-box kpi-icon-box--sm @tone">
                            <i class="fa @icon" aria-hidden="true"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-truncate">@t.Title</div>
                            <div class="small text-muted text-truncate">
                                @(t.CustomerName ?? t.ProjectName ?? "—") · @t.Date.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <span class="apya-chip apya-chip-neutral d-block mb-1">@t.CategoryLabel</span>
                            <div class="apya-numeric fw-bold @(t.IsInflow ? "text-success" : "text-danger")">
                                @(t.IsInflow ? "▲ +" : "▼ −")@MoneyC(t.Amount, t.Currency)
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
</div>
