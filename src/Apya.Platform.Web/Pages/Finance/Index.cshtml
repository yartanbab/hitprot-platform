@page
@using Apya.Platform.Web.Pages.Finance
@model IndexModel
@{
    ViewBag.PageTitle = "Para Hareketleri";
}
@section scripts {
    <abp-script src="/Pages/Finance/Index.js" />
}

@functions {
    // Çoklu döviz gizlendi — tutarlar sade (sembolsüz) gösterilir; tüm işlemler TRY.
    string Money(decimal v, string cur) => $"{v:N2}";
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size="_6">
                <abp-card-title><i class="fa fa-coins me-1"></i> @ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size="_6" class="text-end">
                <div class="dropdown d-inline-block">
                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-plus"></i> Ekle
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Incomes"><i class="fa fa-hand-holding-dollar text-success me-2"></i> Gelir</a></li>
                        <li><a class="dropdown-item" href="/Expenses"><i class="fa fa-receipt text-danger me-2"></i> Gider</a></li>
                        <li><a class="dropdown-item" href="/Invoices"><i class="fa fa-file-invoice-dollar text-primary me-2"></i> Fatura</a></li>
                    </ul>
                </div>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>

        @* === Özet kartları (para birimi başına) === *@
        @if (Model.Summaries.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var s in Model.Summaries)
                {
                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small mb-2 fw-bold">Özet</div>
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="text-muted small">Gelir</div>
                                    <div class="fw-bold text-success">@Money(s.Income, s.Currency)</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Gider</div>
                                    <div class="fw-bold text-danger">@Money(s.Expense, s.Currency)</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Net</div>
                                    <div class="fw-bold @(s.Net >= 0 ? "text-success" : "text-danger")">@Money(s.Net, s.Currency)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* === Filtre sekmeleri === *@
        <div class="btn-group btn-group-sm mb-3" role="group" id="TxFilter">
            <button type="button" class="btn btn-primary" data-filter="all">Tümü</button>
            <button type="button" class="btn btn-outline-primary" data-filter="Income">Gelirler</button>
            <button type="button" class="btn btn-outline-primary" data-filter="Expense">Giderler</button>
            <button type="button" class="btn btn-outline-primary" data-filter="Invoice">Faturalar</button>
        </div>

        @* === Birleşik hareket listesi === *@
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0" id="TransactionsTable">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tür</th>
                        <th>Açıklama</th>
                        <th>Proje</th>
                        <th>Cari</th>
                        <th class="text-end">Tutar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Transactions.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Henüz kayıt yok. Sağ üstten <strong>Ekle</strong> ile gelir, gider veya fatura ekleyin.</td></tr>
                    }
                    @foreach (var t in Model.Transactions)
                    {
                        var (badgeClass, badgeText) = t.Type switch
                        {
                            IndexModel.TxType.Income => ("bg-success", "Gelir"),
                            IndexModel.TxType.Expense => ("bg-danger", "Gider"),
                            _ => ("bg-primary", "Fatura")
                        };
                        <tr data-type="@t.Type">
                            <td class="text-nowrap">@t.Date.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge @badgeClass">@badgeText</span></td>
                            <td>@t.Title</td>
                            <td>@(t.ProjectName ?? "—")</td>
                            <td>@(t.CustomerName ?? "—")</td>
                            <td class="text-end fw-bold @(t.IsInflow ? "text-success" : "text-danger")">
                                @(t.IsInflow ? "+" : "−")@Money(t.Amount, t.Currency)
                            </td>
                            <td class="text-end"><a href="@t.Url" class="btn btn-sm btn-outline-secondary" title="Aç"><i class="fa fa-arrow-up-right-from-square"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </abp-card-body>
</abp-card>
