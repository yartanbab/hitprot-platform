@page "/TenantManagement/AiSettings"
@model Apya.Platform.Web.Pages.TenantManagement.AiSettings.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    ViewBag.Title = "AI Ayarları";
    var usagePct = Model.Current?.MonthlyTokenQuota > 0
        ? (int)(100.0 * Model.Current.TokensUsedThisMonth / Model.Current.MonthlyTokenQuota)
        : 0;
}

<div data-page-description="Müşteri bazlı AI kotası ve sağlayıcı" class="apya-page--narrow">
<abp-card>
    <abp-card-header>
        <abp-card-title>Tenant AI Ayarları</abp-card-title>
    </abp-card-header>
    <abp-card-body>
        @if (TempData["Saved"] != null)
        {
            <div class="alert alert-success" role="status">@L["Settings:Saved"]</div>
        }

        <form method="get" class="mb-4">
            <label class="form-label" for="AiTenantSelect">Tenant:</label>
            <select id="AiTenantSelect" name="TenantId" class="form-select" onchange="this.form.submit()">
                @foreach (var t in Model.TenantOptions)
                {
                    if (t.Id == Model.TenantId)
                    {
                        <option value="@t.Id" selected>@t.Name</option>
                    }
                    else
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                }
            </select>
        </form>

        @if (Model.Current != null)
        {
            <div class="alert alert-info">
                <strong>Aylık Kullanım:</strong> @Model.Current.TokensUsedThisMonth / @Model.Current.MonthlyTokenQuota token (kalan: @Model.Current.RemainingTokens)
                <div class="apya-tile-progress-label mt-2">
                    <span>Kota kullanımı</span>
                    <span class="apya-numeric">@usagePct%</span>
                </div>
                <div class="apya-mini-progress @(usagePct > 80 ? "is-negative" : usagePct > 50 ? "is-warning" : "is-positive")">
                    <span style="width: @usagePct%;"></span>
                </div>
                <small class="text-muted">Dönem başlangıcı: @Model.Current.QuotaPeriodStart.ToString("yyyy-MM-dd")</small>
            </div>
        }

        <form method="post">
            <input type="hidden" name="TenantId" value="@Model.TenantId" />

            <div class="mb-3">
                <label asp-for="Input.PreferredProvider" class="form-label">AI Sağlayıcı</label>
                @* Serbest metin değil: seçenekler servisin kabul ettiği kayıtlı sağlayıcılar (ADM-14).
                   Değer listede yoksa boş yer tutucu basılır; [Required] açık seçim ister. *@
                <select asp-for="Input.PreferredProvider" asp-items="Model.ProviderOptions" class="form-select">
                    @if (Model.ProviderNeedsChoice)
                    {
                        <option value="">@L["AiSettings:Provider:Choose"]</option>
                    }
                </select>
                <span asp-validation-for="Input.PreferredProvider" class="text-danger small"></span>
                @if (Model.UnknownStoredProvider != null)
                {
                    <div class="form-text text-danger">@L["AiSettings:Provider:StoredUnknown", Model.UnknownStoredProvider]</div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Input.PreferredModel" class="form-label">Model</label>
                <input asp-for="Input.PreferredModel" class="form-control" placeholder="gpt-4o-mini" />
                <span asp-validation-for="Input.PreferredModel" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.MonthlyTokenQuota" class="form-label">
                    Aylık Token Kotası
                    <apya-hint text="Bu kiracının bir dönemde harcayabileceği toplam token. Dönem her ayın 1'inde başlar. Kotayı Sıfırla düğmesi yalnız sayacı sıfırlar, buradaki limiti değiştirmez." />
                </label>
                <input asp-for="Input.MonthlyTokenQuota" type="number" min="0" class="form-control" />
                <span asp-validation-for="Input.MonthlyTokenQuota" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.IsEnabled" class="form-check-input" />
                <label asp-for="Input.IsEnabled" class="form-check-label">AI özellikleri aktif</label>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <button type="submit" asp-page-handler="Reset" formnovalidate class="btn btn-warning ms-2"
                    onclick="return confirm('Bu tenant için aylık kullanımı sıfırlamak istediğinize emin misiniz?')">
                Kotayı Sıfırla
            </button>
        </form>
    </abp-card-body>
</abp-card>
</div>
