@page
@model Apya.Platform.Web.Pages.TenantManagement.Tenants.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    ViewBag.PageTitle = "Kiracı Yönetimi";
}
@section scripts {
    <abp-script src="/Pages/TenantManagement/Tenants/Index.js" />
}

<div data-page-description="Müşteri hesapları ve paketleri" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <a href="/TenantManagement/Tenants?handler=Excel" data-transfer-export class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-file-excel me-1" aria-hidden="true"></i>@L["Export:ExcelButton"]
                </a>
                <button id="NewTenantButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i> Yeni Müşteri Ekle (Gelişmiş)
                </button>
                <apya-hint placement="bottom" text="3 sekmeli sihirbaz açar: Temel Bilgiler, Resmi (Kurumsal) Bilgiler, Adres & İletişim. Yalnız Temel Bilgiler sekmesindeki isim, yönetici e-postası ve şifre zorunludur — diğer ikisi isteğe bağlıdır, boş geçilebilir." />
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="TenantsTable" class="apya-clean-table"></abp-table>
    </abp-card-body>
</abp-card>
</div>
