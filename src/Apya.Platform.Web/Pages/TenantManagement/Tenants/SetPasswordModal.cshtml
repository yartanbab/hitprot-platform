@page
@model Apya.Platform.Web.Pages.TenantManagement.Tenants.SetPasswordModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/TenantManagement/Tenants/SetPasswordModal")">
    <abp-modal>
        <abp-modal-header title="Şifre Belirle"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="TenantId" />

            @if (!string.IsNullOrWhiteSpace(Model.TenantName))
            {
                <div class="mb-3 text-muted small">Müşteri: <strong>@Model.TenantName</strong></div>
            }

            <abp-select asp-for="Input.UserId" asp-items="Model.UserOptions" label="Kullanıcı" />
            <abp-input asp-for="Input.NewPassword" label="Yeni Şifre" />
            <abp-input asp-for="Input.ConfirmPassword" label="Yeni Şifre (Tekrar)" />

            <div class="form-text">
                Eski şifre sorulmaz. Kaydedildiği anda kullanıcının açık oturumları düşer ve
                yeni şifreyle girmesi gerekir; şifreyi müşteriye siz iletirsiniz.
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
