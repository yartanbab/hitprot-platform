@page
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.ExchangeRates.IndexModel
@{
    ViewBag.PageTitle = "Kurlar";
}
@section scripts {
    <abp-script src="/Pages/ExchangeRates/Index.js" />
}

<div data-page-description="Günlük ve manuel döviz kurları" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size="_6">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size="_6" class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.ExchangeRates.Create))
                {
                    <button id="SyncTcmbButton" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="fa fa-sync"></i> TCMB'den Güncelle
                    </button>
                    <button id="NewExchangeRateButton" class="btn btn-primary btn-sm">
                        <i class="fa fa-plus"></i> Yeni Kur Ekle
                    </button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="ExchangeRatesTable" class="nowrap apya-clean-table"></abp-table>
    </abp-card-body>
</abp-card>
</div>
