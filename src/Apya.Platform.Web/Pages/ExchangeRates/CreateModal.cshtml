@page
@model Apya.Platform.Web.Pages.ExchangeRates.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/ExchangeRates/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Kur"></abp-modal-header>
        <abp-modal-body>
            <abp-row>
                <abp-column size-md="_4">
                    <abp-select asp-for="ExchangeRate.FromCurrency" asp-items="Model.Currencies" label="Kaynak Para Birimi" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-select asp-for="ExchangeRate.ToCurrency" asp-items="Model.Currencies" label="Hedef Para Birimi" />
                </abp-column>
                <abp-column size-md="_4">
                    <abp-input asp-for="ExchangeRate.Rate" label="Kur (1 kaynak = ? hedef)" data-money-input="true" data-decimals="6" />
                </abp-column>
            </abp-row>
            <label class="form-label" for="ExchangeRate_RateDate">
                Kur Tarihi
                <apya-hint text="Kurun geçerli olduğu gün. Transferler ve ₺ karşılığı toplamlar her zaman EN GÜNCEL tarihli kaydı kullanır; kur değerleme ise değerleme tarihine kadarki en güncel kaydı seçer. Aynı gün ve para birimi çifti için ikinci bir kayıt girmek engellenmez — mükerrer kayıttan kaçının." />
            </label>
            <abp-input asp-for="ExchangeRate.RateDate" type="date" suppress-label="true" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
