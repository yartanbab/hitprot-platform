@page
@model Apya.Platform.Web.Pages.Expenses.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Expenses/EditModal")">
    <abp-modal>
        <abp-modal-header title="Gideri Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="ExpenseId" />
            <abp-input asp-for="Expense.Title" label="Başlık" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Expense.Amount" label="Tutar" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Expense.ExpenseDate" type="date" label="Tarih" />
                </abp-column>
            </abp-row>
            @* Çoklu para birimi gizlendi — mevcut kaydın para birimi korunur. *@
            <input type="hidden" asp-for="Expense.Currency" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Expense.Category" asp-items="Model.Categories" label="Kategori" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Expense.CashAccountId" asp-items="Model.Accounts" label="Kasa" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_12">
                    <abp-select asp-for="Expense.ProjectId" asp-items="Model.Projects" label="Proje (opsiyonel)">
                        <option value="">— Proje yok —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            @* Cari alanı gizlendi (kullanıcı kararı 2026-06-22); mevcut değer korunsun diye gizli alan. *@
            <input type="hidden" asp-for="Expense.CustomerId" />
            <abp-input asp-for="Expense.Description" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

@* Proje seçiliyse tarih, projenin başlangıç–bitiş aralığında olmalı (apya-finance-modal.js). *@
<script type="application/json" id="ExpenseEditProjectDates">@Html.Raw(Model.ProjectDatesJson)</script>
<script>
    (function () {
        var dates = {};
        try { dates = JSON.parse(document.getElementById('ExpenseEditProjectDates').textContent || '{}'); } catch (e) { }
        setTimeout(function () {
            apya.financeModal.bindProjectDateRange({
                formSelector: 'form[action$="/Expenses/EditModal"]',
                projectSelector: '#Expense_ProjectId',
                dateSelector: '#Expense_ExpenseDate',
                projectDates: dates
            });
        }, 0);
    })();
</script>
