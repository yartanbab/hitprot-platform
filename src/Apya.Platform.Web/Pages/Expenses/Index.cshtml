@page
@model Apya.Platform.Web.Pages.Expenses.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = "Giderler";
}
@section scripts {
    <abp-script src="/Pages/Expenses/Index.js" />
}

<div data-page-description="Proje ve genel giderler" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <button type="button" id="ExpensesExportExcel" data-transfer-export class="btn btn-outline-secondary btn-sm me-1">
                    <i class="fa fa-file-excel"></i> @L["Export:ExcelButton"]
                </button>
                @if (await AuthorizationService.IsGrantedAsync(Apya.Platform.Permissions.PlatformPermissions.Expenses.Create))
                {
                    <button type="button" id="ExpensesImportExcel" class="btn btn-outline-secondary btn-sm me-1">
                        <i class="fa fa-file-import"></i> @L["Import:ExcelButton"]
                    </button>
                }
                <a href="/Expenses/Capture" class="btn btn-outline-secondary btn-sm me-1">
                    <i class="fa fa-camera"></i> Masraf Yakala
                </a>
                <apya-hint placement="bottom" text="Fiş/fatura fotoğrafını çekip ona bakarak masraf girmek için: fotoğraf formun üstünde durur, tutarı, tarihi ve tedarikçiyi siz girersiniz. Sahada ardışık masraf girmek için tasarlandı." />
                <button id="NewExpenseButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i> Yeni Gider
                </button>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="ExpensesTable" class="nowrap apya-clean-table"></abp-table>
    </abp-card-body>
</abp-card>
</div>
