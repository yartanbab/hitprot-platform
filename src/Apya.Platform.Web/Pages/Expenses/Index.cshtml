@page
@model Apya.Platform.Web.Pages.Expenses.IndexModel
@{
    ViewBag.PageTitle = "Giderler";
}
@section scripts {
    <abp-script src="/Pages/Expenses/Index.js" />
}

<div class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size="_6">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size="_6" class="text-end">
                <a href="/Expenses/Capture" class="btn btn-outline-secondary btn-sm me-1">
                    <i class="fa fa-camera"></i> Masraf Yakala
                </a>
                <apya-hint placement="bottom" text="Fiş/fatura fotoğrafını çekip tutar ve tarihi otomatik okutmak için. Okuma başarısız olursa form boş açılır, elle doldurursunuz. Sahada ardışık masraf girmek için tasarlandı." />
                <button id="NewExpenseButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i> Yeni Gider
                </button>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="ExpensesTable" class="nowrap"></abp-table>
    </abp-card-body>
</abp-card>
</div>
