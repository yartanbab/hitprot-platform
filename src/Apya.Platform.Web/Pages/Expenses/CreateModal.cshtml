@page
@model Apya.Platform.Web.Pages.Expenses.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Expenses/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Gider"></abp-modal-header>
        <abp-modal-body>
            @* Görev panelinden açılınca TaskId query'den gelir; POST'ta korunması için gizli alan.
               Eksikti → gider TaskId'siz oluşuyor, görevin Finans sekmesinde listelenmiyordu. *@
            <input type="hidden" asp-for="Expense.TaskId" />
            <abp-input asp-for="Expense.Title" label="Başlık" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Expense.Amount" label="Tutar" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Expense.ExpenseDate" type="date" label="Tarih" />
                </abp-column>
            </abp-row>
            @* Çoklu döviz gizlendi — tüm işlemler TRY. *@
            <input type="hidden" asp-for="Expense.Currency" value="TRY" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Expense.Category" asp-items="Model.Categories" label="Kategori" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Expense.CashAccountId" asp-items="Model.Accounts" label="Kasa (zorunlu — buradan ödenir)" />
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_12">
                    <abp-select asp-for="Expense.ProjectId" asp-items="Model.Projects" label="Proje (opsiyonel)">
                        <option value="">— Proje yok —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            @* Cari alanı gizlendi (kullanıcı kararı 2026-06-22); değer korunsun diye gizli alan. *@
            <input type="hidden" asp-for="Expense.CustomerId" />
            <abp-input asp-for="Expense.Description" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

@* Proje seçiliyse tarih, projenin başlangıç–bitiş aralığında olmalı (apya-finance-modal.js). *@
<script type="application/json" id="ExpenseCreateProjectDates">@Html.Raw(Model.ProjectDatesJson)</script>
<script>
    (function () {
        var dates = {};
        try { dates = JSON.parse(document.getElementById('ExpenseCreateProjectDates').textContent || '{}'); } catch (e) { }
        setTimeout(function () {
            apya.financeModal.bindProjectDateRange({
                formSelector: 'form[action$="/Expenses/CreateModal"]',
                projectSelector: '#Expense_ProjectId',
                dateSelector: '#Expense_ExpenseDate',
                projectDates: dates
            });
        }, 0);
    })();
</script>
