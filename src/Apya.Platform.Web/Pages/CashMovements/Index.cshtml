@page
@model Apya.Platform.Web.Pages.CashMovements.IndexModel
@{
    ViewBag.PageTitle = "Kasa Hareketleri";
}
@section scripts {
    <abp-script src="/Pages/CashMovements/Index.js" />
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size="_5">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
            </abp-column>
            <abp-column size="_4">
                <select id="AccountFilter" class="form-select form-select-sm">
                    <option value="">— Tüm kasalar —</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Value">@a.Text</option>
                    }
                </select>
            </abp-column>
            <abp-column size="_3" class="text-end">
                <button id="NewCashMovementButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i> Yeni Hareket
                </button>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <div id="BalanceCard" class="alert alert-info d-none mb-3">
            <strong id="BalAccount"></strong> —
            Açılış: <span id="BalOpening"></span> |
            Giriş: <span class="text-success" id="BalIn"></span> |
            Çıkış: <span class="text-danger" id="BalOut"></span> |
            <strong>Güncel Bakiye: <span id="BalCurrent"></span></strong>
        </div>
        <abp-table striped-rows="true" id="CashMovementsTable" class="nowrap"></abp-table>
    </abp-card-body>
</abp-card>
