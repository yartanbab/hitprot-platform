@page
@model Apya.Platform.Web.Pages.Feedback.IndexModel
@{
    ViewData["Title"] = "Geri Bildirimlerim";
}

<div class="apya-page--narrow py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa fa-comment-dots me-2 text-primary"></i> Geri Bildirimlerim</h5>
                    <button id="btn-new-feedback" class="btn btn-sm btn-primary">
                        <i class="fa fa-plus me-1"></i> Yeni Geri Bildirim
                    </button>
                </div>
                <div class="card-body p-0">
                    <div id="feedback-full-list" class="list-group list-group-flush">
                        <div class="text-center p-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Geri bildirimler yükleniyor...</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center py-3">
                    <button id="load-more-btn" class="btn btn-sm btn-light d-none">
                        <i class="fa fa-chevron-down me-1"></i> Daha Fazla Göster
                    </button>
                    <p id="no-more-feedback" class="text-muted text-sm d-none mb-0">Tüm geri bildirimler gösterildi.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="feedback-detail-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title mb-0" id="feedback-detail-subject"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="feedback-detail-meta" class="mb-3 text-sm text-muted"></div>
                <p id="feedback-detail-body" class="mb-4"></p>
                <div id="feedback-detail-attachments" class="mb-3"></div>
                <hr />
                <h6 class="text-sm fw-bold mb-3">Cevaplar</h6>
                <div id="feedback-detail-comments"></div>

                @* Kullanıcının ek açıklaması — ilk metin değişmez, diyaloğa eklenir. *@
                <div class="mt-3">
                    <label class="form-label text-sm fw-bold" for="feedback-detail-comment-input">Ek açıklama yaz</label>
                    <textarea id="feedback-detail-comment-input" class="form-control form-control-sm" rows="2"
                              maxlength="4000" placeholder="Sorulara cevabınızı veya ek bilginizi buraya yazın..."></textarea>
                    <div class="text-end mt-2">
                        <button id="feedback-detail-comment-send" class="btn btn-sm btn-primary">
                            <i class="fa fa-paper-plane me-1"></i> Gönder
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .feedback-page-item { transition: all 0.2s; border-left: 4px solid transparent; cursor: pointer; }
    .feedback-page-item:hover { background-color: var(--apya-surface-raised); }
    .feedback-status-badge { font-size: 0.7rem; }
    .feedback-comment-item { border-left: 3px solid var(--apya-accent-500); padding: 0.5rem 0.75rem; margin-bottom: 0.75rem; background: var(--apya-surface-sunken); border-radius: 0 6px 6px 0; }
</style>

@section scripts {
    <abp-script src="/Pages/Feedback/Index.js" />
}
