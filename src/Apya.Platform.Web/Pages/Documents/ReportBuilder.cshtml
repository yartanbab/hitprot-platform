@page
@model Apya.Platform.Web.Pages.Documents.ReportBuilderModel
@{
    ViewBag.Title = "Rapor derleyici";
}

@* Tailwind island stylesheet (js/style.css) — bu partial olmadan island stilsiz kalır. *@
<partial name="_ApyaThemeBootstrap" />
<island-preload entry="documents-report" />

@* Şablon .json içe aktarması dosyayı FormData ile yollar; jeton buradan okunur. *@
@Html.AntiForgeryToken()

<div data-page-description="Şablon bölümlerini seçin, önizleyin, alıcıya dağıtın" class="apya-page">
    <div id="report-builder-island"></div>
</div>

<script type="module" src="~/js/documents-report.js" asp-append-version="true"></script>
