@page
@model Apya.Platform.Web.Pages.Documents.CreateModalModel
@using Apya.Platform.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<PlatformResource> L
@{
    Layout = null;
}
@* DOC-06: pencerenin tek çağıranı klasör oluşturma (DocumentsRoot.jsx openCreateFolder). İkon ve İçerik
   arayüzde hiç gösterilmiyordu → kaldırıldı (DTO'da duruyor; gönderilmeyen içerik "" kaydedilir). Son Tarih
   DocumentExpiryWorker ile işlevsel (7 gün kala hatırlatma) → kalır. EditModal'a DOKUNULMADI: tam değiştirme
   ucunda formdan düşen alan mevcut değeri siler. *@
<form method="post" action="@Url.Page("/Documents/CreateModal")">
    <abp-modal>
        <abp-modal-header title="@L["Documents:NewFolder:Title"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="ParentDocumentId" />
            <abp-input asp-for="Document.Title" label="@L["Documents:NewFolder:Name"].Value" />
            <label class="form-label" for="Document_ExpiryDate">
                Son Tarih
                <apya-hint text="Belgenin geçerlilik bitiş tarihi. Bu tarihe 7 gün kala sistem otomatik hatırlatma bildirimi gönderir. Boş bırakırsanız hiç hatırlatma yapılmaz." />
            </label>
            <abp-input asp-for="Document.ExpiryDate" suppress-label="true" type="date" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
