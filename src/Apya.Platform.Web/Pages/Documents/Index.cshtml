@page
@model Apya.Platform.Web.Pages.Documents.IndexModel
@{
    ViewBag.Title = "Dokümanlar";
}

@*
    data-filter: konsol filtre sözleşmesi. Üst bardaki kayıtlı görünüm çipi
    (wwwroot/js/apya-saved-views.js) yalnız bu işareti taşıyan ekranlarda basılır
    ve ekranın FİLTRE URL'İNİ adlandırıp saklar. İşaret STATİK olmalı — çip
    DOMContentLoaded'da kurulur, React adası ise daha sonra bağlanır.
*@
<div data-page-description="Klasörler ve doküman arşivi" class="apya-page" data-filter="documents">
    <div id="documents-island"></div>
</div>

<script type="module" src="~/js/documents.js" asp-append-version="true"></script>
