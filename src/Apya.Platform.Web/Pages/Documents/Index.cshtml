@page
@model Apya.Platform.Web.Pages.Documents.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    ViewBag.Title = "Belgeler";
}

@* Tailwind island stylesheet (js/style.css) — bu partial olmadan island stilsiz kalır. *@
<partial name="_ApyaThemeBootstrap" />
<island-preload entry="documents" />

@*
    data-filter: konsol filtre sözleşmesi. Üst bardaki kayıtlı görünüm çipi
    (wwwroot/js/apya-saved-views.js) yalnız bu işareti taşıyan ekranlarda basılır
    ve ekranın FİLTRE URL'İNİ adlandırıp saklar. İşaret STATİK olmalı — çip
    DOMContentLoaded'da kurulur, React adası ise daha sonra bağlanır.
*@
<div data-page-description="Klasörler ve belge arşivi" class="apya-page" data-filter="documents">
    @* Ada dışında: süzgeç adres çubuğunda yaşadığı için düğme onu tıklama anında okur,
       ada yeniden derlenmeden çalışır (sunucu tarafı: OnGetFilesExcelAsync). *@
    <div class="apya-page-head">
        <div class="apya-page-head-actions">
            <button type="button" id="DocumentsExportExcel" data-transfer-export class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-file-excel me-1" aria-hidden="true"></i>@L["Export:ExcelButton"]
            </button>
        </div>
    </div>
    <div id="documents-island"></div>
</div>

<script type="module" src="~/js/documents.js" asp-append-version="true"></script>
<script>
    document.getElementById('DocumentsExportExcel').addEventListener('click', function () {
        var from = new URLSearchParams(window.location.search);
        var to = new URLSearchParams({ handler: 'FilesExcel' });
        if (window.apyaExportFormat) { to.set('format', window.apyaExportFormat); }
        ['folder', 'step', 'projectId', 'smart', 'q', 'sort'].forEach(function (k) {
            if (from.get(k)) { to.set(k, from.get(k)); }
        });
        window.location.href = window.location.pathname + '?' + to.toString();
    });
</script>
