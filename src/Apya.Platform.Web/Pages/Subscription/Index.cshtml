@page "/Subscription"
@model Apya.Platform.Web.Pages.Subscription.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@using Apya.Platform.Tenants
@{
    ViewBag.Title = L["Subscription:Title"].Value;
    var sub = Model.Subscription;
}

@section styles {
    @* Sözleşme kartındaki belge görünümü. Aynı dosya /Account/Protokol'de de yüklenir. *@
    <abp-style src="/css/apya-document.css" />
}

@*
    PAKETİM — kiracının kendi paketini gördüğü tek yüzey.

    Neden var: süre bildirimleri ("süreniz doluyor", "Basic'e indirildiniz") kiracıya
    gidiyordu ama tıklanacak bir yer yoktu; paket, kalan süre ve kota kullanımı hiçbir
    ekranda görünmüyordu. Yükseltme çağrısının da bir evi olması gerekiyordu.

    Sayfa SALT OKUNURDUR. Yükseltme, host'un tanımladığı iletişim kanalına yönlendirir;
    kanal tanımlı değilse hiçbir çağrı basılmaz — çalışmayan düğme göstermek, hiç
    göstermemekten kötüdür.
*@
@* apya-subscription: kart içeriğinin metin rengini token'a bağlayan kural buna asılı
   (LeptonX'in sabit .card-body rengi koyu temada 3,43:1'de bırakıyordu). *@
<div data-page-description="@L["Subscription:PageDescription"]" class="apya-page--narrow apya-subscription">

@if (Model.IsHost)
{
    <div class="alert alert-info" role="status">
        <i class="fa fa-circle-info me-2"></i>@L["Subscription:Host.Notice"]
    </div>
}
else
{
    <abp-card>
        <abp-card-body>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="flex-grow-1">
                    <div class="text-muted small">@L["Subscription:CurrentPackage"]</div>
                    <div class="fs-3 fw-semibold">@sub.PackageName</div>
                </div>
                <div class="text-md-end">
                    @if (sub.IsInGrace)
                    {
                        <span class="badge bg-danger fs-6">@L["Subscription:Status.InGrace"]</span>
                    }
                    else if (sub.IsUnlimited)
                    {
                        <span class="badge bg-success fs-6">@L["Subscription:Status.Unlimited"]</span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6">@L["Subscription:Status.Active"]</span>
                    }
                </div>
            </div>

            @if (sub.IsInGrace && sub.EndDate.HasValue)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    <i class="fa fa-triangle-exclamation me-2"></i>
                    @L["Subscription:GraceNotice", sub.EndDate.Value.ToString("dd.MM.yyyy")]
                </div>
            }
            else if (!sub.IsUnlimited && sub.EndDate.HasValue)
            {
                @* 7 gün ve altı uyarı rengine geçer: bildirim eşiklerinin varsayılanı da 7. *@
                var soon = sub.DaysRemaining <= 7;
                <div class="alert @(soon ? "alert-warning" : "alert-secondary") mt-3 mb-0" role="status">
                    <i class="fa fa-hourglass-half me-2"></i>
                    @L["Subscription:EndsAt", sub.EndDate.Value.ToString("dd.MM.yyyy")]
                    @if (sub.DaysRemaining.HasValue)
                    {
                        <strong class="ms-1">
                            @(sub.DaysRemaining.Value == 0
                                ? L["Subscription:EndsToday"].Value
                                : L["Subscription:DaysRemaining", sub.DaysRemaining.Value].Value)
                        </strong>
                    }
                </div>
            }
        </abp-card-body>
    </abp-card>

    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title><i class="fa fa-gauge-high text-primary me-2"></i>@L["Subscription:Quotas"]</abp-card-title>
        </abp-card-header>
        <abp-card-body>
            <div class="row g-3">
                @foreach (var quota in sub.Quotas)
                {
                    <div class="col-12 col-md-6">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-medium">@quota.DisplayName</span>
                            <span class="text-muted small">
                                @quota.Used /
                                @(quota.IsUnlimited
                                    ? L["Subscription:Quota.Unlimited"].Value
                                    : quota.Max.ToString())
                            </span>
                        </div>
                        @if (!quota.IsUnlimited)
                        {
                            @* Kotası dolan kiracı, yükseltme kartını görmeden önce sebebi burada görür. *@
                            var tone = quota.UsagePercent >= 100 ? "bg-danger"
                                : quota.UsagePercent >= 80 ? "bg-warning" : "bg-primary";
                            <div class="progress mt-1" style="height:.5rem"
                                 role="progressbar" aria-label="@quota.DisplayName"
                                 aria-valuenow="@quota.UsagePercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @tone" style="width:@(quota.UsagePercent)%"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </abp-card-body>
    </abp-card>

    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title><i class="fa fa-list-check text-primary me-2"></i>@L["Subscription:Capabilities"]</abp-card-title>
        </abp-card-header>
        <abp-card-body>
            <div class="row g-2">
                @foreach (var capability in sub.Capabilities)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="d-flex align-items-center gap-2 @(capability.Enabled ? null : "text-muted")">
                            <i class="fa @(capability.Enabled ? "fa-circle-check text-success" : "fa-lock")"></i>
                            <span>@capability.DisplayName</span>
                        </div>
                    </div>
                }
            </div>
        </abp-card-body>
    </abp-card>

    @if (sub.UpgradeOptions.Count == 0)
    {
        <div class="alert alert-success mt-3" role="status">
            <i class="fa fa-crown me-2"></i>@L["Subscription:TopTier"]
        </div>
    }
    else
    {
        <abp-card class="mt-3">
            <abp-card-header>
                <abp-card-title><i class="fa fa-arrow-up-right-dots text-primary me-2"></i>@L["Subscription:Upgrade.Title"]</abp-card-title>
            </abp-card-header>
            <abp-card-body>
                <div class="row g-3">
                    @foreach (var option in sub.UpgradeOptions)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="border rounded-3 p-3 h-100 d-flex flex-column">
                                <div class="fs-5 fw-semibold mb-2">@option.PackageName</div>

                                @if (option.UnlockedCapabilities.Count > 0)
                                {
                                    <div class="text-muted small">@L["Subscription:Upgrade.Unlocks"]</div>
                                    <ul class="list-unstyled mb-2">
                                        @foreach (var name in option.UnlockedCapabilities)
                                        {
                                            <li><i class="fa fa-plus text-success me-2"></i>@name</li>
                                        }
                                    </ul>
                                }

                                @if (option.QuotaGains.Count > 0)
                                {
                                    <div class="text-muted small">@L["Subscription:Upgrade.QuotaGains"]</div>
                                    <ul class="list-unstyled mb-2">
                                        @foreach (var gain in option.QuotaGains)
                                        {
                                            <li>
                                                <i class="fa fa-arrow-up text-success me-2"></i>
                                                @gain.DisplayName: @gain.CurrentMax →
                                                @(gain.TargetIsUnlimited
                                                    ? L["Subscription:Quota.Unlimited"].Value
                                                    : gain.TargetMax.ToString())
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (sub.HasUpgradeChannel)
                                {
                                    <div class="mt-auto pt-2 d-flex flex-wrap gap-2">
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeContactEmail))
                                        {
                                            <a class="btn btn-primary btn-sm"
                                               href="@Model.BuildMailToLink(sub.UpgradeContactEmail, option.PackageName)">
                                                <i class="fa fa-envelope me-1"></i>@L["Subscription:Upgrade.Email"]
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeContactPhone))
                                        {
                                            <a class="btn btn-outline-primary btn-sm" href="tel:@sub.UpgradeContactPhone">
                                                <i class="fa fa-phone me-1"></i>@sub.UpgradeContactPhone
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeUrl))
                                        {
                                            <a class="btn btn-link btn-sm" href="@sub.UpgradeUrl" target="_blank" rel="noopener">
                                                @L["Subscription:Upgrade.Details"]
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!sub.HasUpgradeChannel)
                {
                    @* Host iletişim kanalı tanımlamamış: düğme yerine kime gidileceği yazılır. *@
                    <div class="alert alert-secondary mt-3 mb-0" role="status">
                        <i class="fa fa-circle-info me-2"></i>@L["Subscription:Upgrade.NoChannel"]
                    </div>
                }
            </abp-card-body>
        </abp-card>
    }

    @* --- SÖZLEŞMEM ---
       Sözleşmesi olmayan kiracıda kart HİÇ basılmaz: protokol akışı devreye girmeden
       önce kurulmuş müşteriler için "sözleşme bulunamadı" yazmak, olmayan bir eksiklik
       varmış gibi gösterirdi. *@
    @if (Model.Agreement is { } agreement)
    {
        <abp-card class="mt-3">
            <abp-card-header>
                <abp-card-title>
                    <i class="fa fa-file-signature me-2"></i>@L["Subscription:Agreement.Title"]
                </abp-card-title>
            </abp-card-header>
            <abp-card-body>
                @if (!agreement.HashVerified)
                {
                    @* Saklanan metin, saklanan özetle tutmuyor. Sessiz geçmek, delil değerini
                       yitirmiş bir belgeyi geçerli göstermek olurdu. *@
                    <div class="alert alert-danger" role="alert">
                        <i class="fa fa-triangle-exclamation me-2"></i>@L["Subscription:Agreement.HashMismatch"]
                    </div>
                }

                <dl class="row small mb-3">
                    <dt class="col-sm-4">@L["Subscription:Agreement.Number"]</dt>
                    <dd class="col-sm-8">@agreement.Number</dd>

                    <dt class="col-sm-4">@L["Subscription:Agreement.Plan"]</dt>
                    <dd class="col-sm-8">@agreement.PlanName</dd>

                    @if (agreement.Amount.HasValue)
                    {
                        <dt class="col-sm-4">@L["Subscription:Agreement.Amount"]</dt>
                        <dd class="col-sm-8">@agreement.Amount.Value.ToString("N2") TL + KDV</dd>
                    }

                    <dt class="col-sm-4">@L["Subscription:Agreement.Term"]</dt>
                    <dd class="col-sm-8">
                        @agreement.StartDate.ToString("dd.MM.yyyy") – @agreement.EndDate.ToString("dd.MM.yyyy")
                    </dd>

                    <dt class="col-sm-4">@L["Subscription:Agreement.Approver"]</dt>
                    <dd class="col-sm-8">
                        @agreement.ApproverName · @agreement.ApproverTitle<br />
                        <span class="text-muted">
                            @agreement.ApprovedAt.ToString("dd.MM.yyyy HH:mm:ss")
                            @if (!string.IsNullOrWhiteSpace(agreement.ApprovedIp))
                            {
                                <text> · IP @agreement.ApprovedIp</text>
                            }
                        </span>
                    </dd>

                    <dt class="col-sm-4">@L["Subscription:Agreement.Hash"]</dt>
                    <dd class="col-sm-8"><code class="apya-doc__hash">@agreement.ContentHash</code></dd>
                </dl>

                <details class="apya-doc__details">
                    <summary>@L["Subscription:Agreement.ShowDocument"]</summary>
                    @* Belge onay anında sunucuda üretildi ve kaçırıldı; saklanan kopya
                       olduğu gibi basılır — yeniden render etmek "onaylanan metin" iddiasını
                       bozardı. *@
                    <div class="apya-doc__frame apya-doc__frame--tall mt-2">
                        @Html.Raw(agreement.RenderedHtml)
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                            onclick="window.print()">
                        <i class="fa fa-print me-1"></i>@L["Subscription:Agreement.Print"]
                    </button>
                </details>
            </abp-card-body>
        </abp-card>
    }

    @* --- FATURALARIM ---
       Faturası olmayan kiracıda kart yine basılır (boş mesajıyla): "faturam nerede"
       sorusunun cevabı, ekranın hiç olmaması değil, boş olduğunu söylemesidir. *@
    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title>
                <i class="fa fa-file-invoice me-2"></i>@L["Subscription:Billing.Title"]
            </abp-card-title>
        </abp-card-header>
        <abp-card-body>
            @if (TempData["BillingSaved"] != null)
            {
                <div class="alert alert-success" role="status">@TempData["BillingSaved"]</div>
            }
            @if (TempData["BillingError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["BillingError"]</div>
            }

            @if (Model.Invoices.Count == 0)
            {
                <p class="text-muted mb-0">@L["Subscription:Billing.Empty"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle small">
                        <thead>
                            <tr>
                                <th scope="Column">@L["Subscription:Billing.Number"]</th>
                                <th scope="Column">@L["Subscription:Billing.IssueDate"]</th>
                                <th scope="Column">@L["Subscription:Billing.DueDate"]</th>
                                <th scope="Column" class="text-end">@L["Subscription:Billing.Total"]</th>
                                <th scope="Column" class="text-end">@L["Subscription:Billing.Remaining"]</th>
                                <th scope="Column">@L["Subscription:Billing.Status"]</th>
                                <th scope="Column"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in Model.Invoices)
                            {
                                var formId = "declare-" + invoice.Id;
                                <tr>
                                    <td class="text-nowrap">
                                        @invoice.Number<br />
                                        <span class="text-muted">@L["Billing:Type:" + invoice.Type]</span>
                                    </td>
                                    <td class="text-nowrap">@invoice.IssueDate.ToString("dd.MM.yyyy")</td>
                                    <td class="text-nowrap @(invoice.IsOverdue ? "text-danger fw-semibold" : "")">
                                        @invoice.DueDate.ToString("dd.MM.yyyy")
                                    </td>
                                    <td class="text-end text-nowrap">@invoice.TotalAmount.ToString("N2") TL</td>
                                    <td class="text-end text-nowrap">@invoice.RemainingAmount.ToString("N2") TL</td>
                                    <td>
                                        @if (invoice.IsOverdue)
                                        {
                                            <span class="badge bg-danger">@L["Subscription:Billing.Overdue"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@L["Billing:Status:" + invoice.Status]</span>
                                        }
                                        @if (invoice.HasPendingDeclaration)
                                        {
                                            <br />
                                            <span class="badge bg-info text-dark mt-1">@L["Subscription:Billing.PendingDeclaration"]</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (invoice.HasDocument)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-page-handler="DownloadInvoice" asp-route-id="@invoice.Id">
                                                <i class="fa fa-download me-1"></i>@L["Subscription:Billing.Download"]
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@L["Subscription:Billing.NoDocument"]</span>
                                        }
                                        @if (invoice.Status != Apya.Platform.Billing.SubscriptionInvoiceStatus.Paid
                                             && invoice.Status != Apya.Platform.Billing.SubscriptionInvoiceStatus.Cancelled)
                                        {
                                            <button class="btn btn-sm btn-link" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#@formId">
                                                @L["Subscription:Billing.DeclareTitle"]
                                            </button>
                                        }
                                    </td>
                                </tr>

                                @if (invoice.Payments.Count > 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-muted">
                                            <span class="fw-semibold">@L["Subscription:Billing.Payments"]:</span>
                                            @foreach (var payment in invoice.Payments)
                                            {
                                                <span class="me-3">
                                                    @payment.PaidAt.ToString("dd.MM.yyyy") ·
                                                    @payment.Amount.ToString("N2") TL ·
                                                    @(payment.IsConfirmed
                                                        ? L["Subscription:Billing.Confirmed"]
                                                        : L["Subscription:Billing.Declared"])
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }

                                <tr class="collapse" id="@formId">
                                    <td colspan="7" class="bg-body-tertiary">
                                        <p class="text-muted mb-2">@L["Subscription:Billing.DeclareHint"]</p>
                                        <form method="post" asp-page-handler="Declare" enctype="multipart/form-data"
                                              class="row g-2 align-items-end">
                                            <input type="hidden" name="id" value="@invoice.Id" />

                                            <div class="col-sm-3">
                                                <label class="form-label small mb-0" for="paid-@invoice.Id">
                                                    @L["Subscription:Billing.PaidAt"]
                                                </label>
                                                <input class="form-control form-control-sm" type="date"
                                                       id="paid-@invoice.Id" name="declarePaidAt"
                                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            </div>
                                            <div class="col-sm-3">
                                                <label class="form-label small mb-0" for="amt-@invoice.Id">
                                                    @L["Subscription:Billing.Amount"]
                                                </label>
                                                @* __Invariant ŞART: elle name= ile yazılan ondalık alan.
                                                   Onsuz tr-TR bağlaması noktayı binlik sayar ve tutar bin kat sapar. *@
                                                <input class="form-control form-control-sm" type="number" step="0.01" min="0.01"
                                                       id="amt-@invoice.Id" name="declareAmount"
                                                       value="@invoice.RemainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                <input type="hidden" name="__Invariant" value="declareAmount" />
                                            </div>
                                            <div class="col-sm-2">
                                                <label class="form-label small mb-0" for="mth-@invoice.Id">
                                                    @L["Subscription:Billing.Method"]
                                                </label>
                                                <select class="form-select form-select-sm" id="mth-@invoice.Id" name="declareMethod">
                                                    @foreach (var method in Enum.GetValues<Apya.Platform.Billing.PaymentMethod>())
                                                    {
                                                        <option value="@method">@L["Billing:Method:" + method]</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-sm-4">
                                                <label class="form-label small mb-0" for="ref-@invoice.Id">
                                                    @L["Subscription:Billing.Reference"]
                                                </label>
                                                <input class="form-control form-control-sm" id="ref-@invoice.Id"
                                                       name="declareReference" />
                                            </div>
                                            <div class="col-sm-8">
                                                <label class="form-label small mb-0" for="rcpt-@invoice.Id">
                                                    @L["Subscription:Billing.Receipt"]
                                                </label>
                                                <input class="form-control form-control-sm" type="file"
                                                       id="rcpt-@invoice.Id" name="receipt" accept=".pdf,.jpg,.jpeg,.png" />
                                            </div>
                                            <div class="col-sm-4">
                                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                                    @L["Subscription:Billing.Submit"]
                                                </button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </abp-card-body>
    </abp-card>
}

</div>
