@page "/Subscription"
@model Apya.Platform.Web.Pages.Subscription.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@using Apya.Platform.Tenants
@{
    ViewBag.Title = L["Subscription:Title"].Value;
    var sub = Model.Subscription;
}

@*
    PAKETİM — kiracının kendi paketini gördüğü tek yüzey.

    Neden var: süre bildirimleri ("süreniz doluyor", "Basic'e indirildiniz") kiracıya
    gidiyordu ama tıklanacak bir yer yoktu; paket, kalan süre ve kota kullanımı hiçbir
    ekranda görünmüyordu. Yükseltme çağrısının da bir evi olması gerekiyordu.

    Sayfa SALT OKUNURDUR. Yükseltme, host'un tanımladığı iletişim kanalına yönlendirir;
    kanal tanımlı değilse hiçbir çağrı basılmaz — çalışmayan düğme göstermek, hiç
    göstermemekten kötüdür.
*@
@* apya-subscription: kart içeriğinin metin rengini token'a bağlayan kural buna asılı
   (LeptonX'in sabit .card-body rengi koyu temada 3,43:1'de bırakıyordu). *@
<div data-page-description="@L["Subscription:PageDescription"]" class="apya-page--narrow apya-subscription">

@if (Model.IsHost)
{
    <div class="alert alert-info" role="status">
        <i class="fa fa-circle-info me-2"></i>@L["Subscription:Host.Notice"]
    </div>
}
else
{
    <abp-card>
        <abp-card-body>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="flex-grow-1">
                    <div class="text-muted small">@L["Subscription:CurrentPackage"]</div>
                    <div class="fs-3 fw-semibold">@sub.PackageName</div>
                </div>
                <div class="text-md-end">
                    @if (sub.IsInGrace)
                    {
                        <span class="badge bg-danger fs-6">@L["Subscription:Status.InGrace"]</span>
                    }
                    else if (sub.IsUnlimited)
                    {
                        <span class="badge bg-success fs-6">@L["Subscription:Status.Unlimited"]</span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6">@L["Subscription:Status.Active"]</span>
                    }
                </div>
            </div>

            @if (sub.IsInGrace && sub.EndDate.HasValue)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    <i class="fa fa-triangle-exclamation me-2"></i>
                    @L["Subscription:GraceNotice", sub.EndDate.Value.ToString("dd.MM.yyyy")]
                </div>
            }
            else if (!sub.IsUnlimited && sub.EndDate.HasValue)
            {
                @* 7 gün ve altı uyarı rengine geçer: bildirim eşiklerinin varsayılanı da 7. *@
                var soon = sub.DaysRemaining <= 7;
                <div class="alert @(soon ? "alert-warning" : "alert-secondary") mt-3 mb-0" role="status">
                    <i class="fa fa-hourglass-half me-2"></i>
                    @L["Subscription:EndsAt", sub.EndDate.Value.ToString("dd.MM.yyyy")]
                    @if (sub.DaysRemaining.HasValue)
                    {
                        <strong class="ms-1">
                            @(sub.DaysRemaining.Value == 0
                                ? L["Subscription:EndsToday"].Value
                                : L["Subscription:DaysRemaining", sub.DaysRemaining.Value].Value)
                        </strong>
                    }
                </div>
            }
        </abp-card-body>
    </abp-card>

    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title><i class="fa fa-gauge-high text-primary me-2"></i>@L["Subscription:Quotas"]</abp-card-title>
        </abp-card-header>
        <abp-card-body>
            <div class="row g-3">
                @foreach (var quota in sub.Quotas)
                {
                    <div class="col-12 col-md-6">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-medium">@quota.DisplayName</span>
                            <span class="text-muted small">
                                @quota.Used /
                                @(quota.IsUnlimited
                                    ? L["Subscription:Quota.Unlimited"].Value
                                    : quota.Max.ToString())
                            </span>
                        </div>
                        @if (!quota.IsUnlimited)
                        {
                            @* Kotası dolan kiracı, yükseltme kartını görmeden önce sebebi burada görür. *@
                            var tone = quota.UsagePercent >= 100 ? "bg-danger"
                                : quota.UsagePercent >= 80 ? "bg-warning" : "bg-primary";
                            <div class="progress mt-1" style="height:.5rem"
                                 role="progressbar" aria-label="@quota.DisplayName"
                                 aria-valuenow="@quota.UsagePercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @tone" style="width:@(quota.UsagePercent)%"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </abp-card-body>
    </abp-card>

    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title><i class="fa fa-list-check text-primary me-2"></i>@L["Subscription:Capabilities"]</abp-card-title>
        </abp-card-header>
        <abp-card-body>
            <div class="row g-2">
                @foreach (var capability in sub.Capabilities)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="d-flex align-items-center gap-2 @(capability.Enabled ? null : "text-muted")">
                            <i class="fa @(capability.Enabled ? "fa-circle-check text-success" : "fa-lock")"></i>
                            <span>@capability.DisplayName</span>
                        </div>
                    </div>
                }
            </div>
        </abp-card-body>
    </abp-card>

    @if (sub.UpgradeOptions.Count == 0)
    {
        <div class="alert alert-success mt-3" role="status">
            <i class="fa fa-crown me-2"></i>@L["Subscription:TopTier"]
        </div>
    }
    else
    {
        <abp-card class="mt-3">
            <abp-card-header>
                <abp-card-title><i class="fa fa-arrow-up-right-dots text-primary me-2"></i>@L["Subscription:Upgrade.Title"]</abp-card-title>
            </abp-card-header>
            <abp-card-body>
                <div class="row g-3">
                    @foreach (var option in sub.UpgradeOptions)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="border rounded-3 p-3 h-100 d-flex flex-column">
                                <div class="fs-5 fw-semibold mb-2">@option.PackageName</div>

                                @if (option.UnlockedCapabilities.Count > 0)
                                {
                                    <div class="text-muted small">@L["Subscription:Upgrade.Unlocks"]</div>
                                    <ul class="list-unstyled mb-2">
                                        @foreach (var name in option.UnlockedCapabilities)
                                        {
                                            <li><i class="fa fa-plus text-success me-2"></i>@name</li>
                                        }
                                    </ul>
                                }

                                @if (option.QuotaGains.Count > 0)
                                {
                                    <div class="text-muted small">@L["Subscription:Upgrade.QuotaGains"]</div>
                                    <ul class="list-unstyled mb-2">
                                        @foreach (var gain in option.QuotaGains)
                                        {
                                            <li>
                                                <i class="fa fa-arrow-up text-success me-2"></i>
                                                @gain.DisplayName: @gain.CurrentMax →
                                                @(gain.TargetIsUnlimited
                                                    ? L["Subscription:Quota.Unlimited"].Value
                                                    : gain.TargetMax.ToString())
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (sub.HasUpgradeChannel)
                                {
                                    <div class="mt-auto pt-2 d-flex flex-wrap gap-2">
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeContactEmail))
                                        {
                                            <a class="btn btn-primary btn-sm"
                                               href="@Model.BuildMailToLink(sub.UpgradeContactEmail, option.PackageName)">
                                                <i class="fa fa-envelope me-1"></i>@L["Subscription:Upgrade.Email"]
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeContactPhone))
                                        {
                                            <a class="btn btn-outline-primary btn-sm" href="tel:@sub.UpgradeContactPhone">
                                                <i class="fa fa-phone me-1"></i>@sub.UpgradeContactPhone
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(sub.UpgradeUrl))
                                        {
                                            <a class="btn btn-link btn-sm" href="@sub.UpgradeUrl" target="_blank" rel="noopener">
                                                @L["Subscription:Upgrade.Details"]
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!sub.HasUpgradeChannel)
                {
                    @* Host iletişim kanalı tanımlamamış: düğme yerine kime gidileceği yazılır. *@
                    <div class="alert alert-secondary mt-3 mb-0" role="status">
                        <i class="fa fa-circle-info me-2"></i>@L["Subscription:Upgrade.NoChannel"]
                    </div>
                }
            </abp-card-body>
        </abp-card>
    }
}

</div>
