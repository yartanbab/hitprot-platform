@page "{id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@using Apya.Platform.Permissions
@using Apya.Platform.Web.Pages.Tasks
@inject IHtmlLocalizer<PlatformResource> L
@model DetailModel
@{
    ViewBag.Title = Model.Task?.Title ?? "Görev Detayı";
}

@* Tailwind island stylesheet (js/style.css) *@
<partial name="_ApyaThemeBootstrap" />

<div data-page-description="Görev detayları" class="apya-page max-w-7xl mx-auto py-4 px-4">
    @* Embedded React Island Mount Point *@
    <div id="task-detail-page-island" data-task-id="@Model.Id"></div>
</div>

@section styles {
    <link rel="stylesheet" href="~/libs/select2/css/select2.min.css" />
}

@section scripts {
    <script src="~/libs/select2/js/select2.min.js"></script>
    <script type="module" src="~/js/task-detail.js" asp-append-version="true"></script>
}
