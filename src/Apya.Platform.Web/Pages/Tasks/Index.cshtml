@page
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<PlatformResource> L
@using Apya.Platform.Web.Pages.Tasks
@model IndexModel


@* ─── Başlık satırı — AiCenter/Workflows/Index.cshtml ile aynı yerleşik desen. ─── *@
<div class="apya-page">
<div class="mb-3">
    <h1 class="h5 mb-1"><i class="fa fa-list-check me-2"></i>Görevler</h1>
    <p class="text-muted mb-0" style="font-size:12px">Tüm projelerdeki görevler · tablo görünümü</p>
</div>

@* ─── Gelişmiş Filtreleme Paneli ─── *@
<div class="accordion mb-3" id="taskFiltersAccordion">
    <div class="accordion-item shadow-sm border-0" style="border-radius:var(--apya-radius-xl);">
        <h2 class="accordion-header" id="headingFilters">
            <button class="accordion-button collapsed fw-bold text-primary"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseFilters"
                    aria-expanded="false"
                    aria-controls="collapseFilters"
                    style="border-radius:var(--apya-radius-xl);">
                <i class="fa fa-filter me-2"></i> @L["Tasks:AdvancedFilters"]
            </button>
        </h2>
        <div id="collapseFilters"
             class="accordion-collapse collapse"
             aria-labelledby="headingFilters"
             data-bs-parent="#taskFiltersAccordion">
            <div class="accordion-body bg-light" style="border-radius:0 0 var(--apya-radius-xl) var(--apya-radius-xl);">
                <form id="TaskFilterForm" class="row g-3">
                    <div class="col-md-3">
                        <label for="Filter_AssigneeId" class="form-label fw-bold small text-muted">@L["Tasks:Filter:Assignee"]</label>
                        <select id="Filter_AssigneeId" class="form-select border-0 shadow-sm">
                            <option value="">@L["Common:Everyone"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="Filter_Status" class="form-label fw-bold small text-muted">@L["Tasks:Filter:Status"]</label>
                        <select id="Filter_Status" class="form-select border-0 shadow-sm">
                            <option value="">@L["Common:All"]</option>
                            <option value="1">@L["Tasks:Status:Todo"]</option>
                            <option value="2">@L["Tasks:Status:InProgress"]</option>
                            <option value="3">@L["Tasks:Status:InReview"]</option>
                            <option value="4">@L["Tasks:Status:Done"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="Filter_Priority" class="form-label fw-bold small text-muted">Öncelik</label>
                        <select id="Filter_Priority" class="form-select border-0 shadow-sm">
                            <option value="">@L["Common:All"]</option>
                            <option value="1">Düşük</option>
                            <option value="2">Orta</option>
                            <option value="3">Yüksek</option>
                            <option value="4">Kritik</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="Filter_MinDueDate" class="form-label fw-bold small text-muted">@L["Tasks:Filter:MinDueDate"]</label>
                        <input type="date" id="Filter_MinDueDate" class="form-control border-0 shadow-sm">
                    </div>
                    <div class="col-md-2">
                        <label for="Filter_MaxDueDate" class="form-label fw-bold small text-muted">@L["Tasks:Filter:MaxDueDate"]</label>
                        <input type="date" id="Filter_MaxDueDate" class="form-control border-0 shadow-sm">
                    </div>
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="button" id="btn-apply-filters" class="btn btn-primary shadow-sm fw-bold flex-fill">
                            <i class="fa fa-search me-1"></i> @L["Common:Filter"]
                        </button>
                        <button type="button" id="btn-clear-filters" class="btn btn-light shadow-sm fw-bold flex-fill">@L["Common:Clear"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ─── Görev Yönetimi ─── *@
<abp-card>
    <abp-card-header class="border-bottom-0 pb-0">
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Tasks:BoardTitle"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <select id="tasks-project" class="form-select form-select-sm d-inline-block w-auto me-2 align-middle" title="Proje seçince kanban o projeye scope'lanır (özel kolonlar + Kolon Ekle); liste/gantt da filtrelenir">
                    <option value="">Tüm Projeler (Genel)</option>
                </select>
                <div class="btn-group me-2" role="group">
                    <button type="button" id="btn-view-list" class="btn btn-outline-primary active">
                        <i class="fa fa-list me-1"></i> @L["Tasks:View:List"]
                    </button>
                    <button type="button" id="btn-view-kanban" class="btn btn-outline-primary">
                        <i class="fa fa-columns me-1"></i> @L["Tasks:View:Kanban"]
                    </button>
                    <button type="button" id="btn-view-gantt" class="btn btn-outline-primary">
                        <i class="fa fa-stream me-1"></i> @L["Tasks:View:Gantt"]
                    </button>
                </div>
                @* APYA-122: AI ile Görev Oluştur butonu kaldırıldı.
                   Generic Tasks sayfasında AI özelliği uygunsuz — proje bağlamı olmadan
                   anlamlı bir AI üretimi yapılamaz. AI girişi proje detay sayfasından yapılmalı. *@
                @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Create))
                {
                    <abp-button id="NewTaskButton"
                                text="@L["Tasks:NewButton"].Value"
                                icon="plus"
                                button-type="Primary"
                                size="Small"
                                class="ms-1" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        @* --- LİSTE GÖRÜNÜMÜ --- *@
        <div id="view-list" class="view-panel">
            <abp-table striped-rows="true" id="TasksTable"></abp-table>
        </div>

        @* --- KANBAN GÖRÜNÜMÜ --- *@
        <div id="view-kanban" class="view-panel d-none">
            @* Merkezi kanban markup'ı (tek kaynak) — ortak çekirdek /js/apya-kanban.js doldurur. *@
            <partial name="_KanbanBoard" />
        </div>

        @* --- GANTT GÖRÜNÜMÜ --- *@
        <div id="view-gantt" class="view-panel d-none">
            <div class="gantt-controls mb-3 text-center">
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-light border gantt-change-view" data-view="Day">@L["Tasks:Gantt:Day"]</button>
                    <button type="button" class="btn btn-light border gantt-change-view" data-view="Week">@L["Tasks:Gantt:Week"]</button>
                    <button type="button" class="btn btn-light border gantt-change-view active" data-view="Month">@L["Tasks:Gantt:Month"]</button>
                </div>
            </div>
            <div style="overflow-x: auto;">
                <svg id="gantt-svg"></svg>
            </div>
        </div>
    </abp-card-body>
</abp-card>
</div>

@section styles {
    @* Merkezi kanban tasarımı (tek kaynak) *@
    <abp-style src="/css/kanban.css" />
    @* Görev modallarındaki etiket girişi (Select2 tags:true) — dark uyumu apya-shell.css'te zaten hazır. *@
    <link rel="stylesheet" href="~/libs/select2/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/frappe-gantt/0.6.1/frappe-gantt.min.css" />
    <style>
        /* Proje stili için Gantt özelleştirmesi */
        .gantt .bar-label { fill: #fff; font-weight: bold; } /* renkli bar üstü kontrast metni — bilinçli sabit */
        .gantt .bar-progress { fill: var(--apya-accent-500); }
        .gantt .bar { fill: var(--apya-border-strong); }
        .gantt .priority-high .bar-progress { fill: var(--apya-negative-500); }
        .gantt .priority-medium .bar-progress { fill: var(--apya-warning-500); }
        .gantt .priority-low .bar-progress { fill: var(--apya-positive-500); }
    </style>
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/frappe-gantt/0.6.1/frappe-gantt.min.js"></script>
    <script src="~/libs/select2/js/select2.min.js"></script>
    <abp-script src="/js/apya-task-render.js" />
    <abp-script src="/js/apya-kanban.js" />
    <abp-script src="/Pages/Tasks/index.js" />
}

<style>
    /* Kanban kart/kolon tasarımı artık /css/kanban.css'ten gelir (tek kaynak).
       Burada yalnızca timer + deadline animasyonları kalır. */
    .timer-active { border-left-color: var(--apya-negative-500) !important; background-color: var(--apya-negative-50) !important; box-shadow: 0 0 10px rgba(220, 53, 69, 0.2) !important; }
    .fa-beat { animation: fa-beat 1.5s infinite linear; }
    @@keyframes fa-beat {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }
    @@keyframes heartbeat {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    .heartbeat-animation { animation: heartbeat 1.5s infinite; }
</style>
