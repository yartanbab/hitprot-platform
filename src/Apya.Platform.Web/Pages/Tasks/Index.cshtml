@page
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<PlatformResource> L
@using Apya.Platform.Web.Pages.Tasks
@model IndexModel
@{
    ViewBag.Title = "Görevler";

    // Toplu işlem + satır aksiyonları izne bağlı; JS bunları kök elemandan okur
    // (ProjectDetails konsoluyla aynı desen).
    var canChangeStatus = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.ChangeStatus);
    var canDeleteTasks = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Delete);
    // Gantt'ta bar sürükleyip tarih kaydetmek görev düzenleme yetkisi ister.
    var canEditTasks = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Edit);
    var canBulk = canChangeStatus || canDeleteTasks;
    var canCreate = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Tasks.Create);
}

@* Tailwind island stylesheet (js/style.css) — bu partial olmadan görev detay modalı stilsiz kalır. *@
<partial name="_ApyaThemeBootstrap" />

@* Proje Detay konsolunun tasarım dili buraya uyarlandı. Fark: burası TÜM
   projelerin görevleri — proje kimliği/bütçe/ekip yerine proje FİLTRESİ ve
   PROJE kolonu var. Şerit barları çapraz-proje sayaçlarıdır (GetSummaryAsync). *@
<div data-page-description="Tüm projelerdeki görevler"
     class="apya-page apya-task-console"
     data-can-change-status="@canChangeStatus.ToString().ToLowerInvariant()"
     data-can-delete-tasks="@canDeleteTasks.ToString().ToLowerInvariant()"
     data-can-edit-tasks="@canEditTasks.ToString().ToLowerInvariant()"
     data-can-bulk="@canBulk.ToString().ToLowerInvariant()">

@* ─── ÜST ŞERİT ─── *@
<div class="apya-console-rail">

    <div class="apya-console-identity">
        <div class="d-flex align-items-center gap-2">
            <i class="fa fa-list-check apya-console-rocket" aria-hidden="true"></i>
            <h1 class="apya-console-name">Görevler</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="apya-chip apya-chip-neutral">Tüm projeler</span>
        </div>
    </div>

    <span class="apya-console-sep" aria-hidden="true"></span>

    @* Sayaç barları — hepsi aynı zamanda filtre düğmesi. Değerleri
       GetSummaryAsync doldurur (index.js). Barlar ve alttaki chip'ler AYNI
       state'i okur/yazar; iki ayrı filtre mekanizması yok. *@
    <div class="apya-console-bars">

        <button type="button" class="apya-console-bar" id="bar-progress" aria-pressed="false"
                title="Tamamlanmamış görevleri filtrele">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-chart-line me-1" aria-hidden="true"></i>İlerleme</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric" id="sum-progress-pct">—</strong>
                <small class="apya-numeric" id="sum-progress-ratio"></small>
            </span>
            <span class="apya-mini-progress is-progress" id="sum-progress-bar"><span style="width:0%"></span></span>
        </button>

        <button type="button" class="apya-console-bar" id="bar-overdue" aria-pressed="false"
                title="Gecikmiş görevleri filtrele">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>Gecikmiş</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric is-negative" id="sum-overdue">—</strong>
                <small>görev</small>
            </span>
            <span class="apya-mini-progress is-negative" id="sum-overdue-bar"><span style="width:0%"></span></span>
        </button>

        <button type="button" class="apya-console-bar" id="bar-due7" aria-pressed="false"
                title="7 gün içinde bitmesi gerekenler">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-calendar-day me-1" aria-hidden="true"></i>7 Gün İçinde</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric is-warning" id="sum-due7">—</strong>
                <small>görev</small>
            </span>
            <span class="apya-mini-progress is-warning" id="sum-due7-bar"><span style="width:0%"></span></span>
        </button>

        <button type="button" class="apya-console-bar" id="bar-mine" aria-pressed="false"
                title="Bana atanmış açık görevler">
            <span class="apya-console-bar-head">
                <span class="apya-console-bar-label"><i class="fa fa-user-check me-1" aria-hidden="true"></i>Bana Atanan</span>
                <span class="apya-console-bar-chevron" aria-hidden="true">&rsaquo;</span>
            </span>
            <span class="apya-console-bar-value">
                <strong class="apya-numeric" id="sum-mine">—</strong>
                <small>görev</small>
            </span>
            <span class="apya-mini-progress is-progress" id="sum-mine-bar"><span style="width:0%"></span></span>
        </button>

    </div>

    <div class="apya-console-actions">
        <div class="apya-console-search">
            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="console-search" placeholder="Görev ara" aria-label="Görev ara" />
        </div>

        @* Kolon araçları "Yeni Görev"in solunda (kullanıcı kararı 2026-08-25);
           yalnız Kanban görünümünde ve koşulları sağlanınca JS tarafından açılır. *@
        <partial name="_KanbanColumnTools" />

        @if (canCreate)
        {
            @* APYA-122: AI ile Görev Oluştur burada YOK — proje bağlamı olmadan
               anlamlı üretim yapılamıyor, AI girişi proje detayında. *@
            <button id="NewTaskButton" type="button" class="btn btn-primary btn-sm">
                <i class="fa fa-plus me-1" aria-hidden="true"></i>@L["Tasks:NewButton"]
            </button>
        }

        <div class="dropdown">
            <button type="button" class="apya-console-kebab" id="btn-tasks-menu"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                    aria-label="Görev menüsü" title="Görev menüsü">
                <i class="fa fa-ellipsis" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end apya-console-menu" aria-labelledby="btn-tasks-menu">

                <div class="apya-console-menu-head">Görünüm</div>
                <div class="apya-console-menu-row">
                    <span>Yoğunluk</span>
                    <span class="apya-console-density" role="group" aria-label="Satır yoğunluğu">
                        <button type="button" data-density-set="compact" title="Sıkı">S</button>
                        <button type="button" data-density-set="cozy" title="Normal">N</button>
                        <button type="button" data-density-set="comfortable" title="Geniş">G</button>
                    </span>
                </div>
                <div class="apya-console-menu-row is-stacked">
                    <span>Kolonlar</span>
                    <span class="apya-console-colpicker" role="group" aria-label="Görünür kolonlar">
                        <button type="button" data-col-toggle="project" aria-pressed="true">Proje</button>
                        <button type="button" data-col-toggle="effort" aria-pressed="true">Efor</button>
                        <button type="button" data-col-toggle="start" aria-pressed="true">Başlangıç</button>
                        <button type="button" data-col-toggle="due" aria-pressed="true">Bitiş</button>
                    </span>
                    <span class="apya-console-menu-hint">Başlık, Atanan, Durum ve Öncelik sabittir.</span>
                </div>

                <button type="button" class="apya-console-menu-item" id="menu-shortcuts">
                    <span class="apya-console-menu-icon"><i class="fa fa-keyboard" aria-hidden="true"></i></span>
                    Klavye kısayolları
                    <span class="apya-console-menu-trailing apya-numeric">?</span>
                </button>

                @* Kaydedilmiş görünümler — filtre + görünüm + arama önayarı.
                   Konsolda proje başına saklanır; burada proje yok, düz liste. *@
                <div class="apya-console-menu-head is-divided">Kaydedilmiş görünümler</div>
                <div id="saved-views-list"></div>
                <button type="button" class="apya-console-menu-item" id="btn-save-view">
                    <span class="apya-console-menu-icon"><i class="fa fa-bookmark" aria-hidden="true"></i></span>
                    Mevcut filtreyi kaydet
                </button>

                <div class="apya-console-menu-head is-divided">Geri bildirim</div>
                <div class="apya-console-menu-row">
                    @await Html.PartialAsync("/Pages/Shared/_FeedbackLink.cshtml",
                        new Apya.Platform.Web.Feedbacks.FeedbackLinkContext(Module: "Tasks", Component: "TaskList"))
                </div>
            </div>
        </div>
    </div>
</div>

@* ─── GÖREV ALANI ─── *@
<div class="card apya-console-main">

    <div class="apya-console-tabs" role="tablist">
        <button type="button" class="apya-console-tab active" id="btn-view-list"
                role="tab" aria-selected="true" aria-controls="view-list">
            <i class="fa fa-list" aria-hidden="true"></i>@L["Tasks:View:List"]
        </button>
        <button type="button" class="apya-console-tab" id="btn-view-kanban"
                role="tab" aria-selected="false" aria-controls="view-kanban">
            <i class="fa fa-table-columns" aria-hidden="true"></i>@L["Tasks:View:Kanban"]
        </button>
        <button type="button" class="apya-console-tab" id="btn-view-gantt"
                role="tab" aria-selected="false" aria-controls="view-gantt"
                title="Başlangıç-bitiş tarihlerinden türeyen zaman çizelgesi">
            <i class="fa fa-clock" aria-hidden="true"></i>@L["Tasks:View:Gantt"]
        </button>
        <span class="apya-console-count apya-numeric" id="console-task-count"></span>
    </div>

    @* ─── Filtre çubuğu ─── *@
    <div class="apya-console-filters" id="console-filters">
        <span class="apya-console-filter-label">Filtre</span>

        @* Mobilde chip'ler tek düğmenin arkasına katlanır — 375px'te üç satır
           kaplıyorlardı. Düğme YALNIZ mobilde görünür: masaüstünde sarmalayıcı
           `display: contents` olduğu için chip'ler eskisi gibi doğrudan filtre
           çubuğunun flex öğeleridir, düzen hiç değişmez. *@
        <button type="button" class="apya-filter-chip apya-filters-toggle" id="btn-filters-toggle"
                aria-expanded="false" aria-controls="console-filter-set">
            <i class="fa fa-filter" aria-hidden="true"></i>
            <span>Filtreler</span>
            @* Katlıyken kaç filtrenin etkin olduğu görünür kalsın (index.js doldurur). *@
            <span class="apya-filters-badge d-none" id="filters-active-count"></span>
        </button>

        <div class="apya-console-filter-set" id="console-filter-set">

            <div class="dropdown">
                <button type="button" class="apya-filter-chip" id="chip-status"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span data-chip-text>Durum: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu">
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="">Tümü</button>
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="1">@L["Tasks:Status:Todo"]</button>
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="2">@L["Tasks:Status:InProgress"]</button>
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="3">@L["Tasks:Status:InReview"]</button>
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="4">@L["Tasks:Status:Done"]</button>
                    <button type="button" class="apya-console-menu-item" data-filter="status" data-value="0">İptal</button>
                </div>
            </div>

            @* Atanan ve Proje listeleri JS ile doldurulur (lookup uçları) — konsolda
               bunlar PageModel'den geliyor, burada tenant'ın tamamı söz konusu. *@
            <div class="dropdown">
                <button type="button" class="apya-filter-chip" id="chip-assignee"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span data-chip-text>Atanan: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu" id="chip-assignee-menu">
                    <button type="button" class="apya-console-menu-item" data-filter="assignee" data-value="">Tümü</button>
                </div>
            </div>

            <div class="dropdown">
                <button type="button" class="apya-filter-chip" id="chip-project"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span data-chip-text>Proje: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu" id="chip-project-menu">
                    <button type="button" class="apya-console-menu-item" data-filter="project" data-value="">Tümü</button>
                </div>
            </div>
            <apya-hint placement="bottom" text="Üç görünümü de filtreler. Bir proje seçtiğinizde Kanban o projenin kendi kolonlarına geçer ve Kolon Ekle görünür; Tüm Projeler seçiliyken ortak kolonlar kullanılır." />

            <div class="dropdown">
                <button type="button" class="apya-filter-chip" id="chip-priority"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span data-chip-text>Öncelik: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu">
                    <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="">Tümü</button>
                    <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="1">Düşük</button>
                    <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="2">Orta</button>
                    <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="3">Yüksek</button>
                    <button type="button" class="apya-console-menu-item" data-filter="priority" data-value="4">Kritik</button>
                </div>
            </div>

            @* Tarih aralığı konsolda yok ama burada mevcut bir yetenek — kaldırmak
               gerileme olurdu, chip biçimine taşındı. *@
            <div class="dropdown">
                <button type="button" class="apya-filter-chip" id="chip-daterange"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <span data-chip-text>Son Tarih: tümü</span><i class="fa fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu p-3" style="min-width:240px;">
                    <label for="Filter_MinDueDate" class="form-label small fw-bold text-muted">@L["Tasks:Filter:MinDueDate"]</label>
                    <input type="date" id="Filter_MinDueDate" class="form-control form-control-sm mb-2">
                    <label for="Filter_MaxDueDate" class="form-label small fw-bold text-muted">@L["Tasks:Filter:MaxDueDate"]</label>
                    <input type="date" id="Filter_MaxDueDate" class="form-control form-control-sm mb-2">
                    <button type="button" id="btn-apply-daterange" class="btn btn-primary btn-sm w-100">@L["Common:Filter"]</button>
                </div>
            </div>

            <button type="button" class="apya-filter-chip" id="chip-overdue" aria-pressed="false">Gecikmiş</button>
            <button type="button" class="apya-filter-chip" id="chip-mine" aria-pressed="false">Bana atanan</button>
            <button type="button" class="apya-console-filter-clear d-none" id="btn-clear-filters">Filtreleri temizle</button>
        </div>
    </div>

    <div class="apya-console-views">

        @* --- LİSTE GÖRÜNÜMÜ --- *@
        <div id="view-list" class="view-panel" role="tabpanel" aria-labelledby="btn-view-list">
            <abp-table class="apya-clean-table" id="TasksTable"></abp-table>

            @* Yükleniyor — spinner değil, tablo hizasında iskelet satırlar. *@
            <div class="apya-console-skeleton d-none" id="state-loading" aria-hidden="true">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="apya-console-skeleton-row">
                        <span class="apya-skeleton" style="width:34%"></span>
                        <span class="apya-skeleton" style="width:14%"></span>
                        <span class="apya-skeleton" style="width:12%"></span>
                        <span class="apya-skeleton" style="width:10%"></span>
                        <span class="apya-skeleton" style="width:12%"></span>
                    </div>
                }
            </div>

            @* Boş hâller — DataTables'ın boş hücresine JS ile basılır. *@
            <template id="tpl-state-empty">
                <div class="apya-console-state">
                    <span class="apya-console-state-icon"><i class="fa fa-list-check" aria-hidden="true"></i></span>
                    <strong>Henüz görev yok</strong>
                    <p>İlk görevi ekleyerek başlayın.</p>
                    @if (canCreate)
                    {
                        <span class="apya-console-state-actions">
                            <button type="button" class="btn btn-primary btn-sm" data-state-action="create">
                                <i class="fa fa-plus me-1" aria-hidden="true"></i>@L["Tasks:NewButton"]
                            </button>
                        </span>
                    }
                </div>
            </template>
            <template id="tpl-state-nomatch">
                <div class="apya-console-state">
                    <span class="apya-console-state-icon"><i class="fa fa-filter" aria-hidden="true"></i></span>
                    <strong>Filtreye uyan görev yok</strong>
                    <span class="apya-console-state-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-state-action="clear">Filtreleri temizle</button>
                    </span>
                </div>
            </template>
        </div>

        @* --- KANBAN GÖRÜNÜMÜ --- *@
        <div id="view-kanban" class="view-panel d-none" role="tabpanel" aria-labelledby="btn-view-kanban">
            <partial name="_KanbanBoard" />
        </div>

        @* --- ZAMAN ÇİZELGESİ (GANTT) ---
             Paylaşılan bileşen (/js/apya-gantt.js) — proje konsoluyla AYNISI;
             frappe-gantt'ın yerini aldı. İçerik tamamen JS ile basılır. *@
        <div id="view-gantt" class="view-panel d-none" role="tabpanel" aria-labelledby="btn-view-gantt"></div>

    </div>
</div>

@* ─── Toplu işlem çubuğu ───
   Ata / Tarihi ötele YOK: ikisi de tam DTO ile UpdateAsync gerektiriyor,
   kısmi güncelleme uç noktası repoda yok (konsoldaki kararla aynı). *@
@if (canBulk)
{
    <div class="apya-console-bulkbar d-none" id="bulk-bar" role="region" aria-label="Toplu işlem">
        <span class="apya-console-bulkbar-count" id="bulk-count">0 görev seçili</span>
        <span class="apya-console-bulkbar-sep" aria-hidden="true"></span>

        @if (canChangeStatus)
        {
            <div class="dropdown dropup">
                <button type="button" class="apya-console-bulkbar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                    Durum değiştir <i class="fa fa-chevron-up ms-1" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu apya-console-menu">
                    <button type="button" class="apya-console-menu-item" data-bulk-status="1">@L["Tasks:Status:Todo"]</button>
                    <button type="button" class="apya-console-menu-item" data-bulk-status="2">Sürüyor</button>
                    <button type="button" class="apya-console-menu-item" data-bulk-status="3">Testte</button>
                    <button type="button" class="apya-console-menu-item" data-bulk-status="4">Tamamlandı</button>
                </div>
            </div>
        }
        @if (canDeleteTasks)
        {
            <button type="button" class="apya-console-bulkbar-btn is-danger" id="bulk-delete">Sil</button>
        }
        <button type="button" class="apya-console-bulkbar-close" id="bulk-clear" aria-label="Seçimi temizle">
            <i class="fa fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
}
</div> @* /.apya-page *@

@section styles {
    @* Merkezi kanban tasarımı (tek kaynak) *@
    <abp-style src="/css/kanban.css" />
    @* Görev modallarındaki etiket girişi (Select2 tags:true) — dark uyumu apya-shell.css'te zaten hazır. *@
    <link rel="stylesheet" href="~/libs/select2/css/select2.min.css" />
    @* Gantt tasarımı apya-shell.css'te (tek kaynak) — frappe-gantt ve ona ait
       .gantt .bar-* yamaları kaldırıldı, yerini /js/apya-gantt.js aldı. *@
}

@* Klavye kısayolları penceresi — proje konsoluyla ortak partial. *@
<partial name="_TaskShortcutsModal" model="new Apya.Platform.Web.Pages.Shared.TaskShortcutsModalModel { CanBulk = canBulk, CanChangeStatus = canChangeStatus }" />

<partial name="_TaskDetailIsland" />

@section scripts {
    <script src="~/libs/sortablejs/Sortable.min.js"></script>
    <script src="~/libs/select2/js/select2.min.js"></script>
    <abp-script src="/js/apya-task-render.js" />
    <abp-script src="/js/apya-task-console.js" />
    <abp-script src="/js/task-drawer.js" />
    <abp-script src="/js/apya-kanban.js" />
    <abp-script src="/js/apya-gantt.js" />
    <abp-script src="/Pages/Tasks/index.js" />
}

<style>
    /* Kanban kart/kolon tasarımı /css/kanban.css'ten gelir (tek kaynak).
       Burada yalnızca timer + deadline animasyonları kalır. */
    .timer-active { border-left-color: var(--apya-negative-500) !important; background-color: var(--apya-negative-50) !important; box-shadow: 0 0 10px rgba(220, 53, 69, 0.2) !important; }

    .fa-beat { animation: fa-beat 1.5s infinite linear; }
    @@keyframes fa-beat {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }
    @@keyframes heartbeat {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    .heartbeat-animation { animation: heartbeat 1.5s infinite; }

    /* Konsol tasarımı apya-shell.css §21'de (tek kaynak).
       DataTables'ın kendi arama kutusu gizlenir — arama şeritteki pile taşındı
       (#console-search → dataTable.search()). */
    .apya-task-console .dt-search { display: none; }
</style>
