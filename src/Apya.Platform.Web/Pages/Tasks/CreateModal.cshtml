@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Tasks.CreateModalModel
@{
    Layout = null;
}

<form asp-page="/Tasks/CreateModal" method="post">
    <abp-modal size="Large">
        <abp-modal-header title="@($"🚀 {L["Tasks:Create:Title"].Value}")"></abp-modal-header>

        <abp-modal-body class="p-4">
            <input type="hidden" asp-for="Task.ProjectId" />

            <div class="alert alert-light border shadow-sm mb-4 d-flex align-items-center rounded-3" role="alert">
                <i class="fa fa-info-circle text-primary fs-3 me-3"></i>
                <div class="text-muted" style="font-size: 0.95rem;">
                    @L["Tasks:Create:InfoText"]
                </div>
            </div>

            <h6 class="text-primary fw-bold mb-3"><i class="fa fa-align-left me-2"></i>@L["Tasks:Section:BasicInfo"]</h6>
            <div class="bg-light p-3 rounded-3 border mb-4">
                <abp-input asp-for="Task.Title" label="@L["Tasks:Field:Title"].Value" placeholder="@L["Tasks:Field:TitlePlaceholder"].Value" />

                <div class="mt-3">
                    <abp-input asp-for="Task.Description" type="textarea" label="@L["Tasks:Field:Description"].Value" rows="3" placeholder="@L["Tasks:Field:DescriptionPlaceholder"].Value" />
                </div>
            </div>

            <h6 class="text-primary fw-bold mb-3"><i class="fa fa-calendar-alt me-2"></i>@L["Tasks:Section:Schedule"]</h6>
            <div class="bg-light p-3 rounded-3 border mb-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <abp-input asp-for="Task.StartDate" label="@L["Tasks:Field:StartDate"].Value" type="date" />
                    </div>
                    <div class="col-md-6">
                        <abp-input asp-for="Task.DueDate" label="@L["Tasks:Field:DueDate"].Value" type="date" />
                    </div>
                </div>
            </div>

            <h6 class="text-primary fw-bold mb-3"><i class="fa fa-user-tag me-2"></i>@L["Tasks:Section:StatusPriority"]</h6>
            <div class="bg-light p-3 rounded-3 border">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark" asp-for="StatusOrColumn">@L["Tasks:Field:Status"]</label>
                        <select class="form-select shadow-sm" asp-for="StatusOrColumn" asp-items="@Model.StatusOrColumnList"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark" asp-for="Task.Priority">@L["Tasks:Field:Priority"]</label>
                        <select class="form-select shadow-sm" asp-for="Task.Priority">
                            <option value="1">🟢 @L["Tasks:Priority:Low"]</option>
                            <option value="2" selected>🟡 @L["Tasks:Priority:Medium"]</option>
                            <option value="3">🔴 @L["Tasks:Priority:High"]</option>
                            <option value="4">⚫ @L["Tasks:Priority:Critical"]</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark" asp-for="Task.AssigneeId">@L["Tasks:Field:Assignee"]</label>
                        <select class="form-select shadow-sm" asp-for="Task.AssigneeId" asp-items="@Model.UserList">
                            <option value="">👤 @L["Tasks:Field:Unassigned"]</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <label class="form-label fw-semibold text-dark" asp-for="Task.TagNames">Etiketler</label>
                        <select class="form-select" asp-for="Task.TagNames" multiple id="TaskTagsSelect">
                            @foreach (var tag in Model.AllTagNames)
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <div class="form-check form-switch d-inline-block text-start bg-light p-3 rounded border shadow-sm">
                    <input class="form-check-input ms-0 mt-1" style="transform: scale(1.3);" type="checkbox" asp-for="Task.IsPrivate">
                    <label class="form-check-label fw-bold text-danger ms-3" asp-for="Task.IsPrivate">
                        <i class="fa fa-user-secret me-1"></i> @L["Tasks:Field:Private"]
                    </label>
                    <small class="d-block text-muted ms-3 mt-1">@L["Tasks:Field:PrivateHint"]</small>
                </div>
            </div>

        </abp-modal-body>

        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

<script>
    $('#TaskTagsSelect').select2({
        tags: true,
        width: '100%',
        placeholder: 'Etiket ekle veya seç…',
        dropdownParent: $('#TaskTagsSelect').closest('.modal')
    });
</script>
