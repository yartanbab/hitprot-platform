@page
@using Apya.Platform.Web.Pages.Tasks
@using Apya.Platform.Web.Pages.Shared
@using Apya.Platform.Tasks
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditModalModel
@{
    Layout = null;
}

<form asp-page="/Tasks/EditModal" method="post" id="EditTaskForm_@Model.Id" data-check-form-on-close="false">
<abp-modal size="ExtraLarge">
    <abp-modal-header title="🚀 Görev Paneli: @Model.Task.Title"></abp-modal-header>

    <abp-modal-body class="p-0">
        
        @* ZAMAN TAKİBİ (Kronometre / Süreyi Başlat) banner'ı kullanıcı isteğiyle KALDIRILDI (2026-06-09).
           İlgili timer JS'i (refreshTimerState / BtnStartTimer / BtnStopTimer) DOM'da karşılığı olmadığı
           için artık inert (no-op). Gerekirse git geçmişinden geri getirilebilir. *@

        <div class="apya-pilltab-row px-4 pt-3" id="taskTabs_@Model.Id" data-drawer-scope="@Model.Id">
            <button type="button" class="apya-pilltab-btn active" data-pilltab-target="details_@Model.Id">
                <i class="fa fa-info-circle me-1"></i> Genel
            </button>
            <button type="button" class="apya-pilltab-btn" data-pilltab-target="subtasks_@Model.Id">
                <i class="fa fa-check-square me-1"></i> Alt Görevler
            </button>
            <button type="button" class="apya-pilltab-btn" data-pilltab-target="files_@Model.Id">
                <i class="fa fa-paperclip me-1"></i> Dosyalar
            </button>
            <button type="button" class="apya-pilltab-btn" data-pilltab-target="finance_@Model.Id">
                <i class="fa fa-coins me-1"></i> Finans
            </button>
            <button type="button" class="apya-pilltab-btn" data-pilltab-target="deps_@Model.Id">
                <i class="fa fa-link me-1"></i> Bağımlılıklar
            </button>
            <button type="button" class="apya-pilltab-btn" data-pilltab-target="timelog_@Model.Id" data-lazy="timelog">
                <i class="fa fa-history me-1"></i> Geçmiş
            </button>
            @if (Model.CanDelete)
            {
                <button type="button" class="btn btn-sm btn-outline-danger ms-auto js-delete-task-btn" title="Görevi Sil">
                    <i class="fa fa-trash me-1"></i> Sil
                </button>
            }
        </div>

        <div class="tab-content px-4 py-3 border-top" id="taskTabsContent_@Model.Id">
            <div class="tab-pane fade show active" id="details_@Model.Id" role="tabpanel">
                    <abp-input asp-for="Id" type="hidden" class="task-id-input" />
                    <abp-input asp-for="Task.ProjectId" type="hidden" />

                    <abp-input asp-for="Task.Title" label="Görev Başlığı" class="form-control-lg fw-bold" />

                    @{
                        var systemStatusValues = new[] { "s:1", "s:2", "s:3", "s:4" };
                        var overflowStatusItems = Model.StatusOrColumnList.Where(x => !systemStatusValues.Contains(x.Value)).ToList();
                    }
                    <div class="mt-3">
                        <label class="apya-overline d-block mb-1">Durum</label>
                        <select asp-for="StatusOrColumn" asp-items="Model.StatusOrColumnList" id="StatusOrColumn_@Model.Id" class="d-none"></select>
                        <div class="apya-status-pill-row" data-status-select="#StatusOrColumn_@Model.Id">
                            @foreach (var (label, sv) in new[] { ("Yapılacak", 1), ("Sürüyor", 2), ("Testte", 3), ("Tamamlandı", 4) })
                            {
                                var val = "s:" + sv;
                                var isActive = Model.StatusOrColumnList.FirstOrDefault(x => x.Value == val)?.Selected == true;
                                <button type="button" class="apya-status-pill@(isActive ? " active" : "")" data-value="@val">@label</button>
                            }
                            @if (overflowStatusItems.Any())
                            {
                                <select class="form-select form-select-sm d-inline-block w-auto apya-status-overflow" data-status-select="#StatusOrColumn_@Model.Id">
                                    <option value="">Diğer…</option>
                                    @foreach (var item in overflowStatusItems)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <div class="apya-meta-grid mt-3">
                        <div>
                            <label class="apya-overline d-block mb-1">Atanan</label>
                            <select asp-for="Task.AssigneeId" asp-items="Model.UserList" class="form-select"></select>
                        </div>
                        <div>
                            <label class="apya-overline d-block mb-1">Son Tarih</label>
                            <input asp-for="Task.DueDate" type="date" class="form-control" />
                        </div>
                        <div>
                            <label class="apya-overline d-block mb-1">Öncelik</label>
                            <select asp-for="Task.Priority" asp-items="Model.PriorityList" class="form-select"></select>
                        </div>
                        <div>
                            <label class="apya-overline d-block mb-1" asp-for="Task.TagNames">Etiketler</label>
                            <select class="form-select" asp-for="Task.TagNames" multiple id="TaskTagsSelectEdit">
                                @foreach (var tag in Model.AllTagNames)
                                {
                                    <option value="@tag" selected="@(Model.Task.TagNames.Contains(tag))">@tag</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <abp-input asp-for="Task.Description" text-area label="Açıklama" rows="4" placeholder="Bu görevin detayları nelerdir?" />
                    </div>

                    <div class="row g-2 mt-1 align-items-end">
                        <div class="col-7">
                            <abp-input asp-for="Task.StartDate" type="date" label="Başlangıç" />
                        </div>
                        <div class="col-5">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="Task.IsPrivate">
                                <label class="form-check-label fw-bold text-danger small" asp-for="Task.IsPrivate">
                                    <i class="fa fa-user-secret me-1"></i> Gizli
                                </label>
                            </div>
                        </div>
                    </div>
            </div>

            <div class="tab-pane fade" id="subtasks_@Model.Id" role="tabpanel">
                <h5 class="fw-bold mb-3">Yapılacaklar (Checklist)</h5>
                <div class="input-group mb-4 shadow-sm">
                    <input type="text" id="NewSubTaskTitle" class="form-control" placeholder="Yeni alt görev yaz...">
                    <button class="btn btn-success px-4" type="button" id="BtnAddSubTask"><i class="fa fa-plus me-1"></i> Ekle</button>
                </div>

                <div class="list-group list-group-flush border rounded-3" id="SubTaskList">
                    @if (Model.SubTasks != null && Model.SubTasks.Any())
                    {
                    @foreach (var sub in Model.SubTasks)
                        {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                        <div>
                            @if(sub.Status == Apya.Platform.Tasks.TaskStatus.Done) { <i class="fa fa-check-circle text-success me-2"></i> }
                                    else { <i class="fa fa-circle-o text-secondary me-2"></i> }

                            <strong class="@(sub.Status == Apya.Platform.Tasks.TaskStatus.Done ? "text-decoration-line-through text-muted" : "")">@sub.Title</strong>

                            <span class="apya-chip apya-chip-neutral ms-2">@sub.Status</span>
                            @if(!string.IsNullOrEmpty(sub.AssigneeName))
                                    {
                            <span class="apya-chip apya-chip-brand ms-1"><i class="fa fa-user"></i> @sub.AssigneeName</span>
                                    }
                        </div>
                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn btn-sm btn-light border edit-subtask-btn" data-id="@sub.Id" title="Düzenle"><i class="fa fa-edit text-primary"></i></button>
                            <button type="button" class="btn btn-sm btn-light border delete-subtask-btn" data-id="@sub.Id" title="Sil"><i class="fa fa-trash text-danger"></i></button>
                        </div>
                    </div>
                        }
                    }
                    else
                    {
                    <partial name="_EmptyState" model='new EmptyStateModel { Id = "NoSubTasksPlaceholder", Icon = "fa-list-ul", Title = "Henüz alt görev yok.", Description = "Yukarıdaki alandan ilk alt görevi ekleyin." }' />
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="files_@Model.Id" role="tabpanel">
                <div class="input-group mb-4 shadow-sm">
                    <input type="file" class="form-control" id="FileInput">
                    <button class="btn btn-outline-secondary px-4" type="button" id="BtnUploadFile"><i class="fa fa-upload me-1"></i> Yükle</button>
                </div>

                <ul class="list-group list-group-flush" id="FileList">
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                    @foreach (var file in Model.Attachments)
                        {
                    <li class="list-group-item apya-comment d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa fa-file-alt text-info fs-4 me-3"></i>
                            <a href="@file.DownloadUrl" target="_blank" class="text-decoration-none fw-bold fs-6">@file.FileName</a>
                            <small class="text-muted ms-3">(@(file.FileSize / 1024) KB) - @file.UploaderName</small>
                        </div>
                        <span class="text-muted small">@file.CreationTime.ToShortDateString()</span>
                    </li>
                        }
                    }
                    else
                    {
                    <partial name="_EmptyState" model='new EmptyStateModel { CssClass = "no-file-text", Icon = "fa-paperclip", Title = "Henüz dosya yüklenmemiş." }' />
                    }
                </ul>
            </div>

            @{
                var totalExpense = Model.TaskExpenses.Sum(x => x.Amount);
                var totalIncome  = Model.TaskIncomes.Sum(x => x.Amount);
                var netFinance   = totalIncome - totalExpense;
            }
            <div class="tab-pane fade" id="finance_@Model.Id" role="tabpanel">
                @* ── Bütçe bağı (6. adım) ────────────────────────────────────────
                   Blok YALNIZ projede kalem varsa ve kullanıcı bütçeyi görebiliyorsa
                   basılır. Basılmadığında aşağıdaki gizli işaretçi de gitmez; POST
                   tarafı bunu görüp mevcut bağı KORUR (alanlar boş POST edilip bağ
                   silinmesin). *@
                @if (Model.BudgetLines.Any())
                {
                    <input type="hidden" name="BudgetFormRendered" value="true" />
                    <div class="row g-2 align-items-end mb-4">
                        <div class="col-12 col-sm-7">
                            <label class="apya-overline d-block mb-1" asp-for="Task.BudgetLineId">Bütçe kalemi</label>
                            <select asp-for="Task.BudgetLineId" class="form-select" id="TaskBudgetLine_@Model.Id">
                                <option value="">— Bağlı değil —</option>
                                @foreach (var l in Model.BudgetLines)
                                {
                                    <option value="@l.Id" selected="@(Model.Task.BudgetLineId == l.Id)">
                                        @(string.IsNullOrWhiteSpace(l.Code) ? l.Name : l.Code + " · " + l.Name)
                                        (kalan @l.RemainingAmount.ToString("N2"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-sm-5">
                            <label class="apya-overline d-block mb-1" asp-for="Task.PlannedAmount">Görev bütçesi</label>
                            @* type="number" DEĞİL — bkz. Finance/ContextWizardModal.cshtml'deki not:
                               sayı alanı NOKTALI gönderir, tr-TR bağlaması "1234.56"yı 123456 yapardı. *@
                            <input asp-for="Task.PlannedAmount" type="text" inputmode="decimal" data-money-input="true"
                                   class="form-control apya-numeric" placeholder="—" />
                        </div>
                        <div class="col-12">
                            <div class="form-text">
                                Aynı kalemdeki görev bütçelerinin toplamı kalemi aşamaz; aşarsa kayıt reddedilir.
                            </div>
                        </div>
                    </div>
                }
                <div class="row text-center mb-4">
                    <div class="col-12 col-sm-4 mb-2 mb-sm-0">
                        <div class="card py-2 border-danger">
                            <div class="text-muted small">Toplam Gider</div>
                            <div class="fw-bold fs-5 apya-numeric text-danger">@totalExpense.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4 mb-2 mb-sm-0">
                        <div class="card py-2 border-success">
                            <div class="text-muted small">Toplam Gelir</div>
                            <div class="fw-bold fs-5 apya-numeric text-success">@totalIncome.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="card py-2">
                            <div class="text-muted small">Net</div>
                            <div class="fw-bold fs-5 apya-numeric @(netFinance >= 0 ? "text-success" : "text-danger")">@netFinance.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="fa fa-arrow-down text-danger me-1"></i> Giderler</h6>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="(new abp.ModalManager({ viewUrl: '/Expenses/CreateModal?TaskId=@Model.Id' })).open()">
                        <i class="fa fa-plus me-1"></i> Gider Ekle
                    </button>
                </div>
                @if (!Model.TaskExpenses.Any())
                {
                    <p class="text-muted small mb-3">Bu görev için gider kaydı yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-sm apya-clean-table mb-4">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Başlık</th>
                                <th>Kategori</th>
                                <th class="text-end apya-numeric">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.TaskExpenses)
                        {
                            <tr>
                                <td>@e.ExpenseDate.ToString("dd.MM.yyyy")</td>
                                <td>@e.Title</td>
                                <td>@e.Category</td>
                                <td class="text-end apya-numeric text-danger">@e.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="fa fa-arrow-up text-success me-1"></i> Gelirler</h6>
                    <button type="button" class="btn btn-sm btn-outline-success"
                            onclick="(new abp.ModalManager({ viewUrl: '/Incomes/CreateModal?TaskId=@Model.Id' })).open()">
                        <i class="fa fa-plus me-1"></i> Gelir Ekle
                    </button>
                </div>
                @if (!Model.TaskIncomes.Any())
                {
                    <p class="text-muted small">Bu görev için gelir kaydı yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-sm apya-clean-table">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Başlık</th>
                                <th>Kategori</th>
                                <th class="text-end apya-numeric">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in Model.TaskIncomes)
                        {
                            <tr>
                                <td>@i.IncomeDate.ToString("dd.MM.yyyy")</td>
                                <td>@i.Title</td>
                                <td>@i.Category</td>
                                <td class="text-end apya-numeric text-success">@i.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="deps_@Model.Id" role="tabpanel">
                <h6 class="fw-bold mb-1"><i class="fa fa-link me-1 text-primary"></i> Görev Bağımlılıkları (Önkoşullar)</h6>
                <p class="text-muted small mb-3">Bu görev başlamadan önce tamamlanması gereken görevleri seçin.</p>

                <div id="PredecessorInputs_@Model.Id">
                    @foreach (var predId in Model.Task.PredecessorIds)
                    {
                        <input type="hidden" name="Task.PredecessorIds" value="@predId" class="predecessor-input" data-pred-id="@predId" />
                    }
                </div>

                <div id="PredecessorBadges_@Model.Id" class="mb-3 d-flex flex-wrap gap-2">
                    @if (Model.Task.PredecessorIds.Any())
                    {
                        foreach (var predId in Model.Task.PredecessorIds)
                        {
                            var predTask = Model.ProjectTasks.FirstOrDefault(t => t.Id == predId);
                            var predTitle = predTask?.Title ?? predId.ToString()[..8] + "…";
                            <span class="apya-chip apya-chip-brand p-2 fs-6 pred-badge d-flex align-items-center gap-1" data-pred-id="@predId">
                                <i class="fa fa-arrow-right me-1"></i> @predTitle
                                <button type="button" class="btn-close btn-remove-pred ms-1"
                                        data-pred-id="@predId" style="font-size: 0.6em;" aria-label="Kaldır"></button>
                            </span>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0" id="NoPredecessorsMsg_@Model.Id">Henüz bağımlılık eklenmemiş.</p>
                    }
                </div>

                @if (Model.ProjectTasks.Any())
                {
                    <div class="input-group shadow-sm" style="max-width: 500px;">
                        <select class="form-select" id="PredecessorSelect_@Model.Id">
                            <option value="">-- Önkoşul görev seçin --</option>
                            @foreach (var t in Model.ProjectTasks)
                            {
                                <option value="@t.Id" data-title="@t.Title">@t.Title</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary px-4" type="button" id="BtnAddPredecessor_@Model.Id">
                            <i class="fa fa-plus me-1"></i> Ekle
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted small"><i class="fa fa-info-circle me-1"></i> Bu görevin projesinde başka görev bulunamadı.</p>
                }
            </div>

            <div class="tab-pane fade" id="timelog_@Model.Id" role="tabpanel">
                <h6 class="fw-bold mb-3"><i class="fa fa-history me-1 text-secondary"></i> Zaman Kayıtları</h6>
                <div id="TimeLogList_@Model.Id">
                    <div class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm me-2"></div> Yükleniyor...
                    </div>
                </div>
            </div>
        </div>

        @{
            var totalCommentCount = (Model.Comments?.Count ?? 0) + (Model.Comments?.Sum(c => c.Replies.Count) ?? 0);
        }
        @* Yorumlar — mockup'ta HER ZAMAN görünür/sabit, pill-tab'lara dahil değil. *@
        <div class="px-4 py-3 border-top" id="comments_@Model.Id">
            <h6 class="fw-bold mb-3"><i class="fa fa-comments me-1 text-warning"></i> Yorumlar <span class="text-muted fw-normal js-comment-count">@totalCommentCount</span></h6>
            <div class="list-group list-group-flush" id="CommentList">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                @foreach (var comment in Model.Comments)
                    {
                <div class="list-group-item apya-comment comment-item" data-comment-id="@comment.Id">
                    <div class="d-flex w-100 justify-content-between mb-2">
                        <h6 class="mb-1 fw-bold text-primary"><i class="fa fa-user-circle me-1"></i> @comment.AuthorName</h6>
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-muted"><i class="fa fa-clock me-1"></i> @comment.CreationTime.ToShortDateString() @comment.CreationTime.ToShortTimeString()</small>
                            @if (comment.IsOwn)
                            {
                                <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>
                            }
                        </div>
                    </div>
                    <p class="mb-1 comment-text">@comment.Text</p>
                    <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-reply-btn"><i class="fa fa-reply me-1"></i>Yanıtla</button>
                    <div class="comment-replies ms-4 mt-2 ps-2 border-start">
                        @foreach (var reply in comment.Replies)
                        {
                        <div class="list-group-item apya-comment apya-comment--reply comment-item reply-item" data-comment-id="@reply.Id">
                            <div class="d-flex w-100 justify-content-between mb-1">
                                <h6 class="mb-0 fw-bold text-secondary"><i class="fa fa-reply fa-flip-horizontal me-1"></i> @reply.AuthorName</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted">@reply.CreationTime.ToShortDateString() @reply.CreationTime.ToShortTimeString()</small>
                                    @if (reply.IsOwn)
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 comment-text">@reply.Text</p>
                        </div>
                        }
                    </div>
                </div>
                    }
                }
                else
                {
                <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-comments", Title = "Henüz yorum yapılmamış.", Description = "İlk yorumu siz yazın." }' />
                }
            </div>
        </div>
    </abp-modal-body>

    @* Yorum giriş kutusu — drawer'ın altına sabit (modal-content flex-column, flex:1 olmayan bu satır doğal olarak dibe yapışır). *@
    <div class="apya-drawer-commentbar">
        <div class="input-group shadow-sm">
            <input type="text" id="NewCommentText" class="form-control" placeholder="Bir yorum yaz...">
            <button class="btn btn-primary px-4" type="button" id="BtnAddComment"><i class="fa fa-paper-plane me-1"></i> Gönder</button>
        </div>
    </div>
</abp-modal>
    <!-- Footer kaldırıldı (Auto-save) -->
</form>

<script>
    // Görev detay drawer'ı — abp.ModalManager/<abp-modal> altyapısı aynen kalıyor,
    // yalnız .modal'a apya-drawer class'ı eklenip apya-shell.css §16 ile sağdan
    // kayan panele dönüştürülüyor (<abp-modal> class attribute'u geçirmediği için JS'le).
    $('#EditTaskForm_@Model.Id').find('.modal').addClass('apya-drawer');

    $('#TaskTagsSelectEdit').select2({
        tags: true,
        width: '100%',
        placeholder: 'Etiket ekle veya seç…',
        dropdownParent: $('#TaskTagsSelectEdit').closest('.modal')
    });

    $('#BtnAddSubTask').click(function () {
        var title = $('#NewSubTaskTitle').val();
        var parentId = $('.task-id-input').val();
        if (!title) return;

        $.ajax({
            type: 'POST',
            url: '/Tasks/EditModal?handler=AddSubTask',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            data: { parentId: parentId, subTaskTitle: title },
            success: function (result) {
                abp.notify.success('Alt görev eklendi!');
                $('#NoSubTasksPlaceholder').remove();

                // Sunucudan dönen gerçek Id ile satırı ANINDA çalışır şekilde çiz:
                // edit/delete-subtask-btn sınıfları + data-id → mevcut delegasyon
