@page
@using Apya.Platform.Web.Pages.Tasks
@using Apya.Platform.Tasks
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditModalModel
@{
    Layout = null;
}

<form asp-page="/Tasks/EditModal" method="post" id="EditTaskForm_@Model.Id" data-check-form-on-close="false">
<abp-modal size="ExtraLarge">
    <abp-modal-header title="🚀 Görev Paneli: @Model.Task.Title"></abp-modal-header>

    <abp-modal-body class="p-0 bg-light">
        
        @* ZAMAN TAKİBİ (Kronometre / Süreyi Başlat) banner'ı kullanıcı isteğiyle KALDIRILDI (2026-06-09).
           İlgili timer JS'i (refreshTimerState / BtnStartTimer / BtnStopTimer) DOM'da karşılığı olmadığı
           için artık inert (no-op). Gerekirse git geçmişinden geri getirilebilir. *@

        <ul class="nav nav-tabs nav-justified px-4 pt-3 border-bottom-0 shadow-sm bg-white" id="taskTabs_@Model.Id" role="tablist">
            <li class="nav-item">
                <a class="nav-link active fw-bold text-primary" id="details-tab_@Model.Id" data-bs-toggle="tab" href="#details_@Model.Id" role="tab">
                    <i class="fa fa-info-circle me-1"></i> Genel Bilgiler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="subtasks-tab_@Model.Id" data-bs-toggle="tab" href="#subtasks_@Model.Id" role="tab">
                    <i class="fa fa-check-square text-success me-1"></i> Alt Görevler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="comments-tab_@Model.Id" data-bs-toggle="tab" href="#comments_@Model.Id" role="tab">
                    <i class="fa fa-comments text-warning me-1"></i> Yorumlar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="files-tab_@Model.Id" data-bs-toggle="tab" href="#files_@Model.Id" role="tab">
                    <i class="fa fa-paperclip text-info me-1"></i> Dosyalar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="finance-tab_@Model.Id" data-bs-toggle="tab" href="#finance_@Model.Id" role="tab">
                    <i class="fa fa-coins text-warning me-1"></i> Finans
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="deps-tab_@Model.Id" data-bs-toggle="tab" href="#deps_@Model.Id" role="tab">
                    <i class="fa fa-link text-primary me-1"></i> Bağımlılıklar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="timelog-tab_@Model.Id" data-bs-toggle="tab" href="#timelog_@Model.Id" role="tab">
                    <i class="fa fa-history text-secondary me-1"></i> Zaman Geçmişi
                </a>
            </li>
        </ul>

        <div class="tab-content px-5 py-4 bg-white border-top" id="taskTabsContent_@Model.Id" style="min-height: 450px;">
            <div class="tab-pane fade show active" id="details_@Model.Id" role="tabpanel">
                    <abp-input asp-for="Id" type="hidden" class="task-id-input" />
                    <abp-input asp-for="Task.ProjectId" type="hidden" />

                    <div class="row">
                        <div class="col-md-8 border-end pe-4">
                            <abp-input asp-for="Task.Title" label="Görev Başlığı" class="form-control-lg fw-bold" />
                            <div class="mt-3">
                                <abp-input asp-for="Task.Description" type="textarea" label="Açıklama" rows="6" placeholder="Bu görevin detayları nelerdir?" />
                            </div>
                        </div>
                        <div class="col-md-4 ps-4">
                            <h6 class="text-muted fw-bold mb-3"><i class="fa fa-calendar-alt me-2"></i>Zaman Planı</h6>
                            <abp-input asp-for="Task.StartDate" type="date" label="Başlangıç" />
                            <abp-input asp-for="Task.DueDate" type="date" label="Bitiş (Deadline)" />

                            <h6 class="text-muted fw-bold mt-4 mb-3"><i class="fa fa-cog me-2"></i>Durum & Atama</h6>
                            <abp-select asp-for="Task.Priority" asp-items="Model.PriorityList" label="Öncelik" />
                            <abp-select asp-for="Task.Status" asp-items="Model.StatusList" label="Durum" />
                            <abp-select asp-for="Task.AssigneeId" asp-items="Model.UserList" label="Sorumlu Kişi" />

                            <div class="form-check form-switch mt-4 bg-light p-2 rounded border shadow-sm">
                                <input class="form-check-input ms-1 mt-2" style="transform: scale(1.2);" type="checkbox" asp-for="Task.IsPrivate">
                                <label class="form-check-label fw-bold text-danger ms-2 mt-1" asp-for="Task.IsPrivate">
                                    <i class="fa fa-user-secret me-1"></i> Gizli Görev
                                </label>
                                <small class="d-block text-muted ms-2 mt-1 px-1" style="font-size: 0.8rem; line-height: 1.2;">Sadece siz ve sorumlu kişi görebilir. Admin dahil başkası profilinize girdiğinde göremez.</small>
                            </div>
                        </div>
                    </div>
            </div>

            <div class="tab-pane fade" id="subtasks_@Model.Id" role="tabpanel">
                <h5 class="fw-bold mb-3">Yapılacaklar (Checklist)</h5>
                <div class="input-group mb-4 shadow-sm">
                    <input type="text" id="NewSubTaskTitle" class="form-control form-control-lg" placeholder="Yeni alt görev yaz...">
                    <button class="btn btn-success px-4" type="button" id="BtnAddSubTask"><i class="fa fa-plus me-1"></i> Ekle</button>
                </div>

                <div class="list-group list-group-flush border rounded-3" id="SubTaskList">
                    @if (Model.SubTasks != null && Model.SubTasks.Any())
                    {
                    @foreach (var sub in Model.SubTasks)
                        {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                        <div>
                            @if(sub.Status == Apya.Platform.Tasks.TaskStatus.Done) { <i class="fa fa-check-circle text-success fs-5 me-2"></i> }
                                    else { <i class="fa fa-circle-o text-secondary fs-5 me-2"></i> }

                            <strong class="fs-5 @(sub.Status == Apya.Platform.Tasks.TaskStatus.Done ? "text-decoration-line-through text-muted" : "")">@sub.Title</strong>

                            <span class="badge bg-secondary ms-2">@sub.Status</span>
                            @if(!string.IsNullOrEmpty(sub.AssigneeName))
                                    {
                            <span class="badge bg-info text-dark ms-1"><i class="fa fa-user"></i> @sub.AssigneeName</span>
                                    }
                        </div>
                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn btn-sm btn-light border edit-subtask-btn" data-id="@sub.Id" title="Düzenle"><i class="fa fa-edit text-primary"></i></button>
                            <button type="button" class="btn btn-sm btn-light border delete-subtask-btn" data-id="@sub.Id" title="Sil"><i class="fa fa-trash text-danger"></i></button>
                        </div>
                    </div>
                        }
                    }
                    else
                    {
                    <div class="text-center text-muted p-5 bg-light rounded-3" id="NoSubTasksPlaceholder">
                        <i class="fa fa-list-ul fa-3x mb-3 text-secondary"></i>
                        <p class="fs-5">Henüz alt görev yok.</p>
                    </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="comments_@Model.Id" role="tabpanel">
                <div class="input-group mb-4 shadow-sm">
                    <input type="text" id="NewCommentText" class="form-control form-control-lg" placeholder="Bir yorum yaz...">
                    <button class="btn btn-primary px-4" type="button" id="BtnAddComment"><i class="fa fa-paper-plane me-1"></i> Gönder</button>
                </div>
                <div class="list-group list-group-flush" id="CommentList">
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                    @foreach (var comment in Model.Comments)
                        {
                    <div class="list-group-item bg-light border-0 mb-2 rounded-3 comment-item" data-comment-id="@comment.Id">
                        <div class="d-flex w-100 justify-content-between mb-2">
                            <h6 class="mb-1 fw-bold text-primary"><i class="fa fa-user-circle me-1"></i> @comment.AuthorName</h6>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted"><i class="fa fa-clock me-1"></i> @comment.CreationTime.ToShortDateString() @comment.CreationTime.ToShortTimeString()</small>
                                @if (comment.IsOwn)
                                {
                                    <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>
                                }
                            </div>
                        </div>
                        <p class="mb-1 text-dark comment-text">@comment.Text</p>
                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-reply-btn"><i class="fa fa-reply me-1"></i>Yanıtla</button>
                        <div class="comment-replies ms-4 mt-2 ps-2 border-start">
                            @foreach (var reply in comment.Replies)
                            {
                            <div class="list-group-item bg-white border-0 mb-1 rounded-3 comment-item reply-item py-2" data-comment-id="@reply.Id">
                                <div class="d-flex w-100 justify-content-between mb-1">
                                    <h6 class="mb-0 fw-bold text-secondary" style="font-size:0.85rem;"><i class="fa fa-reply fa-flip-horizontal me-1"></i> @reply.AuthorName</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted" style="font-size:0.7rem;">@reply.CreationTime.ToShortDateString() @reply.CreationTime.ToShortTimeString()</small>
                                        @if (reply.IsOwn)
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>
                                        }
                                    </div>
                                </div>
                                <p class="mb-0 text-dark comment-text" style="font-size:0.9rem;">@reply.Text</p>
                            </div>
                            }
                        </div>
                    </div>
                        }
                    }
                    else
                    {
                    <div class="text-center text-muted p-5">Henüz yorum yapılmamış.</div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="files_@Model.Id" role="tabpanel">
                <div class="input-group mb-4 shadow-sm">
                    <input type="file" class="form-control form-control-lg" id="FileInput">
                    <button class="btn btn-outline-secondary px-4" type="button" id="BtnUploadFile"><i class="fa fa-upload me-1"></i> Yükle</button>
                </div>

                <ul class="list-group list-group-flush" id="FileList">
                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                    @foreach (var file in Model.Attachments)
                        {
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light border-0 mb-2 rounded-3">
                        <div>
                            <i class="fa fa-file-alt text-info fs-4 me-3"></i>
                            <a href="@file.DownloadUrl" target="_blank" class="text-decoration-none fw-bold fs-6">@file.FileName</a>
                            <small class="text-muted ms-3">(@(file.FileSize / 1024) KB) - @file.UploaderName</small>
                        </div>
                        <span class="text-muted small">@file.CreationTime.ToShortDateString()</span>
                    </li>
                        }
                    }
                    else
                    {
                    <div class="text-center text-muted p-5 no-file-text">Henüz dosya yüklenmemiş.</div>
                    }
                </ul>
            </div>

            @{
                var totalExpense = Model.TaskExpenses.Sum(x => x.Amount);
                var totalIncome  = Model.TaskIncomes.Sum(x => x.Amount);
                var netFinance   = totalIncome - totalExpense;
            }
            <div class="tab-pane fade" id="finance_@Model.Id" role="tabpanel">
                <div class="row text-center mb-4">
                    <div class="col-4">
                        <div class="card py-2 border-danger">
                            <div class="text-muted small">Toplam Gider</div>
                            <div class="fw-bold fs-5 text-danger">@totalExpense.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card py-2 border-success">
                            <div class="text-muted small">Toplam Gelir</div>
                            <div class="fw-bold fs-5 text-success">@totalIncome.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card py-2">
                            <div class="text-muted small">Net</div>
                            <div class="fw-bold fs-5 @(netFinance >= 0 ? "text-success" : "text-danger")">@netFinance.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="fa fa-arrow-down text-danger me-1"></i> Giderler</h6>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="(new abp.ModalManager({ viewUrl: '/Expenses/CreateModal?TaskId=@Model.Id' })).open()">
                        <i class="fa fa-plus me-1"></i> Gider Ekle
                    </button>
                </div>
                @if (!Model.TaskExpenses.Any())
                {
                    <p class="text-muted small mb-3">Bu görev için gider kaydı yok.</p>
                }
                else
                {
                    <table class="table table-sm table-striped table-bordered mb-4">
                        <thead class="table-light">
                            <tr>
                                <th style="width:100px;">Tarih</th>
                                <th>Başlık</th>
                                <th style="width:90px;">Kategori</th>
                                <th class="text-end" style="width:100px;">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.TaskExpenses)
                        {
                            <tr>
                                <td>@e.ExpenseDate.ToString("dd.MM.yyyy")</td>
                                <td>@e.Title</td>
                                <td>@e.Category</td>
                                <td class="text-end text-danger">@e.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="fa fa-arrow-up text-success me-1"></i> Gelirler</h6>
                    <button type="button" class="btn btn-sm btn-outline-success"
                            onclick="(new abp.ModalManager({ viewUrl: '/Incomes/CreateModal?TaskId=@Model.Id' })).open()">
                        <i class="fa fa-plus me-1"></i> Gelir Ekle
                    </button>
                </div>
                @if (!Model.TaskIncomes.Any())
                {
                    <p class="text-muted small">Bu görev için gelir kaydı yok.</p>
                }
                else
                {
                    <table class="table table-sm table-striped table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width:100px;">Tarih</th>
                                <th>Başlık</th>
                                <th style="width:90px;">Kategori</th>
                                <th class="text-end" style="width:100px;">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in Model.TaskIncomes)
                        {
                            <tr>
                                <td>@i.IncomeDate.ToString("dd.MM.yyyy")</td>
                                <td>@i.Title</td>
                                <td>@i.Category</td>
                                <td class="text-end text-success">@i.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <div class="tab-pane fade" id="deps_@Model.Id" role="tabpanel">
                <h6 class="fw-bold mb-1"><i class="fa fa-link me-1 text-primary"></i> Görev Bağımlılıkları (Önkoşullar)</h6>
                <p class="text-muted small mb-3">Bu görev başlamadan önce tamamlanması gereken görevleri seçin.</p>

                <div id="PredecessorInputs_@Model.Id">
                    @foreach (var predId in Model.Task.PredecessorIds)
                    {
                        <input type="hidden" name="Task.PredecessorIds" value="@predId" class="predecessor-input" data-pred-id="@predId" />
                    }
                </div>

                <div id="PredecessorBadges_@Model.Id" class="mb-3 d-flex flex-wrap gap-2">
                    @if (Model.Task.PredecessorIds.Any())
                    {
                        foreach (var predId in Model.Task.PredecessorIds)
                        {
                            var predTask = Model.ProjectTasks.FirstOrDefault(t => t.Id == predId);
                            var predTitle = predTask?.Title ?? predId.ToString()[..8] + "…";
                            <span class="badge bg-primary p-2 fs-6 pred-badge d-flex align-items-center gap-1" data-pred-id="@predId">
                                <i class="fa fa-arrow-right me-1"></i> @predTitle
                                <button type="button" class="btn-close btn-close-white btn-remove-pred ms-1"
                                        data-pred-id="@predId" style="font-size: 0.6em;" aria-label="Kaldır"></button>
                            </span>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0" id="NoPredecessorsMsg_@Model.Id">Henüz bağımlılık eklenmemiş.</p>
                    }
                </div>

                @if (Model.ProjectTasks.Any())
                {
                    <div class="input-group shadow-sm" style="max-width: 500px;">
                        <select class="form-select" id="PredecessorSelect_@Model.Id">
                            <option value="">-- Önkoşul görev seçin --</option>
                            @foreach (var t in Model.ProjectTasks)
                            {
                                <option value="@t.Id" data-title="@t.Title">@t.Title</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary px-4" type="button" id="BtnAddPredecessor_@Model.Id">
                            <i class="fa fa-plus me-1"></i> Ekle
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted small"><i class="fa fa-info-circle me-1"></i> Bu görevin projesinde başka görev bulunamadı.</p>
                }
            </div>

            <div class="tab-pane fade" id="timelog_@Model.Id" role="tabpanel">
                <h6 class="fw-bold mb-3"><i class="fa fa-history me-1 text-secondary"></i> Zaman Kayıtları</h6>
                <div id="TimeLogList_@Model.Id">
                    <div class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm me-2"></div> Yükleniyor...
                    </div>
                </div>
            </div>
        </div>
    </abp-modal-body>
</abp-modal>
    <!-- Footer kaldırıldı (Auto-save) -->
</form>

<script>
    $('#BtnAddSubTask').click(function () {
        var title = $('#NewSubTaskTitle').val();
        var parentId = $('.task-id-input').val();
        if (!title) return;

        $.ajax({
            type: 'POST',
            url: '/Tasks/EditModal?handler=AddSubTask',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            data: { parentId: parentId, subTaskTitle: title },
            success: function (result) {
                abp.notify.success('Alt görev eklendi!');
                $('#NoSubTasksPlaceholder').remove();

                // Sunucudan dönen gerçek Id ile satırı ANINDA çalışır şekilde çiz:
                // edit/delete-subtask-btn sınıfları + data-id → mevcut delegasyon
                // handler'ları (aşağıda) yeni satırda da çalışır. (disabled YOK.)
                var newId = result && result.id ? result.id : '';
                var $row = $(
                    '<div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 bg-light border-warning">' +
                        '<div>' +
                            '<i class="fa fa-circle-o text-secondary fs-5 me-2"></i>' +
                            '<strong class="fs-5 js-subtask-title"></strong>' +
                            '<span class="badge bg-warning ms-2 text-dark">Yeni</span>' +
                        '</div>' +
                        '<div class="btn-group shadow-sm" role="group">' +
                            '<button type="button" class="btn btn-sm btn-light border edit-subtask-btn" data-id="' + newId + '" title="Düzenle"><i class="fa fa-edit text-primary"></i></button>' +
                            '<button type="button" class="btn btn-sm btn-light border delete-subtask-btn" data-id="' + newId + '" title="Sil"><i class="fa fa-trash text-danger"></i></button>' +
                        '</div>' +
                    '</div>'
                );
                // Başlığı text() ile yaz (HTML enjeksiyonunu önler).
                $row.find('.js-subtask-title').text(title);
                $('#SubTaskList').prepend($row);
                $('#NewSubTaskTitle').val('');
            },
            error: function (xhr) {
                abp.notify.error('Alt görev eklenemedi!');
                console.error("Alt görev ekleme hatası", xhr);
            }
        });
    });

    $(document).off('click', '.edit-subtask-btn').on('click', '.edit-subtask-btn', function () {
        var subTaskId = $(this).data('id');
        var subTaskModal = new abp.ModalManager({ viewUrl: abp.appPath + 'Tasks/EditModal' });
        subTaskModal.open({ id: subTaskId });
    });

    $(document).off('click', '.delete-subtask-btn').on('click', '.delete-subtask-btn', function () {
        var subTaskId = $(this).data('id');
        var $li = $(this).closest('.list-group-item');
        
        Swal.fire({
            title: 'Alt Görev Silinecek!',
            text: 'Bu alt görevi kalıcı olarak silmek üzeresiniz. Onaylamak için aşağıdaki alana "SİL" yazmalısınız.',
            icon: 'warning',
            input: 'text',
            inputPlaceholder: 'SİL',
            showCancelButton: true,
            confirmButtonText: '<i class="fa fa-trash"></i> Evet, Sil!',
            cancelButtonText: 'İptal',
            confirmButtonColor: '#dc3545',
            preConfirm: function (inputValue) {
                if (inputValue !== 'SİL') {
                    Swal.showValidationMessage('Silme işlemini onaylamak için tam olarak "SİL" yazmalısınız.');
                }
                return inputValue;
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                apya.platform.tasks.task.delete(subTaskId).then(function () {
                    abp.notify.info('Başarıyla silindi.');
                    $li.remove();
                });
            }
        });
    });

    $('#BtnAddComment').click(function () {
        var text = $('#NewCommentText').val();
        var taskId = $('.task-id-input').val();
        if (!text) return;
        
        $.ajax({
            type: 'POST',
            url: '/Tasks/EditModal?handler=AddComment',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            data: { taskId: taskId, commentText: text },
            success: function (result) {
                abp.notify.success('Yorum gönderildi!');
                var now = new Date().toLocaleString();
                var newId = result && result.id ? result.id : '';
                // Yeni yorum her zaman "own" → düzenle/sil butonlu, gerçek data-comment-id ile.
                var $item = $('<div class="list-group-item bg-light border-success mb-2 rounded-3 comment-item" data-comment-id="' + newId + '">' +
                    '<div class="d-flex w-100 justify-content-between mb-2">' +
                        '<h6 class="mb-1 fw-bold text-success"><i class="fa fa-user-circle me-1"></i> Siz (Az önce)</h6>' +
                        '<div class="d-flex align-items-center gap-2">' +
                            '<small class="text-muted">' + now + '</small>' +
                            '<button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>' +
                        '</div>' +
                    '</div>' +
                    '<p class="mb-1 text-dark comment-text"></p>' +
                    '<button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-reply-btn"><i class="fa fa-reply me-1"></i>Yanıtla</button>' +
                    '<div class="comment-replies ms-4 mt-2 ps-2 border-start"></div>' +
                '</div>');
                $item.find('.comment-text').text(text); // HTML enjeksiyonunu önle
                $('#CommentList').prepend($item);
                $('#NewCommentText').val('');
            },
            error: function (xhr) {
                abp.notify.error('Yorum gönderilemedi!');
                console.error("Yorum gönderme hatası", xhr);
            }
        });
    });

    // --- YORUM DÜZENLE (inline) — yalnızca kendi yorumu (butonlar IsOwn ile render edilir) ---
    $(document).off('click', '.comment-edit-btn').on('click', '.comment-edit-btn', function () {
        var $item = $(this).closest('.comment-item');
        if ($item.children('.comment-edit-box').length) return; // zaten düzenleniyor
        var $textEl = $item.children('.comment-text'); // doğrudan çocuk (iç içe yanıt metnini yakalamasın)
        var $box = $('<div class="comment-edit-box mt-1"></div>');
        var $input = $('<input type="text" class="form-control form-control-sm mb-1">').val($textEl.text().trim());
        var $save = $('<button type="button" class="btn btn-sm btn-success me-1"><i class="fa fa-check"></i></button>');
        var $cancel = $('<button type="button" class="btn btn-sm btn-secondary"><i class="fa fa-times"></i></button>');
        $box.append($input).append($save).append($cancel);
        $textEl.hide().after($box);
        $input.trigger('focus');

        $cancel.on('click', function () { $box.remove(); $textEl.show(); });
        $save.on('click', function () {
            var newText = $input.val();
            if (!newText || !newText.trim()) return;
            var id = $item.data('comment-id');
            $save.prop('disabled', true);
            apya.platform.tasks.task.updateComment(id, newText.trim()).then(function () {
                $textEl.text(newText.trim());
                $box.remove();
                $textEl.show();
                abp.notify.success('Yorum güncellendi.');
            }).catch(function () { $save.prop('disabled', false); });
        });
    });

    // --- YORUM SİL — yalnızca kendi yorumu ---
    $(document).off('click', '.comment-delete-btn').on('click', '.comment-delete-btn', function () {
        var $item = $(this).closest('.comment-item');
        var id = $item.data('comment-id');
        abp.message.confirm('Bu yorumu silmek istediğinize emin misiniz?', 'Yorumu Sil', function (confirmed) {
            if (!confirmed) return;
            apya.platform.tasks.task.deleteComment(id).then(function () {
                $item.remove();
                abp.notify.info('Yorum silindi.');
            });
        });
    });

    // --- YORUMA YANIT (Instagram tarzı, tek seviye) ---
    function buildReplyRow(id, author, text) {
        var $r = $('<div class="list-group-item bg-white border-0 mb-1 rounded-3 comment-item reply-item py-2" data-comment-id="' + id + '">' +
            '<div class="d-flex w-100 justify-content-between mb-1">' +
                '<h6 class="mb-0 fw-bold text-secondary js-reply-author" style="font-size:0.85rem;"><i class="fa fa-reply fa-flip-horizontal me-1"></i> </h6>' +
                '<div class="d-flex align-items-center gap-2">' +
                    '<small class="text-muted" style="font-size:0.7rem;">' + new Date().toLocaleString() + '</small>' +
                    '<button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>' +
                    '<button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>' +
                '</div>' +
            '</div>' +
            '<p class="mb-0 text-dark comment-text" style="font-size:0.9rem;"></p>' +
        '</div>');
        $r.find('.js-reply-author').append(document.createTextNode(author || 'Siz'));
        $r.children('.comment-text').text(text); // HTML enjeksiyonunu önle
        return $r;
    }

    $(document).off('click', '.comment-reply-btn').on('click', '.comment-reply-btn', function () {
        var $comment = $(this).closest('.comment-item');
        var $replies = $comment.children('.comment-replies');
        if ($comment.children('.reply-input-box').length) { $comment.children('.reply-input-box').find('input').trigger('focus'); return; }

        var $box = $('<div class="reply-input-box input-group input-group-sm mt-2 mb-1"></div>');
        var $input = $('<input type="text" class="form-control form-control-sm" placeholder="Yanıt yaz...">');
        var $send = $('<button type="button" class="btn btn-primary"><i class="fa fa-paper-plane"></i></button>');
        $box.append($input).append($send);
        $replies.before($box);
        $input.trigger('focus');

        function submitReply() {
            var text = $input.val();
            if (!text || !text.trim()) return;
            var parentId = $comment.data('comment-id');
            $send.prop('disabled', true);
            $.ajax({
                type: 'POST',
                url: '/Tasks/EditModal?handler=ReplyComment',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: { parentCommentId: parentId, commentText: text },
                success: function (result) {
                    var id = result && result.id ? result.id : '';
                    var author = result && result.author ? result.author : 'Siz';
                    $replies.append(buildReplyRow(id, author, text));
                    $box.remove();
                    abp.notify.success('Yanıt eklendi!');
                },
                error: function () { $send.prop('disabled', false); abp.notify.error('Yanıt eklenemedi!'); }
            });
        }
        $send.on('click', submitReply);
        $input.on('keypress', function (e) { if (e.which === 13) { e.preventDefault(); submitReply(); } });
    });

    $('#BtnUploadFile').click(function () {
        var fileInput = document.getElementById('FileInput');
        var file = fileInput.files[0];
        var taskId = $('.task-id-input').val();
        if (!file) { abp.notify.warn('Lütfen bir dosya seçin.'); return; }

        var formData = new FormData();
        formData.append('file', file);

        $.ajax({
            url: '/api/tasks/attachments/upload/' + taskId,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (result) {
                if (result.success) {
                    abp.notify.success('Dosya yüklendi!');
                    $('.no-file-text').remove();
                    $('#FileList').prepend('<li class="list-group-item d-flex justify-content-between align-items-center bg-light border-info mb-2 rounded-3"><div><i class="fa fa-file-alt text-info fs-4 me-3"></i><a href="/file/get/' + result.storedFileName + '" target="_blank" class="text-decoration-none fw-bold fs-6">' + file.name + '</a><small class="text-muted ms-3">Şimdi yüklendi</small></div><span class="badge bg-success">Yeni</span></li>');
                    fileInput.value = '';
                } else {
                    abp.notify.error('Dosya yüklenirken hata oluştu: ' + result.error);
                }
            },
            error: function (xhr) { 
                var msg = 'Dosya yüklenirken hata oluştu.';
                if (xhr.responseJSON && xhr.responseJSON.error) {
                    msg = xhr.responseJSON.error;
                }
                abp.notify.error(msg);
            }
        });
    });

    // --- ZAMAN TAKİBİ (TIME TRACKING) JS ---
    var timerInterval = null;
    var startTime = null;

    function refreshTimerState() {
        var taskId = $('.task-id-input').val();
        if(!taskId || taskId === '00000000-0000-0000-0000-000000000000') return;

        apya.platform.tasks.task.getActiveTimeLog().then(function(log) {
            if (log && log.taskId === taskId) {
                // Bu görev için sayaç çalışıyor
                startTime = new Date(log.startTime);
                $('#BtnStartTimer').hide();
                $('#BtnStopTimer').show();
                if (!timerInterval) {
                    timerInterval = setInterval(updateTimerDisplay, 1000);
                    updateTimerDisplay(); // ilk saniyeyi bekleme
                }
            } else if (log && log.taskId !== taskId) {
                // Başka görev için sayaç var, bunu kitleyelim
                $('#BtnStartTimer').prop('disabled', true).html('<i class="fa fa-lock me-1"></i> Başka Görevde Çalışıyor');
                $('#BtnStopTimer').hide();
            } else {
                // Sayaç çalışmıyor
                $('#BtnStartTimer').show().prop('disabled', false).html('<i class="fa fa-play me-1"></i> Süreyi Başlat');
                $('#BtnStopTimer').hide();
                if(timerInterval) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }
            }
        });
    }

    function updateTimerDisplay() {
        if (!startTime) return;
        var now = new Date();
        var diff = Math.floor((now - startTime) / 1000); // saniye
        var h = Math.floor(diff / 3600).toString().padStart(2, '0');
        var m = Math.floor((diff % 3600) / 60).toString().padStart(2, '0');
        var s = (diff % 60).toString().padStart(2, '0');
        $('#TimerElapsed').text(h + ":" + m + ":" + s);
    }

    $('#BtnStartTimer').click(function() {
        var taskId = $('.task-id-input').val();
        // UI olarak hemen feedback ver (optimistik)
        var originalBtnHtml = $(this).html();
        $(this).html('<i class="fa fa-spinner fa-spin me-1"></i> Başlatılıyor...').prop('disabled', true);

        apya.platform.tasks.task.startTimeTracking(taskId).then(function() {
            abp.notify.success('Zaman takibi başlatıldı!');
            refreshTimerState();
        }).catch(function(err) {
            $('#BtnStartTimer').html(originalBtnHtml).prop('disabled', false); // rollback
            abp.message.error(err.message || 'Zaman kaydı başlatılamadı, başka bir aktif sayaç olabilir.', 'Hata');
        });
    });

    $('#BtnStopTimer').click(function() {
        var taskId = $('.task-id-input').val();
        var originalBtnHtml = $(this).html();
        $(this).html('<i class="fa fa-spinner fa-spin me-1"></i> Kaydediliyor...').prop('disabled', true);

        apya.platform.tasks.task.stopTimeTracking(taskId).then(function() {
            abp.notify.success('Kronometre durduruldu ve sisteme kaydedildi!');
            refreshTimerState();
        }).catch(function() {
             $(this).html(originalBtnHtml).prop('disabled', false); // rollback
        });
    });

    // INIT — Zaman takibi banner'ı kaldırıldığı için refreshTimerState otomatik çağrısı devre dışı
    // (gereksiz getActiveTimeLog isteği + dangling interval olmasın). Banner geri gelirse aç:
    // setTimeout(refreshTimerState, 300);

    // === OTOMATİK KAYIT (AUTO-SAVE) MANTIĞI ===
    if (typeof window.taskAutoSaveTimeouts === 'undefined') {
        window.taskAutoSaveTimeouts = {};
    }
    
    $('#EditTaskForm_@Model.Id').on('input change', 'input:not(#NewSubTaskTitle, #NewCommentText, #FileInput), select, textarea', function() {
        if ($(this).hasClass('task-id-input')) return;
        
        var modalId = '@Model.Id';
        clearTimeout(window.taskAutoSaveTimeouts[modalId]);
        
        // Formda değişiklik olunca 1 sn sonra POST atar.
        window.taskAutoSaveTimeouts[modalId] = setTimeout(function() {
            var $form = $('#EditTaskForm_' + modalId);
            
            // Eğer form client-side validasyona takılıyorsa (zorunlu alanlar boşsa) POST atma.
            // Bu, "Description field is required" gibi sunucu hatalarını önler.
            if ($form.length && typeof $form.valid === 'function' && !$form.valid()) {
                console.log('Form henüz geçerli değil, kayıt ertelendi.');
                return;
            }

            var formData = $form.serialize();
            
            var $modal = $form.closest('.modal-content');
            var $titleContainer = $modal.find('.modal-title');
            
            var $status = $('#AutoSaveStatus_' + modalId.replace(/-/g, ''));
            if (!$status.length) {
                $titleContainer.append(' <small class="text-muted ms-2" id="AutoSaveStatus_' + modalId.replace(/-/g, '') + '" style="font-size: 0.75rem;"></small>');
                $status = $('#AutoSaveStatus_' + modalId.replace(/-/g, ''));
            }
            
            $status.html('<i class="fa fa-sync-alt fa-spin me-1"></i> Kaydediliyor...').show();

            $.ajax({
                type: 'POST',
                url: '/Tasks/EditModal?Id=' + modalId,
                data: formData,
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function () {
                    $status.html('<i class="fa fa-check-circle text-success me-1"></i> Kaydedildi').show();
                    setTimeout(function() { $status.fadeOut(500); }, 3000);
                    abp.event.trigger('app.task.updated');
                },
                error: function (xhr) {
                    $status.html('<i class="fa fa-exclamation-triangle text-danger me-1"></i> Kayıt Başarısız').show();
                    var errMsg = "Kayıt işlemi sırasında sunucu hatası oluştu.";
                    if (xhr.responseText) {
                        try {
                            // ABP bazen JSON döndürüyor olabilir
                            var errObj = JSON.parse(xhr.responseText);
                            errMsg = errObj.error ? errObj.error.message : xhr.responseText;
                        } catch (e) {
                            errMsg = xhr.responseText;
                        }
                    }
                    abp.notify.error(errMsg);
                }
            });
        }, 1000);
    });

    // --- ZAMAN GEÇMİŞİ SEKMESİ ---
    var timeLogLoaded_@(Model.Id.ToString().Replace("-","")) = false;
    $('a[href="#timelog_@Model.Id"]').on('shown.bs.tab', function () {
        if (timeLogLoaded_@(Model.Id.ToString().Replace("-",""))) return;
        timeLogLoaded_@(Model.Id.ToString().Replace("-","")) = true;
        var taskId = $('.task-id-input').val();
        apya.platform.tasks.task.getTimeLogs(taskId).then(function (logs) {
            var $container = $('#TimeLogList_@Model.Id');
            if (!logs || logs.length === 0) {
                $container.html('<p class="text-muted text-center py-4">Henüz zaman kaydı yok.</p>');
                return;
            }
            var totalSec = logs.reduce(function (s, l) { return s + (l.secondsSpent || 0); }, 0);
            var fmtSec = function (s) {
                var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
                return h + 's ' + m + 'dk ' + sec + 'sn';
            };
            var rows = logs.map(function (l) {
                var dur = l.secondsSpent ? fmtSec(l.secondsSpent) : '—';
                var start = luxon.DateTime.fromISO(l.startTime).toFormat('dd.MM.yyyy HH:mm');
                var end   = l.endTime ? luxon.DateTime.fromISO(l.endTime).toFormat('HH:mm') : '<span class="badge bg-success">Aktif</span>';
                return '<tr><td>' + start + '</td><td>' + end + '</td><td>' + dur + '</td><td>' + (l.userName || '—') + '</td><td class="text-muted small">' + (l.note || '') + '</td></tr>';
            }).join('');
            $container.html(
                '<p class="text-end text-muted small mb-2">Toplam: <strong>' + fmtSec(totalSec) + '</strong></p>' +
                '<table class="table table-sm table-striped table-bordered">' +
                '<thead class="table-light"><tr><th>Başlangıç</th><th>Bitiş</th><th>Süre</th><th>Kullanıcı</th><th>Not</th></tr></thead>' +
                '<tbody>' + rows + '</tbody></table>'
            );
        }).catch(function () {
            $('#TimeLogList_@Model.Id').html('<p class="text-danger">Zaman kayıtları yüklenemedi.</p>');
        });
    });

    // --- BAĞIMLILIK (PREDECESSOR) YÖNETİMİ ---
    $('#BtnAddPredecessor_@Model.Id').click(function () {
        var $select = $('#PredecessorSelect_@Model.Id');
        var predId = $select.val();
        var predTitle = $select.find(':selected').data('title');
        if (!predId) return;

        if ($('#PredecessorInputs_@Model.Id').find('[data-pred-id="' + predId + '"]').length > 0) {
            abp.notify.warn('Bu görev zaten bağımlılık listesinde.');
            return;
        }

        var $newInput = $('<input type="hidden" name="Task.PredecessorIds" class="predecessor-input" />')
            .val(predId).attr('data-pred-id', predId);
        $('#PredecessorInputs_@Model.Id').append($newInput);

        $('#NoPredecessorsMsg_@Model.Id').remove();
        $('#PredecessorBadges_@Model.Id').append(
            '<span class="badge bg-primary p-2 fs-6 pred-badge d-flex align-items-center gap-1" data-pred-id="' + predId + '">' +
                '<i class="fa fa-arrow-right me-1"></i> ' + predTitle +
                '<button type="button" class="btn-close btn-close-white btn-remove-pred ms-1" data-pred-id="' + predId + '" style="font-size:0.6em;" aria-label="Kaldır"></button>' +
            '</span>'
        );

        $select.val('');
        $newInput.trigger('change');
    });

    $(document).on('click', '#deps_@Model.Id .btn-remove-pred', function () {
        var predId = $(this).data('pred-id');
        $('#PredecessorInputs_@Model.Id').find('[data-pred-id="' + predId + '"]').remove();
        $('#PredecessorBadges_@Model.Id').find('.pred-badge[data-pred-id="' + predId + '"]').remove();

        if ($('#PredecessorBadges_@Model.Id .pred-badge').length === 0) {
            $('#PredecessorBadges_@Model.Id').append('<p class="text-muted small mb-0" id="NoPredecessorsMsg_@Model.Id">Henüz bağımlılık eklenmemiş.</p>');
        }

        $('#EditTaskForm_@Model.Id').find('input[name="Task.Title"]').trigger('input');
    });

    // Modal dışındayken değişiklikleri ebeveyn tablosuna yansıtmak istenir ise:
    $('#EditTaskForm_@Model.Id').closest('.modal').on('hidden.bs.modal', function () {
        // Eğer dış dünyada bir abp veritabanı gridi varsa onu tazeleyelim
        if (typeof window.dataTable !== 'undefined') {
            window.dataTable.ajax.reload(null, false);
        } else if (typeof window.projectsTable !== 'undefined') {
            window.projectsTable.ajax.reload(null, false);
        } else if (typeof window.tasksTable !== 'undefined') {
            window.tasksTable.ajax.reload(null, false);
        }
    });
</script>

<style>
    @Html.Raw("@keyframes pulse-border { 0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); } }")
    .pulse-animation {
      animation: pulse-border 2s infinite;
    }
</style>