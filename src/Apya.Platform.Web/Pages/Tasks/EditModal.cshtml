    // --- YORUM DÜZENLE (inline) — yalnızca kendi yorumu (butonlar IsOwn ile render edilir) ---
    $(document).off('click', '.comment-edit-btn').on('click', '.comment-edit-btn', function () {
        var $item = $(this).closest('.comment-item');
        if ($item.children('.comment-edit-box').length) return; // zaten düzenleniyor
        var $textEl = $item.children('.comment-text'); // doğrudan çocuk (iç içe yanıt metnini yakalamasın)
        var $box = $('<div class="comment-edit-box mt-1"></div>');
        var $input = $('<input type="text" class="form-control form-control-sm mb-1">').val($textEl.text().trim());
        var $save = $('<button type="button" class="btn btn-sm btn-success me-1"><i class="fa fa-check"></i></button>');
        var $cancel = $('<button type="button" class="btn btn-sm btn-secondary"><i class="fa fa-times"></i></button>');
        $box.append($input).append($save).append($cancel);
        $textEl.hide().after($box);
        $input.trigger('focus');

        $cancel.on('click', function () { $box.remove(); $textEl.show(); });
        $save.on('click', function () {
            var newText = $input.val();
            if (!newText || !newText.trim()) return;
            var id = $item.data('comment-id');
            $save.prop('disabled', true);
            apya.platform.tasks.task.updateComment(id, newText.trim()).then(function () {
                $textEl.text(newText.trim());
                $box.remove();
                $textEl.show();
                abp.notify.success('Yorum güncellendi.');
            }).catch(function () { $save.prop('disabled', false); });
        });
    });

    // --- YORUM SİL — yalnızca kendi yorumu ---
    $(document).off('click', '.comment-delete-btn').on('click', '.comment-delete-btn', function () {
        var $item = $(this).closest('.comment-item');
        var id = $item.data('comment-id');
        abp.message.confirm('Bu yorumu silmek istediğinize emin misiniz?', 'Yorumu Sil', function (confirmed) {
            if (!confirmed) return;
            apya.platform.tasks.task.deleteComment(id).then(function () {
                $item.remove();
                bumpCommentCount(-1);
                abp.notify.info('Yorum silindi.');
            });
        });
    });

    // --- YORUMA YANIT (Instagram tarzı, tek seviye) ---
    function buildReplyRow(id, author, text) {
        var $r = $('<div class="list-group-item apya-comment apya-comment--reply comment-item reply-item" data-comment-id="' + id + '">' +
            '<div class="d-flex w-100 justify-content-between mb-1">' +
                '<h6 class="mb-0 fw-bold text-secondary js-reply-author"><i class="fa fa-reply fa-flip-horizontal me-1"></i> </h6>' +
                '<div class="d-flex align-items-center gap-2">' +
                    '<small class="text-muted">' + new Date().toLocaleString() + '</small>' +
                    '<button type="button" class="btn btn-sm btn-link text-secondary p-0 comment-edit-btn" title="Düzenle"><i class="fa fa-pen"></i></button>' +
                    '<button type="button" class="btn btn-sm btn-link text-danger p-0 comment-delete-btn" title="Sil"><i class="fa fa-trash"></i></button>' +
                '</div>' +
            '</div>' +
            '<p class="mb-0 comment-text"></p>' +
        '</div>');
        $r.find('.js-reply-author').append(document.createTextNode(author || 'Siz'));
        $r.children('.comment-text').text(text); // HTML enjeksiyonunu önle
        return $r;
    }

    $(document).off('click', '.comment-reply-btn').on('click', '.comment-reply-btn', function () {
        var $comment = $(this).closest('.comment-item');
        var $replies = $comment.children('.comment-replies');
        if ($comment.children('.reply-input-box').length) { $comment.children('.reply-input-box').find('input').trigger('focus'); return; }

        var $box = $('<div class="reply-input-box input-group input-group-sm mt-2 mb-1"></div>');
        var $input = $('<input type="text" class="form-control form-control-sm" placeholder="Yanıt yaz...">');
        var $send = $('<button type="button" class="btn btn-primary"><i class="fa fa-paper-plane"></i></button>');
        $box.append($input).append($send);
        $replies.before($box);
        $input.trigger('focus');

        function submitReply() {
            var text = $input.val();
            if (!text || !text.trim()) return;
            var parentId = $comment.data('comment-id');
            $send.prop('disabled', true);
            $.ajax({
                type: 'POST',
                url: '/Tasks/EditModal?handler=ReplyComment',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: { parentCommentId: parentId, commentText: text },
                success: function (result) {
                    var id = result && result.id ? result.id : '';
                    var author = result && result.author ? result.author : 'Siz';
                    $replies.append(buildReplyRow(id, author, text));
                    $box.remove();
                    bumpCommentCount(1);
                    abp.notify.success('Yanıt eklendi!');
                },
                error: function () { $send.prop('disabled', false); abp.notify.error('Yanıt eklenemedi!'); }
            });
        }
        $send.on('click', submitReply);
        $input.on('keypress', function (e) { if (e.which === 13) { e.preventDefault(); submitReply(); } });
    });

