@page
@using System.Linq
@using System.Text.Json
@using Apya.Platform.Consents
@using Apya.Platform.Web.Pages.Shared
@model Apya.Platform.Web.Pages.Admin.Consent.IndexModel
@{
    ViewBag.Title = "Rıza / KVKK Analizi";
    var s = Model.Stats;

    var typeChartLabels = JsonSerializer.Serialize(s.ByType.Select(x => Apya.Platform.Web.Pages.Admin.Consent.IndexModel.TypeLabel(x.Type)));
    var typeChartData = JsonSerializer.Serialize(s.ByType.Select(x => x.Total));
    var trendLabels = JsonSerializer.Serialize(s.Trend.Select(x => x.Date.ToString("dd.MM")));
    var trendData = JsonSerializer.Serialize(s.Trend.Select(x => x.Count));
    var acceptRate = s.TotalRecords > 0 ? (s.GrantedCount * 100.0 / s.TotalRecords) : 0;
}

<div data-page-description="Rıza kayıtları: tip, kabul oranı ve trend" class="apya-page">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="fa fa-shield-halved me-2"></i> Rıza / KVKK Analizi</h5>
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="text-muted small mb-0">Pencere:</label>
        <select name="Days" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
            <option value="7" selected="@(Model.Days == 7)">7 gün</option>
            <option value="30" selected="@(Model.Days == 30)">30 gün</option>
            <option value="90" selected="@(Model.Days == 90)">90 gün</option>
        </select>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-clipboard-check", Accent = "accent", Label = $"Toplam ({s.WindowDays} gün)", Value = s.TotalRecords.ToString() }' />
    </div>
    <div class="col-md-3">
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-circle-check", Accent = "positive", Label = "Onaylandı", Value = s.GrantedCount.ToString() }' />
    </div>
    <div class="col-md-3">
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-circle-xmark", Accent = "negative", Label = "Reddedildi", Value = s.DeclinedCount.ToString() }' />
    </div>
    <div class="col-md-3">
        <partial name="_KpiCard" model='new KpiCardModel { Icon = "fa-percent", Accent = "brand", Label = "Kabul Oranı", Value = $"%{acceptRate:0.#}" }' />
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <abp-card>
            <abp-card-header><h6 class="mb-0">Türe Göre Dağılım</h6></abp-card-header>
            <abp-card-body>
                @if (s.ByType.Count == 0)
                {
                    <p class="text-muted text-center my-4">Bu pencerede rıza kaydı yok.</p>
                }
                else
                {
                    <canvas id="typeChart" height="220"></canvas>
                }
            </abp-card-body>
        </abp-card>
    </div>
    <div class="col-md-7">
        <abp-card>
            <abp-card-header><h6 class="mb-0">Günlük Trend</h6></abp-card-header>
            <abp-card-body>
                <canvas id="trendChart" height="220"></canvas>
            </abp-card-body>
        </abp-card>
    </div>
</div>

@if (s.ByType.Count > 0)
{
    <abp-card class="mt-3">
        <abp-card-header><h6 class="mb-0">Tür Kırılımı</h6></abp-card-header>
        <abp-card-body>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="Column">Tür</th>
                            <th scope="Column" class="text-end">Onaylandı</th>
                            <th scope="Column" class="text-end">Reddedildi</th>
                            <th scope="Column" class="text-end">Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in s.ByType)
                        {
                            <tr>
                                <td>@Apya.Platform.Web.Pages.Admin.Consent.IndexModel.TypeLabel(row.Type)</td>
                                <td class="text-end">@row.Granted</td>
                                <td class="text-end">@row.Declined</td>
                                <td class="text-end fw-semibold">@row.Total</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </abp-card-body>
    </abp-card>
}
</div>

@section scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <abp-script src="/js/apya-chart-theme.js" />
    <script>
        (function () {
            var typeChart = null, trendChart = null;

            function build() {
                var t = document.getElementById('typeChart');
                if (t && window.Chart) {
                    typeChart = new Chart(t, apyaChart.options({
                        type: 'doughnut',
                        data: { labels: @Html.Raw(typeChartLabels), datasets: [{ data: @Html.Raw(typeChartData) }] }
                    }));
                }
                var tr = document.getElementById('trendChart');
                if (tr && window.Chart) {
                    trendChart = new Chart(tr, apyaChart.options({
                        type: 'line',
                        data: {
                            labels: @Html.Raw(trendLabels),
                            datasets: [{ label: 'Rıza', data: @Html.Raw(trendData), fill: true }]
                        },
                        options: { plugins: { legend: { display: false } } }
                    }));
                }
            }

            build();
            if (window.apyaChart && apyaChart.onThemeChange) {
                apyaChart.onThemeChange(function () {
                    if (typeChart) typeChart.destroy();
                    if (trendChart) trendChart.destroy();
                    build();
                });
            }
        })();
    </script>
}
