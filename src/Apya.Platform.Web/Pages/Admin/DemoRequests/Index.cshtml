@page
@using System
@using System.Linq
@using Apya.Platform.DemoRequests
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using Apya.Platform.Localization
@model Apya.Platform.Web.Pages.Admin.DemoRequests.IndexModel
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<PlatformResource> L
@{
    ViewBag.Title = "Demo Talepleri";
    var canManage = await AuthorizationService.IsGrantedAsync(PlatformPermissions.DemoRequests.Manage);
}

<div data-page-description="Giriş ekranından gelen demo taleplerini takip edin" class="apya-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0"><i class="fa fa-handshake me-2" aria-hidden="true"></i> Demo Talepleri</h5>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-primary">Yeni: @Model.Summary.NewCount</span>
            <span class="badge bg-warning text-dark">İletişimde: @Model.Summary.ContactedCount</span>
            <span class="badge bg-secondary">Kapalı: @Model.Summary.ClosedCount</span>
        </div>
    </div>

    @if (TempData["Saved"] != null)
    {
        <div class="alert alert-success" role="status">Talep güncellendi.</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-sm-4 col-md-3">
            <label class="form-label" for="Status">Durum</label>
            <select class="form-select" id="Status" name="Status" asp-for="Status">
                <option value="">Tümü</option>
                @foreach (var status in Enum.GetValues<DemoRequestStatus>())
                {
                    <option value="@status">@L["DemoRequest:Status:" + status]</option>
                }
            </select>
        </div>
        <div class="col-sm-5 col-md-4">
            <label class="form-label" for="Filter">Ara</label>
            <input class="form-control" id="Filter" name="Filter" asp-for="Filter"
                   placeholder="Ad, kurum, e-posta veya telefon" />
        </div>
        <div class="col-sm-3 col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="fa fa-filter me-1" aria-hidden="true"></i> Süz
            </button>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-light border" role="status">
            Bu süzgece uyan demo talebi yok.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="Column">Tarih</th>
                        <th scope="Column">Ad Soyad</th>
                        <th scope="Column">Kurum</th>
                        <th scope="Column">İletişim</th>
                        <th scope="Column">Durum</th>
                        <th scope="Column" class="text-end">Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var detailId = "demo-detail-" + item.Id;
                        <tr>
                            <td class="text-nowrap">@item.CreationTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.FullName</td>
                            <td>@item.CompanyName</td>
                            <td>
                                <a href="mailto:@item.Email">@item.Email</a><br />
                                <a href="tel:@item.Phone">@item.Phone</a>
                            </td>
                            <td>
                                <span class="badge @Apya.Platform.Web.Pages.Admin.DemoRequests.IndexModel.StatusBadgeClass(item.Status)">
                                    @L["DemoRequest:Status:" + item.Status]
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@detailId"
                                        aria-expanded="false" aria-controls="@detailId">
                                    <i class="fa fa-chevron-down" aria-hidden="true"></i>
                                    <span class="visually-hidden">Detayı aç</span>
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse" id="@detailId">
                            <td colspan="6" class="bg-body-tertiary">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <dl class="row mb-0 small">
                                            @if (item.OrganizationKind.HasValue)
                                            {
                                                <dt class="col-5">Kurum türü</dt>
                                                <dd class="col-7">@L["DemoRequest:OrganizationKind:" + item.OrganizationKind.Value]</dd>
                                            }
                                            @if (item.CompanySize.HasValue)
                                            {
                                                <dt class="col-5">Çalışan sayısı</dt>
                                                <dd class="col-7">@L["DemoRequest:CompanySize:" + item.CompanySize.Value]</dd>
                                            }
                                            @if (item.InterestedModuleKeys.Length > 0)
                                            {
                                                <dt class="col-5">İlgilendiği modüller</dt>
                                                <dd class="col-7">
                                                    @string.Join(", ", item.InterestedModuleKeys.Select(k => L["DemoRequest:Module:" + k].Value))
                                                </dd>
                                            }
                                            <dt class="col-5">IP</dt>
                                            <dd class="col-7">@(item.IpAddress ?? "—")</dd>
                                            @if (item.LastModificationTime.HasValue)
                                            {
                                                <dt class="col-5">Son güncelleme</dt>
                                                <dd class="col-7">@item.LastModificationTime.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                                            }
                                        </dl>

                                        @if (item.BudgetRange.HasValue || !string.IsNullOrWhiteSpace(item.TargetAudience)
                                             || !string.IsNullOrWhiteSpace(item.ProblemStatement)
                                             || !string.IsNullOrWhiteSpace(item.PlannedActivities)
                                             || !string.IsNullOrWhiteSpace(item.ExpectedOutcomes))
                                        {
                                            <div class="mt-3">
                                                <div class="fw-semibold small mb-1">Proje fikri</div>
                                                <dl class="row mb-0 small">
                                                    @if (!string.IsNullOrWhiteSpace(item.TargetAudience))
                                                    {
                                                        <dt class="col-5">Hedef kitle</dt>
                                                        <dd class="col-7">@item.TargetAudience</dd>
                                                    }
                                                    @if (item.BudgetRange.HasValue)
                                                    {
                                                        <dt class="col-5">Tahmini bütçe</dt>
                                                        <dd class="col-7">@L["DemoRequest:BudgetRange:" + item.BudgetRange.Value]</dd>
                                                    }
                                                </dl>
                                                @if (!string.IsNullOrWhiteSpace(item.ProblemStatement))
                                                {
                                                    <div class="mt-2">
                                                        <div class="fw-semibold small">Çözüm aranan sorun</div>
                                                        <p class="mb-0 small">@item.ProblemStatement</p>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.PlannedActivities))
                                                {
                                                    <div class="mt-2">
                                                        <div class="fw-semibold small">Planlanan faaliyetler</div>
                                                        <p class="mb-0 small">@item.PlannedActivities</p>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ExpectedOutcomes))
                                                {
                                                    <div class="mt-2">
                                                        <div class="fw-semibold small">Beklenen çıktılar</div>
                                                        <p class="mb-0 small">@item.ExpectedOutcomes</p>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Message))
                                        {
                                            <div class="mt-2">
                                                <div class="fw-semibold small">Mesajı</div>
                                                <p class="mb-0 small">@item.Message</p>
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-6">
                                        @if (canManage)
                                        {
                                            <form method="post" asp-page-handler="Update" class="row g-2">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="Status" value="@Model.Status" />
                                                <input type="hidden" name="Filter" value="@Model.Filter" />
                                                <input type="hidden" name="PageIndex" value="@Model.PageIndex" />

                                                <div class="col-12">
                                                    <label class="form-label small" for="status-@item.Id">Durum</label>
                                                    <select class="form-select form-select-sm" id="status-@item.Id" name="newStatus">
                                                        @foreach (var status in Enum.GetValues<DemoRequestStatus>())
                                                        {
                                                            <option value="@status" selected="@(status == item.Status)">
                                                                @L["DemoRequest:Status:" + status]
                                                            </option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label small" for="note-@item.Id">İç not</label>
                                                    <textarea class="form-control form-control-sm" id="note-@item.Id"
                                                              name="adminNote" rows="3"
                                                              placeholder="Kim aradı, ne konuşuldu">@item.AdminNote</textarea>
                                                </div>

                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <i class="fa fa-save me-1" aria-hidden="true"></i> Kaydet
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.AdminNote))
                                        {
                                            <div class="fw-semibold small">İç not</div>
                                            <p class="mb-0 small">@item.AdminNote</p>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Sayfalama">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-Status="@Model.Status" asp-route-Filter="@Model.Filter"
                           asp-route-PageIndex="@(Model.PageIndex - 1)">Önceki</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageIndex / @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-Status="@Model.Status" asp-route-Filter="@Model.Filter"
                           asp-route-PageIndex="@(Model.PageIndex + 1)">Sonraki</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
