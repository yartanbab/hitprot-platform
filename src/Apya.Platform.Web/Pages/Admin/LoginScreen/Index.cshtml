@page
@model Apya.Platform.Web.Pages.Admin.LoginScreen.IndexModel
@{
    ViewBag.Title = "Giriş Ekranı Ayarları";
}

<div data-page-description="Giriş ekranında nelerin görüneceğini belirler" class="apya-page">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i> Giriş Ekranı Ayarları</h5>
    <a href="/Account/Login" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-up-right-from-square me-1" aria-hidden="true"></i> Ekranı Görüntüle
    </a>
</div>

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success" role="status">Ayarlar kaydedildi.</div>
}

<form method="post">
    <div class="row g-3">
        <div class="col-lg-6">
            <abp-card>
                <abp-card-header><abp-card-title>Kiracı (Müşteri) Seçici</abp-card-title></abp-card-header>
                <abp-card-body>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="ShowTenantSwitch" asp-for="Settings.ShowTenantSwitch" />
                        <label class="form-check-label" for="ShowTenantSwitch">
                            Giriş ekranında kiracı seçici görünsün
                        </label>
                        <div class="form-text">
                            Kapalıyken giriş ekranında yalnızca kullanıcı adı ve şifre istenir.
                            <strong>Dikkat:</strong> kiracıya bağlı kullanıcılar bu kutu olmadan
                            kendi hesaplarıyla giriş yapamaz; onlara yalnızca host yöneticisinin
                            müşteri değiştirme (impersonate) akışıyla erişilir.
                        </div>
                    </div>
                </abp-card-body>
            </abp-card>
        </div>

        <div class="col-lg-6">
            <abp-card>
                <abp-card-header><abp-card-title>Sosyal Giriş</abp-card-title></abp-card-header>
                <abp-card-body>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="ShowSocialLogin" asp-for="Settings.ShowSocialLogin" />
                        <label class="form-check-label" for="ShowSocialLogin">
                            Google / Microsoft ile giriş düğmeleri görünsün
                        </label>
                        <div class="form-text">
                            Açmadan önce ilgili sağlayıcı uygulamada tanımlı olmalıdır.
                            Tanımlı sağlayıcı yoksa bu ayar açık olsa bile düğmeler görünmez —
                            ölü düğme çıkmaz.
                        </div>
                    </div>
                </abp-card-body>
            </abp-card>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save me-1" aria-hidden="true"></i> Kaydet
        </button>
    </div>
</form>
</div>
