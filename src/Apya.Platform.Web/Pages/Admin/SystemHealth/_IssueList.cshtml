@using Apya.Platform.Telemetry.Dtos
@using Apya.Platform.Web.Pages.Shared
@using Apya.Platform.Web.Pages.Admin.SystemHealth
@model Apya.Platform.Web.Pages.Admin.SystemHealth.IndexModel
@{
    var list = Model.Issues;
}
@*
    Konsolun sol listesi. Arama kutusu BİLEREK dışarıda (Index.cshtml): bu parça her
    tuş vuruşunda değiştiği için kutu burada olsaydı odak kaybolurdu. Çipler ise
    içeride, çünkü sayaçları pencere/arama değişince tazelenmeli.
*@
<div class="apya-health-facets" role="group" aria-label="Kanal süzgeci">
    <button type="button" class="apya-health-facet" data-facet="open">Açık · @list.OpenCount</button>
    <button type="button" class="apya-health-facet" data-facet="server">Sunucu · @list.ServerCount</button>
    <button type="button" class="apya-health-facet" data-facet="rejected">İstek reddi · @list.RejectedCount</button>
    <button type="button" class="apya-health-facet" data-facet="client">İstemci · @list.ClientCount</button>
    <button type="button" class="apya-health-facet" data-facet="perf">Performans · @list.PerformanceCount</button>
    <button type="button" class="apya-health-facet" data-facet="resolved">Çözüldü · @list.ResolvedCount</button>
</div>

@if (list.Items.Count == 0)
{
    <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-thumbs-up", Title = "Olay yok.", Description = "Seçili pencerede ve süzgeçte teşhis edilecek bir şey görünmüyor." }' />
}
else
{
    <div class="apya-health-rows">
        @foreach (var issue in list.Items)
        {
            var tone = IndexModel.KindTone(issue);
            var spark = IndexModel.SparkPath(issue.Trend);

            <button type="button"
                    class="apya-health-row apya-health-row--@tone"
                    data-kind="@((int)issue.Kind)"
                    data-client-error-id="@(issue.ClientErrorId?.ToString() ?? "")"
                    data-url="@(issue.Where ?? "")"
                    data-http-method="@(issue.HttpMethod ?? "")"
                    title="@issue.Title">
                <span class="kpi-icon-box kpi-icon-box--xs kpi-icon-box--@tone">
                    <i class="@IndexModel.KindIcon(issue.Kind)" aria-hidden="true"></i>
                </span>
                <span class="apya-health-row-body">
                    <span class="apya-health-row-head">
                        <span class="apya-health-row-kind apya-health-row-kind--@tone">
                            @IndexModel.KindLabel(issue.Kind)@(issue.HttpStatusCode.HasValue ? $" · {issue.HttpStatusCode}" : "")
                        </span>
                        <span class="apya-health-row-when">@IndexModel.Ago(issue.LastSeenAt)</span>
                        @if (issue.IsRegression && !issue.IsResolved)
                        {
                            <span class="apya-chip apya-chip-warning" title="İlk görülme pencerenin son %20'sinde">yeni</span>
                        }
                    </span>
                    <span class="apya-health-row-title">@issue.Title</span>
                    <span class="apya-health-row-where">@(issue.HttpMethod is null ? "" : issue.HttpMethod + " ")@issue.Where</span>
                    <span class="apya-health-row-meta">
                        @if (spark is null)
                        {
                            @* Zaman serisi tutulmayan kanal — uydurma eğri çizilmez. *@
                            <span class="apya-health-spark--none" title="Bu kanalda zaman serisi tutulmuyor"></span>
                        }
                        else
                        {
                            <svg class="apya-health-spark" viewBox="0 0 60 16" aria-hidden="true">
                                <path d="@spark" fill="none" stroke="currentColor" stroke-width="1.4" />
                            </svg>
                        }
                        <span class="apya-numeric">@issue.OccurrenceCount oluşum</span>
                        <span class="text-muted">@IndexModel.MetaTail(issue)</span>
                    </span>
                </span>
                @* Satırda olayın kanıtı YOK — ikon, detay parçasını arka planda çekip
                   oradaki tam özeti kopyalar. Odak alınamaz ve ekran okuyucudan
                   gizlidir: iç içe düğme geçersiz olurdu, erişilebilir eşdeğeri
                   kanıt panelindeki "Agent'a kopyala" düğmesidir. *@
                <span class="apya-health-row-copy" aria-hidden="true"
                      title="Bu olayın özetini agent'a kopyala">
                    <i class="fa fa-robot"></i>
                </span>
            </button>
        }
    </div>
}

<div class="apya-md-pager">
    <span>@list.TotalCount kayıttan @list.Items.Count tanesi gösteriliyor</span>
    <span class="d-flex align-items-center gap-2">
        @if (list.Items.Count > 0)
        {
            @* Yalnız tek satırlık künyeler — kanıt taşımaz. Hangi olaya bakılacağını
               seçtirmek içindir; ayrıntı olayın kendi özetinden kopyalanır. *@
            <button type="button" class="btn btn-sm btn-link p-0 issue-agent-copy-list"
                    title="Listelenen olayların künyesini agent'a kopyala">
                <i class="fa fa-robot me-1"></i>Görünenleri kopyala
            </button>
            <textarea class="d-none" data-agent-list-summary aria-hidden="true" tabindex="-1">@HealthIssueSummaryBuilder.BuildList(list, Model.WindowDays)</textarea>
        }
        <span class="text-muted">Etkiye göre sıralı</span>
    </span>
</div>
