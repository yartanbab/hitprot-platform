@page
@model Apya.Platform.Web.Pages.Admin.SystemHealth.ClientErrorDetailModalModel
@using Apya.Platform.Web.Pages.Admin.SystemHealth
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@{
    Layout = null;
    var e = Model.Error;
    var canResolve = await AuthorizationService.IsGrantedAsync(PlatformPermissions.SystemHealth.Resolve);
}
<abp-modal size="Large">
    <abp-modal-header title="İstemci Hatası Detayı"></abp-modal-header>
    <abp-modal-body>
        @* Önce "ne kadar ciddi" sorusuna cevap veren özet şerit. *@
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            @if (e.IsResolved)
            {
                <span class="apya-chip apya-chip-positive">Çözüldü</span>
            }
            else
            {
                <span class="apya-chip apya-chip-negative">Açık</span>
            }
            <span class="apya-chip apya-chip-neutral">@ClientErrorDetailModalModel.SourceLabel(e.Source)</span>
            <span class="apya-chip apya-chip-warning">@e.OccurrenceCount kez görüldü</span>
            <span class="apya-chip apya-chip-neutral">@(e.TenantName ?? "-")</span>
            @if (Model.IssueTaskLink is not null)
            {
                <partial name="_IssueTaskLinkBadge" model="Model.IssueTaskLink" />
            }
        </div>

        <div class="alert alert-danger py-2 mb-3" style="white-space:pre-wrap;word-break:break-word;">@e.Message</div>

        <dl class="row mb-3 text-sm">
            <dt class="col-sm-3">İlk görülme</dt>
            <dd class="col-sm-9">@e.FirstSeenAt.ToString("dd.MM.yyyy HH:mm")</dd>
            <dt class="col-sm-3">Son görülme</dt>
            <dd class="col-sm-9">@e.LastSeenAt.ToString("dd.MM.yyyy HH:mm")</dd>
            <dt class="col-sm-3">Sayfa</dt>
            <dd class="col-sm-9"><code>@(e.PageUrl ?? "-")</code></dd>
            <dt class="col-sm-3">Tarayıcı</dt>
            <dd class="col-sm-9 text-muted" style="word-break:break-word;">@(e.UserAgent ?? "-")</dd>
            <dt class="col-sm-3">Ekran</dt>
            <dd class="col-sm-9 text-muted">@(e.ScreenResolution ?? "-")</dd>
            <dt class="col-sm-3">Sürüm</dt>
            <dd class="col-sm-9 text-muted">@(e.AppVersion ?? "-")</dd>
            <dt class="col-sm-3">İmza</dt>
            <dd class="col-sm-9"><code class="text-xs">@e.Fingerprint</code></dd>
            @if (e.IsResolved && e.ResolvedAt.HasValue)
            {
                <dt class="col-sm-3">Çözüldü</dt>
                <dd class="col-sm-9">@e.ResolvedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
            }
        </dl>

        @if (Model.Breadcrumb.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label text-xs fw-bold d-block">
                    Davranış İzi
                    <span class="text-muted fw-normal">(hatadan hemen önceki adımlar)</span>
                </label>
                <ul class="list-unstyled text-sm mb-0" style="max-height:180px;overflow-y:auto;">
                    @foreach (var b in Model.Breadcrumb)
                    {
                        <li class="mb-1">
                            <span class="text-muted">@b.Time.ToString("HH:mm:ss")</span>
                            <span class="apya-chip apya-chip-neutral mx-1">@b.Type</span>
                            <span>@b.Label</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(e.StackTrace))
        {
            <div class="mb-0">
                <label class="form-label text-xs fw-bold d-block">Stack Trace</label>
                <pre class="text-xs mb-0 p-2" style="max-height:240px;overflow:auto;background:var(--apya-surface-sunken);border-radius:6px;">@e.StackTrace</pre>
            </div>
        }
    </abp-modal-body>
    <abp-modal-footer>
        @if (Model.CanCreateIssueTask && Model.IssueTaskLink is null)
        {
            @* Detay kapanıp dönüştürme modalı açılır — iç içe modal yığını kurmuyoruz. *@
            <button type="button" class="btn btn-sm btn-outline-primary issue-task-create"
                    data-source-type="@((int)Apya.Platform.IssueTasks.IssueSourceType.ClientError)"
                    data-source-id="@e.Id">
                <i class="fa fa-list-check me-1"></i>Göreve Dönüştür
            </button>
        }
        @if (canResolve)
        {
            @* Durum değiştirme burada da yapılabilsin — tabloya dönmek gerekmesin. *@
            <button type="button" class="btn btn-sm @(e.IsResolved ? "btn-outline-secondary" : "btn-outline-success") me-auto client-error-toggle-resolved"
                    data-id="@e.Id" data-resolved="@e.IsResolved.ToString().ToLowerInvariant()">
                <i class="fa @(e.IsResolved ? "fa-rotate-left" : "fa-check") me-1"></i>
                @(e.IsResolved ? "Yeniden Aç" : "Çözüldü İşaretle")
            </button>
        }
        <abp-button text="Kapat" button-type="Secondary" data-bs-dismiss="modal"></abp-button>
    </abp-modal-footer>
</abp-modal>
