@page
@using System
@using System.Globalization
@using System.Linq
@using Apya.Platform.Billing
@using Apya.Platform.Localization
@using Apya.Platform.Permissions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@model Apya.Platform.Web.Pages.Admin.Billing.IndexModel
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<PlatformResource> L
@{
    ViewBag.Title = "Faturalar & Tahsilat";
    var canManage = await AuthorizationService.IsGrantedAsync(PlatformPermissions.Billing.Manage);
}

<div data-page-description="Müşterilere kesilen faturalar ve tahsilat takibi" class="apya-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="mb-0"><i class="fa fa-file-invoice me-2" aria-hidden="true"></i> Faturalar &amp; Tahsilat</h5>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="badge bg-primary">Açık: @Model.Summary.IssuedCount</span>
            <span class="badge bg-warning text-dark">Kısmi: @Model.Summary.PartiallyPaidCount</span>
            <span class="badge bg-success">Tahsil: @Model.Summary.PaidCount</span>
            <span class="badge bg-danger">Vadesi geçen: @Model.Summary.OverdueCount</span>
            @if (Model.Summary.PendingDeclarationCount > 0)
            {
                <span class="badge bg-info text-dark">
                    <i class="fa fa-bell me-1" aria-hidden="true"></i>Onay bekleyen dekont: @Model.Summary.PendingDeclarationCount
                </span>
            }
        </div>
    </div>

    <div class="alert alert-light border d-flex justify-content-between align-items-center flex-wrap gap-2" role="status">
        <span>Tahsil edilmemiş toplam</span>
        <strong class="fs-5">@Model.Summary.OutstandingAmount.ToString("N2") TL</strong>
    </div>

    @if (TempData["BillingSaved"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["BillingSaved"]</div>
    }
    @if (TempData["BillingError"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["BillingError"]</div>
    }

    @* --- Süzgeç --- *@
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-sm-4 col-md-3">
            <label class="form-label" for="TenantId">Müşteri</label>
            <select class="form-select" id="TenantId" name="TenantId" asp-for="TenantId"
                    asp-items="Model.TenantOptions">
                <option value="">Tümü</option>
            </select>
        </div>
        <div class="col-sm-3 col-md-2">
            <label class="form-label" for="Status">Durum</label>
            <select class="form-select" id="Status" name="Status" asp-for="Status">
                <option value="">Tümü</option>
                @foreach (var status in Enum.GetValues<SubscriptionInvoiceStatus>())
                {
                    <option value="@status">@L["Billing:Status:" + status]</option>
                }
            </select>
        </div>
        <div class="col-sm-5 col-md-3">
            <label class="form-label" for="Filter">Ara</label>
            <input class="form-control" id="Filter" name="Filter" asp-for="Filter"
                   placeholder="Fatura veya resmî numara" />
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="OnlyOverdue" asp-for="OnlyOverdue" />
                <label class="form-check-label small" for="OnlyOverdue">Vadesi geçen</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="OnlyPendingDeclaration" asp-for="OnlyPendingDeclaration" />
                <label class="form-check-label small" for="OnlyPendingDeclaration">Dekont bekleyen</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="fa fa-filter me-1" aria-hidden="true"></i> Süz
            </button>
        </div>
    </form>

    @if (canManage)
    {
        @* --- Yeni fatura --- *@
        <div class="card mb-3">
            <div class="card-header py-2">
                <button class="btn btn-sm btn-link text-decoration-none p-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#new-invoice">
                    <i class="fa fa-plus me-1" aria-hidden="true"></i> Yeni fatura aç
                </button>
            </div>
            <div class="collapse" id="new-invoice">
                <div class="card-body">
                    <form method="post" asp-page-handler="Create" class="row g-2">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="col-md-4">
                            <label class="form-label small" asp-for="NewInvoice.TenantId">Müşteri</label>
                            <select class="form-select form-select-sm" asp-for="NewInvoice.TenantId"
                                    asp-items="Model.TenantOptions">
                                <option value="">Seçiniz</option>
                            </select>
                            <span class="text-danger small" asp-validation-for="NewInvoice.TenantId"></span>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small" asp-for="NewInvoice.Type">Konu</label>
                            <select class="form-select form-select-sm" asp-for="NewInvoice.Type">
                                @foreach (var type in Enum.GetValues<SubscriptionInvoiceType>())
                                {
                                    <option value="@type">@L["Billing:Type:" + type]</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small" asp-for="NewInvoice.IssueDate">Fatura tarihi</label>
                            <input class="form-control form-control-sm" type="date" asp-for="NewInvoice.IssueDate" />
                            <span class="text-danger small" asp-validation-for="NewInvoice.IssueDate"></span>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small" asp-for="NewInvoice.DueDate">
                                Vade <span class="text-muted">(boşsa +15 gün)</span>
                            </label>
                            <input class="form-control form-control-sm" type="date" asp-for="NewInvoice.DueDate" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small" asp-for="NewInvoice.NetAmount">Tutar (KDV hariç)</label>
                            @* type="number" değeri DAİMA noktalı gönderir; asp-for ondalık alanı
                               text olarak bassaydı tr-TR bağlaması noktayı binlik sayardı. Bu yüzden
                               tip AÇIKÇA number ve yanında __Invariant işaretçisi var. *@
                            <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                                   name="NewInvoice.NetAmount"
                                   value="@Model.NewInvoice.NetAmount.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="__Invariant" value="NewInvoice.NetAmount" />
                            <span class="text-danger small" asp-validation-for="NewInvoice.NetAmount"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small" asp-for="NewInvoice.VatMode">KDV</label>
                            <select class="form-select form-select-sm" asp-for="NewInvoice.VatMode">
                                @foreach (var mode in Enum.GetValues<VatMode>())
                                {
                                    <option value="@mode">@L["Billing:Vat:" + mode]</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small" asp-for="NewInvoice.VatRate">KDV oranı (%)</label>
                            <input class="form-control form-control-sm" type="number" step="0.01" min="0" max="100"
                                   name="NewInvoice.VatRate"
                                   value="@Model.NewInvoice.VatRate.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="__Invariant" value="NewInvoice.VatRate" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small" asp-for="NewInvoice.OfficialNumber">Resmî fatura no</label>
                            <input class="form-control form-control-sm" asp-for="NewInvoice.OfficialNumber"
                                   placeholder="e-fatura numarası" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small" asp-for="NewInvoice.Notes">Not</label>
                            <input class="form-control form-control-sm" asp-for="NewInvoice.Notes" />
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fa fa-save me-1" aria-hidden="true"></i> Faturayı aç
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-light border" role="status">Bu süzgece uyan fatura yok.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="Column">Fatura</th>
                        <th scope="Column">Müşteri</th>
                        <th scope="Column">Tarih / Vade</th>
                        <th scope="Column" class="text-end">Tutar</th>
                        <th scope="Column" class="text-end">Kalan</th>
                        <th scope="Column">Durum</th>
                        <th scope="Column" class="text-end">Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var detailId = "invoice-detail-" + item.Id;
                        <tr>
                            <td>
                                <span class="text-nowrap">@item.Number</span><br />
                                <span class="text-muted small">@L["Billing:Type:" + item.Type]</span>
                                @if (!string.IsNullOrWhiteSpace(item.OfficialNumber))
                                {
                                    <br />
                                    <span class="text-muted small">e-fatura: @item.OfficialNumber</span>
                                }
                            </td>
                            <td>@item.TenantName</td>
                            <td class="text-nowrap">
                                @item.IssueDate.ToString("dd.MM.yyyy")<br />
                                <span class="@(item.IsOverdue ? "text-danger fw-semibold" : "text-muted") small">
                                    vade @item.DueDate.ToString("dd.MM.yyyy")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                @item.TotalAmount.ToString("N2") TL
                                @if (item.VatMode == VatMode.TeknoparkExempt)
                                {
                                    <br />

                                    <span class="text-muted small">KDV istisnası</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">@item.RemainingAmount.ToString("N2") TL</td>
                            <td>
                                <span class="badge @Apya.Platform.Web.Pages.Admin.Billing.IndexModel.StatusBadgeClass(item)">
                                    @(item.IsOverdue && item.Status != SubscriptionInvoiceStatus.Cancelled
                                        ? "Vadesi geçti"
                                        : L["Billing:Status:" + item.Status])
                                </span>
                                @if (item.HasPendingDeclaration)
                                {
                                    <br />
                                    <span class="badge bg-info text-dark mt-1">dekont onayı bekliyor</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@detailId"
                                        aria-expanded="false" aria-controls="@detailId">
                                    <i class="fa fa-chevron-down" aria-hidden="true"></i>
                                    <span class="visually-hidden">Detayı aç</span>
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse" id="@detailId">
                            <td colspan="7" class="bg-body-tertiary">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="fw-semibold small mb-1">Tutar dökümü</div>
                                        <dl class="row mb-0 small">
                                            <dt class="col-6">KDV hariç</dt>
                                            <dd class="col-6 text-end">@item.NetAmount.ToString("N2") TL</dd>
                                            <dt class="col-6">KDV (@item.VatRate.ToString("0.##")%)</dt>
                                            <dd class="col-6 text-end">@item.VatAmount.ToString("N2") TL</dd>
                                            <dt class="col-6">Toplam</dt>
                                            <dd class="col-6 text-end fw-semibold">@item.TotalAmount.ToString("N2") TL</dd>
                                            <dt class="col-6">Tahsil edilen</dt>
                                            <dd class="col-6 text-end">@item.PaidAmount.ToString("N2") TL</dd>
                                        </dl>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="mt-2">
                                                <div class="fw-semibold small">Not</div>
                                                <p class="mb-0 small">@item.Notes</p>
                                            </div>
                                        }

                                        <div class="mt-3">
                                            <div class="fw-semibold small mb-1">Fatura belgesi</div>
                                            @if (item.HasDocument)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-page-handler="Download" asp-route-id="@item.Id">
                                                    <i class="fa fa-download me-1" aria-hidden="true"></i> @item.FileName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Henüz yüklenmedi.</span>
                                            }

                                            @if (canManage)
                                            {
                                                <form method="post" asp-page-handler="Attach" enctype="multipart/form-data"
                                                      class="mt-2 d-flex gap-2 align-items-center">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input class="form-control form-control-sm" type="file" name="file"
                                                           accept=".pdf,.jpg,.jpeg,.png" aria-label="Fatura belgesi" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                                        Yükle
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="fw-semibold small mb-1">Tahsilatlar</div>
                                        @if (item.Payments.Count == 0)
                                        {
                                            <p class="text-muted small mb-2">Henüz tahsilat yok.</p>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled small mb-2">
                                                @foreach (var payment in item.Payments)
                                                {
                                                    <li class="border-bottom py-1">
                                                        <div class="d-flex justify-content-between gap-2">
                                                            <span>
                                                                @payment.PaidAt.ToString("dd.MM.yyyy") ·
                                                                @L["Billing:Method:" + payment.Method]
                                                                @if (payment.DeclaredByTenant)
                                                                {
                                                                    <span class="badge bg-info text-dark ms-1">müşteri beyanı</span>
                                                                }
                                                                @if (!payment.IsConfirmed)
                                                                {
                                                                    <span class="badge bg-warning text-dark ms-1">onay bekliyor</span>
                                                                }
                                                            </span>
                                                            <strong class="text-nowrap">@payment.Amount.ToString("N2") TL</strong>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(payment.Reference))
                                                        {
                                                            <div class="text-muted">@payment.Reference</div>
                                                        }
                                                        <div class="d-flex gap-2 mt-1">
                                                            @if (payment.HasReceipt)
                                                            {
                                                                <a class="btn btn-sm btn-link p-0"
                                                                   asp-page-handler="DownloadReceipt"
                                                                   asp-route-id="@item.Id" asp-route-paymentId="@payment.Id">
                                                                    dekontu indir
                                                                </a>
                                                            }
                                                            @if (canManage && !payment.IsConfirmed)
                                                            {
                                                                <form method="post" asp-page-handler="ConfirmPayment">
                                                                    <input type="hidden" name="id" value="@item.Id" />
                                                                    <input type="hidden" name="paymentId" value="@payment.Id" />
                                                                    <button type="submit" class="btn btn-sm btn-link p-0 text-success">
                                                                        onayla
                                                                    </button>
                                                                </form>
                                                            }
                                                            @if (canManage)
                                                            {
                                                                <form method="post" asp-page-handler="RemovePayment">
                                                                    <input type="hidden" name="id" value="@item.Id" />
                                                                    <input type="hidden" name="paymentId" value="@payment.Id" />
                                                                    <button type="submit" class="btn btn-sm btn-link p-0 text-danger">
                                                                        sil
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }

                                        @if (canManage && item.Status != SubscriptionInvoiceStatus.Cancelled)
                                        {
                                            <form method="post" asp-page-handler="RecordPayment" class="row g-1">
                                                <input type="hidden" name="id" value="@item.Id" />

                                                <div class="col-5">
                                                    <label class="form-label small mb-0" for="paid-@item.Id">Tarih</label>
                                                    <input class="form-control form-control-sm" type="date"
                                                           id="paid-@item.Id" name="paymentPaidAt"
                                                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-7">
                                                    <label class="form-label small mb-0" for="amount-@item.Id">Tutar</label>
                                                    @* __Invariant ŞART — elle name= ile yazılan ondalık alan. *@
                                                    <input class="form-control form-control-sm" type="number" step="0.01" min="0.01"
                                                           id="amount-@item.Id" name="paymentAmount"
                                                           value="@item.RemainingAmount.ToString(CultureInfo.InvariantCulture)" />
                                                    <input type="hidden" name="__Invariant" value="paymentAmount" />
                                                </div>
                                                <div class="col-5">
                                                    <label class="form-label small mb-0" for="method-@item.Id">Kanal</label>
                                                    <select class="form-select form-select-sm" id="method-@item.Id" name="paymentMethod">
                                                        @foreach (var method in Enum.GetValues<PaymentMethod>())
                                                        {
                                                            <option value="@method">@L["Billing:Method:" + method]</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-7">
                                                    <label class="form-label small mb-0" for="ref-@item.Id">Referans</label>
                                                    <input class="form-control form-control-sm" id="ref-@item.Id"
                                                           name="paymentReference" placeholder="EFT no / açıklama" />
                                                </div>
                                                <div class="col-12 mt-2 d-flex gap-2">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <i class="fa fa-check me-1" aria-hidden="true"></i> Tahsilat kaydet
                                                    </button>
                                                </div>
                                            </form>

                                            @if (item.PaidAmount == 0)
                                            {
                                                <form method="post" asp-page-handler="Cancel" class="mt-2">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Faturayı iptal et
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Sayfalama">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-TenantId="@Model.TenantId" asp-route-Status="@Model.Status"
                           asp-route-Filter="@Model.Filter" asp-route-PageIndex="@(Model.PageIndex - 1)">Önceki</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@Model.PageIndex / @Model.TotalPages</span></li>
                    <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-route-TenantId="@Model.TenantId" asp-route-Status="@Model.Status"
                           asp-route-Filter="@Model.Filter" asp-route-PageIndex="@(Model.PageIndex + 1)">Sonraki</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
