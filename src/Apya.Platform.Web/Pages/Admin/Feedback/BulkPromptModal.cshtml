@page
@model Apya.Platform.Web.Pages.Admin.Feedback.BulkPromptModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-modal size="Large">
    <abp-modal-header title="Seçilenlerden prompt"></abp-modal-header>
    <abp-modal-body>
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-warning mb-0" role="alert">@Model.ErrorMessage</div>
        }
        else
        {
            @* Metin SUNUCUDA üretilir (FeedbackPromptBuilder.BuildBulk); kopyalama ve iç not
               geçişi detay penceresindeki Prompt sekmesiyle aynı işleyicileri kullanır. *@
            <div class="detail-prompt-pane">
                <p class="text-sm text-muted mb-2">
                    @Model.Count geri bildirim tek bir göreve toplandı: asistandan kayıtları gruplayıp sıralı bir iş listesi çıkarması istenir.
                    Her kayıt kısa özet olarak girer; gönderen ve kiracı adı metne girmez.
                </p>
                @if (Model.MissingCount > 0)
                {
                    <div class="alert alert-info py-2 text-sm" role="status">@Model.MissingCount kayıt artık mevcut olmadığı için atlandı.</div>
                }
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    @if (Model.PromptWithNotes is not null)
                    {
                        <div class="form-check mb-0">
                            <input class="form-check-input detail-prompt-internal" type="checkbox" id="BulkPromptInternal" />
                            <label class="form-check-label text-xs" for="BulkPromptInternal">İç notları da ekle</label>
                        </div>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button type="button" class="btn btn-sm btn-primary detail-prompt-copy">
                        <i class="fa fa-copy me-1"></i>Kopyala
                    </button>
                </div>
                <textarea class="form-control form-control-sm font-monospace detail-prompt-text" rows="18"
                          aria-label="Geliştirme prompt'u" spellcheck="false">@Model.Prompt</textarea>
                <textarea class="d-none detail-prompt-plain" aria-hidden="true" tabindex="-1">@Model.Prompt</textarea>
                @if (Model.PromptWithNotes is not null)
                {
                    <textarea class="d-none detail-prompt-with-notes" aria-hidden="true" tabindex="-1">@Model.PromptWithNotes</textarea>
                }
            </div>
        }
    </abp-modal-body>
    <abp-modal-footer>
        <abp-button text="Kapat" button-type="Secondary" data-bs-dismiss="modal"></abp-button>
    </abp-modal-footer>
</abp-modal>
