@page
@model Apya.Platform.Web.Pages.Incomes.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Incomes/EditModal")">
    <abp-modal>
        <abp-modal-header title="Geliri Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="IncomeId" />
            <abp-input asp-for="Income.Title" label="Başlık" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Income.Amount" label="Tutar" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Income.IncomeDate" type="date" label="Tarih" />
                </abp-column>
            </abp-row>
            @* Çoklu para birimi gizlendi — mevcut kaydın para birimi korunur. *@
            <input type="hidden" asp-for="Income.Currency" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.Category" asp-items="Model.Categories" label="Kategori" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.CashAccountId" asp-items="Model.Accounts" label="Giren Kasa">
                        <option value="">— Kasaya işlenmesin —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_12">
                    <abp-select asp-for="Income.ProjectId" asp-items="Model.Projects" label="Proje (opsiyonel)">
                        <option value="">— Proje yok —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            @* Cari alanı gizlendi (kullanıcı kararı 2026-06-22); mevcut değer korunsun diye gizli alan. *@
            <input type="hidden" asp-for="Income.CustomerId" />
            <abp-input asp-for="Income.Description" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

@* Proje seçiliyse tarih, projenin başlangıç–bitiş aralığında olmalı (apya-finance-modal.js). *@
<script type="application/json" id="IncomeEditProjectDates">@Html.Raw(Model.ProjectDatesJson)</script>
<script>
    (function () {
        var dates = {};
        try { dates = JSON.parse(document.getElementById('IncomeEditProjectDates').textContent || '{}'); } catch (e) { }
        setTimeout(function () {
            apya.financeModal.bindProjectDateRange({
                formSelector: 'form[action$="/Incomes/EditModal"]',
                projectSelector: '#Income_ProjectId',
                dateSelector: '#Income_IncomeDate',
                projectDates: dates
            });
        }, 0);
    })();
</script>
