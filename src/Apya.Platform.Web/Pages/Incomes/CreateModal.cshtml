@page
@model Apya.Platform.Web.Pages.Incomes.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/Incomes/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Gelir / Fon"></abp-modal-header>
        <abp-modal-body>
            @* Görev panelinden açılınca TaskId query'den gelir; POST'ta korunması için gizli alan.
               Eksikti → gelir TaskId'siz oluşuyor, görevin Finans sekmesinde listelenmiyordu. *@
            <input type="hidden" asp-for="Income.TaskId" />
            <abp-input asp-for="Income.Title" label="Başlık" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-input asp-for="Income.Amount" label="Tutar" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="Income.IncomeDate" type="date" label="Tarih" />
                </abp-column>
            </abp-row>
            @* Çoklu para birimi gizlendi — tüm işlemler TRY. *@
            <input type="hidden" asp-for="Income.Currency" value="TRY" />
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.Category" asp-items="Model.Categories" label="Kategori" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.CashAccountId" asp-items="Model.Accounts" label="Giren Kasa (opsiyonel — boşsa tahsil edilmemiş)">
                        <option value="">— Kasaya işlenmesin —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            <abp-row>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.ProjectId" asp-items="Model.Projects" label="Proje (opsiyonel)">
                        <option value="">— Proje yok —</option>
                    </abp-select>
                </abp-column>
                <abp-column size-md="_6">
                    <abp-select asp-for="Income.CustomerId" asp-items="Model.Customers" label="Cari (opsiyonel)">
                        <option value="">— Cari yok —</option>
                    </abp-select>
                </abp-column>
            </abp-row>
            <abp-input asp-for="Income.Description" label="Açıklama" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
