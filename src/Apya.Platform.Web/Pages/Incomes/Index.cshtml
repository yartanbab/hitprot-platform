@page
@model Apya.Platform.Web.Pages.Incomes.IndexModel
@{
    ViewBag.PageTitle = "Gelirler (Faturasız / Hibe)";
}
@section scripts {
    <abp-script src="/Pages/Incomes/Index.js" />
}

<div data-page-description="Faturasız gelir ve hibe kayıtları" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_7">
                <abp-card-title>@ViewBag.PageTitle</abp-card-title>
                <small class="text-muted">Hibe, bağış, faturasız nakit gelir. Kasa seçilirse otomatik kasa girişi oluşur.</small>
            </abp-column>
            <abp-column size-md="_5" class="text-end">
                <button id="NewIncomeButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i> Yeni Gelir
                </button>
                <apya-hint placement="bottom" text="Fatura kesmediğiniz gelirler için: hibe, bağış, nakit gelir. Kasa seçerseniz o kasaya giriş hareketi otomatik yazılır. DİKKAT: buraya girilen gelir, cari seçseniz bile cari bakiyesini değiştirmez — cari hesabı faturalar, tahsilatlar ve açılış kayıtları işler." />
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table id="IncomesTable" class="nowrap apya-clean-table"></abp-table>
    </abp-card-body>
</abp-card>
</div>
