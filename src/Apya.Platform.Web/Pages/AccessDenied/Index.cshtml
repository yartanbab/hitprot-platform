@page
@model Apya.Platform.Web.Pages.AccessDenied.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@*
    Erişim reddi — uygulama kabuğunda (menü, üst çubuk, tema, bürünme şeridi korunur). Sebep ve
    eylemler ErrorStates.ForAccessDenial'da; görünüm ortak _EmptyState (Page varyantı).
*@
@{
    ViewBag.Title = Model.State.Title;
}

<div class="apya-page" data-page-description="@L["AccessDenied:PageDescription"]">
    <div class="card">
        <div class="card-body">
            <partial name="_EmptyState" model="Model.State" />
        </div>
    </div>
</div>
