@using System.Globalization
@using Volo.Abp.Ui.Branding
@inject IBrandingProvider BrandingProvider
@{
    Layout = null;
    var rtl = Volo.Abp.Localization.CultureHelper.IsRtl ? "rtl" : string.Empty;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name" dir="@rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewBag.Title == null ? BrandingProvider.AppName : ViewBag.Title + " · " + BrandingProvider.AppName)</title>

    @* Yasal sayfalar oturumsuz da açılabildiği için uygulama kabuğu demetine bağlı
       değil; yalnız token + font + temel stil yüklenir (F/Index deseni). *@
    <link rel="stylesheet" href="~/css/apya-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dynamic-assets/src/styles/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            background: var(--apya-bg, #f6f7fb);
            color: var(--apya-text, #1a1a2e);
            font-family: var(--apya-font-sans, system-ui), sans-serif;
            line-height: 1.65;
        }
        .apya-legal { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
        .apya-legal__top {
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;
        }
        .apya-legal__brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.05rem; }
        .apya-legal__brand svg { flex: none; }
        .apya-legal__back {
            font-size: .875rem; text-decoration: none;
            color: var(--apya-primary, #4f46e5); font-weight: 600;
        }
        .apya-legal__back:hover { text-decoration: underline; }
        .apya-legal__card {
            background: var(--apya-surface, #fff);
            border: 1px solid var(--apya-border, #e5e7eb);
            border-radius: 16px;
            padding: 2.25rem clamp(1.25rem, 4vw, 2.75rem);
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }
        .apya-legal h1 { font-size: 1.6rem; margin: 0 0 .25rem; line-height: 1.25; }
        .apya-legal__meta { color: var(--apya-text-muted, #6b7280); font-size: .85rem; margin: 0 0 1.75rem; }
        .apya-legal h2 { font-size: 1.15rem; margin: 2rem 0 .6rem; }
        .apya-legal h3 { font-size: 1rem; margin: 1.4rem 0 .4rem; }
        .apya-legal p, .apya-legal li { font-size: .95rem; }
        .apya-legal ul, .apya-legal ol { padding-left: 1.4rem; }
        .apya-legal li { margin-bottom: .35rem; }
        .apya-legal a { color: var(--apya-primary, #4f46e5); }
        .apya-legal__note {
            border-left: 3px solid var(--apya-warning, #f59e0b);
            background: color-mix(in srgb, var(--apya-warning, #f59e0b) 8%, transparent);
            padding: .85rem 1rem; border-radius: 8px; font-size: .85rem;
            margin: 0 0 1.75rem;
        }
        .apya-legal__ph { color: var(--apya-danger, #dc2626); font-weight: 600; }
        .apya-legal table { width: 100%; border-collapse: collapse; margin: .75rem 0 1.25rem; font-size: .9rem; }
        .apya-legal th, .apya-legal td { border: 1px solid var(--apya-border, #e5e7eb); padding: .5rem .65rem; text-align: left; vertical-align: top; }
        .apya-legal th { background: var(--apya-surface-2, #f9fafb); font-weight: 600; }
        .apya-legal__footer { margin-top: 2rem; text-align: center; color: var(--apya-text-muted, #6b7280); font-size: .8rem; }
    </style>
</head>
<body>
    <div class="apya-legal">
        <div class="apya-legal__top">
            <span class="apya-legal__brand">
                <svg width="26" height="26" viewBox="0 0 48 48" role="img" aria-label="@BrandingProvider.AppName">
                    <polygon points="24,2 33,24 24,20 15,24" fill="#4338CA"></polygon>
                    <polygon points="46,24 24,33 28,24 24,15" fill="#4F46E5"></polygon>
                    <polygon points="24,46 15,24 24,28 33,24" fill="#5B54E8"></polygon>
                    <polygon points="2,24 24,15 20,24 24,33" fill="#6D5FEC"></polygon>
                    <polygon points="24,19 29,24 24,29 19,24" fill="#F5F5F5"></polygon>
                </svg>
                @BrandingProvider.AppName
            </span>
            <a class="apya-legal__back" href="~/">← Ana sayfaya dön</a>
        </div>

        <article class="apya-legal__card">
            @RenderBody()
        </article>

        <p class="apya-legal__footer">© @DateTime.Now.Year @BrandingProvider.AppName · Pargetto</p>
    </div>
</body>
</html>
