@page
@model Apya.Platform.Web.Pages.Customers.StatementModalModel
@using Apya.Platform.CustomerLedger
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
    string SourceText(CustomerLedgerSource s) => s switch
    {
        CustomerLedgerSource.Invoice => "Satış Faturası",
        CustomerLedgerSource.Payment => "Tahsilat",
        CustomerLedgerSource.Opening => "Açılış",
        _ => "Manuel"
    };
}
<abp-modal size="Large">
    <abp-modal-header title="@($"Cari Ekstre — {Model.Statement.CustomerName}")"></abp-modal-header>
    <abp-modal-body>
        <div class="alert @(Model.Statement.Balance > 0 ? "alert-danger" : Model.Statement.Balance < 0 ? "alert-success" : "alert-secondary")">
            <strong>Net Bakiye: @Model.Statement.Balance.ToString("N2") ₺</strong>
            @if (Model.Statement.Balance > 0)
            {
                <span> — Müşteri bize borçlu</span>
            }
            else if (Model.Statement.Balance < 0)
            {
                <span> — Fazla tahsilat / bizim borcumuz</span>
            }
            <span class="float-end">
                Toplam Borç: @Model.Statement.TotalDebit.ToString("N2") &nbsp;|&nbsp;
                Toplam Alacak: @Model.Statement.TotalCredit.ToString("N2")
            </span>
        </div>
        @if (Model.Statement.Lines.Count == 0)
        {
            <p class="text-muted">Bu cari için hareket yok.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th><th>Kaynak</th><th>Açıklama</th>
                        <th class="text-end">Borç</th>
                        <th class="text-end">Alacak</th>
                        <th class="text-end">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in Model.Statement.Lines)
                {
                    <tr>
                        <td>@l.EntryDate.ToString("dd.MM.yyyy")</td>
                        <td>@SourceText(l.Source)</td>
                        <td>@(l.Description ?? "-")</td>
                        <td class="text-end">@(l.Debit > 0 ? l.Debit.ToString("N2") : "")</td>
                        <td class="text-end">@(l.Credit > 0 ? l.Credit.ToString("N2") : "")</td>
                        <td class="text-end fw-bold">@l.RunningBalance.ToString("N2")</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">TOPLAM</td>
                        <td class="text-end">@Model.Statement.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@Model.Statement.TotalCredit.ToString("N2")</td>
                        <td class="text-end">@Model.Statement.Balance.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        }
    </abp-modal-body>
    <abp-modal-footer buttons="@(AbpModalButtons.Close)"></abp-modal-footer>
</abp-modal>
