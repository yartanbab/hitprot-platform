@page
@model Apya.Platform.Web.Pages.PackageManagement.IndexModel
@{
    ViewBag.PageTitle = "Paket Yönetimi";
}
@section scripts {
    <abp-script src="/Pages/PackageManagement/Index.js" />
}

<div data-page-description="Abonelik paketleri ve özellikleri" class="apya-page">
<abp-card>
    <abp-card-header>
        <abp-card-title><i class="fa fa-box-open text-primary me-2"></i> Paket Yönetimi (Edition)</abp-card-title>
    </abp-card-header>
    <abp-card-body>
        <p class="text-muted">
            Her paketin hangi <strong>izinleri</strong> kapsadığını ve limitlerini buradan düzenleyin.
            İzin listesi paketin tavanıdır: listede olmayan bir izni o paketteki tenant kendi
            kullanıcılarına <strong>veremez</strong>. Değişiklik; paketin <strong>yeni atandığı</strong>
            tenant'lara ve <strong>"yeniden uygula"</strong> dediğiniz mevcut tenant'lara yansır.
            <apya-hint text="İzin tavanı anında geçerlidir (yeniden uygulamaya gerek yok). Yeniden uygula yalnız feature/limit değerlerini o tenant'a olduğu gibi yazar — tenant'a özel elle verdiğiniz istisna/limit varsa üzerine yazılır ve kaybolur." />
        </p>
        <div class="row g-3" id="PackageCards"></div>
    </abp-card-body>
</abp-card>

<abp-card class="mt-3">
    <abp-card-header>
        <abp-card-title><i class="fa fa-hourglass-half text-primary me-2"></i> Paket Süresi ve Otomatik İndirme</abp-card-title>
    </abp-card-header>
    <abp-card-body>
        <p class="text-muted">
            Süreli paket atanmış müşteriler, süre dolduğunda otomatik olarak <strong>Basic</strong> pakete iner.
            Mevcut verileri silinmez; yalnız yeni kayıt açma limitleri ve modül yetkileri Basic'e döner.
            <strong>Süresi olmayan</strong> (süresiz) müşteriler bu kurallardan hiç etkilenmez.
            <apya-hint text="Müşteriye süre, kiracı yönetimi ekranındaki 'Paket Değiştir' ile verilir. Süre verilmemiş müşteri süresiz sayılır ve hiçbir zaman düşürülmez." />
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="SubAutoDowngrade">
                    <label class="form-check-label" for="SubAutoDowngrade">Süre dolunca Basic'e indir</label>
                </div>
                <div class="form-text">Kapalıyken yalnız uyarı gider, paket değişmez.</div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="SubGraceDays">Ek süre (gün)</label>
                <input type="number" min="0" max="90" step="1" class="form-control" id="SubGraceDays">
                <div class="form-text">0 = bitiş tarihinde iner.</div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="SubWarningDays">Uyarı eşikleri (gün)</label>
                <input type="text" class="form-control" id="SubWarningDays" placeholder="7,1" autocomplete="off">
                <div class="form-text">Virgülle ayırın. Boş = uyarı yok.</div>
            </div>
            <div class="col-12 col-md-2">
                <button type="button" class="btn btn-primary w-100" id="SubSaveBtn">
                    <i class="fa fa-check me-1"></i> Kaydet
                </button>
            </div>
        </div>
    </abp-card-body>
</abp-card>
</div>

@* Düzenleme modalı (saf JS; dinamik feature formu) *@
<div class="modal fade" id="PackageEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="PkgEditTitle">Paketi Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="PkgFeatureRows"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="PkgSaveBtn"><i class="fa fa-check me-1"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

@* İzin tavanı modalı — yetki yönetimiyle AYNI ağaç, paket bazında işaretlenir *@
<div class="modal fade" id="PackagePermissionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="PkgPermTitle">Paket İzinleri</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <div class="flex-grow-1">
                        <input type="search" class="form-control" id="PkgPermSearch" placeholder="İzin ara…" autocomplete="off">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="PkgPermSelectAll">Tümünü seç</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="PkgPermClearAll">Tümünü kaldır</button>
                </div>
                <div class="alert alert-light border py-2 small mb-3">
                    <i class="fa fa-circle-info me-1 text-primary"></i>
                    Modül özellikleri (Finans, Hibe, AI…) bu seçimden <strong>otomatik türetilir</strong>;
                    ayrıca açmanız gerekmez.
                </div>
                <div id="PkgPermGroups"></div>
            </div>
            <div class="modal-footer">
                <span class="me-auto text-muted small" id="PkgPermCount"></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="PkgPermSaveBtn"><i class="fa fa-check me-1"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>
