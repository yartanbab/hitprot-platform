@page "/f/{slug}"
@model Apya.Platform.Web.Pages.F.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@Model.Slug</title>
    @* Layout=null: global stil bundle'ı yok — token tanımları + marka fontu elle yüklenir
       (style.css yalnız var(--apya-*) tüketir, tanımlamaz). *@
    <link rel="stylesheet" href="~/css/apya-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dynamic-assets/src/styles/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />
    <style>body { margin: 0; font-family: var(--apya-font-sans, system-ui), sans-serif; }</style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div id="public-form-root" data-slug="@Model.Slug"></div>
    <footer style="max-width:640px;margin:1.5rem auto 3rem;text-align:center;font-size:.8rem;color:var(--apya-text-muted,#6b7280);">
        <a href="/aydinlatma-metni" target="_blank" rel="noopener" style="color:var(--apya-primary,#4f46e5);">Aydınlatma Metni</a>
        &nbsp;·&nbsp;
        <a href="/gizlilik-politikasi" target="_blank" rel="noopener" style="color:var(--apya-primary,#4f46e5);">Gizlilik Politikası</a>
    </footer>
    <script type="module" src="~/js/public-form.js" asp-append-version="true"></script>
</body>
</html>
