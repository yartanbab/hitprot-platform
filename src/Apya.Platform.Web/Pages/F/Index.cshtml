@page "/f/{slug}"
@model Apya.Platform.Web.Pages.F.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@Model.Slug</title>
    @* Layout=null: global stil bundle'ı yok — token tanımları + marka fontu elle yüklenir
       (style.css yalnız var(--apya-*) tüketir, tanımlamaz). *@
    <link rel="stylesheet" href="~/css/apya-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dynamic-assets/src/styles/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />
    @* Font Awesome ve Bootstrap da yok. Ada hata kartının düğmeleri uygulamada Razor'la aynı Bootstrap sınıflarını
       taşır (btn btn-sm btn-outline-primary / btn-outline-secondary; "Tekrar dene"de <i class="fa … me-1">): burada
       karşılıklarını bu kurallar verir. Boş <i class="fa"> kenar boşluğuyla düğme yazısını kaydırmasın diye gizlenir. *@
    <style>
        body { margin: 0; font-family: var(--apya-font-sans, system-ui), sans-serif; }
        i.fa { display: none; }
        .btn { display: inline-flex; align-items: center; justify-content: center; height: 2rem; padding: 0 .75rem; border: 1px solid transparent; border-radius: var(--apya-radius-md, 6px); background: transparent; font-size: .875rem; font-weight: 500; line-height: 1.25rem; white-space: nowrap; cursor: pointer; }
        .btn:focus-visible { outline: none; box-shadow: var(--apya-shadow-focus); }
        .btn-outline-primary { border-color: var(--apya-accent-500); color: var(--apya-accent-500); }
        .btn-outline-primary:hover { background: var(--apya-accent-500); color: var(--apya-text-inverse); }
        .btn-outline-secondary { border-color: var(--apya-border-strong); color: var(--apya-text-primary); }
        .btn-outline-secondary:hover { background: var(--apya-surface-raised); }
    </style>
    <island-preload entry="public-form" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div id="public-form-root" data-slug="@Model.Slug"></div>
    <footer style="max-width:640px;margin:1.5rem auto 3rem;text-align:center;font-size:.8rem;color:var(--apya-text-muted,#6b7280);">
        <a href="/aydinlatma-metni" target="_blank" rel="noopener" style="color:var(--apya-primary,#4f46e5);">Aydınlatma Metni</a>
        &nbsp;·&nbsp;
        <a href="/gizlilik-politikasi" target="_blank" rel="noopener" style="color:var(--apya-primary,#4f46e5);">Gizlilik Politikası</a>
    </footer>
    <script type="module" src="~/js/public-form.js" asp-append-version="true"></script>
</body>
</html>
