@page
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.DynamicAssets.Webhooks.IndexModel
@{
    ViewBag.PageTitle = "Webhook Yönetimi";
}
@section scripts {
    <script>
        window.webhookFormNames = @Html.Raw(JsonSerializer.Serialize(Model.FormNames));
    </script>
    <abp-script src="/Pages/DynamicAssets/Webhooks/Index.js" />
}

<div class="apya-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <div class="apya-overline mb-1">Olay Abonelikleri ve Teslimat Logları</div>
            <h1 class="h3 fw-bold mb-1">Webhooks</h1>
            <p class="text-muted mb-0" style="max-width: 640px;">
                Formlarınıza yanıt geldiğinde belirttiğiniz URL'ye HMAC imzalı bildirim gönderilir.
                Teslimatları her abonelik için aşağıdan izleyebilir, gerekirse yeniden gönderebilirsiniz.
            </p>
        </div>
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.DynamicAssets.Create))
        {
            <button id="NewWebhookButton" class="btn btn-primary flex-shrink-0">
                <i class="fa fa-plus me-1"></i> Yeni Webhook
            </button>
        }
    </div>

    <div id="WebhookCardsContainer" class="d-flex flex-column gap-3"></div>

    <div id="WebhookEmptyState" class="text-center text-muted py-5 d-none">
        <i class="fa fa-bolt fa-2x mb-3 d-block opacity-50"></i>
        Henüz webhook aboneliğiniz yok.
    </div>
</div>
