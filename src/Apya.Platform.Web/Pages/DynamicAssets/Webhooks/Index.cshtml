@page
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Apya.Platform.Permissions
@inject IAuthorizationService AuthorizationService
@model Apya.Platform.Web.Pages.DynamicAssets.Webhooks.IndexModel
@{
    ViewBag.PageTitle = "Webhook Yönetimi";
}
@section scripts {
    <script>
        window.webhookFormNames = @Html.Raw(JsonSerializer.Serialize(Model.FormNames));
    </script>
    <abp-script src="/Pages/DynamicAssets/Webhooks/Index.js" />
}

@* Başlık + açıklama app header'da; sayfa içinde tekrarlanmıyor. *@
<div data-page-description="Olay abonelikleri ve teslimat logları · HMAC imzalı bildirim" class="apya-page">
    <div class="apya-page-head">
        <div class="apya-page-head-actions">
        @if (await AuthorizationService.IsGrantedAsync(PlatformPermissions.DynamicAssets.Create))
        {
            <button id="NewWebhookButton" class="btn btn-sm btn-primary">
                <i class="fa fa-plus me-1"></i> Yeni Webhook
            </button>
        }
        </div>
    </div>

    <div id="WebhookCardsContainer" class="d-flex flex-column gap-3"></div>

    <div id="WebhookEmptyState" class="text-center text-muted py-5 d-none">
        <i class="fa fa-bolt fa-2x mb-3 d-block opacity-50"></i>
        Henüz webhook aboneliğiniz yok.
    </div>
</div>
