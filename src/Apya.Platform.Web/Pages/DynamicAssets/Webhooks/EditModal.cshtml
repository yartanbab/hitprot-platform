@page
@model Apya.Platform.Web.Pages.DynamicAssets.Webhooks.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/DynamicAssets/Webhooks/EditModal")">
    <abp-input asp-for="Id" />
    <input type="hidden" asp-for="Subscription.DocumentId" />
    <abp-modal>
        <abp-modal-header title="Webhook Aboneliğini Düzenle"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Subscription.TargetUrl" label="Hedef URL (https://...)" />
            <abp-input asp-for="Subscription.Secret" label="Gizli Anahtar (güvenlik gereği tekrar girilmeli)"
                       placeholder="Kaydetmek için gizli anahtarı yeniden girin" />
            <abp-input asp-for="Subscription.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
