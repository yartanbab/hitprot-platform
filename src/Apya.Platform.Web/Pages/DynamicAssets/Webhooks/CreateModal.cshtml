@page
@model Apya.Platform.Web.Pages.DynamicAssets.Webhooks.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form method="post" action="@Url.Page("/DynamicAssets/Webhooks/CreateModal")">
    <abp-modal>
        <abp-modal-header title="Yeni Webhook Aboneliği"></abp-modal-header>
        <abp-modal-body>
            <abp-select asp-for="Subscription.DocumentId" asp-items="Model.Forms" label="Form" />
            <abp-input asp-for="Subscription.TargetUrl" label="Hedef URL (https://...)"
                       placeholder="https://example.com/webhooks/apya" />
            <abp-input asp-for="Subscription.Secret" label="Gizli Anahtar (HMAC imza için)"
                       placeholder="örn. wh_secret_..." />
            <abp-input asp-for="Subscription.IsActive" label="Aktif" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
