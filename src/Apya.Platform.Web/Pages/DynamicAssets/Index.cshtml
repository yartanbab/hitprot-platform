@page
@model Apya.Platform.Web.Pages.DynamicAssets.IndexModel
@{
    ViewBag.Title = "Formlar";
}

<link rel="stylesheet" href="~/js/style.css" asp-append-version="true" />
<island-preload entry="forms" />

@Html.AntiForgeryToken()

<div data-page-description="Dinamik form tanımları" class="apya-page">
    <div class="text-end mb-2">
        @await Html.PartialAsync("/Pages/Shared/_FeedbackLink.cshtml",
            new Apya.Platform.Web.Feedbacks.FeedbackLinkContext(Module: "DynamicAssets", Component: "FormList"))
    </div>
    <div class="card">
        <div class="card-body">
            <div id="forms-list-root"></div>
        </div>
    </div>
</div>

<script type="module" src="~/js/forms.js" asp-append-version="true"></script>
