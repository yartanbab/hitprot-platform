@page "/Settings/Menu"
@model Apya.Platform.Web.Pages.Settings.MenuModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@using Apya.Platform.Web.Menus
@using Apya.Platform.Settings
@{
    ViewBag.Title = L["MenuLayout:Title"].Value;
}

@*
    İki sütun AYNI ağaç markup'ını kullanır: taşınan <li> DOM'da olduğu gibi öbür
    sütuna geçer, düğme cerrahisi gerekmez. Hangi ok görüneceğini sütunun
    [data-nav-side] değeri CSS'te belirler (apya-shell.css §25).

    Gruplar da taşınabilir (kategoriyi bütün hâlinde indirme) ve her madde her
    gruba sürüklenebilir; tek kısıt grubu grubun İÇİNE bırakmamak — LeptonX'in
    bastığı derinlik üç seviye.
*@
@functions {
    void RenderNode(Apya.Platform.Web.Pages.Settings.MenuModel.NavNode node)
    {
        <li class="apya-navedit-item @(node.IsGroup ? "apya-navedit-item--group" : "")"
            data-nav-node="@node.Name"
            data-nav-kind="@(node.IsGroup ? "group" : "leaf")"
            data-nav-locked="@(node.IsLocked ? "true" : "false")"
            data-nav-admin="@(node.IsAdminLink ? "true" : "false")"
            data-nav-custom="@(node.IsCustom ? (node.IsGroup ? "group" : "link") : "")"
            data-nav-title="@node.Title"
            data-nav-icon="@node.Icon"
            data-nav-url="@node.Url"
            @* Gizlenenler bölmesindeki KÖK satırlar nereden geldiklerini taşır;
               olmadan "geri getir" hepsini kenar çubuğunun köküne bırakırdı.
               Diğer satırlarda boş kalır — Menu.js'teki listByKey boş anahtarı
               zaten null sayıyor, ayrıca koşullu basmaya gerek yok. *@
            data-nav-from="@node.From">
            <div class="apya-navedit-row">
                @if (node.IsLocked)
                {
                    <span class="apya-navedit-handle apya-navedit-handle--locked" aria-hidden="true">
                        <i class="fa fa-lock"></i>
                    </span>
                }
                else
                {
                    <span class="apya-navedit-handle" title="@L["MenuLayout:Drag"]" aria-hidden="true">
                        <i class="fa fa-grip-vertical"></i>
                    </span>
                }
                <i class="apya-navedit-icon @node.Icon" aria-hidden="true"></i>
                <span class="apya-navedit-title">@node.Title</span>

                @if (node.IsLocked)
                {
                    <span class="apya-navedit-locked-hint">@L["MenuLayout:LockedHint"]</span>
                }
                else
                {
                    <span class="apya-navedit-actions">
                        <button type="button" class="apya-navedit-btn" data-nav-up
                                aria-label="@L["MenuLayout:MoveUp"]" title="@L["MenuLayout:MoveUp"]">
                            <i class="fa fa-chevron-up" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="apya-navedit-btn" data-nav-down
                                aria-label="@L["MenuLayout:MoveDown"]" title="@L["MenuLayout:MoveDown"]">
                            <i class="fa fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="apya-navedit-btn apya-navedit-btn--move" data-nav-to-settings
                                aria-label="@L["MenuLayout:MoveToSettings"]" title="@L["MenuLayout:MoveToSettings"]">
                            <i class="fa fa-arrow-right" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="apya-navedit-btn apya-navedit-btn--move" data-nav-to-sidebar
                                aria-label="@L["MenuLayout:MoveToSidebar"]" title="@L["MenuLayout:MoveToSidebar"]">
                            <i class="fa fa-arrow-left" aria-hidden="true"></i>
                        </button>

                        @* Yalnız kullanıcının kendi kurduğu satırlar düzenlenip silinebilir:
                           koddan gelen bir öğenin adını değiştirmek yerelleştirmeyi kırar,
                           silmek ise "gizle" ile zaten karşılanıyor. *@
                        @if (node.IsCustom)
                        {
                            <button type="button" class="apya-navedit-btn" data-nav-edit
                                    aria-label="@L["MenuLayout:Edit"]" title="@L["MenuLayout:Edit"]">
                                <i class="fa fa-pen" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="apya-navedit-btn apya-navedit-btn--danger" data-nav-delete
                                    aria-label="@L["MenuLayout:Delete"]" title="@L["MenuLayout:Delete"]">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        }

                        <button type="button" class="apya-navedit-btn" data-nav-hide
                                aria-label="@L["MenuLayout:Hide"]" title="@L["MenuLayout:Hide"]">
                            <i class="fa fa-eye-slash" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="apya-navedit-btn" data-nav-show
                                aria-label="@L["MenuLayout:Show"]" title="@L["MenuLayout:Show"]">
                            <i class="fa fa-eye" aria-hidden="true"></i>
                        </button>
                    </span>
                }
            </div>

            @if (node.IsGroup)
            {
                <ul class="apya-navedit-list apya-navedit-list--inner" data-nav-list="@node.Name">
                    @foreach (var child in node.Children)
                    {
                        RenderNode(child);
                    }
                    <li class="apya-navedit-empty">@L["MenuLayout:Empty"]</li>
                </ul>
            }
        </li>
    }
}

<div data-page-description="@L["MenuLayout:PageDescription"]">
    @if (TempData["Saved"] != null)
    {
        <div class="alert alert-success" role="status">@L["MenuLayout:Saved"]</div>
    }

    <form method="post" id="ApyaMenuEditor">
        @* Tarayıcı DOM'dan kurar; sunucuda MenuLayout.Parse normalize eder. *@
        <input type="hidden" asp-for="LayoutJson" id="ApyaMenuLayoutJson" />

        @* Adet tavanları SUNUCUNUN sınırlarıdır (MenuLayout.Normalize). Ekrana
           taşınmasalardı 11. kategori sessizce kırpılır, kullanıcı ad+ikon+hedef
           yazıp "kaydedildi" gördükten sonra kaybını ancak menüde fark ederdi. *@
        <div class="apya-navedit-toolbar"
             data-nav-max-group="@PlatformSettingDefaults.ShellMenuLayoutCustomGroupMax"
             data-nav-max-link="@PlatformSettingDefaults.ShellMenuLayoutCustomLinkMax"
             data-nav-limit-group="@L["MenuLayout:LimitGroup", PlatformSettingDefaults.ShellMenuLayoutCustomGroupMax]"
             data-nav-limit-link="@L["MenuLayout:LimitLink", PlatformSettingDefaults.ShellMenuLayoutCustomLinkMax]">
            <button type="button" class="btn btn-outline-primary btn-sm" data-nav-new="group">
                <i class="fa fa-folder-plus me-1" aria-hidden="true"></i>@L["MenuLayout:NewGroup"]
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-nav-new="link">
                <i class="fa fa-link me-1" aria-hidden="true"></i>@L["MenuLayout:NewLink"]
            </button>

            @* Tek form üç iş görür: kategori ekle, kısayol ekle, ikisini düzenle.
               Ayrı ayrı üç form basmak aynı alanları üç kez çoğaltırdı. *@
            <div class="apya-navedit-form" id="ApyaNavForm" hidden>
                <label class="visually-hidden" for="ApyaNavFormTitle">@L["MenuLayout:FormTitle"]</label>
                <input type="text" id="ApyaNavFormTitle" class="form-control form-control-sm"
                       maxlength="40" placeholder="@L["MenuLayout:FormTitle"]"
                       data-required="@L["MenuLayout:FormTitleRequired"]" />

                <label class="visually-hidden" for="ApyaNavFormIcon">@L["MenuLayout:FormIcon"]</label>
                <select id="ApyaNavFormIcon" class="form-select form-select-sm">
                    @* Etiket ÇEVİRİLİR: sınıf adının İngilizce parçasını basmak
                       ("shield-halved") Türkçe arayüzde anlaşılmaz bir seçenek
                       listesi bırakıyordu. Anahtar ikon adından türetiliyor. *@
                    @foreach (var icon in Model.IconChoices)
                    {
                        <option value="@icon">@L["MenuLayout:Icon." + icon.Replace("fa fa-", "")]</option>
                    }
                </select>
                <i class="apya-navedit-icon" id="ApyaNavFormPreview" aria-hidden="true"></i>

                <label class="visually-hidden" for="ApyaNavFormUrl">@L["MenuLayout:FormUrl"]</label>
                <input type="text" id="ApyaNavFormUrl" class="form-control form-control-sm"
                       maxlength="200" placeholder="@L["MenuLayout:FormUrl"]"
                       data-invalid="@L["MenuLayout:FormUrlInvalid"]" hidden />

                <button type="button" class="btn btn-primary btn-sm" id="ApyaNavFormSave">@L["MenuLayout:FormSave"]</button>
                <button type="button" class="btn btn-link btn-sm" id="ApyaNavFormCancel">@L["MenuLayout:FormCancel"]</button>
                <span class="apya-navedit-form-error" id="ApyaNavFormError" role="alert"></span>
            </div>
        </div>

        @*
            Yeni satırı JS elle kurmuyor: şablonu AYNI RenderNode üretiyor.
            Elle kurulsaydı markup iki yerde yaşar ve er geç ayrışırdı (bu repoda
            "test DOM'u partial'dan ayrıştı" vakası zaten yaşandı).
        *@
        @{
            var templateChildren = new List<Apya.Platform.Web.Pages.Settings.MenuModel.NavNode>();
        }
        <template id="ApyaNavGroupTemplate">
            <ul>
                @{
                    RenderNode(new Apya.Platform.Web.Pages.Settings.MenuModel.NavNode(
                        "__NAME__", "__TITLE__", MenuIcons.Default,
                        IsGroup: true, IsLocked: false, IsAdminLink: false,
                        IsCustom: true, Url: string.Empty, From: string.Empty, templateChildren));
                }
            </ul>
        </template>
        <template id="ApyaNavLinkTemplate">
            <ul>
                @{
                    RenderNode(new Apya.Platform.Web.Pages.Settings.MenuModel.NavNode(
                        "__NAME__", "__TITLE__", MenuIcons.Default,
                        IsGroup: false, IsLocked: false, IsAdminLink: false,
                        IsCustom: true, Url: "__URL__", From: string.Empty, templateChildren));
                }
            </ul>
        </template>

        <div class="row g-3">
            <div class="col-lg-6">
                <abp-card>
                    <abp-card-header>
                        <abp-card-title>@L["MenuLayout:Sidebar"]</abp-card-title>
                    </abp-card-header>
                    <abp-card-body>
                        <div class="form-text mb-3">@L["MenuLayout:SidebarHelp"]</div>
                        <div data-nav-side="sidebar">
                            <ul class="apya-navedit-list apya-navedit-list--root" data-nav-root="sidebar">
                                @foreach (var node in Model.Sidebar)
                                {
                                    RenderNode(node);
                                }
                                <li class="apya-navedit-empty">@L["MenuLayout:Empty"]</li>
                            </ul>
                        </div>
                    </abp-card-body>
                </abp-card>
            </div>

            <div class="col-lg-6">
                <abp-card>
                    <abp-card-header>
                        <abp-card-title>@L["MenuLayout:SettingsColumn"]</abp-card-title>
                    </abp-card-header>
                    <abp-card-body>
                        <div class="form-text mb-3">@L["MenuLayout:SettingsHelp"]</div>
                        <div data-nav-side="settings">
                            <ul class="apya-navedit-list apya-navedit-list--root" data-nav-root="settings">
                                @foreach (var node in Model.SettingsColumn)
                                {
                                    RenderNode(node);
                                }
                                <li class="apya-navedit-empty">@L["MenuLayout:Empty"]</li>
                            </ul>
                        </div>
                    </abp-card-body>
                </abp-card>
            </div>
        </div>

        <abp-card class="mt-3">
            <abp-card-header>
                <abp-card-title>@L["MenuLayout:Hidden"]</abp-card-title>
            </abp-card-header>
            <abp-card-body>
                <div class="form-text mb-3">@L["MenuLayout:HiddenHelp"]</div>
                <div data-nav-side="hidden">
                    <ul class="apya-navedit-list apya-navedit-list--root" data-nav-root="hidden">
                        @foreach (var node in Model.HiddenItems)
                        {
                            RenderNode(node);
                        }
                        <li class="apya-navedit-empty">@L["MenuLayout:Empty"]</li>
                    </ul>
                </div>
            </abp-card-body>
        </abp-card>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary">@L["MenuLayout:Save"]</button>
            <a href="/Settings" class="btn btn-link">@L["MenuLayout:Back"]</a>
            @if (Model.HasCustomLayout)
            {
                <button type="submit" asp-page-handler="Reset" class="btn btn-outline-secondary ms-auto">
                    @L["MenuLayout:Reset"]
                </button>
            }
        </div>
    </form>
</div>

@section scripts {
    <script src="~/libs/sortablejs/Sortable.min.js"></script>
    <abp-script src="/Pages/Settings/Menu.js" />
}
