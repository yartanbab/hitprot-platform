@page "/Settings"
@model Apya.Platform.Web.Pages.Settings.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Apya.Platform.Localization.PlatformResource> L
@{
    ViewBag.Title = L["Settings:Title"].Value;
}

<div data-page-description="@L["Settings:PageDescription"]" class="apya-page--narrow">
<abp-card>
    <abp-card-header>
        <abp-card-title>@L["Settings:Title"]</abp-card-title>
    </abp-card-header>
    <abp-card-body>
        @if (TempData["Saved"] != null)
        {
            <div class="alert alert-success" role="status">@L["Settings:Saved"]</div>
        }

        <form method="post">
            <fieldset class="mb-3">
                <legend class="form-label mb-1">@L["Settings:TaskDetailUi.Label"]</legend>
                <div class="form-text mb-2">@L["Settings:TaskDetailUi.Help"]</div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="TaskDetailUi" id="taskui-v3"
                           value="v3" checked="@(Model.TaskDetailUi != "v1" && Model.TaskDetailUi != "v2")" />
                    <label class="form-check-label" for="taskui-v3">
                        <strong>@L["Settings:TaskDetailUi.V3"]</strong>
                        <div class="text-muted small">@L["Settings:TaskDetailUi.V3.Desc"]</div>
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="TaskDetailUi" id="taskui-v2"
                           value="v2" checked="@(Model.TaskDetailUi == "v2")" />
                    <label class="form-check-label" for="taskui-v2">
                        <strong>@L["Settings:TaskDetailUi.V2"]</strong>
                        <div class="text-muted small">@L["Settings:TaskDetailUi.V2.Desc"]</div>
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TaskDetailUi" id="taskui-v1"
                           value="v1" checked="@(Model.TaskDetailUi == "v1")" />
                    <label class="form-check-label" for="taskui-v1">
                        <strong>@L["Settings:TaskDetailUi.V1"]</strong>
                        <div class="text-muted small">@L["Settings:TaskDetailUi.V1.Desc"]</div>
                    </label>
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="form-label mb-1">@L["Settings:ProjectsView.Label"]</legend>
                <div class="form-text mb-2">@L["Settings:ProjectsView.Help"]</div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="ProjectsDefaultView" id="projview-card"
                           value="card" checked="@(Model.ProjectsDefaultView != "list")" />
                    <label class="form-check-label" for="projview-card">
                        <strong>@L["Settings:ProjectsView.Card"]</strong>
                        <div class="text-muted small">@L["Settings:ProjectsView.Card.Desc"]</div>
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="ProjectsDefaultView" id="projview-list"
                           value="list" checked="@(Model.ProjectsDefaultView == "list")" />
                    <label class="form-check-label" for="projview-list">
                        <strong>@L["Settings:ProjectsView.List"]</strong>
                        <div class="text-muted small">@L["Settings:ProjectsView.List.Desc"]</div>
                    </label>
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="form-label mb-1">@L["Settings:ProjectsDetailPanel.Label"]</legend>
                <div class="form-text mb-2">@L["Settings:ProjectsDetailPanel.Help"]</div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" name="ProjectsDetailPanel"
                           id="projpanel-toggle" value="true" checked="@Model.ProjectsDetailPanel" />
                    <label class="form-check-label" for="projpanel-toggle">
                        <strong>@L["Settings:ProjectsDetailPanel.Switch"]</strong>
                        <div class="text-muted small">@L["Settings:ProjectsDetailPanel.Switch.Desc"]</div>
                    </label>
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="form-label mb-1">@L["Settings:TaskCreate.Label"]</legend>
                <div class="form-text mb-2">@L["Settings:TaskCreate.Help"]</div>

                @if (Model.QuickEntryAvailable)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="TaskCreateDefaultMode" id="tcmode-quick"
                               value="quick" checked="@(Model.TaskCreateDefaultMode != "form")" />
                        <label class="form-check-label" for="tcmode-quick">
                            <strong>@L["Settings:TaskCreate.Quick"]</strong>
                            <div class="text-muted small">@L["Settings:TaskCreate.Quick.Desc"]</div>
                        </label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="TaskCreateDefaultMode" id="tcmode-form"
                               value="form" checked="@(Model.TaskCreateDefaultMode == "form")" />
                        <label class="form-check-label" for="tcmode-form">
                            <strong>@L["Settings:TaskCreate.Form"]</strong>
                            <div class="text-muted small">@L["Settings:TaskCreate.Form.Desc"]</div>
                        </label>
                    </div>
                }
                else
                {
                    @* Paket ya da izin kapalı: seçim anlamsız, sebebi yazılıyor —
                       ayarın sessizce yok olması "bozuk" hissi veriyor. *@
                    <div class="alert alert-light border small mb-3" role="note">
                        @L["Settings:TaskCreate.Unavailable"]
                    </div>
                }

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" name="TaskCreateShowKeyboardHints"
                           id="tchints-toggle" value="true" checked="@Model.TaskCreateShowKeyboardHints" />
                    <label class="form-check-label" for="tchints-toggle">
                        <strong>@L["Settings:TaskCreate.Hints"]</strong>
                        <div class="text-muted small">@L["Settings:TaskCreate.Hints.Desc"]</div>
                    </label>
                </div>
            </fieldset>

            @if (Model.CanManageTenantSettings)
            {
                <fieldset class="mb-3">
                    <legend class="form-label mb-1">@L["Settings:TaskCreate.Tenant.Label"]</legend>
                    <div class="form-text mb-2">@L["Settings:TaskCreate.Tenant.Help"]</div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" name="TaskCreateShowInfoBanner"
                               id="tcbanner-toggle" value="true" checked="@Model.TaskCreateShowInfoBanner" />
                        <label class="form-check-label" for="tcbanner-toggle">
                            <strong>@L["Settings:TaskCreate.Banner"]</strong>
                            <div class="text-muted small">@L["Settings:TaskCreate.Banner.Desc"]</div>
                        </label>
                    </div>
                </fieldset>
            }

            <button type="submit" class="btn btn-primary">@L["Settings:Save"]</button>
        </form>

        @*
            Mobil gezinme — sunucuya GİTMEZ, bu yüzden yukarıdaki formun DIŞINDA.
            Kenar çubuğu modu ile aynı desen: kaynak <html data-mobile-shell>,
            kalıcılık localStorage 'apya-mobile-shell', uygulama sidebar-toggle.js
            (seçim anında yazılır, "Kaydet" gerekmez).
        *@
        <fieldset class="mt-4" id="MobileShellChooser">
            <legend class="form-label mb-1">@L["Settings:MobileShell.Label"]</legend>
            <div class="form-text mb-2">@L["Settings:MobileShell.Help"]</div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="MobileShell" id="mshell-drawer"
                       value="drawer" data-mobile-shell="drawer" />
                <label class="form-check-label" for="mshell-drawer">
                    <strong>@L["Settings:MobileShell.Drawer"]</strong>
                    <div class="text-muted small">@L["Settings:MobileShell.Drawer.Desc"]</div>
                </label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="MobileShell" id="mshell-tabs"
                       value="tabs" data-mobile-shell="tabs" />
                <label class="form-check-label" for="mshell-tabs">
                    <strong>@L["Settings:MobileShell.Tabs"]</strong>
                    <div class="text-muted small">@L["Settings:MobileShell.Tabs.Desc"]</div>
                </label>
            </div>
        </fieldset>
    </abp-card-body>
</abp-card>

@*
    Yönetim hedefleri — eski YÖNETİM menü bölümünün gittiği yer (kabuk handoff'u
    2026-08-13). Sekme değil bağlantı: ABP modül sayfaları kendi route'larında
    kalır. Yetkisi olmayan kullanıcıda liste boş döner ve kart hiç basılmaz.
*@
@if (Model.AdminLinks.Count > 0)
{
    <abp-card class="mt-3">
        <abp-card-header>
            <abp-card-title>@L["Settings:Admin.Title"]</abp-card-title>
        </abp-card-header>
        <abp-card-body>
            <div class="form-text mb-3">@L["Settings:Admin.Help"]</div>
            <ul class="apya-settings-links">
                @foreach (var link in Model.AdminLinks)
                {
                    <li>
                        <a href="@link.Url" class="apya-settings-link">
                            <span class="kpi-icon-box kpi-icon-box--sm kpi-icon-box--neutral" aria-hidden="true">
                                <i class="@link.Icon"></i>
                            </span>
                            <span class="apya-settings-link-text">
                                <span class="apya-settings-link-title">@link.Title</span>
                                <span class="apya-settings-link-desc">@link.Description</span>
                            </span>
                            <i class="fa fa-chevron-right apya-settings-link-chevron" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        </abp-card-body>
    </abp-card>
}
</div>
