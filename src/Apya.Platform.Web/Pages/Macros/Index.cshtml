@page "/Makro"
@using Apya.Platform.Localization
@using Apya.Platform.Web.Pages.Shared
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<PlatformResource> L
@model Apya.Platform.Web.Pages.Macros.IndexModel
@{
    ViewBag.Title = L["Menu:Macros"].Value;
}

@section styles {
    <abp-style src="/Pages/Macros/Index.css" />
}

@section scripts {
    <abp-script src="/Pages/Macros/Index.js" />
    <abp-script src="/Pages/Macros/Panels.js" />
    <abp-script src="/Pages/Grants/Poster.js" />
    <abp-script src="/Pages/Macros/NewsBanner.js" />
}

@* Hibe satırlarının durum etiketi/tonu hibe ekranlarıyla aynı katalogdan (GrantStatusCatalog). *@
@if (Model.RecordGroups.Contains("interests"))
{
    <partial name="/Pages/Grants/_StatusMap.cshtml" />
}

@* Makro Ekran — tasarım docs/design/makro-ekran (1a). Adres Türkçe (/Makro), klasör alan kuralıyla
   Pages/Macros. Kartlar sunucuda basılır; Index.js tıklamayı ve sabitlemeyi, Panels.js panelleri yönetir. *@
<div data-page-description="@L["Macros:Description"]" class="apya-page apya-macros" id="ApyaMacros">
    @* Haber şeridi: en fazla 5 haber, istemcide dolar (IMacroNewsAppService). Haber yoksa kalkar. *@
    <section class="apya-macros-news" id="MacrosNews" aria-roledescription="carousel"
             aria-label="@L["Macros:News:Title"]" hidden>
        <div class="apya-macros-news-stage" data-news-stage aria-live="polite"></div>
        <button type="button" class="apya-macros-news-arrow is-prev" data-news-prev aria-label="@L["Macros:News:Prev"]">
            <i class="fa fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="apya-macros-news-arrow is-next" data-news-next aria-label="@L["Macros:News:Next"]">
            <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="apya-macros-news-dots" data-news-dots></div>
    </section>
    <div class="apya-macros-main has-panels @(Model.RecordGroups.Any() ? "has-records" : "")">
        <div class="apya-macros-col">
            @if (!Model.Screen.Items.Any())
            {
                <partial name="_EmptyState" model='new EmptyStateModel { Icon = "fa-bolt", Title = L["Macros:Empty:Title"].Value, Description = L["Macros:Empty:Description"].Value }' />
            }
            else
            {
                <script type="application/json" id="apya-macro-pins">@Html.Raw(Model.PinStateJson)</script>

                <section aria-labelledby="MacrosForYouHeading">
                    <div class="apya-macros-section-head">
                        <h2 class="apya-overline" id="MacrosForYouHeading">@L["Macros:ForYou"]</h2>
                        <span class="apya-chip apya-chip-accent">@L["Macros:ForYouPinnedFirst"]</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary apya-macros-edit" aria-pressed="false">
                            <i class="fa fa-thumbtack me-1" aria-hidden="true"></i><span>@L["Macros:Edit"]</span>
                        </button>
                    </div>
                    <p class="apya-macros-edit-hint" hidden>@L["Macros:EditHint"]</p>
                    <div class="apya-macro-grid" data-macro-grid="for-you">
                        @foreach (var item in Model.ForYou)
                        {
                            <partial name="_MacroCard" model="item" />
                        }
                    </div>
                </section>

                <section aria-labelledby="MacrosAllHeading" hidden="@(!Model.Rest.Any())">
                    <div class="apya-macros-section-head">
                        <h2 class="apya-overline" id="MacrosAllHeading">@L["Macros:All"]</h2>
                        <span class="apya-macros-count">@L["Macros:Count", Model.Rest.Count]</span>
                    </div>
                    <div class="apya-macro-grid" data-macro-grid="rest">
                        @foreach (var item in Model.Rest)
                        {
                            <partial name="_MacroCard" model="item" />
                        }
                    </div>
                </section>
            }
        </div>

        @* Paneller kendi içinde kayar: kabın satır yüksekliğini sol sütun belirler (absolute iç panel). *@
        <div class="apya-macros-panel-slot">
            <section class="apya-macros-panel" id="MacrosNotifications" aria-labelledby="MacrosNotificationsHeading">
                <div class="apya-macros-panel-head">
                    <h2 class="apya-macros-panel-title" id="MacrosNotificationsHeading">@L["Macros:Notifications"]</h2>
                    <span class="apya-macros-bubble" data-unread hidden></span>
                    <span class="apya-macros-panel-note">@L["Macros:Notifications:Newest"]</span>
                    <a class="apya-macros-panel-link" href="/Notifications">@L["Macros:Notifications:All"]</a>
                </div>
                <div class="apya-macros-panel-body" data-panel-body aria-live="polite"></div>
            </section>
        </div>

        @if (Model.RecordGroups.Any())
        {
            <div class="apya-macros-panel-slot">
                <section class="apya-macros-panel" id="MacrosRecords" aria-labelledby="MacrosRecordsHeading"
                         data-groups="@string.Join(",", Model.RecordGroups)">
                    <div class="apya-macros-panel-head">
                        <h2 class="apya-macros-panel-title" id="MacrosRecordsHeading">@L["Macros:Records"]</h2>
                    </div>
                    <div class="apya-macros-panel-body" data-panel-body aria-live="polite"></div>
                </section>
            </div>
        }
    </div>

    @if (Model.PendingSources.Any())
    {
        <section class="apya-macros-pending" id="MacrosPending" aria-labelledby="MacrosPendingHeading"
                 data-sources="@string.Join(",", Model.PendingSources)">
            <div class="apya-macros-pending-head">
                <h2 class="apya-macros-panel-title" id="MacrosPendingHeading">@L["Macros:Pending"]</h2>
                <span class="apya-chip apya-chip-warning" data-pending-total hidden></span>
            </div>
            <div class="apya-macros-pending-grid" data-panel-body aria-live="polite"></div>
        </section>
    }
</div>
