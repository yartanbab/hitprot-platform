@page
@model Apya.Platform.Web.Pages.Calendars.IndexModel
@{
    ViewBag.Title = "Takvim";
}

@* Tailwind island stylesheet (js/style.css) — bu partial olmadan island stilsiz kalır. *@
<partial name="_ApyaThemeBootstrap" />

@*
    Takvim tamamen React island (dynamic-assets/src/calendar.jsx).
    Veri iki uçtan gelir: /api/app/calendar/feed (iç kaynaklar) ve
    /api/app/calendar/external-events (bağlı Google/Outlook hesapları).

    Entegrasyon kartları sayfanın ALTINDAN senkron drawer'ına taşındı (Faz 5):
    kartlar altta dururken kullanıcı takvimi kaydırmadan senkron durumunu
    göremiyordu. Drawer kaynak rayındaki "Ayarlar"dan açılır, takvim bağlamı
    ekranda kalır. Hesap bağlama akışı (SimulateAuth/Callback) değişmedi.
*@
<div data-page-description="Görev, fatura, hibe ve finans tarihleri tek takvimde" class="apya-page">
    <div id="apya-calendar-root"></div>
</div>

<script type="module" src="~/js/calendar.js" asp-append-version="true"></script>

@section scripts {
    @* Bağlantı sonucu bildirimi (?msg=success|error) — hesap bağlama akışı buradan geçer. *@
    <abp-script src="/Pages/Calendars/index.js" />
}
