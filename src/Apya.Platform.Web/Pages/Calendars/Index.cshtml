@page
@model Apya.Platform.Web.Pages.Calendars.IndexModel
@{
    ViewBag.Title = "Takvim";
}

<style>
    /* ── Aylık takvim (HANDOFF: 7 kolonlu grid, renk-kodlu event pill'leri,
       gün pop-over'ı, "Bu Hafta" ajandası) — tamamen token-driven. ── */
    .apya-cal-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
    .apya-cal-title { font-size: 15px; font-weight: 650; color: var(--apya-text-primary); margin: 0 0 0 6px; text-transform: capitalize; }
    .apya-cal-legend { display: flex; gap: 14px; font-size: 11.5px; color: var(--apya-text-secondary); }
    .apya-cal-legend i { display: inline-block; width: 8px; height: 8px; border-radius: 99px; margin-right: 5px; }

    .apya-cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border: 1px solid var(--apya-border-default); border-radius: var(--apya-radius-lg); overflow: hidden; position: relative; }
    .apya-cal-dow { padding: 8px 10px; background: var(--apya-surface-raised); border-bottom: 1px solid var(--apya-border-default); font-size: 10.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--apya-text-tertiary); text-align: right; }
    .apya-cal-day { min-height: 92px; padding: 6px; border-bottom: 1px solid var(--apya-border-subtle); border-right: 1px solid var(--apya-border-subtle); background: var(--apya-surface-base); cursor: pointer; transition: background var(--apya-motion-fast) ease; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .apya-cal-day:nth-child(7n) { border-right: 0; }
    .apya-cal-day:hover { background: var(--apya-surface-raised); }
    .apya-cal-day.is-other { background: var(--apya-surface-sunken); }
    .apya-cal-day.is-other .apya-cal-num { color: var(--apya-text-disabled); }
    .apya-cal-num { align-self: flex-end; font-size: 11.5px; font-weight: 600; color: var(--apya-text-secondary); font-variant-numeric: tabular-nums; line-height: 1; padding: 3px 5px; border-radius: 99px; }
    .apya-cal-day.is-today .apya-cal-num { background: var(--apya-accent-500); color: #fff; }

    .apya-cal-pill { display: block; width: 100%; padding: 2px 7px; border: 0; border-radius: 6px; font-size: 10.5px; font-weight: 600; line-height: 1.5; text-align: left; color: var(--apya-text-primary); background: color-mix(in srgb, var(--apya-accent-500) 14%, transparent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
    .apya-cal-pill.tone-negative { background: color-mix(in srgb, var(--apya-negative-500) 14%, transparent); }
    .apya-cal-pill.tone-positive { background: color-mix(in srgb, var(--apya-positive-500) 14%, transparent); }
    .apya-cal-pill.is-done { text-decoration: line-through; opacity: .65; }
    .apya-cal-more { border: 0; background: none; padding: 0 7px; font-size: 10.5px; font-weight: 600; color: var(--apya-accent-500); text-align: left; cursor: pointer; }

    /* fixed: grid'in overflow:hidden'ından etkilenmesin (alt satır pop-over'ları kırpılmasın) */
    .apya-cal-popover { position: fixed; z-index: var(--apya-z-popover, 1030); width: 280px; background: var(--apya-surface-elevated, var(--apya-surface-base)); border: 1px solid var(--apya-border-default); border-radius: var(--apya-radius-xl); box-shadow: var(--apya-shadow-lg); padding: 12px; }
    .apya-cal-popover-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 12.5px; font-weight: 650; color: var(--apya-text-primary); }
    .apya-cal-popover-close { border: 0; background: none; color: var(--apya-text-tertiary); cursor: pointer; padding: 2px 6px; }
    .apya-cal-popover .apya-cal-pill { margin-bottom: 4px; white-space: normal; }

    .apya-agenda-day { padding: 8px 0; border-bottom: 1px solid var(--apya-border-subtle); }
    .apya-agenda-day:last-child { border-bottom: 0; }
    .apya-agenda-date { font-size: 10.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--apya-text-tertiary); margin-bottom: 5px; }
    .apya-agenda-date.is-today { color: var(--apya-accent-500); }
    .apya-agenda-empty { padding: 28px 8px; text-align: center; color: var(--apya-text-tertiary); font-size: 12.5px; }

    /* ── Entegrasyon kartları (mevcut) — token-driven. ── */
    .calendar-card { border-radius: var(--apya-radius-xl); border: 1px solid var(--apya-border-default); background: var(--apya-surface-base); box-shadow: var(--apya-shadow-sm); transition: transform var(--apya-motion-base) ease, box-shadow var(--apya-motion-base) ease; padding: 20px 22px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; }
    .calendar-card:hover { transform: translateY(-3px); box-shadow: var(--apya-shadow-md); }
    .provider-info { display: flex; align-items: center; }
    .provider-logo { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: var(--apya-radius-lg); margin-right: 16px; font-size: 1.35rem; color: #fff; }
    .logo-google { background: #ea4335; }
    .logo-outlook { background: #0078d4; }
    .connected-email { font-size: 0.85rem; color: var(--apya-text-secondary); margin-top: 4px; }
    .provider-name { font-weight: 700; font-size: 1.05rem; color: var(--apya-text-primary); margin-bottom: 2px; }
</style>

<div data-page-description="Takvim entegrasyonları" class="apya-page">
    <div class="row g-3">
        @* ── Aylık takvim ── *@
        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="apya-cal-head">
                        <div class="d-flex align-items-center">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Ay gezinme">
                                <button type="button" id="cal-prev" class="btn btn-outline-secondary" title="Önceki ay"><i class="fa fa-chevron-left"></i></button>
                                <button type="button" id="cal-today" class="btn btn-outline-secondary">Bugün</button>
                                <button type="button" id="cal-next" class="btn btn-outline-secondary" title="Sonraki ay"><i class="fa fa-chevron-right"></i></button>
                            </div>
                            <h5 class="apya-cal-title" id="cal-title"></h5>
                        </div>
                        <div class="apya-cal-legend">
                            <span><i style="background:var(--apya-accent-500)"></i>Görev</span>
                            <span id="cal-legend-invoice"><i style="background:var(--apya-negative-500)"></i>Fatura</span>
                        </div>
                    </div>
                    <div class="apya-cal-grid" id="cal-grid" aria-live="polite"></div>
                </div>
            </div>
        </div>

        @* ── Bu Hafta ajandası ── *@
        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title mb-3"><i class="fa fa-list-ul me-2 text-muted"></i>Bu Hafta</h6>
                    <div id="cal-agenda"></div>
                </div>
            </div>
        </div>
    </div>

    @* ── Dış takvim entegrasyonları ── *@
    <div class="row justify-content-center mt-4">
        <div class="col-12 col-lg-8">
            <h6 class="apya-overline mb-1">Dış Takvimler</h6>
            <p class="text-muted small mb-3">Görevlerinizi ve planlarınızı dış takvimlerinizle senkronize edin.</p>

            <div id="CalendarManagerArea">
                <!-- GOOGLE CARD -->
                <div class="calendar-card" id="CardGoogle">
                    <div class="provider-info">
                        <div class="provider-logo logo-google">
                            <i class="fab fa-google"></i>
                        </div>
                        <div>
                            <h5 class="provider-name">Google Calendar</h5>
                            <div class="status-area">
                                <span class="apya-chip apya-chip-neutral status-badge">Bağlı Değil</span>
                            </div>
                        </div>
                    </div>
                    <div class="action-area">
                        <button class="btn btn-outline-primary btn-connect" data-provider="1">
                            <i class="fa fa-link me-2"></i>Hesap Bağla
                        </button>
                    </div>
                </div>

                <!-- OUTLOOK CARD -->
                <div class="calendar-card" id="CardOutlook">
                    <div class="provider-info">
                        <div class="provider-logo logo-outlook">
                            <i class="fab fa-windows"></i>
                        </div>
                        <div>
                            <h5 class="provider-name">Microsoft Outlook</h5>
                            <div class="status-area">
                                <span class="apya-chip apya-chip-neutral status-badge">Bağlı Değil</span>
                            </div>
                        </div>
                    </div>
                    <div class="action-area">
                        <button class="btn btn-outline-primary btn-connect" data-provider="2">
                            <i class="fa fa-link me-2"></i>Hesap Bağla
                        </button>
                    </div>
                </div>

                <div class="alert alert-info border-0 shadow-sm rounded-3 mt-2">
                    <div class="d-flex">
                        <i class="fa fa-info-circle fs-4 me-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Dış Takvim Senkronizasyonu Nasıl Çalışır?</h6>
                            <p class="mb-0 small opacity-75">Takviminizi bağladığınızda, APYA üzerindeki size atanan tarihli görevler otomatik olarak dış takviminize bir "Etkinlik" olarak işlenir. Durum veya tarih değişiklikleri çift taraflı güncellenir.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <abp-script src="/Pages/Calendars/index.js" />
    <abp-script src="/Pages/Calendars/calendar.js" />
}
