@page
@model Apya.Platform.Web.Pages.Dashboard.IndexModel
@{
    ViewBag.Title = "Genel Bakış";
}

<partial name="_ApyaThemeBootstrap" />
<island-preload entry="dashboard" />

@* Tam kanamalı: .lpx-content dolgusu apya-shell.css'te iptal ediliyor
   (negatif margin tahmini değerlerle üstte/solda boşluk bırakıyordu). *@
@* Kart düzeni sayfayla birlikte gelir → island onu beklemeden widget isteklerini
   başlatabilir. Gerekçe ve sınırları IndexModel'de. *@
@if (Model.LayoutJson != null)
{
    <script type="application/json" id="apya-dashboard-layout">@Html.Raw(Model.LayoutJson)</script>
}

@* Baskı künyesi (kurum + yazdıran) — istemci tenant ADINI bilemez, bkz IndexModel. *@
@if (Model.PrintContextJson != null)
{
    <script type="application/json" id="apya-dashboard-print-context">@Html.Raw(Model.PrintContextJson)</script>
}

<div id="apya-dashboard-root"></div>

<script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
