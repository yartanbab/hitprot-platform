<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Apya.Platform.Web</RootNamespace>
    <AssetTargetFallback>$(AssetTargetFallback);portable-net45+win8+wp8+wpa81;</AssetTargetFallback>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Apya.Platform-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Yerel geliştirici sırları yayın paketine ASLA girmemeli: aksi halde publish alan
         herkes kendi bağlantı dizisini/anahtarlarını sunucuya taşır ve production
         yapılandırmasını sessizce ezer. Dosya sunucuda elle oluşturulur (bkz.
         docs/deployment/plesk-windows.md). Yerel çalıştırmada output'a kopyalanmaya devam eder. -->
    <Content Update="appsettings.secrets.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2025.4.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.SignalR" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apya.Platform.Application\Apya.Platform.Application.csproj" />
    <ProjectReference Include="..\Apya.Platform.HttpApi\Apya.Platform.HttpApi.csproj" />
    <ProjectReference Include="..\Apya.Platform.EntityFrameworkCore\Apya.Platform.EntityFrameworkCore.csproj" />
    <!-- SQL Server migration assembly'si: runtime'da bin'de bulunsun (Database:Provider=SqlServer). -->
    <ProjectReference Include="..\Apya.Platform.EntityFrameworkCore.SqlServer\Apya.Platform.EntityFrameworkCore.SqlServer.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.Application\Apya.Platform.Ai.Application.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.HttpApi\Apya.Platform.Ai.HttpApi.csproj" />
    <ProjectReference Include="..\Apya.Platform.Ai.EntityFrameworkCore\Apya.Platform.Ai.EntityFrameworkCore.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Identity.Web" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.TenantManagement.Web" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.SettingManagement.Web" Version="10.0.2" />
  </ItemGroup>

</Project>
